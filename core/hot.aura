; Live rules. Installed once with set-code + eval-current. After that,
; (mutate :rebind) replaces any of these while a run is in progress.
; The trailing 0 keeps eval-current from warning about an uncalled
; procedure on stdout.
(define (rule-gravity) 32.0)
(define (rule-jump-v) 11.2)
(define (rule-slide-s) 0.48)
(define (rule-run-speed) 5.0)
(define (rule-coyote-s) 0.12)
(define (rule-forgive) 0.12)
(define (rule-hue) 0.0)
(define (motif-form) "")
0
