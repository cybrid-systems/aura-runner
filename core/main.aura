(define (loot-worth name)
  (cond
    ((string=? name "blossom") 40.0)
    ((string=? name "apple") 55.0)
    ((string=? name "star") 80.0)
    ((string=? name "gem") 120.0)
    (else 25.0)))

(define (rules-hash)
  (rules-of g-now jump-now speed-now slide-now coyote-now forgive-now
            (loot-worth loot-now) air-now magnet-now))

(define thing-src-now "")
; The thing is a cosmetic string. Read the live cell instead of
; rebinding the define: a mutate:rebind recompiles the module for 1-2 s
; on the install tick. The full source below carries the same reader so
; a later rule publish keeps it.
(define (thing-form) thing-src-now)
(define (full-src)
  (string-append
    "(define (thing-form) thing-src-now)\n"
    (hot-source g-now jump-now slide-now speed-now coyote-now forgive-now hue-now motif-now scene-now pals-now air-now magnet-now)))

(define (rule-body n)
  (string-append "(lambda () " (num-src n) ")"))

(define (publish-all!)
  (let ((how (publish-rule! "rule-gravity" (rule-body g-now) (full-src))))
    (set! publish-via how)
    (set! rule-rev (+ rule-rev 1))
    how))

