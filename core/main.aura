; The rival's pace. One knob at a time, after a level, on its own arm.
; A miss puts the previous numbers back. It is not the band policy.
(define chase (chase-blank))
(define level-coins 0)
(define level-swaps 0)
(define chase-recent (list))
(define chase-phase 0)
(define chase-plan #f)
(define chase-road (list))
(define chase-sim (list))
(define chase-body #f)
