; 0 unknown, 1 the runtime accepts an extra hash, 2 two-argument llm:chat.
(define llm-chat-mode 0)
(define llm-extra (hash "reasoning_effort" "minimal" "max_tokens" 2048))
(define llm-reply #f)
(define pending (list))
(define llm-on #f)
; A child's wish holds the chat slot until that reply is scored. Automatic
; asks wait. The 15s clock is only for this path; garden asks keep the
; longer HTTP budget.
(define wish-open #f)
(define wish-queued #f)
(define wish-flight #f)
(define wish-wait #f)
(define wish-think #f)
(define wish-mine #f)
(define wish-text "")
