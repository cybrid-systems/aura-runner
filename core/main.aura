; Lumen Run server. Aura owns rules, chunks, fairness, difficulty and score.
; The browser predicts motion from the rule snapshot so a slow tick never
; changes how a jump feels.
(require "std/socket" all:)
(require "std/string" all:)
(require "std/math" all:)
(require "std/evo" all:)
(require "std/evo-core" all:)
(require "lib/gen")
(require "lib/live")
(require "lib/scene")

(define SYS
  "You design one obstacle phrase for a children's 3D endless runner called Lumen Run. The runner has three lanes (0 left, 1 centre, 2 right), jumps, and slides. Reply with ONLY one s-expression and no markdown. Allowed pieces: (seq (ground W) (gap W) (hurdle H W) (gate BOTTOM W) (coin Y) (spring W) (block LANE DEPTH) (coin-lane LANE Y)). Every parameter is a number; never write the words BOTTOM, W, H, LANE, DEPTH or other placeholders. Ranges in meters: spring W 0.45-1.6, hurdle W 0.35-2.2 and H 0.15-0.9, gate W 0.35-2.0 and BOTTOM 0.58-0.85, coin Y 0.4-2.4, coin-lane LANE 0, 1 or 2 and Y 0.4-2.4, ground W 0.8-18, gap W 0.4-2.0, block LANE 0, 1 or 2 and DEPTH 0.5-2.2. Start and end with ground. Leave at least one lane open beside every block. No violence, fear, weapons, or scary words. Bright garden, friendly shapes. Example: (seq (ground 6) (block 0 1) (hurdle 0.4 0.7) (ground 5) (gate 0.72 0.8) (ground 5) (gap 1.1) (ground 5))")

(define SCENE-SYS
  "You redesign the garden backdrop for a children's 3D endless runner called Lumen Run. Reply with ONLY one s-expression and no markdown. Form: (garden (sky R G B) (ground R G B) (flower KIND DENSITY) (light L)). KIND is one of daisy, tulip, blossom, buttercup. Sky channels are 0.25 to 1 and the sky stays bright. Ground is green: G is at least 0.30 and at least as large as R, and not much smaller than B. Density is 0.15 to 1. Light is 0.50 to 1, never night. Optional (fog F) is 0 to 0.38; do not ask for thicker fog. No violence, fear, weapons, or scary words. Make it look different from a plain blue sky and daisies. Example: (garden (sky 0.95 0.45 0.55) (ground 0.35 0.72 0.32) (flower tulip 0.85) (light 0.9))")

(define g-now 32.0)
(define jump-now 11.2)
(define slide-now 0.48)
(define speed-now 5.0)
(define coyote-now 0.12)
(define forgive-now 0.12)
(define hue-now 0.0)
(define motif-now "")
(define motif-pieces (list))
(define motif-span 0.0)
(define scene-now default-scene)
(define sky-r 0.55)
(define sky-g 0.72)
(define sky-b 0.95)
(define ground-r 0.42)
(define ground-g 0.68)
(define ground-b 0.38)
(define flower-now "daisy")
(define density-now 0.45)
(define light-now 0.82)
(define fog-now 0.22)
(define speed-lock #f)
(define rule-rev 1)
(define publish-via "set-code")

(define seed 1)
(define player (make-player 1.2))
(define world (list))
(define chunks (list))
(define next-id 0)
(define next-x 0.0)
(define sent-id 0)
(define run-ms 0.0)
(define band 0)
(define acc 0.0)
(define last-ms 0)
(define audit (list))
(define policy #f)
(define cleared (list))
; Derived view of the two in-flight flags. Obstacle and garden each keep
; their own, so a hung garden call cannot stop obstacle phrases.
(define llm-busy #f)
(define motif-busy #f)
(define scene-busy #f)
(define motif-asked-at -1.0)
(define scene-asked-at -1.0)
(define motif-token 0)
(define scene-token 0)
(define motif-accept -1)
(define scene-accept -1)
(define motif-working #f)
(define scene-working #f)
(define motif-req #f)
(define scene-req #f)
(define motif-res #f)
(define scene-res #f)
(define llm-timeout-s 120.0)
(define llm-watchdogs 0)
(define stall-ch #f)
(define stall-waiting #f)
(define stall-scene? #f)
(define scene-stalled 0)
(define slide-hinted #f)
(define tick-force -1.0)
; 0 unknown, 1 the runtime accepts an extra hash, 2 two-argument llm:chat.
(define llm-chat-mode 0)
(define llm-extra (hash "reasoning_effort" "minimal" "max_tokens" 2048))
(define llm-reply #f)
(define pending (list))
(define llm-on #f)
(define req-ch #f)
(define res-ch #f)
(define buf "")

(define (rules-hash)
  (rules-of g-now jump-now speed-now slide-now coyote-now forgive-now))

(define (full-src)
  (hot-source g-now jump-now slide-now speed-now coyote-now forgive-now hue-now motif-now scene-now))

(define (rule-body n)
  (string-append "(lambda () " (num-src n) ")"))

(define (publish-all!)
  (let ((how (publish-rule! "rule-gravity" (rule-body g-now) (full-src))))
    (set! publish-via how)
    (set! rule-rev (+ rule-rev 1))
    how))

(define rules-dirty #f)
(define next-dream 1500.0)
(define dream-phase 0)
(define dream-pieces (list))
(define dream-sim (list))
(define dream-body #f)
(define dream-i 0)
(define dream-form "")
(define dream-span 0.0)
(define tuned #f)

(define (publish-named! name value)
  (let ((how (publish-rule! name (rule-body value) (full-src))))
    (set! publish-via how)
    (set! rule-rev (+ rule-rev 1))
    (set! rules-dirty #t)
    how))

(define (note! kind why arm . rest)
  (let ((cue (if (and (pair? rest) (string? (car rest))) (car rest) "")))
    (let ((row (hash "op" "decision" "kind" kind "why" why "arm" arm
                     "via" publish-via "cue" cue)))
    (set! audit (cons (hash "kind" kind "why" why "arm" arm "cue" cue) audit))
    (if (> (length audit) 12)
      (set! audit (take-n audit 12))
      #f)
    (set! pending (cons row pending))
    (try (evo:record! arm kind why (hash "arm" arm) "" 0) (catch (e) #f))
    row)))

(define (flush-notes! c)
  (let loop ((xs (reverse pending)))
    (if (null? xs)
      (set! pending (list))
      (begin
        (send c (car xs))
        (loop (cdr xs))))))

(define (int-str n)
  (let ((s (number->string (floor (exact->inexact n)))))
    (if (string-suffix? s ".0")
      (substring s 0 (- (string-length s) 2))
      s)))

(define (take-n xs n)
  (if (or (null? xs) (<= n 0))
    (list)
    (cons (car xs) (take-n (cdr xs) (- n 1)))))

(define (arm-name b)
  (string-append "band-" (number->string b)))

(define (band-of arm)
  (cond
    ((string=? arm "band-1") 1)
    ((string=? arm "band-2") 2)
    ((string=? arm "band-3") 3)
    ((string=? arm "band-4") 4)
    (else 0)))

; Gravity, jump and slide ease with the band so a faster path stays
; reachable. The step is one notch at a time: a new arm is added only
; after the current one is being cleared.
(define (feel-for b)
  (cond
    ((= b 0) (list 32.0 11.2 0.48 5.0))
    ((= b 1) (list 31.4 11.4 0.50 5.8))
    ((= b 2) (list 30.8 11.6 0.52 6.6))
    ((= b 3) (list 30.4 11.8 0.54 7.3))
    (else (list 30.0 12.0 0.56 8.0))))

(define (arm-row name)
  (list (cons "arm" name) (cons "n" 0) (cons "keeps" 0) (cons "mean" 0.0)))

; #5274: a long run can refuse hash-set! while another fiber holds the
; mutation boundary. The tick path builds hashes instead of mutating
; them. Policy updates are skipped when a trial is open or the write
; is refused, so the core keeps serving.
(define trial-open #f)
(define llm-kind "motif")
(define motif-next 2500.0)
(define scene-next 5000.0)

(define (hash-put! h k v)
  (try (begin (hash-set! h k v) #t) (catch (e) #f)))

(define (open-trial cand spec)
  (set! trial-open #t)
  (let ((trial (try (evo:trial cand spec) (catch (e) #f))))
    (set! trial-open #f)
    trial))

(define (make-policy)
  (let ((p (evo:policy "ucb" (quote ()))))
    (if (not (hash-put! p "arms" (list (arm-row "band-0") (arm-row "band-1"))))
      #f
      #f)
    p))

(define (row-get row key fallback)
  (let loop ((xs row))
    (if (or (not (pair? xs)) (null? xs))
      fallback
      (if (and (pair? (car xs)) (string? (car (car xs))) (string=? (car (car xs)) key))
        (cdr (car xs))
        (loop (cdr xs))))))

(define (find-arm rows name)
  (let loop ((xs rows))
    (if (null? xs)
      #f
      (if (string=? (row-get (car xs) "arm" "") name)
        (car xs)
        (loop (cdr xs))))))

(define (has-arm? rows name)
  (if (find-arm rows name) #t #f))

; Open the next band only after this one has been cleared more often
; than not. A miss does not unlock a crueller arm.
(define (open-next-arm!)
  (if (>= band 4)
    #f
    (let ((rows (hash-ref policy "arms" (list)))
          (nxt (arm-name (+ band 1))))
      ; llm-busy used to skip this for the whole wait, so a hung call
      ; never opened band 2. The watchdog clears that latch. hash-set!
      ; itself is still fatal on this pin while a fiber is inside
      ; llm:chat (#5274), so the write waits only for that call to leave
      ; the interpreter. A trial skips it too.
      (if (or (has-arm? rows nxt) trial-open motif-working scene-working
              (env-on? "LUMEN_SKIP_ARM"))
        #f
        (let ((row (find-arm rows (arm-name band))))
          (if (and row
                   (>= (row-get row "n" 0) 2)
                   (>= (row-get row "mean" 0.0) 0.5))
            (hash-put! policy "arms" (append rows (list (arm-row nxt))))
            #f))))))

(define (choose-band)
  (if (or (< run-ms 30000.0) (env-on? "LUMEN_SKIP_ARM"))
    (begin (set! band 0) "tutorial")
    (begin
      (open-next-arm!)
      (let ((sel (evo:policy-select policy)))
        (let ((arm (if (and (pair? sel) (string? (car sel))) (car sel) "band-0"))
              (next (if (and (pair? sel) (pair? (cdr sel)) (hash? (car (cdr sel))))
                      (car (cdr sel))
                      #f)))
          (if next (set! policy next) #f)
          (set! band (band-of arm))
          "ucb")))))

(define (apply-feel! why)
  (let ((f (feel-for band)))
    (let ((ng (car f))
          (nj (car (cdr f)))
          (nsl (car (cdr (cdr f))))
          (nv (car (cdr (cdr (cdr f)))))
          (cue ""))
      (if (not (= ng g-now))
        (begin
          (set! g-now ng)
          (publish-named! "rule-gravity" g-now)
          (if (= (string-length cue) 0)
            (set! cue (if (< ng 32.0) "Lighter steps" "A bit heavier"))
            #f))
        #f)
      (if (not (= nj jump-now))
        (begin
          (set! jump-now nj)
          (publish-named! "rule-jump-v" jump-now)
          (if (= (string-length cue) 0) (set! cue "Higher jumps") #f))
        #f)
      (if (not (= nsl slide-now))
        (begin
          (set! slide-now nsl)
          (publish-named! "rule-slide-s" slide-now)
          (if (= (string-length cue) 0) (set! cue "Longer slides") #f))
        #f)
      (if (and (not speed-lock) (not (= nv speed-now)))
        (begin
          (let ((up (> nv speed-now)))
            (set! speed-now nv)
            (publish-named! "rule-run-speed" speed-now)
            (set! cue (if up "A little faster" "A gentler pace"))))
        #f)
      (if (> (string-length cue) 0)
        (begin (set! tuned #t) (note! "KEEP" why "rule" cue))
        #f)
      why)))

(define (shift-onto pieces x0)
  (shift-pieces pieces x0))

(define (any-gate? ps)
  (let loop ((xs ps))
    (if (null? xs)
      #f
      (if (= (piece-k (car xs)) 4.0) #t (loop (cdr xs))))))

(define (add-chunk! origin pieces span b h)
  (let ((placed (shift-onto pieces next-x))
        (id next-id)
        (x0 next-x)
        (x1 (+ next-x span)))
    (set! chunks (append chunks (list (hash "id" id "x0" x0 "x1" x1
                                            "band" b "origin" origin "hue" h
                                            "pieces" placed))))
    (set! world (append world placed))
    (set! next-x x1)
    (set! next-id (+ id 1))
    (if (and (not slide-hinted) (any-gate? placed))
      (begin
        (set! slide-hinted #t)
        (note! "KEEP" "tutorial" "gate" "Slide under the bar"))
      #f)
    id))

(define (spawn-chunk!)
  (let ((why (choose-band)))
    (apply-feel! why)
    (if (and (pair? motif-pieces) (> motif-span 0.5) (= (modulo next-id 3) 2))
      (add-chunk! "motif" motif-pieces motif-span band hue-now)
      (let ((ch (chunk-or-fallback (pattern-chunk seed next-id band))))
        (if ch
          (add-chunk! (hash-ref ch "origin" "offline")
                      (hash-ref ch "pieces") (hash-ref ch "x1") band hue-now)
          ; Layout of the fallback itself failed. Still step the cursor so
          ; ensure-ahead cannot spin in place and leave the road empty.
          (add-chunk! "fallback"
                      (list (piece 3.0 1.2 0.7 0.45 0.0))
                      8.0 band hue-now))))))

(define (ensure-ahead!)
  (let loop ((guard 0))
    (if (or (>= guard 8) (> next-x (+ (player-x player) 42.0)))
      #t
      (begin
        (spawn-chunk!)
        (loop (+ guard 1))))))

(define (sync-rules!)
  (publish-named! "rule-gravity" g-now)
  (publish-named! "rule-jump-v" jump-now)
  (publish-named! "rule-slide-s" slide-now)
  (publish-named! "rule-run-speed" speed-now)
  (publish-named! "rule-hue" hue-now)
  (let ((how (publish-rule! "motif-form" (motif-body motif-now) (full-src))))
    (set! publish-via how)
    (set! rule-rev (+ rule-rev 1))
    (set! rules-dirty #t)))

(define (reset-run!)
  ; A death used to leave llm-busy set, so the next run never asked again.
  (set! llm-busy #f)
  (set! motif-busy #f)
  (set! scene-busy #f)
  (set! motif-accept -1)
  (set! scene-accept -1)
  (set! motif-asked-at -1.0)
  (set! scene-asked-at -1.0)
  (set! slide-hinted #f)
  (set! player (make-player 1.2))
  (set! world (list))
  (set! chunks (list))
  (set! next-id 0)
  (set! next-x 0.0)
  (set! sent-id 0)
  (set! run-ms 0.0)
  (set! band 0)
  (set! acc 0.0)
  (set! last-ms 0)
  (set! cleared (list))
  (set! g-now 32.0)
  (set! jump-now 11.2)
  (set! slide-now 0.48)
  (set! hue-now 0.0)
  (set! motif-now "")
  (set! motif-pieces (list))
  (set! motif-span 0.0)
  (set! next-dream 1500.0)
  (set! motif-next 2500.0)
  (set! scene-next 5000.0)
  (set! dream-phase 0)
  (if (not speed-lock) (set! speed-now 5.0) #f)
  (if tuned
    (begin (sync-rules!) (set! tuned #f))
    #f)
  (ensure-ahead!))

(define (parse-seed v)
  (cond
    ((and (number? v) (> v 0)) (exact->inexact v))
    ((and (string? v) (string-prefix? v "LUMEN-"))
     (let ((n (string->number (substring v 6 (string-length v)))))
       (if (and (number? n) (> n 0)) (exact->inexact n) #f)))
    (else #f)))

(define (fresh-seed)
  (+ 1 (modulo (monotonic-ms) 900000)))

(define (send c v)
  (tcp-send c (string-append (json-encode v) "\n")))

(define (rules-msg)
  (hash "op" "rules" "rev" rule-rev
        "g" g-now "jump" jump-now "speed" speed-now
        "slide" slide-now "coyote" coyote-now "forgive" forgive-now
        "hue" hue-now "ph" 1.05 "pw" 0.56 "sh" 0.46
        "via" publish-via
        "sky" (list sky-r sky-g sky-b)
        "ground" (list ground-r ground-g ground-b)
        "flower" flower-now "density" density-now "light" light-now
        "fog" fog-now
        "motif" motif-now "scene" scene-now))

(define (welcome-msg)
  (hash "op" "welcome" "seed" seed
        "replay" (string-append "LUMEN-" (int-str seed))
        "rev" rule-rev "via" publish-via
        "g" g-now "jump" jump-now "speed" speed-now
        "slide" slide-now "coyote" coyote-now "forgive" forgive-now
        "hue" hue-now "ph" 1.05 "pw" 0.56 "sh" 0.46
        "sky" (list sky-r sky-g sky-b)
        "ground" (list ground-r ground-g ground-b)
        "flower" flower-now "density" density-now "light" light-now
        "fog" fog-now
        "motif" motif-now "scene" scene-now))

; The event is part of the hash when it is built. A later hash-set! on
; this value is the site cybrid-systems/aura #5274 exits from.
(define (state-msg ev)
  (hash "op" "state"
        "x" (player-x player)
        "y" (player-y player)
        "vy" (player-vy player)
        "alive" #t
        "score" (floor (score-now player))
        "slide" (if (> (pxs player 3) 0.0) 1 0)
        "lane" (player-lane player)
        "lx" (player-lx player)
        "band" band
        "g" g-now
        "jump" jump-now
        "speed" speed-now
        "slide-dur" slide-now
        "rev" rule-rev
        "run" (floor run-ms)
        "hue" hue-now
        "seed" seed
        "event" ev
        "grace" (player-grace player)
        "chunks" (length chunks)
        "sky" (list sky-r sky-g sky-b)
        "ground" (list ground-r ground-g ground-b)
        "flower" flower-now
        "density" density-now
        "light" light-now
        "fog" fog-now
        "motif" motif-now
        "scene" scene-now
        "ahead" (obstacles-ahead)
        "llm-busy" (if (or motif-busy scene-busy) #t #f)
        "motif-busy" (if motif-busy #t #f)
        "scene-busy" (if scene-busy #t #f)
        "watchdogs" llm-watchdogs
        "stall" (if stall-waiting #t #f)))

(define (chunk-msg c)
  (hash "op" "chunk"
        "id" (hash-ref c "id")
        "x0" (hash-ref c "x0")
        "x1" (hash-ref c "x1")
        "band" (hash-ref c "band")
        "origin" (hash-ref c "origin")
        "hue" (hash-ref c "hue")
        "pieces" (hash-ref c "pieces")))

; all? resends every chunk still on the server. A reconnect cannot
; rebuild the road from the browser's pruned list alone.
(define (emit-chunks c all?)
  (let loop ((cs chunks))
    (if (null? cs)
      #t
      (begin
        (if (or all? (>= (hash-ref (car cs) "id") sent-id))
          (send c (chunk-msg (car cs)))
          #f)
        (loop (cdr cs)))))
  (set! sent-id next-id))

(define (send-new-chunks c)
  (emit-chunks c #f))

(define (send-all-chunks c)
  (emit-chunks c #t))

(define (obstacle-kind? k)
  (or (= k 2.0) (= k 3.0) (= k 4.0) (= k 7.0)))

(define (obstacles-ahead)
  (let ((x0 (player-x player))
        (x1 (+ (player-x player) 40.0)))
    (let loop ((ps world) (n 0))
      (if (null? ps)
        n
        (let ((q (car ps)))
          (loop (cdr ps)
                (if (and (obstacle-kind? (piece-k q))
                         (> (piece-x q) x0)
                         (< (piece-x q) x1))
                  (+ n 1)
                  n)))))))

(define (mark-cleared!)
  (let loop ((cs chunks))
    (if (null? cs)
      #t
      (let ((ch (car cs)))
        (if (and (player-alive? player)
                 (>= (player-x player) (hash-ref ch "x1"))
                 (not (member-id? (hash-ref ch "id") cleared)))
          (begin
            (set! cleared (cons (hash-ref ch "id") cleared))
            (if (env-on? "LUMEN_SKIP_ARM")
              #f
              (set! policy (evo:policy-report policy (arm-name (hash-ref ch "band")) #t)))
            (note! "CLEAR" "cleared" (arm-name (hash-ref ch "band"))))
          #f)
        (loop (cdr cs))))))

(define (member-id? id xs)
  (let loop ((ys xs))
    (if (null? ys) #f
      (if (= (car ys) id) #t (loop (cdr ys))))))

(define (one-step!)
  (let ((r (step player world (rules-hash) PHYS-DT)))
    (set! player (car r))
    (set! world (prune-world (car (cdr r)) (player-x player)))
    (set! chunks (prune-chunks chunks (player-x player)))
    (if (> (length cleared) 32)
      (set! cleared (take-n cleared 32))
      #f)
    (set! run-ms (+ run-ms (* PHYS-DT 1000.0)))
    (mark-cleared!)
    (car (cdr (cdr r)))))

(define (prune-world ps x)
  (let loop ((ys ps) (acc (list)))
    (if (null? ys)
      (reverse acc)
      (let ((q (car ys)))
        (if (or (= (piece-k q) 0.0)
                (< (+ (piece-x q) (piece-w q)) (- x 8.0)))
          (loop (cdr ys) acc)
          (loop (cdr ys) (cons q acc)))))))

(define (keep-event cur next)
  (cond
    ((or (string=? next "bump") (string=? next "oops")) next)
    ((or (string=? cur "bump") (string=? cur "oops")) cur)
    ((string=? next "ok") cur)
    (else next)))

(define (pump! dt-ms)
  ; A test can advance a whole second per message. A live tick stays at
  ; a tenth of a second so one slow frame cannot skip the road.
  (let ((cap (if (> (tick-force-ms) 0.0) 3.0 0.1))
        (limit (if (> (tick-force-ms) 0.0) 180 6)))
    (set! acc (+ acc (min cap (/ (exact->inexact dt-ms) 1000.0))))
    (let loop ((n 0) (ev "ok"))
      (if (or (< acc PHYS-DT) (>= n limit))
        ev
        (begin
          (set! acc (- acc PHYS-DT))
          (loop (+ n 1) (keep-event ev (one-step!))))))))

(define (tick-force-ms)
  (if (>= tick-force 0.0)
    tick-force
    (let ((raw (try (getenv "LUMEN_TICK_MS") (catch (e) ""))))
      (let ((n (if (and (string? raw) (> (string-length raw) 0)) (string->number raw) 0)))
        (set! tick-force (if (and (number? n) (> n 0)) (min 3000.0 (exact->inexact n)) 0.0))
        tick-force))))

(define (elapsed-ms)
  (let ((forced (tick-force-ms)))
    (if (> forced 0.0)
      forced
      (let ((now (monotonic-ms)))
        (let ((d (if (= last-ms 0) 16 (- now last-ms))))
          (set! last-ms now)
          (if (> d 80) 80 (if (< d 0) 0 d)))))))

; The kept string is compared against the live binding. rebind is tried
; first; if persist-reject aborts it, set-code installs the same source.
; Pieces and garden colours change only after that binding matches.
(define (live-motif)
  (let ((got (try (motif-form) (catch (e) ""))))
    (if (string? got) got "")))

(define (live-scene)
  (let ((got (try (scene-form) (catch (e) ""))))
    (if (string? got) got "")))

(define (phrase-apply target)
  (lambda (s c)
    (let ((genome (evo:candidate-genome c)))
      (let ((body (if (string=? target "scene-form")
                    (scene-body genome)
                    (motif-body genome))))
        (not (string=? (publish-rule! target body (full-src)) "fail"))))))

(define (phrase-search target)
  (evo:search
    (hash "algo" "lumen" "seed" (floor seed) "budget" 8
          "target" target
          "apply" (phrase-apply target))))

(define (binding-landed? name body expected)
  (let ((live (if (string=? name "scene-form") (live-scene) (live-motif))))
    (if (string=? live expected)
      #t
      (and (not (string=? (publish-rule! name body (full-src)) "fail"))
           (string=? (if (string=? name "scene-form") (live-scene) (live-motif)) expected)))))

(define (try-tell-commit! search cand ev)
  (try (begin (evo:tell! search (list cand) (list ev))
              (evo:commit! search cand))
       (catch (e) #f)))

(define (consider-form! text)
  (let ((form (one-line (if (string? text) text ""))))
    (let ((found #f))
      (let* ((cand (evo:candidate form (hash "id" (string-append "m" (int-str next-id))
                                            "target" "motif-form")))
             (trial (open-trial cand
                               (hash "timeout-ms" 4000
                                     "apply" (lambda (c) #t)
                                     "evaluate"
                                     (lambda (c)
                                       (set! found (check-source form (rules-hash)))
                                       (hash "status" "ok"
                                             "objectives"
                                             (hash "fair" (if (and found (hash-ref found "ok")) 1.0 0.0))
                                             "constraints"
                                             (if (and found (hash? (hash-ref found "violations")))
                                               (hash-ref found "violations")
                                               (hash "reachable" 1.0))
                                             "behavior" (hash "band" (exact->inexact band))))))))
        (cond
          ((or (not found) (not (hash-ref found "ok"))
               (not trial) (not (evo:trial-ok? trial)) (not (evo:feasible? trial)))
           (note! "ROLLBACK" (if (and found (string? (hash-ref found "why")))
                               (hash-ref found "why")
                               "trial")
                  "motif" "That shape drifted away"))
          (else
           (let ((prev-form motif-now))
             (set! motif-now form)
             (let ((ev (hash "status" "ok"
                             "objectives" (hash "fair" 1.0)
                             "constraints" (hash-ref found "violations")
                             "behavior" (hash "band" (exact->inexact band))))
                   (search (phrase-search "motif-form")))
               (try-tell-commit! search cand ev)
               (if (binding-landed? "motif-form" (motif-body form) form)
                 (begin
                   (set! motif-pieces (hash-ref found "pieces"))
                   (set! motif-span (hash-ref found "x1"))
                   (set! hue-now (exact->inexact (modulo (+ (floor hue-now) 1) 6)))
                   (publish-named! "rule-hue" hue-now)
                   (note! "KEEP" "fair" "motif" "A new shape bloomed"))
                 (begin
                   (set! motif-now prev-form)
                   (note! "ROLLBACK" "commit" "motif" "That shape drifted away")))))))))))

(define (lref xs i)
  (if (<= i 0) (car xs) (lref (cdr xs) (- i 1))))

; The slice already ran the autopilot. The trial records that verdict
; and rebinds the kept phrase; it does not simulate the chunk again.
(define (seal-sliced! cleared?)
  (let ((form dream-form)
        (pieces dream-pieces)
        (span dream-span))
    (let ((found #f))
      (let* ((cand (evo:candidate form (hash "id" (string-append "d" (int-str next-id))
                                            "target" "motif-form")))
             (trial (open-trial cand
                               (hash "timeout-ms" 1500
                                     "apply" (lambda (c) #t)
                                     "evaluate"
                                     (lambda (c)
                                       (set! found (layout-form form (rules-hash)))
                                       (hash "status" "ok"
                                             "objectives"
                                             (hash "fair" (if (and cleared? found
                                                                   (<= (hash-ref found "geometry" 1.0) 0.0)
                                                                   (<= (hash-ref found "budget" 1.0) 0.0))
                                                            1.0 0.0))
                                             "constraints"
                                             (hash "budget" (if found (hash-ref found "budget" 1.0) 1.0)
                                                   "geometry" (if found (hash-ref found "geometry" 1.0) 1.0)
                                                   "reachable" (if cleared? 0.0 1.0)
                                                   "safe" 0.0)
                                             "behavior" (hash "band" (exact->inexact band))))))))
        (if (or (not found) (not cleared?)
                (> (hash-ref found "geometry" 1.0) 0.0)
                (> (hash-ref found "budget" 1.0) 0.0)
                (not trial) (not (evo:trial-ok? trial)) (not (evo:feasible? trial)))
          (note! "ROLLBACK" "reachable" "motif" "That shape drifted away")
          (let ((prev-form motif-now))
            (set! motif-now form)
            (let ((ev (hash "status" "ok"
                            "objectives" (hash "fair" 1.0)
                            "constraints" (hash "budget" 0.0 "geometry" 0.0 "reachable" 0.0 "safe" 0.0)
                            "behavior" (hash "band" (exact->inexact band))))
                  (search (phrase-search "motif-form")))
              (try-tell-commit! search cand ev)
              (if (binding-landed? "motif-form" (motif-body form) form)
                (begin
                  (set! motif-pieces pieces)
                  (set! motif-span span)
                  (set! hue-now (exact->inexact (modulo (+ (floor hue-now) 1) 6)))
                  (publish-named! "rule-hue" hue-now)
                  (note! "KEEP" "fair" "motif" "A new shape bloomed"))
                (begin
                  (set! motif-now prev-form)
                  (note! "ROLLBACK" "commit" "motif" "That shape drifted away"))))))))))

(define (begin-dream!)
  (set! dream-phase 1)
  (consider-form! "(seq (ground 4.0) (gap 5.5) (ground 4.0))")
  (set! dream-form (pattern-form seed (+ next-id 1) band))
  (let ((laid (layout-form dream-form (rules-hash))))
    (if (or (not laid) (> (hash-ref laid "geometry" 1.0) 0.0))
      (begin
        (set! dream-phase 0)
        (set! next-dream (+ run-ms 8000.0))
        (note! "ROLLBACK" "geometry" "motif" "That shape drifted away"))
      (begin
        (set! dream-pieces (hash-ref laid "pieces"))
        (set! dream-span (hash-ref laid "x1"))
        (set! dream-sim dream-pieces)
        (set! dream-body (make-player 0.4))
        (set! dream-i 0)))))

(define (step-dream!)
  (let ((r (autopilot-slice dream-pieces (rules-hash) dream-body dream-sim dream-i 12)))
    (set! dream-i (lref r 1))
    (set! dream-body (lref r 2))
    (set! dream-sim (lref r 3))
    (if (lref r 0)
      (begin
        (set! dream-phase 0)
        (set! next-dream (+ run-ms 22000.0))
        (seal-sliced! (if (lref r 4) #t #f)))
      #f)))

; An in-progress slice keeps going after a fall so the verdict still lands.
; A new dream starts only while the run is alive, a couple of seconds in.
(define (maybe-dream!)
  (if (env-on? "LUMEN_SKIP_DREAM")
    #f
    (cond
      ((= dream-phase 1) (step-dream!))
      ((and (player-alive? player) (>= run-ms next-dream))
       (begin-dream!))
      (else #f))))

(define (apply-scene! found form)
  (set! scene-now form)
  (set! sky-r (hash-ref found "sky-r"))
  (set! sky-g (hash-ref found "sky-g"))
  (set! sky-b (hash-ref found "sky-b"))
  (set! ground-r (hash-ref found "ground-r"))
  (set! ground-g (hash-ref found "ground-g"))
  (set! ground-b (hash-ref found "ground-b"))
  (set! flower-now (hash-ref found "flower"))
  (set! density-now (hash-ref found "density"))
  (set! light-now (hash-ref found "light"))
  (set! fog-now (hash-ref found "fog" 0.22)))

(define (consider-scene! text)
  (let ((form (one-line (if (string? text) text ""))))
    (let ((found #f))
      (let* ((cand (evo:candidate form (hash "id" (string-append "s" (int-str next-id))
                                            "target" "scene-form")))
             (trial (open-trial cand
                                (hash "timeout-ms" 4000
                                      "apply" (lambda (c) #t)
                                      "evaluate"
                                      (lambda (c)
                                        (set! found (check-scene form))
                                        (hash "status" "ok"
                                              "objectives"
                                              (hash "fair" (if (and found (hash-ref found "ok")) 1.0 0.0))
                                              "constraints"
                                              (if (and found (hash? (hash-ref found "violations")))
                                                (hash-ref found "violations")
                                                (hash "reachable" 1.0))
                                              "behavior" (hash "band" (exact->inexact band))))))))
        (if (or (not found) (not (hash-ref found "ok"))
                (not trial) (not (evo:trial-ok? trial)) (not (evo:feasible? trial)))
          (note! "ROLLBACK" (if (and found (string? (hash-ref found "why")))
                              (hash-ref found "why")
                              "trial")
                 "scene" "The garden stayed")
          (let ((prev-form scene-now))
            (set! scene-now form)
            (let ((ev (hash "status" "ok"
                            "objectives" (hash "fair" 1.0)
                            "constraints" (hash-ref found "violations")
                            "behavior" (hash "band" (exact->inexact band))))
                  (search (phrase-search "scene-form")))
              (try-tell-commit! search cand ev)
              (if (binding-landed? "scene-form" (scene-body form) form)
                (begin
                  (apply-scene! found form)
                  (set! rule-rev (+ rule-rev 1))
                  (set! rules-dirty #t)
                  (note! "KEEP" "fair" "scene" (hash-ref found "cue" "The garden changed color")))
                (begin
                  (set! scene-now prev-form)
                  (note! "ROLLBACK" "commit" "scene" "The garden stayed"))))))))))

(define (llm-prompt kind)
  (if (string=? kind "scene")
    (string-append "Flowers now: " flower-now
                   ". Sky is " (num-src sky-r) " " (num-src sky-g) " " (num-src sky-b)
                   ". Suggest a different bright garden.")
    (string-append "Difficulty band " (number->string band)
                   ". Jump speed is " (num-src speed-now)
                   " m/s. Invent a different rhythm from a straight row of hurdles.")))

; Game-side budget. The runtime's own HTTP cap is LLM_TIMEOUT; if that
; call never comes back, give up LLM_TIMEOUT+10 seconds later and drop
; whatever arrives after that.
(define (load-llm-timeout!)
  (let ((raw (try (getenv "LLM_TIMEOUT") (catch (e) ""))))
    (let ((alt (if (and (string? raw) (> (string-length raw) 0))
                 raw
                 (try (getenv "AURA_HTTP_TIMEOUT") (catch (e) "")))))
      (let ((n (if (and (string? alt) (> (string-length alt) 0))
                 (string->number alt)
                 #f)))
        (if (and (number? n) (> n 0))
          (set! llm-timeout-s (exact->inexact n))
          #f)))))

(define (watchdog-ms)
  (* (+ llm-timeout-s 10.0) 1000.0))

; Tests can ask for obstacles less often. The live game stays at 16 seconds.
(define (motif-gap-ms)
  (let ((raw (try (getenv "LUMEN_MOTIF_GAP_MS") (catch (e) ""))))
    (let ((n (if (and (string? raw) (> (string-length raw) 0)) (string->number raw) #f)))
      (if (and (number? n) (> n 0)) (exact->inexact n) 16000.0))))

(define (sync-llm-busy!)
  (set! llm-busy (or motif-busy scene-busy)))

(define (expire-one! busy asked accept-now arm cue)
  (if (and busy (> asked 0.0) (> (- (monotonic-ms) asked) (watchdog-ms)))
    (begin
      (set! llm-watchdogs (+ llm-watchdogs 1))
      (note! "ROLLBACK" "watchdog" arm cue)
      #t)
    #f))

(define (expire-llm!)
  (if (expire-one! scene-busy scene-asked-at scene-accept "scene" "The garden waited")
    (begin (set! scene-accept -1) (set! scene-busy #f))
    #f)
  (if (expire-one! motif-busy motif-asked-at motif-accept "llm" "Still thinking")
    (begin (set! motif-accept -1) (set! motif-busy #f))
    #f)
  (sync-llm-busy!))

(define (accept-reply! tok accept)
  (and (number? tok) (number? accept) (>= accept 0) (= tok accept)))

(define (take-scene! c msg)
  (if (not (accept-reply! (hash-ref msg "token" -1) scene-accept))
    #f
    (let ((ans (hash-ref msg "ans" #f)))
      (set! scene-busy #f)
      (set! scene-accept -1)
      (if (and (hash? ans) (hash-ref ans "ok"))
        (let ((form (extract-garden (hash-ref ans "content" ""))))
          (if form
            (consider-scene! form)
            (note! "ROLLBACK" "no-garden" "scene" "The garden stayed")))
        (note! "ROLLBACK" (if (hash? ans) (hash-ref ans "error" "llm") "llm")
               "scene" "The garden stayed"))
      (send c (rules-msg))
      (set! rules-dirty #f))))

(define (take-motif! c msg)
  (if (not (accept-reply! (hash-ref msg "token" -1) motif-accept))
    #f
    (let ((ans (hash-ref msg "ans" #f)))
      (set! motif-busy #f)
      (set! motif-accept -1)
      (if (and (hash? ans) (hash-ref ans "ok"))
        (let ((form (extract-seq (hash-ref ans "content" ""))))
          (if form
            (consider-form! form)
            (note! "ROLLBACK" "no-seq" "llm" "That shape drifted away")))
        (note! "ROLLBACK" (if (hash? ans) (hash-ref ans "error" "llm") "llm")
               "llm" "That shape drifted away"))
      (send c (rules-msg))
      (set! rules-dirty #f))))

; Send on the caller. The worker is the only receiver, and we do not
; enqueue a second job while it is still inside llm:chat, so this does
; not block the tick and does not allocate a closure per ask.
(define (ask-scene!)
  (if (or scene-working (not scene-req))
    #f
    (let ((tok (+ scene-token 1)))
      (set! scene-token tok)
      (set! scene-accept tok)
      (set! scene-asked-at (exact->inexact (monotonic-ms)))
      (set! scene-busy #t)
      (set! scene-next (+ run-ms 12000.0))
      (channel:send scene-req (hash "kind" "scene" "token" tok "user" (llm-prompt "scene")))
      (sync-llm-busy!))))

(define (ask-motif!)
  (if (or motif-working (not motif-req))
    #f
    (let ((tok (+ motif-token 1)))
      (set! motif-token tok)
      (set! motif-accept tok)
      (set! motif-asked-at (exact->inexact (monotonic-ms)))
      (set! motif-busy #t)
      (set! motif-next (+ run-ms (motif-gap-ms)))
      (channel:send motif-req (hash "kind" "motif" "token" tok "user" (llm-prompt "motif")))
      (sync-llm-busy!))))

; channel:try-recv on an empty channel is #f (#5161). Each kind has its
; own channel, so a garden call that never returns cannot eat the next
; obstacle phrase. A late hash whose token was retired by the watchdog
; is ignored.
(define (poll-llm! c)
  (if (not llm-on)
    #f
    (begin
      ; try-recv only while a call is outstanding. An idle poll that still
      ; touches the channel every tick retains a capture frame per call on
      ; this Aura pin and a long run exhausts the arena.
      (if (or scene-busy motif-busy) (expire-llm!) #f)
      (if scene-busy
        (let ((scene-msg (channel:try-recv scene-res)))
          (if (hash? scene-msg) (take-scene! c scene-msg) #f))
        #f)
      (if motif-busy
        (let ((motif-msg (channel:try-recv motif-res)))
          (if (hash? motif-msg) (take-motif! c motif-msg) #f))
        #f)
      (sync-llm-busy!)
      (if (and (not scene-busy) (not scene-working) (>= run-ms scene-next))
        (ask-scene!)
        #f)
      (if (and (not motif-busy) (not motif-working) (>= run-ms motif-next))
        (ask-motif!)
        #f))))

(define (on-hello c msg)
  (let ((parsed (parse-seed (hash-ref msg "seed" #f))))
    (set! seed (if parsed parsed (exact->inexact (fresh-seed))))
    (set! speed-lock #f)
    (set! speed-now 5.0)
    (reset-run!)
    (send c (welcome-msg))
    (send-all-chunks c)
    (send c (state-msg "ok"))
    (flush-notes! c)))

(define (on-restart c msg)
  (let ((parsed (parse-seed (hash-ref msg "seed" #f))))
    (if parsed (set! seed parsed) #f)
    (reset-run!)
    (send c (welcome-msg))
    (send-all-chunks c)
    (send c (state-msg "ok"))
    (flush-notes! c)))

(define (on-resync c msg)
  (send c (hash "op" "resync" "seed" seed))
  (send-all-chunks c)
  (send c (state-msg "ok"))
  (flush-notes! c))

(define (on-tick c msg)
  (if (and (player-alive? player) (> (hash-ref msg "jump" 0) 0))
    (set! player (press-jump player))
    #f)
  (if (and (player-alive? player) (> (hash-ref msg "slide" 0) 0))
    (set! player (press-slide player))
    #f)
  (if (and (player-alive? player) (number? (hash-ref msg "lane" 0))
           (not (= (hash-ref msg "lane" 0) 0)))
    (set! player (press-lane player (hash-ref msg "lane" 0)))
    #f)
  (let ((ev (pump! (elapsed-ms))))
    (if (or (string=? ev "bump") (string=? ev "oops"))
      (note! "BUMP" ev "run"
             (if (string=? ev "oops") "Back on the path" "Oops! Keep going"))
      #f)
    (maybe-dream!)
    (ensure-ahead!)
    (poll-llm! c)
    (send-new-chunks c)
    (if rules-dirty
      (begin (send c (rules-msg)) (set! rules-dirty #f))
      #f)
    (send c (state-msg ev))
    (flush-notes! c)))

(define (on-rebind c msg)
  (let ((name (hash-ref msg "name" ""))
        (value (hash-ref msg "value" #f)))
    (if (not (and (number? value)
                  (or (string=? name "gravity") (string=? name "jump")
                      (string=? name "slide") (string=? name "speed")
                      (string=? name "hue"))))
      (send c (hash "op" "err" "why" "bad-value"))
      (begin
        (cond
          ((string=? name "gravity") (set! g-now (exact->inexact value)))
          ((string=? name "jump") (set! jump-now (exact->inexact value)))
          ((string=? name "slide") (set! slide-now (exact->inexact value)))
          ((string=? name "speed")
           (begin (set! speed-now (exact->inexact value)) (set! speed-lock #t)))
          ((string=? name "hue") (set! hue-now (exact->inexact value))))
        (set! tuned #t)
        (publish-named! (cond
                          ((string=? name "gravity") "rule-gravity")
                          ((string=? name "jump") "rule-jump-v")
                          ((string=? name "slide") "rule-slide-s")
                          ((string=? name "speed") "rule-run-speed")
                          (else "rule-hue"))
                        (cond
                          ((string=? name "gravity") g-now)
                          ((string=? name "jump") jump-now)
                          ((string=? name "slide") slide-now)
                          ((string=? name "speed") speed-now)
                          (else hue-now)))
        (note! "KEEP" name "rule"
               (cond
                 ((string=? name "gravity") (if (< value 32.0) "Lighter steps" "A bit heavier"))
                 ((string=? name "jump") (if (> value 11.2) "Higher jumps" "Softer jumps"))
                 ((string=? name "slide") "Longer slides")
                 ((string=? name "speed") (if (> value 5.0) "A little faster" "A gentler pace"))
                 (else "The light shifted")))
        (flush-notes! c)
        (send c (rules-msg))
        (set! rules-dirty #f)))))

(define (on-propose c msg)
  (let ((text (hash-ref msg "form" "")))
    (if (and (string? text) (string-contains? text "(garden"))
      (consider-scene! text)
      (consider-form! text)))
  (flush-notes! c)
  (send c (rules-msg))
  (set! rules-dirty #f)
  (send c (state-msg "ok")))

(define (on-audit c msg)
  (send c (hash "op" "audit" "items" audit "via" publish-via "rev" rule-rev)))

(define (dispatch c msg)
  (let ((op (hash-ref msg "op" "")))
    (cond
      ((string=? op "hello") (on-hello c msg))
      ((string=? op "restart") (on-restart c msg))
      ((string=? op "resync") (on-resync c msg))
      ((string=? op "tick") (on-tick c msg))
      ((string=? op "unstall")
       (if stall-waiting
         (begin
           (channel:send stall-ch #t)
           (set! stall-waiting #f))
         #f))
      ((string=? op "rebind") (on-rebind c msg))
      ((string=? op "propose") (on-propose c msg))
      ((string=? op "audit") (on-audit c msg))
      ((string=? op "bye") #f)
      (else (send c (hash "op" "err" "why" "unknown"))))))

(define (take-line)
  (let ((i (string-find buf "\n")))
    (if (< i 0)
      #f
      (let ((line (substring buf 0 i)))
        (set! buf (substring buf (+ i 1) (string-length buf)))
        line))))

(define (read-msg c)
  (let ((have (take-line)))
    (if have
      have
      (let ((got (tcp-recv c 8192)))
        (if (or (not (string? got)) (= (string-length got) 0))
          #f
          (begin
            (set! buf (string-append buf got))
            (read-msg c)))))))

(define (serve-client c)
  (set! buf "")
  (let loop ()
    (let ((line (read-msg c)))
      (if (not line)
        #f
        (let ((msg (try (json-parse line) (catch (e) #f))))
          (if (not (hash? msg))
            (begin (send c (hash "op" "err" "why" "json")) (loop))
            (if (string=? (hash-ref msg "op" "") "bye")
              #t
              (begin (dispatch c msg) (loop)))))))))

(define (start-llm!)
  (let ((key (try (getenv "LLM_API_KEY") (catch (e) ""))))
    (if (and (string? key) (> (string-length key) 0))
      (begin
        (require "std/llm" all:)
        (set! llm-on #t)
        (set! llm-chat-mode 0)
        ; v0.2.2 llm:chat is (sys user). A newer runtime takes a third
        ; hash (reasoning_effort, max_tokens). The extra call throws an
        ; arity error before any HTTP request; catch it and keep the
        ; two-argument call. A hash result means the extra argument was
        ; accepted, including an API error hash.
        (set! llm-reply
          (lambda (sys user)
            (cond
              ((= llm-chat-mode 2) (llm:chat sys user))
              ((= llm-chat-mode 1) (llm:chat sys user llm-extra))
              (else
               (let ((tried (try (llm:chat sys user llm-extra) (catch (e) #f))))
                 (if (hash? tried)
                   (begin (set! llm-chat-mode 1) tried)
                   (begin (set! llm-chat-mode 2) (llm:chat sys user))))))))
        (load-llm-timeout!)
        (set! stall-scene? (env-on? "LUMEN_STALL_SCENE"))
        (set! stall-ch (channel:create 1))
        (set! motif-req (channel:create 2))
        (set! motif-res (channel:create 2))
        (set! scene-req (channel:create 2))
        (set! scene-res (channel:create 2))
        (fiber:spawn (lambda () (llm-worker motif-req motif-res SYS "motif")))
        (fiber:spawn (lambda () (llm-worker scene-req scene-res SCENE-SYS "scene"))))
      #f)))

; One worker per phrase kind. A scene call stuck inside llm:chat does not
; take the obstacle worker with it. LUMEN_STALL_SCENE parks the first
; garden job until `unstall`, which is how the watchdog test imitates a
; call that ignores LLM_TIMEOUT.
(define (deliver! res job ans)
  (channel:send res
                (hash "kind" (hash-ref job "kind" "")
                      "token" (hash-ref job "token" 0)
                      "ans" (if (hash? ans)
                              ans
                              (hash "ok" #f "error" "bad" "content" "")))))

(define (llm-worker req res sys kind)
  (let loop ()
    (let ((job (channel:recv req)))
      (if (string=? kind "scene") (set! scene-working #t) (set! motif-working #t))
      (if (and stall-scene?
               (= scene-stalled 0)
               (string=? kind "scene"))
        (begin
          (set! scene-stalled 1)
          (set! stall-waiting #t)
          (channel:recv stall-ch)
          (set! stall-waiting #f))
        #f)
      (deliver! res job (llm-reply sys (if (hash? job) (hash-ref job "user" "") "")))
      (if (string=? kind "scene") (set! scene-working #f) (set! motif-working #f))
      (loop))))

(define (port-number)
  (let ((raw (try (getenv "AURA_RUNNER_PORT") (catch (e) ""))))
    (let ((n (if (and (string? raw) (> (string-length raw) 0))
               (string->number raw)
               8765)))
      (if (and (number? n) (> n 0)) n 8765))))

(define (main)
  (set-code (read-file "core/hot.aura"))
  (eval-current)
  (set! policy (make-policy))
  (publish-all!)
  (start-llm!)
  (let ((port (port-number)))
    (let ((listener (tcp-listen port "127.0.0.1")))
      (if (not (number? listener))
        (begin (display "listen-failed\n") 1)
        (let ((bound (tcp-local-port listener)))
          (try (make-directory "out") (catch (e) #f))
          (write-file "out/aura.port" (number->string bound))
          (display "PORT ")
          (display bound)
          (newline)
          (let accept-loop ()
            (let ((client (tcp-accept listener)))
              (if (number? client)
                (begin
                  (serve-client client)
                  (tcp-close client)
                  (accept-loop))
                #f))))))))

(main)
