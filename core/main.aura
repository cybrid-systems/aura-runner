(define (publish-named! name value)
  (let ((how (publish-rule! name (rule-body value) (full-src))))
    (if (string=? how "charter")
      (note! "ROLLBACK" (charter-why name) "rule" (charter-cue) "rule")
      (begin
        (set! publish-via how)
        (set! rule-rev (+ rule-rev 1))
        (set! rules-dirty #t)))
    how))

; A spare-time number rides along in rest. It stays inside the evidence
; hash. A separate decision would count as another trial and drag the mean.
(define (rest-margin rest)
  (let loop ((xs rest))
    (if (or (not (pair? xs)) (null? xs))
      #f
      (if (number? (car xs))
        (exact->inexact (car xs))
        (loop (cdr xs))))))

(define world-tree (world-blank))
; While a rewind is laying the road again, pace must not publish a new note.
(define rewind-quiet #f)

(define (world-track? kind why arm)
  (and (or (string=? kind "KEEP") (string=? kind "ROLLBACK"))
       (or (string=? arm "motif")
           (string=? arm "scene")
           (string=? arm "pals")
           (string=? arm "cards")
           (string=? arm "chaser")
           (string=? arm "rule")
           (string=? arm "wish")
           (string=? arm "guest")
           (string=? arm "llm")
           (and (string=? arm "run") (string=? why "level")))))

; A chase that outran a slower pace is stored just under the cap, so the
; snap can be run again. The live step is unchanged.
(define (chase-snap-speed run)
  (let ((sp (chase-get chase "speed" 2.1))
        (cap (* (exact->inexact run) 0.45)))
    (if (and (number? sp) (>= sp 1.6) (< sp cap) (< sp run))
      sp
      (max 1.6 (- cap 0.05)))))

; A custom id stays in the badge. A mix mood is the spec's number, so a
; night that is not one of the four names does not read back as day.
; The live mood stays a name. Many readers assume that.
(define (snap-biome)
  (cond
    ((biome-name? biome-now) biome-now)
    ((and slow-mods (string? biome-now) (edsl-id? biome-now)) biome-now)
    (else "garden")))

(define (snap-mood)
  (if (and slow-mods (hash? edsl-spec) (number? (hash-ref edsl-spec "mood" #f)))
    (edsl-2 (hash-ref edsl-spec "mood"))
    mood-now))

(define (world-snap-now)
  (hash "seed" seed
        "level" level-n
        "form" form
        "pace" pace
        "band" band
        "g" g-now
        "jump" jump-now
        "slide" slide-now
        "speed" speed-now
        "air" air-now
        "magnet" magnet-now
        "hue" hue-now
        "coyote" coyote-now
        "forgive" forgive-now
        "motif" motif-now
        "scene" scene-now
        "pals" pals-now
        "loot" loot-now
        "bend" bend-now
        "deck" deck-ids
        "chase-speed" (chase-snap-speed speed-now)
        "chase-cool" (chase-get chase "cool" 0.42)
        "chase-at" (chase-get chase "at" 0.42)
        "chase-commit" (chase-get chase "commit" 7.5)
        "sky" (list sky-r sky-g sky-b)
        "ground" (list ground-r ground-g ground-b)
        "flower" flower-now
        "density" density-now
        "light" light-now
        "fog" fog-now
        "biome" (snap-biome)
        "mood" (snap-mood)
        "spec" edsl-spec))

(define (note! kind why arm . rest)
  (let ((cue (if (and (pair? rest) (string? (car rest))) (car rest) ""))
        (mark (if (and (pair? rest) (pair? (cdr rest)) (string? (car (cdr rest))))
                (car (cdr rest)) ""))
        (ask (if (and (pair? rest) (pair? (cdr rest)) (pair? (cdr (cdr rest)))
                      (string? (car (cdr (cdr rest)))))
               (car (cdr (cdr rest))) ""))
        (margin (rest-margin rest)))
    (let* ((tracked (world-track? kind why arm))
           (added (if tracked
                    (world-add world-tree kind why arm cue (world-snap-now) (monotonic-ms))
                    #f)))
      (if tracked (set! world-tree (hash-ref added "tree" world-tree)) #f)
      (let ((row (if (not tracked)
                   (hash "op" "decision" "kind" kind "why" why "arm" arm
                         "via" publish-via "cue" cue "mark" mark "ask" ask)
                   (if (hash? (hash-ref added "snap" #f))
                     (hash "op" "decision" "kind" kind "why" why "arm" arm
                           "via" publish-via "cue" cue "mark" mark "ask" ask
                           "world" (hash-ref added "id" "")
                           "parent" (hash-ref added "parent" "")
                           "snap" (hash-ref added "snap" #f))
                     (hash "op" "decision" "kind" kind "why" why "arm" arm
                           "via" publish-via "cue" cue "mark" mark "ask" ask
                           "world" (hash-ref added "id" "")
                           "parent" (hash-ref added "parent" ""))))))
    (set! audit (cons (hash "kind" kind "why" why "arm" arm "cue" cue) audit))
    (if (> (length audit) 12)
      (set! audit (take-n audit 12))
      #f)
    (set! pending (cons row pending))
    ; evo:record! mutates while a POST is in flight and wedges that call.
    ; The row waits on the queue until the tick after the POST leaves.
    ; The decision is still sent to the client.
    (record-hold! (or (llm-posting?) (chat-open?)))
    (record-note! arm kind why margin)
    row))))

(define (flush-notes! c)
  (let loop ((xs (reverse pending)))
    (if (null? xs)
      (set! pending (list))
      (begin
        (send c (car xs))
        (loop (cdr xs))))))

(define (int-str n)
  (let ((s (number->string (floor (exact->inexact n)))))
    (if (string-suffix? s ".0")
      (substring s 0 (- (string-length s) 2))
      s)))

(define (take-n xs n)
  (if (or (null? xs) (<= n 0))
    (list)
    (cons (car xs) (take-n (cdr xs) (- n 1)))))

(define (arm-name b)
  (string-append "band-" (number->string b)))

(define (band-of arm)
  (cond
    ((string=? arm "band-1") 1)
    ((string=? arm "band-2") 2)
    ((string=? arm "band-3") 3)
    ((string=? arm "band-4") 4)
    (else 0)))

; Gravity, jump and slide ease with the band so a faster path stays
; reachable. The opening is already a run. Each notch is faster, and
; the top stays a pace a short recovery can still land. The numbers
; live in feel-for, which play-review reads too.

(define (arm-row name)
  (list (cons "arm" name) (cons "n" 0) (cons "keeps" 0) (cons "mean" 0.0)))

; #5274: a long run can refuse hash-set! while another fiber holds the
; mutation boundary. The tick path builds hashes instead of mutating
; them. Policy updates are skipped when a trial is open or the write
; is refused, so the core keeps serving.
(define trial-open #f)
(define llm-talking #f)
(define wait-motif #f)
(define wait-scene #f)
(define wait-pals #f)
; One token. The worker holds it across http-post. The tick holds it
; across evo:trial and the commit that follows. A set! in a fiber stays
; in that fiber's overlay, so a shared binding cannot carry this flag.
(define llm-slot #f)
(define slot-mine #f)

; True when a chat POST holds the token. False when this fiber holds it
; for a trial, and false when nobody does.
(define (chat-open?)
  (if (or slot-mine (not llm-slot))
    #f
    (let ((tok (channel:try-recv llm-slot)))
      (if tok
        (begin (channel:send llm-slot #t) #f)
        #t))))

(define (trial-busy? t)
  (and (pair? t) (string? (car t)) (string=? (car t) "busy")))

(define (release-slot!)
  (set! slot-mine #f)
  (if llm-slot (channel:send llm-slot #t) #f))

; Tick-local. True from the ask until that reply is taken. A worker's
; set! does not cross fibers, so this flag is the one the tick can trust.
(define (llm-posting?)
  (or motif-busy scene-busy pals-busy edsl-busy))
(define llm-kind "motif")
(define motif-next 2500.0)
(define scene-next 5000.0)
(define pals-next 5000.0)
(define guest-at 0)

(define (hash-put! h k v)
  (try (begin (hash-set! h k v) #t) (catch (e) #f)))

; The token stays taken on success. The caller releases it after the
; commit, so a worker cannot enter http-post between the trial and that
; hash update. A busy answer means a POST already holds the token.
(define (open-trial cand spec)
  (if (and llm-slot (not (channel:try-recv llm-slot)))
    (list "busy")
    (begin
      (set! slot-mine #t)
      (set! trial-open #t)
      (let ((trial (try (evo:trial cand spec) (catch (e) #f))))
        (set! trial-open #f)
        trial))))

; An empty seen means the scratch define never changed. That does not
; fail a candidate the shadow run already scored. A different token does.
(define (fork-fair seen token fair)
  (if (and (string? seen) (> (string-length seen) 0) (not (string=? seen token)))
    0.0
    (if fair 1.0 0.0)))

(define (note-fork! row compared?)
  (if (and compared? (hash? row))
    (hash-put! row "fork" #t)
    #f)
  row)

(define (make-policy)
  (let ((p (evo:policy "ucb" (quote ()))))
    (if (not (hash-put! p "arms" (list (arm-row "band-0") (arm-row "band-1"))))
      #f
      #f)
    p))

(define (row-get row key fallback)
  (let loop ((xs row))
    (if (or (not (pair? xs)) (null? xs))
      fallback
      (if (and (pair? (car xs)) (string? (car (car xs))) (string=? (car (car xs)) key))
        (cdr (car xs))
        (loop (cdr xs))))))

(define (find-arm rows name)
  (let loop ((xs rows))
    (if (null? xs)
      #f
      (if (string=? (row-get (car xs) "arm" "") name)
        (car xs)
        (loop (cdr xs))))))

(define (has-arm? rows name)
  (if (find-arm rows name) #t #f))

; Open the next band only after this one has been cleared more often
; than not. A miss does not unlock a crueller arm.
(define (open-next-arm!)
  (if (>= band 4)
    #f
    (let ((rows (hash-ref policy "arms" (list)))
          (nxt (arm-name (+ band 1))))
      ; llm-busy used to skip this for the whole wait, so a hung call
      ; never opened band 2. The watchdog clears that latch. hash-set!
      ; itself is still fatal on this pin while a fiber is inside
      ; llm:chat (#5274), so the write waits only for that call to leave
      ; the interpreter. A trial skips it too.
      (if (or (has-arm? rows nxt) trial-open (llm-posting?)
              (env-on? "LUMEN_SKIP_ARM"))
        #f
        (let ((row (find-arm rows (arm-name band))))
          (if (and row
                   (>= (row-get row "n" 0) 2)
                   (>= (row-get row "mean" 0.0) 0.5))
            (hash-put! policy "arms" (append rows (list (arm-row nxt))))
            #f))))))

; The felt band is how the last levels went, not the clock. A clean
; finish steps up. Two bumps step down. One bump holds the pace.
; Four is still the top of the feel table.
(define form 0)
(define level-n 1)
(define level-x0 0.0)
(define level-x1 128.0)
(define level-bumps 0)
; Density band for coins and poppers. 1 is the shipped spacing.
; Skill points the picture adds (combo, Nice, near-miss, overtake)
; arrive on the tick and land on the score the finish reads.
(define pressure-now 1)
(define skill-seen 0.0)
(define level-combo 0)
(define level-near 0)
(define level-overtakes 0)
(define level-streak 0)
; The multiplier climbs at a gate and when the three-coin challenge lands.
; A gate does not put it back to one. Restart does. The pickup combo on
; the page is separate and is not cleared here.
(define run-mult 1)
(define chal-coins 0)
(define chal-done #f)
(define biome-now "garden")
(define edsl-form "")
(define edsl-spec #f)
(define edsl-pool #f)
(define edsl-ready #f)
(define edsl-hint "")
(define edsl-theme-now "")
(define edsl-enter? #f)
(define wish-hold #f)
(define edsl-fallback-form "")
(define edsl-held #f)
(define edsl-busy #f)
(define edsl-working #f)
(define edsl-asked-at -1.0)
(define edsl-token 0)
(define edsl-accept -1)
(define edsl-next 18000.0)
(define edsl-req #f)
(define edsl-res #f)
(define mood-now "day")
(define biome-pin #f)
; Kept places, style by band. A clear may recombine two of them once the
; map has a pair. archive-wait skips that many clears after a keep.
; archive-offers caps how many children a run may try.
(define world-archive #f)
(define archive-on #f)
(define archive-wait 0)
(define archive-offers 0)
(define tune-pick-on #f)
(define banner-id 0)
(define banner-kind "")
(define banner-text "")
(define banner-gain 0)
; A spoken finish stays until this level ends. Sky props are names the
; view draws. sun-hide turns off the soft disc when the child sends the sun home.
(define goal-lock #f)
(define props (list))
(define sun-hide #f)
; Toys drawn beside the runner from a spoken sentence. Not a road piece.
(define shown (list))
(define rival-for 0)
; The ward is not a player field. Fairness and the 15-field list stay put.
; Hearts and a settled run sit beside it, for the same reason.
(define ward-ready #t)
(define ward-left 0.0)
(define run-hearts 3)
(define run-defeats 0)
(define run-over #f)

(define (pace-wanted)
  form)

(define (begin-level!)
  (set! level-x0 (player-x player))
  (set! level-bumps 0)
  (set! level-combo 0)
  (set! level-near 0)
  (set! level-overtakes 0)
  (set! level-coins 0)
  (set! level-swaps 0)
  ; Level 1 uses the plain span. adapt-span lives with voice. A resumed
  ; level keeps the plain span until open-road! has loaded voice, so the
  ; welcome is not waiting on that compile.
  (if goal-lock
    #f
    (set! level-x1 (+ level-x0
                     (if (and (> level-n 1) slow-mods)
                       (adapt-span speed-now (player-score player) level-n)
                       (level-span speed-now)))))
  (coin-open-level! level-x0 level-x1))

; A known-fair garden, painted at once. The rebind waits while a chat is up.
(define (raise-banner! kind text gain)
  (set! banner-id (+ banner-id 1))
  (set! banner-kind kind)
  (set! banner-text text)
  (set! banner-gain (if (and (number? gain) (> gain 0)) (floor gain) 0))
  (set! rules-dirty #t))

(define (paint-env! i say)
  (let ((row (wish-at i)))
    (if (not row)
      #f
      (let ((form (hash-ref row "form" "")))
        (if (scene-install! form)
          (begin
            (if (not (or (llm-posting?) (chat-open?)))
              (publish-phrase! "scene-form" (scene-body form))
              (set! rules-dirty #t))
            (note! "KEEP" "fair" "scene" say "sky")
            #t)
          #f)))))

(define (edsl-clear!)
  (set! edsl-form "")
  (set! edsl-spec #f)
  (set! edsl-held #f)
  (set! edsl-fallback-form ""))

; A spoken built-in venue. Drop the mix and any dream that would
; replace it on the next reply or the next gate.
(define (pin-builtin! name)
  (edsl-clear!)
  (set! biome-now name)
  (set! biome-pin #t)
  (set! edsl-enter? #f)
  (set! edsl-ready #f)
  (set! edsl-theme-now "")
  (set! edsl-hint "")
  (set! wish-hold #f)
  ; Drop a place the model was still painting. The reply must not
  ; land on the venue the child just named.
  (set! edsl-accept -1)
  (set! edsl-busy #f)
  (set! rules-dirty #t))

(define (edsl-remember! form id)
  (if (edsl-has? edsl-pool id)
    #f
    (begin
      (set! edsl-pool
            (let ((next (append edsl-pool (list form))))
              (if (> (edsl-len next) 12)
                (edsl-drop-evolved next)
                next)))
      (archive-remember! form)
      #t)))

; Install a spec that already passed the gate. Does not move the runner,
; the combo, or the camera.
(define (edsl-enter-kept! text)
  (load-slow!)
  (let ((found (edsl-check text)))
    (if (not (and (hash? found) (hash-ref found "ok" #f)))
      #f
      (begin
        (set! biome-now (hash-ref found "id"))
        (set! edsl-form (hash-ref found "form"))
        (set! edsl-spec (if (string=? (hash-ref found "recipe" "") "mix")
                          (edsl-pub found)
                          #f))
        (set! biome-pin #t)
        (set! edsl-enter? #f)
        (set! edsl-ready #f)
        (set! edsl-theme-now "")
        (set! edsl-hint "")
        (set! rules-dirty #t)
        (set! rules-thin #f)
        #t))))

; The same install, without pinning the venue. The next clear still
; steps garden, city, space, coast. A recombined world uses this.
(define (edsl-enter-look text)
  (load-slow!)
  (let ((found (edsl-check text)))
    (if (not (and (hash? found) (hash-ref found "ok" #f)))
      #f
      (begin
        (set! biome-now (hash-ref found "id"))
        (set! edsl-form (hash-ref found "form"))
        (set! edsl-spec (if (string=? (hash-ref found "recipe" "") "mix")
                          (edsl-pub found)
                          #f))
        (set! edsl-enter? #f)
        (set! edsl-ready #f)
        (set! edsl-theme-now "")
        (set! edsl-hint "")
        (set! rules-dirty #t)
        (set! rules-thin #f)
        #t))))

(define (archive-load!)
  (if archive-on
    world-archive
    (begin
      (require "lib/archive")
      (set! world-archive (archive-blank))
      (set! archive-on #t)
      world-archive)))

(define (archive-remember! form)
  (if (not (and (string? form) (> (string-length form) 0)))
    #f
    (begin
      (load-slow!)
      (archive-load!)
      (archive-keep! world-archive form band))))

(define (venue-form name)
  (let ((preset (if (string? name) (edsl-preset name) #f)))
    (if (string? preset)
      preset
      (if (and (string? edsl-form) (> (string-length edsl-form) 0))
        edsl-form
        #f))))

; speak? is the child asking 换一个. A quiet clear stays silent when
; there is nothing to offer yet, or the cap is already spent.
(define (archive-offer! speak?)
  (load-slow!)
  (archive-load!)
  (if (or biome-pin
          (>= archive-offers 4)
          (not (archive-ready? world-archive)))
    (if speak?
      (begin
        (note! "ROLLBACK" "cap" "biome" (world-stay) "world")
        #f)
      #f)
    (let ((child (archive-child world-archive)))
      (if (not (string? child))
        (if speak?
          (begin
            (note! "ROLLBACK" "shape" "biome" (world-stay) "world")
            #f)
          #f)
        (begin
          (set! archive-offers (+ archive-offers 1))
          (if (and llm-slot (not (channel:try-recv llm-slot)))
            (begin
              (note! "ROLLBACK" "busy" "biome" (world-stay) "world")
              #f)
            (begin
              (set! slot-mine #t)
              (set! trial-open #t)
              (let ((gate (try (edsl-gate child) (catch (e) #f))))
                (set! trial-open #f)
                (if (and (hash? gate) (string=? (hash-ref gate "verdict" "") "KEEP"))
                  (begin
                    (edsl-remember! child (hash-ref gate "id" "grown"))
                    (edsl-enter-look child)
                    (set! archive-wait 2)
                    (note-fork! (note! "KEEP" "fair" "biome" "这个世界长大了一点" "world") #t))
                  (note! "ROLLBACK"
                         (if (hash? gate) (hash-ref gate "why" "trial") "trial")
                         "biome" (world-stay) "world"))
                (release-slot!)
                (and (hash? gate) (string=? (hash-ref gate "verdict" "") "KEEP"))))))))))

; Remember the venue this clear stepped to. Offer a child only when
; two kept worlds are already on the map and the cooldown is over.
(define (archive-visit!)
  (load-slow!)
  (archive-load!)
  (let ((form (venue-form biome-now)))
    (if (string? form)
      (archive-keep! world-archive form band)
      #f))
  (if (> archive-wait 0)
    (set! archive-wait (- archive-wait 1))
    (if biome-pin
      #f
      (archive-offer! #f))))

; evo:trial on the tick, holding the chat token the way a garden phrase does.
(define (consider-edsl! text say enter? banner?)
  (load-slow!)
  (let* ((found (edsl-check text))
         (ok (and (hash? found) (hash-ref found "ok" #f)))
         (viol (if ok
                 (hash-ref found "violations")
                 (hash "budget" 0.0 "geometry" 0.0 "reachable" 1.0 "safe" 1.0)))
         (cand (evo:candidate (if (string? text) text "")
                              (hash "id" (string-append "b" (int-str next-id))
                                    "target" "biome-form")))
         (trial (open-trial cand
                            (hash "timeout-ms" 4000
                                  "apply" (lambda (c) #t)
                                  "evaluate"
                                  (lambda (c)
                                    (hash "status" "ok"
                                          "objectives" (hash "fair" (if ok 1.0 0.0))
                                          "constraints" viol
                                          "behavior" (hash "band" (exact->inexact band)))))))
         (cue (if (and (string? say) (> (string-length say) 0))
                say
                (if ok (edsl-banner (hash-ref found "label")) ""))))
    (if (trial-busy? trial)
      ; The chat token belongs to a POST already in flight. A place the
      ; child just asked for already passed edsl-check, so install it
      ; without taking or releasing that token. A background dream waits.
      (if (and enter? ok)
        (begin
          (edsl-remember! text (hash-ref found "id"))
          (edsl-enter-kept! text)
          (if banner?
            (raise-banner! "venue" cue 0)
            #f)
          (note! "KEEP" "fair" "biome" cue "world")
          #t)
        #f)
      (begin
        ; A place the child named already passed edsl-check. The trial
        ; records that. A failed record does not put the world back.
        (if (not ok)
          (note! "ROLLBACK"
                 (hash-ref found "why" "shape")
                 "biome" (world-stay))
          (if (or enter? (and trial (evo:trial-ok? trial) (evo:feasible? trial)))
            (begin
              (edsl-remember! text (hash-ref found "id"))
              (if enter?
                (edsl-enter-kept! text)
                (set! edsl-ready text))
              (if (and enter? banner?)
                (raise-banner! "venue" cue 0)
                #f)
              (note! "KEEP" "fair" "biome" (if enter? cue "") "world"))
            (note! "ROLLBACK" "trial" "biome" (world-stay))))
        (release-slot!)
        ok))))

(define (skill-now)
  (hash "pressure" pressure-now
        "combo" level-combo
        "overtakes" level-overtakes
        "near" level-near
        "streak" level-streak
        "locked" (if speed-lock #t #f)
        "hearts" run-hearts
        "defeats" run-defeats))

(define (level-clear-line combo near overs)
  (if (and (<= combo 0) (<= near 0) (<= overs 0))
    "Level clear"
    (string-append "Level clear · x" (int-str combo)
                   " · close " (int-str near)
                   " · pass " (int-str overs))))

; Centre of the rival nearest the runner, or #f when this level has none.
(define (nearest-rival-x)
  (let ((px (player-x player)))
    (let loop ((ps (live-movers live-st)) (best #f) (dist 1000000.0))
      (if (null? ps)
        best
        (let ((q (car ps)))
          (if (= (piece-k q) 10.0)
            (let ((mid (+ (piece-x q) (* (piece-w q) 0.5))))
              (let ((g (- mid px)))
                (let ((d (if (< g 0.0) (- 0.0 g) g)))
                  (if (< d dist)
                    (loop (cdr ps) mid d)
                    (loop (cdr ps) best dist)))))
            (loop (cdr ps) best dist)))))))

; bonus is a challenge step that landed on this same tick. The gate
; still adds its own step. The page's pickup combo is not this counter.
; Who reached the gate first is folded into the same banner.
(define (finish-level! bonus)
  (set! gate-tick #t)
  (let* ((played form)
         (bumps level-bumps)
         (combo level-combo)
         (near level-near)
         (overs level-overtakes)
         (got-coins level-coins)
         (got-swaps level-swaps)
         (gate level-x1)
         (rx (nearest-rival-x))
         (race (if (number? rx) (race-gate (player-x player) rx gate) ""))
         (cross (gate-cross level-n played bumps (player-score player) run-mult combo (skill-now)))
         (act (hash-ref cross "act" "scene"))
         (scene-i (hash-ref cross "scene" -1))
         (gain (+ (hash-ref cross "gain" 0)
                  (if (and (number? bonus) (> bonus 0)) bonus 0))))
    (set! pressure-now (hash-ref cross "pressure" pressure-now))
    (set! level-streak (hash-ref cross "streak" 0))
    (set! chase-recent (chase-remember chase-recent bumps))
    ; A clean gate spends one remembered defeat, so a rough run eases
    ; and then climbs back instead of staying soft forever.
    (if (<= bumps 0)
      (set! run-defeats (max 0 (- run-defeats 1)))
      #f)
    (set! form (hash-ref cross "form" played))
    (set! level-n (hash-ref cross "level" (+ level-n 1)))
    (set! level-bumps 0)
    (set! level-combo 0)
    (set! level-near 0)
    (set! level-overtakes 0)
    (set! goal-lock #f)
    ; A spoken world stays through the gate. An unpinned clear steps to
    ; the venue for this level (garden, city, space, coast). The scene
    ; below follows how the run went. A recombined world is offered on a
    ; later tick, from two kept places, and a dream is not started on a clock.
    (if (or biome-pin (pair? wish-hold))
      (begin
        (set! edsl-ready #f)
        (if (not (and edsl-held edsl-busy))
          (begin
            (set! edsl-enter? #f)
            (set! edsl-theme-now "")
            (set! edsl-hint ""))
          #f))
      (let ((ready (if (and (not (env-on? "LUMEN_SKIP_DREAM")) (string? edsl-ready))
                     edsl-ready
                     #f)))
        (set! edsl-ready #f)
        (if (and (string? ready) (edsl-enter-kept! ready))
          #f
          (begin
            (edsl-clear!)
            (set! biome-now (hash-ref cross "biome" (biome-for-level level-n)))))))
    (set! chal-coins 0)
    (set! chal-done #f)
    (set! run-mult (hash-ref cross "mult" run-mult))
    (advance-pace!)
    (begin-level!)
    (let* ((preview (chase-step chase played bumps (chase-sum chase-recent) speed-now race))
           (mood (hash-ref preview "mood" "hold"))
           (place (if (or (biome-name? biome-now) (string=? biome-now "garden"))
                    (evo-line level-n biome-now run-mult gain
                              (hash-ref cross "what" "rival") wish-locale)
                    (string-append
                      (if (string=? wish-locale "zh")
                        (string-append "第" (int-str level-n) "关")
                        (string-append "Level " (int-str level-n)))
                      " · "
                      (if (string=? wish-locale "zh")
                        (edsl-zh biome-now)
                        (edsl-title biome-now))
                      " · ×"
                      (int-str run-mult))))
           (line (string-append place (race-aside race mood))))
      (raise-banner! "evo" line gain)
      (let ((say (adapt-line act wish-locale)))
        (if (and (number? scene-i) (>= scene-i 0))
          (if (paint-env! scene-i say)
            #f
            (note! "KEEP" act "run" say "level"))
          (if (or (string=? act "harder") (string=? act "dense"))
            (note! "KEEP" act "run" say "level")
            #f)))
      (note! "KEEP" "level" "run"
             (gate-line (level-clear-line combo near overs) race mood)
             "level"))
    ;; The coin spread step is a fairness trial when it moves. Queue it
    ;; with the roster restyle so neither lands on the crossing frame; the
    ;; drainer runs one per tick after the gate. Same KEEP/ROLLBACK verdict,
    ;; a tick or two later. An unpinned clear also queues one archive visit.
    ;; queue-chase! only arms the sliced autopilot (no trial here), so it
    ;; stays inline.
    (let ((gate-pace speed-now)
          (jobs (list (lambda () (consider-coins! played bumps got-coins got-swaps near gate-pace))
                      (lambda () (roster-evolve! "Level clear")))))
      (set! gate-followups
            (append gate-followups
                    (if (or biome-pin (pair? wish-hold))
                      jobs
                      (append jobs (list (lambda () (archive-visit!))))))))
    (queue-chase! played bumps (chase-sum chase-recent) speed-now race)
    (set! tune-due #t)))

; Three coins in one level step the multiplier once. A gate does not
; clear a combo, and this counter starts over for the next level only.
(define (bank-coin!)
  (if chal-done
    0
    (let ((saw (chal-see chal-coins #f run-mult)))
      (set! chal-coins (hash-ref saw "coins" 0))
      (set! chal-done (equal? (hash-ref saw "done" #f) #t))
      (set! run-mult (hash-ref saw "mult" run-mult))
      (hash-ref saw "gain" 0))))

(define (watch-level! ev)
  (if (string=? ev "bump")
    (set! level-bumps (+ level-bumps 1))
    #f)
  (let ((bonus (if (string=? ev "coin") (bank-coin!) 0)))
    (if (>= (player-x player) level-x1)
      (finish-level! bonus)
      (if (> bonus 0)
        (begin
          (raise-banner! "chal" (chal-line run-mult wish-locale) bonus)
          (note! "KEEP" "coins" "run" (chal-line run-mult wish-locale) "coins"))
        #f))))

(define (flush-owed!)
  (let loop ((xs (reverse owed)))
    (if (null? xs)
      (set! owed (list))
      (begin
        (set! policy (evo:policy-report policy (arm-name (car xs)) #t))
        (loop (cdr xs))))))

(define (choose-band)
  (if rewind-quiet
    "pace"
    (if (env-on? "LUMEN_SKIP_ARM")
    (begin (set! band 0) "tutorial")
    (begin
      (set! pace (pace-wanted))
      (set! band pace)
      ; policy-report and hash-set! wedge a POST that is in flight.
      (if (or (llm-posting?) (chat-open?))
        "pace"
        (begin
          (flush-owed!)
          (open-next-arm!)
          "pace"))))))

; A finish moves the pace. The clock does not.
(define (advance-pace!)
  (if (env-on? "LUMEN_SKIP_ARM")
    #f
    (let ((want (pace-wanted)))
      (if (not (= want pace))
        (begin
          (set! pace want)
          (set! band want)
          (apply-feel! "pace"))
        #f))))

(define (remember-published!)
  (set! published-g g-now)
  (set! published-jump jump-now)
  (set! published-slide slide-now)
  (set! published-speed speed-now)
  (set! published-air air-now)
  (set! published-magnet magnet-now))

; A kept primer gravity stays put. Otherwise the light card, then pace.
(define (gravity-now f)
  (cond
    ((number? g-held) g-held)
    (g-lock CARD-LIGHT-G)
    (else (feel-g f))))

(define (apply-feel! why . rest)
  ; The pace numbers move even while a POST is in flight. The rebind
  ; waits, because publishing a rule then wedges that call.
  ; A rewind lays the saved numbers and must not note a fresh pace step.
  (if rewind-quiet
    why
    (if (string=? why "tutorial")
    why
    (let ((f (feel-for band)))
    (let ((ng (gravity-now f))
          (nj (feel-jump f))
          (nsl (feel-slide f))
          (nv (feel-speed f)))
      (if (not (= ng g-now))
        (begin
          (set! g-now ng)
          (if (= (string-length feel-cue) 0)
            (set! feel-cue (if (< ng (feel-g opening-feel)) "Lighter steps" "A bit heavier"))
            #f))
        #f)
      (if (not (= nj jump-now))
        (begin
          (set! jump-now nj)
          (if (= (string-length feel-cue) 0) (set! feel-cue "Higher jumps") #f))
        #f)
      (if (not (= nsl slide-now))
        (begin
          (set! slide-now nsl)
          (if (= (string-length feel-cue) 0) (set! feel-cue "Longer slides") #f))
        #f)
      (if (and (not speed-lock) (not (= nv speed-now)))
        (begin
          (let ((up (> nv speed-now)))
            (set! speed-now nv)
            (set! feel-cue (if up "Faster now" "A gentler pace"))))
        #f)
      (if (or (llm-posting?) (chat-open?))
        why
        (begin
          (if (not (= g-now published-g))
            (begin (publish-named! "rule-gravity" g-now) (set! published-g g-now))
            #f)
          (if (not (= jump-now published-jump))
            (begin (publish-named! "rule-jump-v" jump-now) (set! published-jump jump-now))
            #f)
          (if (not (= slide-now published-slide))
            (begin (publish-named! "rule-slide-s" slide-now) (set! published-slide slide-now))
            #f)
          (if (not (= speed-now published-speed))
            (begin (publish-named! "rule-run-speed" speed-now) (set! published-speed speed-now))
            #f)
          (if (and (pair? rest) (string? (car rest)) (> (string-length (car rest)) 0))
            (set! feel-cue (car rest))
            #f)
          (if (> (string-length feel-cue) 0)
            (begin
              (set! tuned #t)
              (note! "KEEP" why "rule" feel-cue)
              (set! feel-cue ""))
            #f)
          why)))))))

(define (shift-onto pieces x0)
  (shift-pieces pieces x0))

(define (rival-piece at)
  (let ((lane (exact->inexact (modulo (+ level-n 1) 3)))
        (look (exact->inexact (chase-shown chase level-n))))
    (piece 10.0 at 0.72 0.95 0.0 lane look
           (chase-get chase "speed" 2.1)
           lane
           0.2
           (chase-get chase "cool" 0.42)
           (chase-get chase "commit" 7.5))))

; One rival per level. Level 1 waits until the opening lesson is behind
; it. A later level uses the saved pace, still one lane.
(define (rival-for-chunk x0 x1)
  (if (= rival-for level-n)
    #f
    (let ((at (+ level-x0
                 (chase-place chase (- level-x1 level-x0) level-n form))))
      (if (and (>= at (+ x0 2.0)) (<= at (- x1 3.0)))
        (begin
          (set! rival-for level-n)
          (note! "KEEP" "rival" "run" "A rival is on the path")
          (rival-piece at))
        #f))))

(define (any-gate? ps)
  (let loop ((xs ps))
    (if (null? xs)
      #f
      (if (= (piece-k (car xs)) 4.0) #t (loop (cdr xs))))))

(define (add-chunk! origin pieces span b h . rest)
  (let* ((margin (if (and (pair? rest) (number? (car rest)))
                   (exact->inexact (car rest))
                   9.0))
         (ready? (and (pair? rest) (pair? (cdr rest)) (eq? (car (cdr rest)) #t)))
         (placed (begin
                   (coin-set-origin! next-x)
                   (coin-span! level-x1)
                   (shift-onto (if ready?
                                 pieces
                                 (string-pickups pieces b span pressure-now (loot-worth loot-now)
                                                 (coin-chunk-seed seed next-id b) coin-params))
                               next-x)))
         (id next-id)
         (x0 next-x)
         (x1 (+ next-x span))
         (toss (popper-for id x0 span pressure-now))
         (rival (rival-for-chunk x0 x1))
         (with (append placed
                       (if toss (list toss) (list))
                       (if rival (list rival) (list))))
         (installed (thing-boundary! id))
          (thing (thing-for-chunk id)))
      (set! chunks (append chunks (list (hash "id" id "x0" x0 "x1" x1
                                              "band" b "origin" origin "hue" h
                                              "margin" margin
                                              "thing" thing
                                              "pieces" with))))
      (set! live-st (live-absorb live-st with))
      (set! next-x x1)
      (set! next-id (+ id 1))
      (if (and (not slide-hinted) (any-gate? placed))
        (begin
          (set! slide-hinted #t)
          (note! "KEEP" "tutorial" "gate" "Slide under the bar"))
        #f)
      installed
      id))

; Build the next chunk without installing it. The live tick either
; builds or installs, never both, so layout does not stack on a step.
(define (make-next-chunk)
  (let ((why (choose-band)))
    (apply-feel! why)
    (if (and (pair? motif-pieces) (> motif-span 0.5) (= (modulo next-id 2) 1))
      (let ((laid (layout-form motif-now (rules-hash))))
        (if (and (hash? laid) (> (hash-ref laid "x1" 0.0) 0.5))
          (hash "origin" "motif" "pieces" (hash-ref laid "pieces")
                "x1" (hash-ref laid "x1") "margin" (hash-ref laid "margin" 9.0))
          (hash "origin" "motif" "pieces" motif-pieces "x1" motif-span "margin" 9.0)))
      (let ((ch (chunk-or-fallback (pattern-chunk seed next-id band speed-now) speed-now)))
        (if ch
          ch
          (hash "origin" "fallback"
                "pieces" (list (piece 3.0 1.2 0.7 0.45 0.0))
                "x1" 8.0 "margin" 9.0))))))

(define (install-chunk! ch)
  (add-chunk! (hash-ref ch "origin" "offline")
              (hash-ref ch "pieces")
              (hash-ref ch "x1")
              band hue-now
              (hash-ref ch "margin" 9.0)))

(define (spawn-chunk!)
  (install-chunk! (make-next-chunk)))

(define (road-due? hint)
  (let* ((px (player-x player))
         (want (road-horizon))
         (h (if (and (number? hint) (> hint 0.0)) hint 0.0))
         (from (min (+ px 80.0) (max px h))))
    (not (> next-x (+ from want)))))

(define road-job #f)

; Pattern one tick, then a dozen rows of the coin table, then the
; placement. A live tick never does the whole chunk.
(define (install-ready! ch pieces b h)
  (add-chunk! (hash-ref ch "origin" "offline")
              pieces
              (hash-ref ch "x1")
              b h
              (hash-ref ch "margin" 9.0)
              #t))

(define (road-slice!)
  (cond
    ((not road-job)
     (let ((ch (make-next-chunk)))
       (set! road-job (hash "chunk" ch "band" band "hue" hue-now "pick" #f))
       (set! tick-built #t)))
    (else
     (let* ((ch (hash-ref road-job "chunk"))
            (b (hash-ref road-job "band"))
            (step (pickup-slice (hash-ref ch "pieces")
                                b
                                (hash-ref ch "x1")
                                pressure-now
                                (loot-worth loot-now)
                                (coin-chunk-seed seed next-id b)
                                coin-params
                                (hash-ref road-job "pick" #f))))
       (set! tick-built #t)
       (if (car step)
         (begin
           (install-ready! ch (car (cdr step)) b (hash-ref road-job "hue"))
           (set! road-job #f))
         (set! road-job (hash-set road-job "pick" (car (cdr (cdr step))))))))))

(define (road-one!)
  (if staged-chunk
    (begin (install-chunk! staged-chunk) (set! staged-chunk #f) (set! tick-built #t))
    (road-slice!)))

; Seconds of road in front of the runner. A fixed 42 m is only a few
; seconds once the pace is up, and a slow tick used to let the picture
; run off the end of it.
(define (road-horizon)
  (let ((v (if (and (number? speed-now) (> speed-now 0.1)) speed-now 8.0)))
    (min 160.0 (max 72.0 (* v 6.0)))))

; hint is where the picture already is. Fill past that, not only past
; the server body, or the picture reaches the last ground and waits
; in an empty tail while a level gate is still working.
;
; budget caps how many chunks one call lays. The live tick passes 1: a
; chunk (pattern layout + coin-lay) is ~30-45ms, and a pace step that
; widens the horizon used to lay several in one frame — the spawn spike.
; One chunk a tick spreads that across frames. The road-horizon buffer is
; six seconds of road (72-160 m), far more than one chunk (~8-30 m) and
; the per-tick advance (~0.2 m), so the picture never reaches the tail
; while the fill catches up. open-road! and rewind pass no budget. The
; default cap is 12 chunks, enough for a normal horizon, and the welcome
; is already on the wire before that fill starts.
; Load voice for a resumed level, then lay the road. A failure here must
; not drop the welcome.
; The welcome only needs a gate on the wire. The rest of the horizon
; fills one chunk at a time on later ticks.
(define (chunks-have-gate?)
  (let loop ((cs chunks))
    (if (null? cs)
      #f
      (if (any-gate? (hash-ref (car cs) "pieces" (list)))
        #t
        (loop (cdr cs))))))

(define (open-hello!)
  (let loop ((n 0))
    (if (or (>= n 2) (and (> n 0) (chunks-have-gate?)))
      #t
      (begin
        (spawn-chunk!)
        (loop (+ n 1))))))

(define (open-road!)
  (if (and (> level-n 1) (not slow-mods))
    (try (load-slow!) (catch (e) #f))
    #f)
  (if (and (> level-n 1) slow-mods (not goal-lock))
    (begin
      (set! level-x1 (+ level-x0 (adapt-span speed-now (player-score player) level-n)))
      (coin-span! level-x1))
    #f)
  (ensure-ahead!))

(define (ensure-ahead! . rest)
  (let ((hint (if (and (pair? rest) (number? (car rest)) (> (car rest) 0.0))
                (exact->inexact (car rest))
                0.0))
        (budget (if (and (pair? rest) (pair? (cdr rest))
                         (number? (car (cdr rest))) (> (car (cdr rest)) 0))
                  (car (cdr rest))
                  12))
        (px (player-x player))
        (want (road-horizon)))
    (let ((from (min (+ px 80.0) (max px hint))))
      (if (= budget 1)
        ; A live frame moves a fraction of a metre, so one slice keeps
        ; the six-second buffer full. A fast-forwarded second eats a
        ; whole chunk. Stopping mid-slice leaves next-x where it was,
        ; and the runner reaches the end. That tick keeps laying until
        ; the buffer covers the horizon again.
        (if (or road-job (not (> next-x (+ from want))))
          (let ((limit (if (> (tick-force-ms) 200.0) 80 1)))
            (let loop ((n 0))
              (if (or (>= n limit)
                      (and (not road-job) (> next-x (+ from want))))
                #t
                (begin
                  (road-one!)
                  (loop (+ n 1))))))
          #t)
        (begin
          (if staged-chunk
            (begin (install-chunk! staged-chunk) (set! staged-chunk #f))
            #f)
          (let loop ((guard 0))
            (if (or (>= guard budget) (> next-x (+ from want)))
              #t
              (begin
                (spawn-chunk!)
                (loop (+ guard 1))))))))))

(define (sync-rules!)
  (publish-named! "rule-gravity" g-now)
  (publish-named! "rule-jump-v" jump-now)
  (publish-named! "rule-slide-s" slide-now)
  (publish-named! "rule-run-speed" speed-now)
  (publish-named! "rule-hue" hue-now)
  (publish-named! "rule-double-jump" air-now)
  (publish-named! "rule-magnet" magnet-now)
  (let ((how (publish-rule! "motif-form" (motif-body motif-now) (full-src))))
    (set! publish-via how)
    (set! rule-rev (+ rule-rev 1))
    (set! rules-dirty #t)))

(define (reset-run!)
  ; A kept thing stays with the world. The new road carries it from 0.
  (if (hash? thing-live) (set! thing-live (hash-set thing-live "from" 0)) #f)
  (set! thing-bumps 0)
  ; A death used to leave llm-busy set, so the next run never asked again.
  (set! llm-busy #f)
  (set! motif-busy #f)
  (set! scene-busy #f)
  (set! pals-busy #f)
  (set! edsl-busy #f)
  (set! edsl-enter? #f)
  (set! edsl-ready #f)
  (set! edsl-theme-now "")
  (set! edsl-hint "")
  (set! wish-hold #f)
  (edsl-clear!)
  (if slow-mods
    (set! edsl-pool (edsl-boot))
    (set! edsl-pool #f))
  (set! edsl-next (edsl-gap-ms))
  (set! edsl-accept -1)
  (set! motif-accept -1)
  (set! scene-accept -1)
  (set! pals-accept -1)
  (set! wish-open #f)
  (set! wish-queued #f)
  (set! wish-flight #f)
  (set! wish-wait #f)
  (set! wish-think #f)
  (set! wish-mine #f)
  (set! wish-prompt "")
  (set! wish-sent-at 0.0)
  (set! motif-asked-at -1.0)
  (set! scene-asked-at -1.0)
  (set! pals-asked-at -1.0)
  (set! slide-hinted #f)
  (set! player (make-player 1.2))
  (set! world (list))
  (set! live-st (live-blank))
  (set! staged-chunk #f)
  (set! chunks (list))
  (set! next-id 0)
  (set! next-x 0.0)
  (set! sent-id 0)
  (set! run-ms 0.0)
  (set! band 0)
  (set! clears 0)
  (set! pace 0)
  (set! form 0)
  (set! level-n 1)
  (set! level-bumps 0)
  (set! level-combo 0)
  (set! level-near 0)
  (set! level-overtakes 0)
  (set! level-coins 0)
  (set! level-swaps 0)
  (load-coins!)
  (coin-reset-course!)
  (set! coin-params (coin-blank))
  (set! level-streak 0)
  (set! pressure-now 1)
  (set! skill-seen 0.0)
  (set! run-mult 1)
  (set! chal-coins 0)
  (set! chal-done #f)
  (set! biome-now "garden")
  (set! mood-now "day")
  (set! biome-pin #f)
  (set! banner-id 0)
  (set! banner-kind "")
  (set! banner-text "")
  (set! banner-gain 0)
  (set! rival-for 0)
  (set! chase (chase-blank))
  (set! chase-recent (list))
  (set! chase-phase 0)
  (set! chase-plan #f)
  (set! ward-ready #t)
  (set! ward-left 0.0)
  (set! run-hearts 3)
  (set! run-over #f)
  (set! pick-streak 0)
  (set! pick-at -1.0)
  (set! sparked 0)
  (set! evolve-at -1.0)
  (set! owed (list))
  (set! feel-cue "")
  (set! acc 0.0)
  (set! last-ms 0)
  (set! cleared (list))
  (set! g-now (gravity-now opening-feel))
  (set! jump-now (feel-jump opening-feel))
  (set! slide-now (feel-slide opening-feel))
  (set! card-phase 0)
  (set! primer-phase 0)
  (set! hue-now 0.0)
  (set! motif-now "")
  (set! motif-pieces (list))
  (set! motif-span 0.0)
  (set! tune-now music-home)
  (set! tune-prev music-home)
  (set! tune-due #f)
  (set! gate-followups (list))
  (set! next-dream 1500.0)
  (set! motif-next 2500.0)
  (set! scene-next 5000.0)
  (set! pals-next 5000.0)
  (set! dream-phase 0)
  (set! dream-open #f)
  (set! dream-laid #f)
  (set! hold-phase 0)
  (set! hold-who "")
  (set! tune-job #f)
  (set! chase-seal #f)
  (set! pals-job #f)
  (set! pals-queue (list))
  (if (not speed-lock) (set! speed-now (feel-speed opening-feel)) #f)
  (set! goal-lock #f)
  (set! props (list))
  (set! sun-hide #f)
  (set! shown (list))
  (set! thing-quiet #f)
  (set! thing-shown-name "")
  (if tuned
    (begin (sync-rules!) (set! tuned #f))
    #f)
  (remember-published!)
  (begin-level!))

(define (parse-seed v)
  (cond
    ((and (number? v) (> v 0)) (exact->inexact v))
    ((and (string? v) (string-prefix? v "LUMEN-"))
     (let ((n (string->number (substring v 6 (string-length v)))))
       (if (and (number? n) (> n 0)) (exact->inexact n) #f)))
    (else #f)))

(define (fresh-seed)
  (+ 1 (modulo (monotonic-ms) 900000)))

(define (send c v)
  (tcp-send c (string-append (json-encode v) "\n")))

; The page hides the boot card on this message. Send it before the road
; is laid, and still send a small one if the full snapshot throws.
(define (send-welcome! c)
  (let ((msg (try (welcome-msg) (catch (e) #f))))
    (send c (if (hash? msg)
              msg
              (hash "op" "welcome" "seed" seed
                    "replay" (string-append "LUMEN-" (int-str seed)))))))

(define (hero-public)
  (if (hash? hero-now)
    hero-now
    (hash "kind" "keeper" "plan" "keeper" "r" 0.95 "g" 0.72 "b" 0.45)))

(define (runner-kind)
  (if (hash? hero-now)
    (hash-ref hero-now "kind" "keeper")
    "keeper"))

(define (rules-msg)
  (hash "op" "rules" "rev" rule-rev
        "g" g-now "jump" jump-now "speed" speed-now
        "air" air-now "magnet" magnet-now
        "slide" slide-now "coyote" coyote-now "forgive" forgive-now
        "hue" hue-now "ph" 1.05 "pw" 0.56 "sh" 0.46
        "via" publish-via
        "sky" (list sky-r sky-g sky-b)
        "ground" (list ground-r ground-g ground-b)
        "flower" flower-now "density" density-now "light" light-now
        "fog" fog-now
        "bend" bend-now "loot" loot-now
        "worth" (loot-worth loot-now)
        "motif" motif-now "scene" scene-now
        "pals" pals-rows "hero" (hero-public) "provider" llm-provider
        "model" (active-model) "providers" (ready-providers)
        "props" props "sun-hide" sun-hide "shown" shown
        "level" level-n "goal" level-x1 "level0" level-x0
        "mult" run-mult "biome" biome-now "mood" mood-now "spec" edsl-spec
        "banner-id" banner-id "banner-kind" banner-kind
        "banner" banner-text "banner-gain" banner-gain
        "tune" (tune-public)))

; A thing install changes the shown row and the live payload, not the
; sky, props, spec, pals or level. The page's applyRules keeps every
; absent field, so this is the whole update.
(define (rules-thin-msg)
  (hash "op" "rules" "rev" rule-rev
        "via" publish-via
        "props" props "sun-hide" sun-hide "shown" shown))

(define (send-rules! c)
  (let ((thin rules-thin))
    (send c (if thin (rules-thin-msg) (rules-msg)))
    (set! rules-dirty #f)
    (set! rules-thin #f)
    ; A full rules send is followed by a full state: the page keys its
    ; look off that state. A thin thing update keeps the slim state, so
    ; props/spec are not repeated on every wish.
    (set! state-full (or state-full (not thin)))))

(define (welcome-msg)
  (hash "op" "welcome" "seed" seed
        "replay" (string-append "LUMEN-" (int-str seed))
        "rev" rule-rev "via" publish-via
        "g" g-now "jump" jump-now "speed" speed-now
        "air" air-now "magnet" magnet-now
        "slide" slide-now "coyote" coyote-now "forgive" forgive-now
        "hue" hue-now "ph" 1.05 "pw" 0.56 "sh" 0.46
        "sky" (list sky-r sky-g sky-b)
        "ground" (list ground-r ground-g ground-b)
        "flower" flower-now "density" density-now "light" light-now
        "fog" fog-now
        "bend" bend-now "loot" loot-now
        "worth" (loot-worth loot-now)
        "level" level-n "goal" level-x1 "level0" level-x0
        "pace" pace "points" (floor (player-score player))
        "pressure" pressure-now
        "motif" motif-now "scene" scene-now
        "pals" pals-rows "hero" (hero-public) "provider" llm-provider
        "model" (active-model) "providers" (ready-providers)
        "world" (hash-ref world-tree "tip" "")
        "thing" (if (hash? thing-live) (hash-ref thing-live "public" #f) #f)
        "deck" deck-ids
        "props" props "sun-hide" sun-hide "shown" shown
        "mult" run-mult "biome" biome-now "mood" mood-now "spec" edsl-spec
        "banner-id" banner-id "banner-kind" banner-kind
        "banner" banner-text "banner-gain" banner-gain
        "tune" (tune-public)))

; Steady ticks omit the look (pals, spec, scene, props). Welcome and a
; tick that also sends rules carry the full picture. The page keeps the
; last look when a key is absent. The event is part of the hash when it
; is built. A later hash-set! on this value is the site
; cybrid-systems/aura #5274 exits from.
(define state-full #t)
(define (state-msg ev)
  (let ((full state-full))
    (set! state-full #f)
    (if full
      (state-full-msg ev)
      (state-slim-msg ev))))

(define (state-slim-msg ev)
  (hash "op" "state"
        "x" (player-x player)
        "y" (player-y player)
        "vy" (player-vy player)
        "alive" #t
        "score" (floor (score-now player))
        "slide" (if (> (pxs player 3) 0.0) 1 0)
        "lane" (player-lane player)
        "lx" (player-lx player)
        "band" band
        "g" g-now
        "jump" jump-now
        "air" air-now
        "magnet" magnet-now
        "speed" speed-now
        "worth" (loot-worth loot-now)
        "pace" pace
        "level" level-n
        "goal" level-x1
        "level0" level-x0
        "slide-dur" slide-now
        "rev" rule-rev
        "run" (floor run-ms)
        "hue" hue-now
        "seed" seed
        "event" ev
        "grace" (player-grace player)
        "hearts" run-hearts
        "over" (if run-over #t #f)
        "defeats" run-defeats
        "pressure" pressure-now
        "combo" level-combo
        "near" level-near
        "overtakes" level-overtakes
        "skill" (floor skill-seen)
        "chunks" (length chunks)
        "bend" bend-now
        "loot" loot-now
        "ahead" (obstacles-ahead)
        "llm-busy" (if (or motif-busy scene-busy pals-busy) #t #f)
        "motif-busy" (if motif-busy #t #f)
        "scene-busy" (if scene-busy #t #f)
        "pals-busy" (if pals-busy #t #f)
        "watchdogs" llm-watchdogs
        "stall" (if stall-waiting #t #f)
        "mult" run-mult
        "biome" biome-now
        "mood" mood-now))

(define (state-full-msg ev)
  (hash "op" "state"
        "x" (player-x player)
        "y" (player-y player)
        "vy" (player-vy player)
        "alive" #t
        "score" (floor (score-now player))
        "slide" (if (> (pxs player 3) 0.0) 1 0)
        "lane" (player-lane player)
        "lx" (player-lx player)
        "band" band
        "g" g-now
        "jump" jump-now
        "air" air-now
        "magnet" magnet-now
        "speed" speed-now
        "worth" (loot-worth loot-now)
        "pace" pace
        "level" level-n
        "goal" level-x1
        "level0" level-x0
        "slide-dur" slide-now
        "rev" rule-rev
        "run" (floor run-ms)
        "hue" hue-now
        "seed" seed
        "event" ev
        "grace" (player-grace player)
        "hearts" run-hearts
        "over" (if run-over #t #f)
        "defeats" run-defeats
        "pressure" pressure-now
        "combo" level-combo
        "near" level-near
        "overtakes" level-overtakes
        "skill" (floor skill-seen)
        "chunks" (length chunks)
        "sky" (list sky-r sky-g sky-b)
        "ground" (list ground-r ground-g ground-b)
        "flower" flower-now
        "density" density-now
        "light" light-now
        "fog" fog-now
        "bend" bend-now
        "loot" loot-now
        "motif" motif-now
        "scene" scene-now
        "ahead" (obstacles-ahead)
        "pals" pals-rows
        "hero" (hero-public)
        "provider" llm-provider
        "model" (active-model)
        "providers" (ready-providers)
        "llm-busy" (if (or motif-busy scene-busy pals-busy) #t #f)
        "motif-busy" (if motif-busy #t #f)
        "scene-busy" (if scene-busy #t #f)
        "pals-busy" (if pals-busy #t #f)
        "watchdogs" llm-watchdogs
        "stall" (if stall-waiting #t #f)
        "props" props "sun-hide" sun-hide "shown" shown
        "mult" run-mult "biome" biome-now "mood" mood-now "spec" edsl-spec
        "banner-id" banner-id "banner-kind" banner-kind
        "banner" banner-text "banner-gain" banner-gain))

(define (chunk-msg c)
  (hash "op" "chunk"
        "id" (hash-ref c "id")
        "x0" (hash-ref c "x0")
        "x1" (hash-ref c "x1")
        "band" (hash-ref c "band")
        "origin" (hash-ref c "origin")
        "hue" (hash-ref c "hue")
        "thing" (hash-ref c "thing" #f)
        "pieces" (hash-ref c "pieces")))

; all? resends every chunk still on the server. A reconnect cannot
; rebuild the road from the browser's pruned list alone.
(define (emit-chunks c all?)
  (let loop ((cs chunks))
    (if (null? cs)
      #t
      (begin
        (if (or all? (>= (hash-ref (car cs) "id") sent-id))
          (send c (chunk-msg (car cs)))
          #f)
        (loop (cdr cs)))))
  (set! sent-id next-id))

(define (send-new-chunks c)
  (emit-chunks c #f))

(define (send-all-chunks c)
  (emit-chunks c #t))

(define (obstacle-kind? k)
  (or (= k 2.0) (= k 3.0) (= k 4.0) (= k 7.0) (= k 8.0) (= k 9.0)))

; The window test goes first: most of the road is outside [x0, x0+40],
; and the two cheap x comparisons short-circuit the six-comparison
; obstacle-kind? for those pieces. piece-x is read once per piece. Same
; count as the kind-first walk (the and is the same predicate), ~35%
; faster on a 120-piece road; verified equal over 19k seed/position/motion
; combinations.
(define (obstacles-ahead)
  (live-ahead live-st (player-x player)))

(define (mark-cleared!)
  (let loop ((cs chunks))
    (if (null? cs)
      #t
      (let ((ch (car cs)))
        (if (and (player-alive? player)
                 (>= (player-x player) (hash-ref ch "x1"))
                 (not (member-id? (hash-ref ch "id") cleared)))
          (begin
            (set! cleared (cons (hash-ref ch "id") cleared))
            (set! clears (+ clears 1))
            ; The clear itself is local. Reporting it into the policy
            ; waits until no chat is inside http-post.
            (if (env-on? "LUMEN_SKIP_ARM")
              #f
              (if (or (llm-posting?) (chat-open?))
                (if (< (length owed) 32)
                  (set! owed (cons (hash-ref ch "band") owed))
                  #f)
                (set! policy (evo:policy-report policy (arm-name (hash-ref ch "band")) #t))))
            (note! "CLEAR" "cleared" (arm-name (hash-ref ch "band"))
                   (hash-ref ch "margin" 9.0)))
          #f)
        (loop (cdr cs))))))

(define (member-id? id xs)
  (let loop ((ys xs))
    (if (null? ys) #f
      (if (= (car ys) id) #t (loop (cdr ys))))))

(define (rules-now)
  (if tick-rules
    tick-rules
    (begin (set! tick-rules (rules-hash)) tick-rules)))

(define (prune-chunks-fast cs x)
  (if (or (null? cs) (>= (hash-ref (car cs) "x1") (- x 24.0)))
    cs
    (prune-chunks cs x)))

(define (one-step!)
  ; Score from before the step. pay-bump floors at zero, so adding the
  ; cost back would inflate a total under 15. Drag from that bump goes too.
  (let ((before (player-score player)))
    (let ((r (step-live player live-st (rules-now) PHYS-DT)))
      (set! player (car r))
      (set! live-st (car (cdr r)))
      (set! chunks (prune-chunks-fast chunks (player-x player)))
      (if (> (length cleared) 32)
        (set! cleared (take-n cleared 32))
        #f)
      (set! run-ms (+ run-ms (* PHYS-DT 1000.0)))
      (let* ((ev0 (car (cdr (cdr r))))
             (ward (ward-step ward-ready ward-left ev0 PHYS-DT))
             (held (car (cdr (cdr ward)))))
        (set! ward-ready (car ward))
        (set! ward-left (car (cdr ward)))
        (if held
          (set! player (pset (pset player 6 before) 12 0.0))
          #f)
        (mark-cleared!)
        (let ((ev (if held "ok" ev0)))
          (watch-level! ev)
          (note-play! ev held)
          ev)))))

; Drop coins that were picked up and pieces that have fallen behind.
; Nothing to drop means the same list, so the road index stays warm.
(define (prune-drop? q cut)
  (or (= (piece-k q) 0.0)
      (< (+ (piece-x q) (piece-w q)) cut)))

(define (prune-needed? ps cut)
  (let loop ((ys ps))
    (if (null? ys)
      #f
      (if (prune-drop? (car ys) cut) #t (loop (cdr ys))))))

(define (prune-world ps x)
  (let ((cut (- x 8.0)))
    (if (not (prune-needed? ps cut))
      ps
      (let loop ((ys ps) (acc (list)))
        (if (null? ys)
          (reverse acc)
          (let ((q (car ys)))
            (if (prune-drop? q cut)
              (loop (cdr ys) acc)
              (loop (cdr ys) (cons q acc)))))))))

(define (keep-event cur next)
  (cond
    ((or (string=? next "bump") (string=? next "oops")) next)
    ((or (string=? cur "bump") (string=? cur "oops")) cur)
    ((string=? next "ok") cur)
    (else next)))

(define (begin-over!)
  (if run-over
    #f
    (begin
      (set! run-over #t)
      (set! run-defeats (min 4 (+ run-defeats 1)))
      (note! "KEEP" "over" "run" "Run over"))))

(define (note-hearts! msg)
  (let ((h (hash-ref msg "hearts" #f)))
    (if (number? h)
      (begin
        (set! run-hearts (max 0 (min 3 (floor (+ h 0.001)))))
        (if (<= run-hearts 0) (begin-over!) #f))
      #f)))

(define (pump! dt-ms)
  ; A settled run stays where it is: no score, no camera, no new gate.
  (if run-over
    "over"
  ; A test can advance a whole second per message. A live tick stays at
  ; a tenth of a second so one slow frame cannot skip the road.
  (let ((cap (if (> (tick-force-ms) 0.0) 3.0 0.1))
        (limit (if (> (tick-force-ms) 0.0) 180 6)))
    (set! acc (+ acc (min cap (/ (exact->inexact dt-ms) 1000.0))))
    (let loop ((n 0) (ev "ok"))
      (if (or (< acc PHYS-DT) (>= n limit))
        ev
        (begin
          (set! acc (- acc PHYS-DT))
          (loop (+ n 1) (keep-event ev (one-step!)))))))))

(define (tick-force-ms)
  (if (>= tick-force 0.0)
    tick-force
    (let ((raw (try (getenv "LUMEN_TICK_MS") (catch (e) ""))))
      (let ((n (if (and (string? raw) (> (string-length raw) 0)) (string->number raw) 0)))
        (set! tick-force (if (and (number? n) (> n 0)) (min 3000.0 (exact->inexact n)) 0.0))
        tick-force))))

(define (elapsed-ms)
  (let ((forced (tick-force-ms)))
    (if (> forced 0.0)
      forced
      (let ((now (monotonic-ms)))
        (let ((d (if (= last-ms 0) 16 (- now last-ms))))
          (set! last-ms now)
          (if (> d 80) 80 (if (< d 0) 0 d)))))))

; The page says how much of its own clock this tick covers. A burst of
; queued ticks used to see a near-zero wall gap and simulate nothing,
; while the picture kept running, so the road ahead went empty.
; LUMEN_TICK_MS still wins, so a fast-forwarded check stays on that clock.
(define (tick-slice msg)
  (let ((forced (tick-force-ms)))
    (if (> forced 0.0)
      forced
      (let ((n (if (hash? msg) (hash-ref msg "dt" #f) #f)))
        (if (and (number? n) (> n 5.0))
          (min 200.0 (exact->inexact n))
          (elapsed-ms))))))

; The kept string is compared against the live binding. rebind is tried
; first; if persist-reject aborts it, set-code installs the same source.
; Pieces and garden colours change only after that binding matches.
(define (live-motif)
  (let ((got (try (motif-form) (catch (e) ""))))
    (if (string? got) got "")))

(define (live-scene)
  (let ((got (try (scene-form) (catch (e) ""))))
    (if (string? got) got "")))

(define (live-pals)
  (let ((got (try (pals-form) (catch (e) ""))))
    (if (string? got) got "")))

(define (body-for target text)
  (cond
    ((string=? target "scene-form") (scene-body text))
    ((string=? target "pals-form") (pals-body text))
    (else (motif-body text))))

(define (live-for name)
  (cond
    ((string=? name "scene-form") (live-scene))
    ((string=? name "pals-form") (live-pals))
    (else (live-motif))))

; The search only needs a yes. Publishing inside every sample rebinds the
; live rules once per budget step. The one real publish is binding-landed!.
(define (phrase-apply target)
  (lambda (s c) #t))

(define (phrase-search target)
  (evo:search
    (hash "algo" "lumen" "seed" (floor seed) "budget" 8
          "target" target
          "apply" (phrase-apply target))))

(define (binding-landed? name body expected)
  (let ((live (live-for name)))
    (if (string=? live expected)
      #t
      (and (not (string=? (publish-rule! name body (full-src)) "fail"))
           (string=? (live-for name) expected)))))

(define (try-tell-commit! search cand ev)
  (try (begin (evo:tell! search (list cand) (list ev))
              (evo:commit! search cand))
       (catch (e) #f)))

(define (margin-ok? laid)
  (and (hash? laid) (>= (hash-ref laid "margin" 0.0) SPARE-S)))

(define (layout-fair? laid)
  (and (hash? laid)
       (<= (hash-ref laid "geometry" 1.0) 0.0)
       (<= (hash-ref laid "budget" 1.0) 0.0)
       (margin-ok? laid)
       (> (hash-ref laid "x1" 0.0) 0.0)))

; One note for the next motif or friend ask. Advice only. The tick
; never autopilots to write it, and the felt band stays the pace.
(define hint-now "")
(define pals-hint "")

(define (hint-ok? s)
  (and (string? s)
       (> (string-length s) 0)
       (not (string-contains? s "("))
       (not (string-contains? s "Example:"))
       (not (banned? s))))

(define (remember-hint! text)
  (load-slow!)
  (if (and (string? text) (> (string-length text) 0))
    (let ((r (review-text text (rules-hash))))
      (set! hint-now (if (and (hash? r) (hint-ok? (hash-ref r "hint" "")))
                       (hash-ref r "hint" "")
                       "")))
    (set! hint-now "")))

(define (mark-pals! kept? changed?)
  (set! pals-hint
    (cond
      ((not kept?)
       "The last friend did not stay. Try a new gentle kind and a new runner look.")
      ((not changed?)
       "Dress the runner as a different gentle friend this time.")
      (else ""))))

(define (join-hint base hint)
  (if (hint-ok? hint)
    (string-append base " " hint)
    base))

; Geometry and the spare-time walk. A full autopilot is a few seconds
; of wall time, and doing it inside the reply tick is the hitch. The
; slice below spends twelve steps a tick, not the whole stretch. A
; margin under a quarter-second is refused here, because that walk is cheap.
(define (reject-form! form)
  ; open-trial while another fiber is inside http-post wedges that call
  ; on this pin, so a hung garden never reaches its timeout.
  (if (chat-open?)
    (let ((found (layout-form form (rules-hash))))
      (remember-hint! form)
      (note! "ROLLBACK"
             (cond
               ((and (hash? found) (> (hash-ref found "geometry" 0.0) 0.0)) "geometry")
               ((and (hash? found) (> (hash-ref found "budget" 0.0) 0.0)) "budget")
               ((and (hash? found) (not (margin-ok? found))) "reachable")
               (else "shape"))
             "motif" "That shape drifted away"
             (if (hash? found) (hash-ref found "margin" 0.0) 0.0)))
    (reject-trial! form)))

(define (reject-trial! form)
  (let ((found #f))
    (let* ((cand (evo:candidate form (hash "id" (string-append "m" (int-str next-id))
                                          "target" "motif-form")))
           (trial (open-trial cand
                             (hash "timeout-ms" 1500
                                   "apply" (lambda (c) #t)
                                   "evaluate"
                                   (lambda (c)
                                     (set! found (layout-form form (rules-hash)))
                                     (hash "status" "ok"
                                           "objectives" (hash "fair" 0.0)
                                           "constraints"
                                           (hash "budget" (if (hash? found) (hash-ref found "budget" 1.0) 1.0)
                                                 "geometry" (if (hash? found) (hash-ref found "geometry" 1.0) 1.0)
                                                 "reachable" 1.0
                                                 "safe" 0.0)
                                           "behavior" (hash "band" (exact->inexact band))))))))
      (if (trial-busy? trial)
        #f
        (begin
          (remember-hint! form)
          (note! "ROLLBACK"
                 (cond
                   ((and (hash? found) (> (hash-ref found "geometry" 0.0) 0.0)) "geometry")
                   ((and (hash? found) (> (hash-ref found "budget" 0.0) 0.0)) "budget")
                   ((and (hash? found) (not (margin-ok? found))) "reachable")
                   ((not trial) "trial")
                   (else "shape"))
                 "motif" "That shape drifted away"
                 (if (hash? found) (hash-ref found "margin" 0.0) 0.0))
          (release-slot!))))))

; The slice can take a few dozen ticks. A browser that only pumps on
; demand would otherwise keep the model's sentence off the page until
; the seal, which is later than the garden line. This row is not recorded:
; a second decision would drag the mean.
(define (show-say! cue)
  (if (and (string? cue) (> (string-length cue) 0))
    (set! pending (cons
                    (hash "op" "decision" "kind" "SAY" "why" "heard" "arm" "motif"
                          "via" publish-via "cue" cue "mark" "shape"
                          "ask" "What should come down the path?")
                    pending))
    #f))

; A dream opening waits while a proposed phrase is still being proved.
; A propose replaces a dream that has not sealed yet.
(define (queue-hold! form laid say who)
  (if (and (> hold-phase 0) (string=? hold-who "propose") (string=? who "dream"))
    #f
    (begin
      (set! hold-who who)
      (set! hold-rules (rules-hash))
      (set! hold-geom (hash-ref laid "geometry" 0.0))
      (set! hold-budget (hash-ref laid "budget" 0.0))
      (set! hold-margin (hash-ref laid "margin" 0.0))
      (set! hold-phase 1)
      (set! hold-form form)
      (set! hold-pieces (hash-ref laid "pieces"))
      (set! hold-span (hash-ref laid "x1"))
      (set! hold-sim hold-pieces)
      (set! hold-body (make-player 0.4))
      (set! hold-i 0)
      (set! hold-loot (if (string? (hash-ref laid "loot" "")) (hash-ref laid "loot" "") ""))
      (set! hold-bend (hash-ref laid "bend" -1.0))
      (set! hold-say (if (string? say) say ""))
      (show-say! hold-say)
      #t)))

(define (consider-form! text say . rest)
  (let ((who (if (and (pair? rest) (string? (car rest))) (car rest) "propose"))
        (form (one-line (if (string? text) text ""))))
    (let ((laid (layout-form form (rules-hash))))
      (if (layout-fair? laid)
        (queue-hold! form laid say who)
        (begin (reject-form! form) #f)))))

(define (lref xs i)
  (if (<= i 0) (car xs) (lref (cdr xs) (- i 1))))

; The slice already ran the autopilot. The trial records that verdict
; and rebinds the kept phrase; it does not simulate the chunk again.
(define (seal-sliced! cleared?)
  (let ((form dream-form)
        (pieces dream-pieces)
        (span dream-span))
    (let ((found (layout-form form (rules-hash))))
      (let* ((cand (evo:candidate form (hash "id" (string-append "d" (int-str next-id))
                                            "target" "motif-form")))
             (trial (open-trial cand
                               (hash "timeout-ms" 1500
                                     "apply" (lambda (c) #t)
                                     "evaluate"
                                     (lambda (c)
                                       (hash "status" "ok"
                                             "objectives"
                                             (hash "fair" (if (and cleared? found
                                                                   (<= (hash-ref found "geometry" 1.0) 0.0)
                                                                   (<= (hash-ref found "budget" 1.0) 0.0)
                                                                   (margin-ok? found))
                                                            1.0 0.0))
                                             "constraints"
                                             (hash "budget" (if found (hash-ref found "budget" 1.0) 1.0)
                                                   "geometry" (if found (hash-ref found "geometry" 1.0) 1.0)
                                                   "reachable" (if (and cleared? (margin-ok? found)) 0.0 1.0)
                                                   "safe" 0.0)
                                             "behavior" (hash "band" (exact->inexact band))))))))
        (if (trial-busy? trial)
          #f
          (begin
        (remember-hint! form)
        (if (or (not found) (not cleared?)
                (> (hash-ref found "geometry" 1.0) 0.0)
                (> (hash-ref found "budget" 1.0) 0.0)
                (not (margin-ok? found))
                (not trial) (not (evo:trial-ok? trial)) (not (evo:feasible? trial)))
          (note! "ROLLBACK" "reachable" "motif" "That shape drifted away"
                 (if (hash? found) (hash-ref found "margin" 0.0) 0.0))
          (let ((prev-form motif-now)
                (prev-hue hue-now))
            (set! motif-now form)
            (set! hue-now (exact->inexact (modulo (+ (floor prev-hue) 1) 6)))
            (let ((ev (hash "status" "ok"
                            "objectives" (hash "fair" 1.0)
                            "constraints" (hash "budget" 0.0 "geometry" 0.0 "reachable" 0.0 "safe" 0.0)
                            "behavior" (hash "band" (exact->inexact band))))
                  (search (phrase-search "motif-form")))
              (try-tell-commit! search cand ev)
              (if (binding-landed? "motif-form" (motif-body form) form)
                (begin
                  (set! motif-pieces pieces)
                  (set! motif-span span)
                  (set! rules-dirty #t)
                  (set! rules-thin #f)
                  (set! rule-rev (+ rule-rev 1))
                  (note! "KEEP" "fair" "motif" "A new shape bloomed" "shape"
                         (hash-ref found "margin" 9.0)))
                (begin
                  (set! motif-now prev-form)
                  (set! hue-now prev-hue)
                  (note! "ROLLBACK" "commit" "motif" "That shape drifted away"))))))
            ; release-slot! is #f when no model is configured, because
            ; llm-slot was never created. step-dream! only ends the dream
            ; when this returns true, so the seal has to say so itself,
            ; the same way seal-hold! and seal-chase! do.
            (release-slot!)
            #t))))))

; consider, then the pattern string, then its layout, then the hint.
; Each is its own tick. The pieces that land are the same ones one
; layout-form call would have produced.
(define dream-open #f)
(define dream-laid #f)
(define (dream-open-step!)
  (cond
    ((string=? dream-open "consider")
     (if (consider-form! "(seq (ground 4.0) (gap 5.5) (ground 4.0))" "" "dream")
       (begin
         (load-slow!)
         (set! dream-phase 1)
         (set! dream-open "form"))
       ; A rejected opening must not retry on every tick: reject-form!
       ; already recorded the ROLLBACK, and a per-tick retry turned one
       ; bad layout into 340 decisions in 400 ticks (#57). Back off like
       ; the one-shot opener did.
       (begin
         (set! dream-open #f)
         (set! dream-phase 0)
         (set! next-dream (+ run-ms 8000.0))
         #f)))
    ((string=? dream-open "form")
     (set! dream-form (pattern-form seed (+ next-id 1) band))
     (set! dream-open "layout"))
    ((string=? dream-open "layout")
     (set! dream-laid (layout-form dream-form (rules-hash)))
     (set! dream-open "hint"))
    (else
     (let ((laid dream-laid))
       (set! dream-open #f)
       (set! dream-laid #f)
       (remember-hint! dream-form)
       (if (or (not laid)
               (> (hash-ref laid "geometry" 1.0) 0.0)
               (not (margin-ok? laid)))
         (begin
           (set! dream-phase 0)
           (set! next-dream (+ run-ms 8000.0))
           (note! "ROLLBACK"
                  (if (and laid (> (hash-ref laid "geometry" 1.0) 0.0)) "geometry" "reachable")
                  "motif" "That shape drifted away"
                  (if laid (hash-ref laid "margin" 0.0) 0.0)))
         (begin
           (set! dream-pieces (hash-ref laid "pieces"))
           (set! dream-span (hash-ref laid "x1"))
           (set! dream-sim dream-pieces)
           (set! dream-body (make-player 0.4))
           (set! dream-i 0)))))))

(define (step-dream!)
  ; One proving step a tick. The live pump already uses most of the 50 ms
  ; budget, so a three-step walk does not fit beside it. The phrase still
  ; has to clear the autopilot before it is kept; the seal just lands later.
  (let ((r (autopilot-slice dream-pieces (rules-hash) dream-body dream-sim dream-i 1)))
    (set! dream-i (lref r 1))
    (set! dream-body (lref r 2))
    (set! dream-sim (lref r 3))
    (if (and (lref r 0) (not gate-tick) (not (llm-posting?)) (not (chat-open?)) (seal-sliced! (if (lref r 4) #t #f)))
      (begin
        (set! dream-phase 0)
        (set! next-dream (+ run-ms 22000.0)))
      #f)))

; The held phrase already passed layout. This records the sliced
; autopilot and rebinds once. Hue is part of that one publish.
(define (seal-hold! cleared?)
  (let ((form hold-form)
        (pieces hold-pieces)
        (span hold-span)
        (loot hold-loot)
        (bend hold-bend)
        (say hold-say)
        (geom hold-geom)
        (budget hold-budget)
        (margin hold-margin))
    (let* ((fair (and cleared?
                      (<= geom 0.0)
                      (<= budget 0.0)
                      (>= margin SPARE-S)))
           (cand (evo:candidate form (hash "id" (string-append "h" (int-str next-id))
                                             "target" "motif-form")))
           (trial (open-trial cand
                             (hash "timeout-ms" 1500
                                   "apply" (lambda (c) #t)
                                   "evaluate"
                                   (lambda (c)
                                     (hash "status" "ok"
                                           "objectives" (hash "fair" (if fair 1.0 0.0))
                                           "constraints"
                                           (hash "budget" budget
                                                 "geometry" geom
                                                 "reachable" (if fair 0.0 1.0)
                                                 "safe" 0.0)
                                           "behavior" (hash "band" (exact->inexact band))))))))
      (if (trial-busy? trial)
        #f
        (begin
          (remember-hint! form)
          (if (or (not fair)
                  (not trial) (not (evo:trial-ok? trial)) (not (evo:feasible? trial)))
            (note! "ROLLBACK" "reachable" "motif" "That shape drifted away" margin)
            (let ((prev-form motif-now)
                  (prev-hue hue-now)
                  (prev-loot loot-now)
                  (prev-bend bend-now))
              (set! motif-now form)
              (if (and (string? loot) (> (string-length loot) 0)) (set! loot-now loot) #f)
              (if (and (number? bend) (>= bend 0.12)) (set! bend-now bend) #f)
              (set! hue-now (exact->inexact (modulo (+ (floor prev-hue) 1) 6)))
              (let ((ev (hash "status" "ok"
                              "objectives" (hash "fair" 1.0)
                              "constraints" (hash "budget" 0.0 "geometry" 0.0 "reachable" 0.0 "safe" 0.0)
                              "behavior" (hash "band" (exact->inexact band))))
                    (search (phrase-search "motif-form"))
                    (mark (let ((fly (flyer-mark pieces))
                                (look (look-mark pieces)))
                            (cond
                              ((not (string=? loot-now prev-loot)) loot-now)
                              ((> (abs (- bend-now prev-bend)) 0.02) "bend")
                              ((> (string-length fly) 0) fly)
                              ((> (string-length look) 0) look)
                              (else "shape"))))
                    (line (if (> (string-length say) 0) say "A new shape bloomed")))
                (try-tell-commit! search cand ev)
                (if (binding-landed? "motif-form" (motif-body form) form)
                  (begin
                    (set! motif-pieces pieces)
                    (set! motif-span span)
                    (set! rules-dirty #t)
                    (set! rules-thin #f)
                    (set! rule-rev (+ rule-rev 1))
                    (note! "KEEP" "fair" "motif" line mark "What should come down the path?"
                           margin))
                  (begin
                    (set! motif-now prev-form)
                    (set! hue-now prev-hue)
                    (set! loot-now prev-loot)
                    (set! bend-now prev-bend)
                    (note! "ROLLBACK" "commit" "motif" "That shape drifted away"))))))
          (release-slot!)
          #t)))))

; Three proving steps a tick. The gated phrase is about 190 steps, and
; the rebind check only waits 90 ticks, so a single step misses the
; keep on a slow machine. The alive bit matches one walk of the same
; length. The trial is the next tick, not this one.
(define (step-hold!)
  (let ((rules (if (hash? hold-rules) hold-rules (rules-hash))))
    (if (not (= hold-phase 1))
      #f
      (let ((r (autopilot-slice hold-pieces rules hold-body hold-sim hold-i 3)))
        (set! hold-i (lref r 1))
        (set! hold-body (lref r 2))
        (set! hold-sim (lref r 3))
        (if (lref r 0)
          (begin
            (set! hold-cleared (if (lref r 4) #t #f))
            (set! hold-phase 2))
          #f)))))

(define (maybe-hold!)
  (cond
    ((= hold-phase 2)
     ; chat-open? is the http-post still inside this interpreter.
     ; A busy trial stays in phase 2 and retries next tick.
     (if (or gate-tick (chat-open?))
       #f
       (if (seal-hold! hold-cleared)
         (begin (set! hold-phase 0) (set! hold-who ""))
         #f)))
    ((= hold-phase 1) (step-hold!))
    (else #f)))

; An in-progress slice keeps going after a fall so the verdict still lands.
; A new dream starts only while the run is alive, a couple of seconds in.
; A phrase the model just sent goes first, so the two autopilots do not
; share a tick.
(define (id-list v)
  (cond
    ((string? v) (list v))
    ((null? v) (list))
    ((pair? v) v)
    (else (list))))

(define (cards-rollback! why)
  (note! "ROLLBACK" why "cards" "这样合在一起过不去" "cards"))

; The candidate rules are not live yet. A deck that fails the layout,
; or that names a gravity or jump outside the card bounds, leaves the
; bindings alone.
(define (begin-cards! msg)
  (if (> primer-phase 0)
    #f
    (let ((ids (id-list (hash-ref msg "ids" (list)))))
    (let ((spec (cards-spec ids (feel-g (feel-for band)) jump-now)))
      (if (not (hash-ref spec "ok" #f))
        (cards-rollback! (hash-ref spec "why" "deck"))
        (if (deck-same? (hash-ref spec "ids" (list)) deck-ids)
          #t
          (let ((form (if (and (string? motif-now) (> (string-length motif-now) 0))
                        motif-now
                        (pattern-form seed next-id band))))
            (let ((rules (rules-of (hash-ref spec "g") jump-now speed-now slide-now
                                   coyote-now forgive-now (loot-worth loot-now)
                                   (hash-ref spec "air") (hash-ref spec "magnet"))))
              (let ((laid (layout-form form rules)))
                (if (not (layout-fair? laid))
                  (cards-rollback!
                    (if (and (hash? laid) (> (hash-ref laid "geometry" 0.0) 0.0))
                      "geometry"
                      "reachable"))
                  (begin
                    (set! card-spec spec)
                    (set! card-rules rules)
                    (set! card-geom (hash-ref laid "geometry" 0.0))
                    (set! card-budget (hash-ref laid "budget" 0.0))
                    (set! card-margin (hash-ref laid "margin" 0.0))
                    (set! card-pieces (hash-ref laid "pieces"))
                    (set! card-sim card-pieces)
                    (set! card-body (make-player 0.4))
                    (set! card-i 0)
                    (set! card-phase 1)
                    #t)))))))))))

(define (publish-ok? how)
  (or (string=? how "rebind") (string=? how "set-code")))

(define (publish-trio! g air mag)
  (let ((a (publish-named! "rule-double-jump" air))
        (m (publish-named! "rule-magnet" mag))
        (ghow (publish-named! "rule-gravity" g)))
    (and (publish-ok? a) (publish-ok? m) (publish-ok? ghow))))

(define (cards-saved)
  (hash "g" g-now "air" air-now "mag" magnet-now
        "lock" g-lock "held" g-held "ids" deck-ids))

(define (cards-put! saved)
  (set! g-now (hash-ref saved "g" g-now))
  (set! air-now (hash-ref saved "air" air-now))
  (set! magnet-now (hash-ref saved "mag" magnet-now))
  (set! g-lock (equal? (hash-ref saved "lock" #f) #t))
  (set! g-held (equal? (hash-ref saved "held" #f) #t))
  (set! deck-ids (let ((ids (hash-ref saved "ids" (list))))
                   (if (pair? ids) ids (list)))))

(define (cards-near? a b)
  (and (number? a) (number? b) (< (world-abs (- a b)) 0.02)))

(define (cards-rules-back? saved)
  (and (cards-near? (try (rule-gravity) (catch (e) #f)) (hash-ref saved "g" #f))
       (cards-near? (try (rule-double-jump) (catch (e) #f)) (hash-ref saved "air" #f))
       (cards-near? (try (rule-magnet) (catch (e) #f)) (hash-ref saved "mag" #f))))

(define (seal-cards! cleared?)
  (let* ((spec card-spec)
         (geom card-geom)
         (budget card-budget)
         (margin card-margin)
         (fair (and cleared?
                    (<= geom 0.0)
                    (<= budget 0.0)
                    (>= margin SPARE-S))))
    (let* ((ids (if (hash? spec) (hash-ref spec "ids" (list)) (list)))
           (label (if (null? ids) "plain" (join-cards ids)))
           (cand (evo:candidate label (hash "id" (string-append "c" (int-str next-id))
                                             "target" "rule-gravity")))
           (trial (open-trial cand
                              (hash "timeout-ms" 1500
                                    "apply" (lambda (c) #t)
                                    "evaluate"
                                    (lambda (c)
                                      (hash "status" "ok"
                                            "objectives" (hash "fair" (if fair 1.0 0.0))
                                            "constraints"
                                            (hash "budget" budget
                                                  "geometry" geom
                                                  "reachable" (if fair 0.0 1.0)
                                                  "safe" 0.0)
                                            "behavior" (hash "band" (exact->inexact band))))))))
      (if (trial-busy? trial)
        #f
        (begin
          (if (or (not fair)
                  (not trial) (not (evo:trial-ok? trial)) (not (evo:feasible? trial)))
            (note! "ROLLBACK" "reachable" "cards" "这样合在一起过不去" "cards")
            (let ((saved (cards-saved))
                  (new-g (hash-ref spec "g"))
                  (new-air (hash-ref spec "air"))
                  (new-mag (hash-ref spec "magnet"))
                  (snap (fork-snap "cards")))
              (set! g-now new-g)
              (set! air-now new-air)
              (set! magnet-now new-mag)
              (set! g-lock (has-id? ids "light"))
              (set! g-held #f)
              (set! deck-ids ids)
              (set! tuned #t)
              (if (publish-trio! new-g new-air new-mag)
                (begin
                  (set! published-g g-now)
                  (set! published-air air-now)
                  (set! published-magnet magnet-now)
                  (note! "KEEP" "fair" "cards" "这几张可以一起用" "cards"))
                (begin
                  ; The snapshot puts the rule defines back. Deck fields
                  ; are not part of that AST, so they come from the hash.
                  ; Republish only when the restore did not actually return.
                  (if (not (and snap (fork-restore snap) (cards-rules-back? saved)))
                    (publish-trio! (hash-ref saved "g") (hash-ref saved "air") (hash-ref saved "mag"))
                    #f)
                  (cards-put! saved)
                  (note! "ROLLBACK" "commit" "cards" "这样合在一起过不去" "cards")))))
          (release-slot!)
          #t)))))

(define (step-cards!)
  (let ((rules (if (hash? card-rules) card-rules (rules-hash))))
    (let ((r (autopilot-slice card-pieces rules card-body card-sim card-i 12)))
      (set! card-i (lref r 1))
      (set! card-body (lref r 2))
      (set! card-sim (lref r 3))
      (if (and (lref r 0) (not gate-tick) (not (chat-open?))
               (seal-cards! (if (lref r 4) #t #f)))
        (set! card-phase 0)
        #f))))

; One slice a tick. A phrase already in its slice goes first, so the
; two walks do not share the tick.
(define (maybe-cards!)
  (if (or (= card-phase 0) (> hold-phase 0) (> primer-phase 0))
    #f
    (step-cards!)))

; One number from the card's advanced line. Twelve steps, then one trial.
; The live gravity does not move until that trial keeps it.
(define primer-phase 0)
(define primer-g 32.0)
(define primer-pieces (list))
(define primer-sim (list))
(define primer-body #f)
(define primer-i 0)
(define primer-rules #f)
(define primer-geom 0.0)
(define primer-budget 0.0)
(define primer-margin 0.0)

(define (primer-note! kind why)
  (note! kind why "rule"
         (if (string=? kind "KEEP") "这样可以跑" "这样跑不起来")
         "rule"))

(define (primer-live name)
  (cond
    ((string=? name "rule-double-jump") air-now)
    ((string=? name "rule-magnet") magnet-now)
    (else g-now)))

(define (primer-same? name value)
  (and (number? value) (< (world-abs (- value (primer-live name))) 0.011)))

(define (primer-busy?)
  (or (> hold-phase 0) (> card-phase 0) (> chase-phase 0) (> dream-phase 0)))

(define (begin-primer! got)
  (let ((value (hash-ref got "value" 0)))
    (let ((rules (rules-of value jump-now speed-now slide-now coyote-now forgive-now
                           (loot-worth loot-now) air-now magnet-now))
          (form (if (and (string? motif-now) (> (string-length motif-now) 0))
                  motif-now
                  (pattern-form seed next-id band))))
      (let ((laid (layout-form form rules)))
        (if (not (layout-fair? laid))
          (primer-note! "ROLLBACK"
            (if (and (hash? laid) (> (hash-ref laid "geometry" 0.0) 0.0))
              "geometry"
              "reachable"))
          (begin
            (set! primer-g value)
            (set! primer-rules rules)
            (set! primer-geom (hash-ref laid "geometry" 0.0))
            (set! primer-budget (hash-ref laid "budget" 0.0))
            (set! primer-margin (hash-ref laid "margin" 0.0))
            (set! primer-pieces (hash-ref laid "pieces"))
            (set! primer-sim primer-pieces)
            (set! primer-body (make-player 0.4))
            (set! primer-i 0)
            (set! primer-phase 1)
            #t))))))

(define (seal-primer! cleared?)
  (let ((fair (and cleared?
                   (<= primer-geom 0.0)
                   (<= primer-budget 0.0)
                   (>= primer-margin SPARE-S))))
    (let* ((cand (evo:candidate "gravity"
                                (hash "id" (string-append "p" (int-str next-id))
                                      "target" "rule-gravity")))
           (trial (open-trial cand
                              (hash "timeout-ms" 1500
                                    "apply" (lambda (c) #t)
                                    "evaluate"
                                    (lambda (c)
                                      (hash "status" "ok"
                                            "objectives" (hash "fair" (if fair 1.0 0.0))
                                            "constraints"
                                            (hash "budget" primer-budget
                                                  "geometry" primer-geom
                                                  "reachable" (if fair 0.0 1.0)
                                                  "safe" 0.0)
                                            "behavior" (hash "band" (exact->inexact band))))))))
      (if (trial-busy? trial)
        #f
        (begin
          (if (or (not fair)
                  (not trial) (not (evo:trial-ok? trial)) (not (evo:feasible? trial)))
            (primer-note! "ROLLBACK" "reachable")
            (let ((prev g-now)
                  (prev-held g-held))
              (set! g-now primer-g)
              (set! g-held primer-g)
              (set! tuned #t)
              (if (string=? (publish-named! "rule-gravity" primer-g) "fail")
                (begin
                  (set! g-now prev)
                  (set! g-held prev-held)
                  (publish-named! "rule-gravity" prev)
                  (primer-note! "ROLLBACK" "commit"))
                (begin
                  (set! published-g g-now)
                  (primer-note! "KEEP" "fair")))))
          (release-slot!)
          #t)))))

(define (step-primer!)
  (let ((rules (if (hash? primer-rules) primer-rules (rules-hash))))
    (let ((r (autopilot-slice primer-pieces rules primer-body primer-sim primer-i PRIMER-SLICE)))
      (set! primer-i (lref r 1))
      (set! primer-body (lref r 2))
      (set! primer-sim (lref r 3))
      (if (and (lref r 0) (not gate-tick) (not (chat-open?))
               (seal-primer! (if (lref r 4) #t #f)))
        (set! primer-phase 0)
        #f))))

(define (maybe-primer!)
  (if (or (= primer-phase 0) (> hold-phase 0) (> card-phase 0) (> chase-phase 0) (> dream-phase 0))
    #f
    (step-primer!)))

(define (on-primer c msg)
  (let ((card (hash-ref msg "card" ""))
        (text (hash-ref msg "text" "")))
    (let ((got (primer-read (if (string? card) card "") (if (string? text) text ""))))
      (cond
        ((> primer-phase 0)
         (send c (hash "op" "primer" "status" "busy")))
        ((not (hash-ref got "ok" #f))
         (primer-note! "ROLLBACK" (hash-ref got "why" "lex")))
        ((primer-same? (hash-ref got "name" "") (hash-ref got "value" 0))
         (send c (hash "op" "primer" "status" "same")))
        ((not (string=? (hash-ref got "name" "") "rule-gravity"))
         (primer-note! "ROLLBACK" "bounds"))
        ((primer-busy?)
         (primer-note! "ROLLBACK" "busy"))
        (else (begin-primer! got)))
      (flush-notes! c))))

; The numbers on the note are the live set: the kept step, or the set
; a failed trial left in place. The ask is what puts the sentence on
; the line. The mark is only the corner word.
(define (chase-note! kind why mood . rest)
  (let ((race (if (and (pair? rest) (string? (car rest))) (car rest) "")))
  (let ((row (note! kind why "chaser"
                    (chase-line kind mood race)
                    "chaser"
                    "A friend is keeping up")))
    (if (hash? row)
      (begin
        (hash-put! row "speed" (chase-get chase "speed" 2.1))
        (hash-put! row "cool" (chase-get chase "cool" 0.42))
        (hash-put! row "at" (chase-get chase "at" 0.42))
        (hash-put! row "commit" (chase-get chase "commit" 7.5))
        (hash-put! row "look" (chase-get chase "look" -1)))
      #f)
    row)))

; Coin lanes, pattern mix, density, and arc probability. Up to three
; knobs are scored beside the tick. Only the better one is installed,
; and only after its snapshot is put back. A collapsed lane weight, or
; a coin sitting in an obstacle, rolls back.
(define (coin-score-rows cands pace engage)
  (let loop ((xs cands) (acc (list)))
    (if (or (not (pair? xs)) (null? xs))
      (reverse acc)
      (let* ((row (car xs))
             (params (hash-ref row "params" coin-params))
             (road (coin-sample seed params pace))
             (audit (coin-consider coin-params params road pace engage))
             (why (hash-ref audit "why" "trial"))
             (fair (string=? (hash-ref audit "kind" "") "KEEP"))
             (fit (hash-ref audit "fit" 0.0)))
        (loop (cdr xs)
              (cons (hash "score" (if fair (+ 1.0 (if (number? fit) fit 0.0)) 0.0)
                          "fair" fair
                          "params" params
                          "why" why
                          "label" (hash-ref row "why" "lanes")
                          "knob" (hash-ref row "knob" 0)
                          "engage" (hash-ref audit "engage" 0.0))
                    acc))))))

(define (coin-apply-choice! rows)
  (let* ((best (fork-choose rows))
         (winner (if (hash? best) best (car rows)))
         (fair (hash-ref winner "fair" #f))
         (why (hash-ref winner "why" "trial"))
         (params (hash-ref winner "params" coin-params))
         (token (coin-blob params))
         (cand (evo:candidate (hash-ref winner "label" "lanes")
                              (hash "id" (string-append "c" (int-str level-n))
                                    "target" "rule-coins")))
         (trial (fork-wrap
                  (lambda ()
                    (open-trial cand
                      (fork-spec token
                        (lambda (seen)
                          (hash "status" "ok"
                                "objectives"
                                (hash "fair" (fork-fair seen token fair)
                                      "engage" (hash-ref winner "engage" 0.0))
                                "constraints"
                                (hash "budget" 0.0
                                      "geometry" (if (string=? why "overlap") 1.0 0.0)
                                      "reachable" (if (or (string=? why "reachable")
                                                          (string=? why "engage"))
                                                    1.0 0.0)
                                      "safe" (if (or (string=? why "entropy")
                                                     (string=? why "floor")
                                                     (string=? why "bounds")
                                                     (string=? why "step"))
                                               1.0 0.0))
                                "behavior"
                                (hash "band" (exact->inexact band)
                                      "engage" (hash-ref winner "engage" 0.0))))))))))
    (if (trial-busy? trial)
      #f
      (begin
        (if (or (not fair)
                (not trial)
                (not (evo:trial-ok? trial))
                (not (evo:feasible? trial)))
          (note! "ROLLBACK" (if (string=? why "") "trial" why) "spread"
                 "Coins stay spread" "lanes")
          (begin
            (set! coin-params
                  (coin-keep coin-params
                             (hash "moved" #t
                                   "why" (hash-ref winner "label" "fair")
                                   "knob" (hash-ref winner "knob" 0)
                                   "params" params)))
            (note-fork! (note! "KEEP" (hash-ref winner "label" "fair") "spread"
                              "Coins found a new path" "lanes")
                        (> (length rows) 1))))
        (release-slot!)
        #t))))

; One fork a tick. The same order coin-score-rows used, so the winner
; does not change; the gate just does not score every fork on one frame.
; One pattern or one coin-table slice of one fork. When that fork's
; road is finished, the same audit coin-score-rows would have recorded
; is queued, and the next fork starts on a later tick.
(define (coin-fork-row cand pace engage road)
  (let* ((params (hash-ref cand "params" coin-params))
         (audit (coin-consider coin-params params road pace engage))
         (why (hash-ref audit "why" "trial"))
         (fair (string=? (hash-ref audit "kind" "") "KEEP"))
         (fit (hash-ref audit "fit" 0.0)))
    (hash "score" (if fair (+ 1.0 (if (number? fit) fit 0.0)) 0.0)
          "fair" fair
          "params" params
          "why" why
          "label" (hash-ref cand "why" "lanes")
          "knob" (hash-ref cand "knob" 0)
          "engage" (hash-ref audit "engage" 0.0))))

; One slice per call. A finished fork records its row on the next
; tick, and that tick does not also step the next fork. Applying the
; winner is its own tick. The rows match coin-score-rows.
(define (coin-score-rest! cands acc pace engage sample)
  (cond
    ((and (null? cands) (not sample))
     (coin-apply-choice! (reverse acc)))
    (sample
     (let ((step (coin-sample-step sample)))
       (set! gate-followups
         (cons (lambda ()
                 (if (car step)
                   (let* ((row (coin-fork-row (car cands) pace engage (car (cdr step))))
                          (left (cdr cands))
                          (acc2 (cons row acc)))
                     (if (null? left)
                       (set! gate-followups
                         (cons (lambda () (coin-apply-choice! (reverse acc2)))
                               gate-followups))
                       (coin-score-rest! left acc2 pace engage #f)))
                   (coin-score-rest! cands acc pace engage (car (cdr (cdr step))))))
               gate-followups))
       #t))
    (else
     (set! gate-followups
       (cons (lambda ()
               (coin-score-rest! cands acc pace engage
                                 (coin-sample-job seed
                                                   (hash-ref (car cands) "params" coin-params)
                                                   pace)))
             gate-followups))
     #t)))

(define (consider-coins! played bumps coins swaps near . rest)
  (load-coins!)
  ; The gate queues this a tick later; capture the pace it crossed at so
  ; the verdict matches the inline call. A live caller passes nothing and
  ; reads speed-now as before.
  (let ((pace-now (if (and (pair? rest) (number? (car rest))) (car rest) speed-now)))
  (let ((step (coin-step coin-params played bumps coins swaps near pace-now)))
    (if (not (hash-ref step "moved" #f))
      #f
      (let* ((pace (if (and (number? pace-now) (> pace-now 0.1)) pace-now 8.0))
             (engage (coin-engage coins swaps near))
             (mood (hash-ref step "mood" "hold"))
             (knob (coin-get coin-params "knob" 0))
             (cands (let ((forks (coin-forks coin-params mood knob)))
                      (if (pair? forks)
                        forks
                        (list (hash "params" (hash-ref step "params" coin-params)
                                    "why" (hash-ref step "why" "lanes")
                                    "knob" (hash-ref step "knob" 0)))))))
        (begin
          (set! gate-followups
            (cons (lambda () (coin-score-rest! cands (list) pace engage #f))
                  gate-followups))
          #t))))))

; A step that the numbers already forbid does not take a slice. A legal
; step walks the proving road twelve frames at a time, under the rules
; the run is using now, including a kept deck.
; The race word is who led the gate. Empty keeps the old mood.
(define (queue-chase! played bumps recent pace-now . rest)
  (let ((race (if (and (pair? rest) (string? (car rest))) (car rest) "")))
  (if (> chase-phase 0)
    #f
    (let ((step (chase-step chase played bumps recent pace-now race)))
      (if (not (hash-ref step "moved" #f))
        #f
        (let ((params (hash-ref step "params" chase)))
          (let ((why (chase-static-why chase params pace-now)))
            (if (not (string=? why ""))
              (chase-note! "ROLLBACK" why "hold")
              (begin
                (set! chase-plan step)
                (set! chase-rules (rules-hash))
                (set! chase-road (chase-pieces params))
                (set! chase-sim chase-road)
                (set! chase-body (make-player 0.4))
                (set! chase-i 0)
                (set! chase-phase 1))))))))))

; One slice, not the whole road. Alive is the shadow score. A full
; clear of the primary walk still outranks it.
(define (chase-slice-alive? params rules)
  (let ((pieces (chase-pieces params))
        (body (make-player 0.4)))
    (let ((r (try (autopilot-slice pieces rules body pieces 0 12) (catch (e) #f))))
      (and (pair? r) (player-alive? (lref r 2))))))

(define (chase-alt-rows state primary mood pace rules)
  (let loop ((xs (chase-alts state primary mood pace)) (acc (list)))
    (if (or (not (pair? xs)) (null? xs))
      (reverse acc)
      (let* ((row (car xs))
             (params (hash-ref row "params" primary))
             (static (chase-static-why state params pace))
             (alive (and (string=? static "") (chase-slice-alive? params rules))))
        (loop (cdr xs)
              (cons (hash "score" (if alive 1.0 0.0)
                          "fair" (if alive #t #f)
                          "params" params
                          "why" (if alive "" (if (string=? static "") "reachable" static))
                          "label" (hash-ref row "why" "pace")
                          "knob" (hash-ref row "knob" 0)
                          "mood" (hash-ref row "mood" mood))
                    acc))))))

(define (seal-chase! cleared?)
  (let* ((plan chase-plan)
         (params (if (hash? plan) (hash-ref plan "params" chase) chase))
         (mood (if (hash? plan) (hash-ref plan "mood" "hold") "hold"))
         (race (if (hash? plan) (hash-ref plan "race" "") ""))
         (step-why (if (hash? plan) (hash-ref plan "why" "hold") "hold"))
         (rules (if (hash? chase-rules) chase-rules (rules-hash)))
         (pace-now (pace-of rules))
         (static (chase-static-why chase params pace-now))
         (why (if cleared? (if (string=? static "") "" static) "reachable"))
         (fair (string=? why ""))
         (primary (hash "score" (if fair 2.0 0.0)
                        "fair" fair
                        "params" params
                        "why" why
                        "label" (if (string? step-why) step-why "pace")
                        "knob" (if (hash? plan) (hash-ref plan "knob" 0) 0)
                        "mood" mood))
         (rows (cons primary (chase-alt-rows chase params mood pace-now rules)))
         (best (fork-choose rows))
         (winner (if (hash? best) best primary))
         (win-fair (hash-ref winner "fair" #f))
         (win-params (hash-ref winner "params" params))
         (token (chase-blob win-params))
         (cand (evo:candidate (hash-ref winner "label" "pace")
                              (hash "id" (string-append "r" (int-str level-n))
                                    "target" "rule-chase")))
         (trial (fork-wrap
                  (lambda ()
                    (open-trial cand
                      (fork-spec token
                        (lambda (seen)
                          (hash "status" "ok"
                                "objectives" (hash "fair" (fork-fair seen token win-fair))
                                "constraints"
                                (hash "budget" 0.0
                                      "geometry" 0.0
                                      "reachable" (if win-fair 0.0 1.0)
                                      "safe" 0.0)
                                "behavior"
                                (hash "band" (exact->inexact band)
                                      "speed" (exact->inexact (chase-get win-params "speed" 2.1)))))))))))
    (if (trial-busy? trial)
      #f
      (begin
        (if (or (not win-fair)
                (not trial)
                (not (evo:trial-ok? trial))
                (not (evo:feasible? trial)))
          (chase-note! "ROLLBACK"
                       (let ((w (hash-ref winner "why" "trial")))
                         (if (string=? w "") "trial" w))
                       (hash-ref winner "mood" mood)
                       race)
          (begin
            ; Put the winner on only after the snapshot is back. A shadow
            ; that merely stayed alive cannot beat a walk that cleared.
            (set! chase
                  (chase-keep chase
                              (hash "moved" #t
                                    "why" (hash-ref winner "label" step-why)
                                    "knob" (hash-ref winner "knob" 0)
                                    "params" win-params
                                    "race" race)))
            (note-fork! (chase-note! "KEEP"
                                     (hash-ref winner "label" step-why)
                                     (hash-ref winner "mood" mood)
                                     race)
                        (> (length rows) 1))))
        (release-slot!)
        #t))))

; Shadow-score each alternate one autopilot step at a time. Twelve steps,
; or an earlier finish, is the same alive? bit chase-slice-alive? returns.
(define chase-seal #f)
(define (chase-seal-row row alive static mood)
  (hash "score" (if alive 1.0 0.0)
        "fair" (if alive #t #f)
        "params" (hash-ref row "params" (hash))
        "why" (if alive "" (if (string=? static "") "reachable" static))
        "label" (hash-ref row "why" "pace")
        "knob" (hash-ref row "knob" 0)
        "mood" (hash-ref row "mood" mood)))
(define (chase-seal-finish!)
  (let* ((rows (cons (hash-ref chase-seal "primary") (reverse (hash-ref chase-seal "rows"))))
         (params (hash-ref chase-seal "params"))
         (mood (hash-ref chase-seal "mood"))
         (race (hash-ref chase-seal "race"))
         (step-why (hash-ref chase-seal "step-why"))
         (best (fork-choose rows))
         (winner (if (hash? best) best (hash-ref chase-seal "primary")))
         (win-fair (hash-ref winner "fair" #f))
         (win-params (hash-ref winner "params" params))
         (token (chase-blob win-params))
         (cand (evo:candidate (hash-ref winner "label" "pace")
                              (hash "id" (string-append "r" (int-str level-n))
                                    "target" "rule-chase")))
         (trial (fork-wrap
                  (lambda ()
                    (open-trial cand
                      (fork-spec token
                        (lambda (seen)
                          (hash "status" "ok"
                                "objectives" (hash "fair" (fork-fair seen token win-fair))
                                "constraints"
                                (hash "budget" 0.0 "geometry" 0.0
                                      "reachable" (if win-fair 0.0 1.0)
                                      "safe" 0.0)
                                "behavior"
                                (hash "band" (exact->inexact band)
                                      "speed" (exact->inexact (chase-get win-params "speed" 2.1)))))))))))
    (set! chase-seal #f)
    (set! chase-phase 0)
    (if (trial-busy? trial)
      #f
      (begin
        (if (or (not win-fair) (not trial) (not (evo:trial-ok? trial)) (not (evo:feasible? trial)))
          (chase-note! "ROLLBACK"
                       (let ((w (hash-ref winner "why" "trial")))
                         (if (string=? w "") "trial" w))
                       (hash-ref winner "mood" mood)
                       race)
          (begin
            (set! chase
                  (chase-keep chase
                              (hash "moved" #t
                                    "why" (hash-ref winner "label" step-why)
                                    "knob" (hash-ref winner "knob" 0)
                                    "params" win-params
                                    "race" race)))
            (note-fork! (chase-note! "KEEP"
                                     (hash-ref winner "label" step-why)
                                     (hash-ref winner "mood" mood)
                                     race)
                        (> (length rows) 1))))
        (release-slot!)
        #t))))
(define (chase-seal-note! alive)
  (let* ((row (hash-ref chase-seal "cur"))
         (static (hash-ref chase-seal "static" ""))
         (mood (hash-ref chase-seal "mood"))
         (built (chase-seal-row row alive static mood)))
    (set! chase-seal
          (hash "phase" "alt"
                "alts" (hash-ref chase-seal "alts")
                "rows" (cons built (hash-ref chase-seal "rows"))
                "primary" (hash-ref chase-seal "primary")
                "mood" mood
                "race" (hash-ref chase-seal "race")
                "step-why" (hash-ref chase-seal "step-why")
                "rules" (hash-ref chase-seal "rules")
                "pace" (hash-ref chase-seal "pace")
                "params" (hash-ref chase-seal "params")))))
(define (chase-seal-begin! cleared?)
  (let* ((plan chase-plan)
         (params (if (hash? plan) (hash-ref plan "params" chase) chase))
         (mood (if (hash? plan) (hash-ref plan "mood" "hold") "hold"))
         (race (if (hash? plan) (hash-ref plan "race" "") ""))
         (step-why (if (hash? plan) (hash-ref plan "why" "hold") "hold"))
         (rules (if (hash? chase-rules) chase-rules (rules-hash)))
         (pace-now (pace-of rules))
         (static (chase-static-why chase params pace-now))
         (why (if cleared? (if (string=? static "") "" static) "reachable"))
         (fair (string=? why ""))
         (primary (hash "score" (if fair 2.0 0.0)
                        "fair" fair
                        "params" params
                        "why" why
                        "label" (if (string? step-why) step-why "pace")
                        "knob" (if (hash? plan) (hash-ref plan "knob" 0) 0)
                        "mood" mood)))
    (set! chase-seal
          (hash "phase" "alt"
                "alts" (chase-alts chase params mood pace-now)
                "rows" (list)
                "primary" primary
                "mood" mood
                "race" race
                "step-why" step-why
                "rules" rules
                "pace" pace-now
                "params" params))
    (set! chase-phase 2)))
(define (chase-seal-step!)
  (if (not chase-seal)
    #f
    (let ((phase (hash-ref chase-seal "phase")))
      (cond
        ((string=? phase "walk")
         (let* ((w (hash-ref chase-seal "walk"))
                (r (autopilot-slice (list-ref w 0) (list-ref w 1)
                                    (list-ref w 2) (list-ref w 3)
                                    (list-ref w 4) 1))
                (left (- (list-ref w 5) 1)))
           (if (or (not (pair? r)) (car r) (<= left 0))
             (chase-seal-note! (and (pair? r) (player-alive? (lref r 2))))
             (set! chase-seal
                   (hash-set chase-seal "walk"
                             (list (list-ref w 0) (list-ref w 1)
                                   (lref r 2) (lref r 3) (lref r 1) left))))))
        ((string=? phase "trial")
         (chase-seal-finish!))
        (else
         (let ((alts (hash-ref chase-seal "alts" (list))))
           (if (null? alts)
             (set! chase-seal (hash-set chase-seal "phase" "trial"))
             (let* ((row (car alts))
                    (params (hash-ref row "params" (hash-ref chase-seal "params")))
                    (static (chase-static-why chase params (hash-ref chase-seal "pace"))))
               (set! chase-seal (hash-set (hash-set (hash-set chase-seal "alts" (cdr alts))
                                                    "cur" row)
                                          "static" static))
               (if (not (string=? static ""))
                 (chase-seal-note! #f)
                 (let ((pieces (chase-pieces params)))
                   (set! chase-seal
                         (hash-set (hash-set chase-seal "phase" "walk")
                                   "walk"
                                   (list pieces (hash-ref chase-seal "rules")
                                         (make-player 0.4) pieces 0 12)))))))))))))

(define (step-chase!)
  (let ((rules (if (hash? chase-rules) chase-rules (rules-hash))))
    (let ((r (autopilot-slice chase-road rules chase-body chase-sim chase-i 1)))
      (set! chase-i (lref r 1))
      (set! chase-body (lref r 2))
      (set! chase-sim (lref r 3))
      (if (and (lref r 0) (not gate-tick) (not (chat-open?)))
        (chase-seal-begin! (if (lref r 4) #t #f))
        #f))))

; One slice a tick. A phrase, a deck, or a dream already walking goes first.
(define (maybe-chase!)
  (if (or (= chase-phase 0) (= chase-phase 2) (> hold-phase 0) (> card-phase 0) (> dream-phase 0) (> primer-phase 0))
    #f
    (step-chase!)))

(define (maybe-dream!)
  (if (or tick-built dream-open (env-on? "LUMEN_SKIP_DREAM") (> hold-phase 0) (> card-phase 0) (> primer-phase 0) (llm-posting?) (chat-open?))
    #f
    (cond
      ((= dream-phase 1) (begin (step-dream!) #t))
      ((> chase-phase 0) #f)
      ((and (player-alive? player) (>= run-ms next-dream))
       (begin (set! dream-open "consider") #t))
      (else #f))))

(define (apply-scene! found form)
  (set! scene-now form)
  (set! sky-r (hash-ref found "sky-r"))
  (set! sky-g (hash-ref found "sky-g"))
  (set! sky-b (hash-ref found "sky-b"))
  (set! ground-r (hash-ref found "ground-r"))
  (set! ground-g (hash-ref found "ground-g"))
  (set! ground-b (hash-ref found "ground-b"))
  (set! flower-now (hash-ref found "flower"))
  (set! density-now (hash-ref found "density"))
  (set! light-now (hash-ref found "light"))
  (set! fog-now (hash-ref found "fog" 0.22)))

(define (consider-scene! text say)
  (let ((form (one-line (if (string? text) text ""))))
    (let ((found #f))
      (let* ((cand (evo:candidate form (hash "id" (string-append "s" (int-str next-id))
                                            "target" "scene-form")))
             (trial (open-trial cand
                                (hash "timeout-ms" 4000
                                      "apply" (lambda (c) #t)
                                      "evaluate"
                                      (lambda (c)
                                        (set! found (check-scene form))
                                        (hash "status" "ok"
                                              "objectives"
                                              (hash "fair" (if (and found (hash-ref found "ok")) 1.0 0.0))
                                              "constraints"
                                              (if (and found (hash? (hash-ref found "violations")))
                                                (hash-ref found "violations")
                                                (hash "reachable" 1.0))
                                              "behavior" (hash "band" (exact->inexact band))))))))
        (if (trial-busy? trial)
          (begin (set! wait-scene (list form say)) #f)
          (begin
        (if (or (not found) (not (hash-ref found "ok"))
                (not trial) (not (evo:trial-ok? trial)) (not (evo:feasible? trial)))
          (note! "ROLLBACK" (if (and found (string? (hash-ref found "why")))
                              (hash-ref found "why")
                              "trial")
                 "scene" "The garden stayed")
          (let ((prev-form scene-now))
            (set! scene-now form)
            (let ((ev (hash "status" "ok"
                            "objectives" (hash "fair" 1.0)
                            "constraints" (hash-ref found "violations")
                            "behavior" (hash "band" (exact->inexact band))))
                  (search (phrase-search "scene-form")))
              (try-tell-commit! search cand ev)
              (if (binding-landed? "scene-form" (scene-body form) form)
                (begin
                  (apply-scene! found form)
                  (set! rule-rev (+ rule-rev 1))
                  (set! rules-dirty #t)
                  (set! rules-thin #f)
                  (note! "KEEP" "fair" "scene"
                        (if (and (string? say) (> (string-length say) 0))
                          say
                          (hash-ref found "cue" "The garden changed color"))
                        "sky" "How should the garden look?"))
                (begin
                  (set! scene-now prev-form)
                  (note! "ROLLBACK" "commit" "scene" "The garden stayed"))))))
            (release-slot!)))))))

; rest is an optional note arm. Guest cars pass "guest" so a rolled-in
; car is not read as a model phrase that restyled the runner.
; The roster trial used to be one call: check, trial, tell, bind.
; Each of those is a tick now. The kept phrase is the same one the
; single call would have published; only the tick it lands on moves.
(define pals-job #f)
(define pals-queue (list))

(define (keep-pals! canon merged say hero changed? . rest)
  (let ((arm (if (and (pair? rest) (string? (car rest)) (> (string-length (car rest)) 0))
               (car rest)
               "pals")))
    (set! pals-queue
      (append pals-queue
              (list (hash "canon" canon "merged" merged "say" say
                          "hero" hero "changed" changed? "arm" arm))))
    #t))

(define (pals-fail! job why)
  (mark-pals! #f #f)
  (note! "ROLLBACK" why (hash-ref job "arm" "pals") "The friends stayed")
  (set! pals-job #f)
  (set! trial-open #f))

(define (pals-check!)
  (let ((found (check-roster (hash-ref pals-job "canon" ""))))
    (if (not (and found (hash-ref found "ok" #f)))
      (pals-fail! pals-job
                  (if (and found (string? (hash-ref found "why" #f)))
                    (hash-ref found "why")
                    "trial"))
      (set! pals-job (hash-set (hash-set pals-job "phase" "trial") "found" found)))))

(define (pals-trial!)
  (let* ((canon (hash-ref pals-job "canon" ""))
         (found (hash-ref pals-job "found" #f))
         (cand (evo:candidate canon (hash "id" (string-append "p" (int-str next-id))
                                          "target" "pals-form")))
         (trial (open-trial cand
                            (hash "timeout-ms" 4000
                                  "apply" (lambda (c) #t)
                                  "evaluate"
                                  (lambda (c)
                                    (hash "status" "ok"
                                          "objectives"
                                          (hash "fair" (if (and found (hash-ref found "ok" #f)) 1.0 0.0))
                                          "constraints"
                                          (if (and found (hash? (hash-ref found "violations" #f)))
                                            (hash-ref found "violations")
                                            (hash "reachable" 1.0))
                                          "behavior" (hash "band" (exact->inexact band))))))))
    (if (trial-busy? trial)
      (begin
        (set! wait-pals (list canon (hash-ref pals-job "say" "")))
        (set! pals-job #f))
      (if (or (not trial) (not (evo:trial-ok? trial)) (not (evo:feasible? trial)))
        (begin
          (release-slot!)
          (pals-fail! pals-job "trial"))
        (begin
          (set! trial-open #t)
          (set! pals-job (hash-set (hash-set pals-job "phase" "tell") "cand" cand)))))))

(define (pals-tell!)
  (let* ((found (hash-ref pals-job "found" #f))
         (cand (hash-ref pals-job "cand" #f))
         (ev (hash "status" "ok"
                   "objectives" (hash "fair" 1.0)
                   "constraints" (hash-ref found "violations" (hash))
                   "behavior" (hash "band" (exact->inexact band))))
         (search (phrase-search "pals-form")))
    (try-tell-commit! search cand ev)
    (set! pals-job (hash-set pals-job "phase" "bind"))))

(define (pals-bind!)
  (let ((canon (hash-ref pals-job "canon" ""))
        (merged (hash-ref pals-job "merged" (hash)))
        (say (hash-ref pals-job "say" ""))
        (hero (hash-ref pals-job "hero" #f))
        (changed? (hash-ref pals-job "changed" #f))
        (arm (hash-ref pals-job "arm" "pals"))
        (prev-form pals-now)
        (prev-rows pals-rows)
        (prev-hero hero-now))
    (set! pals-now canon)
    (set! pals-rows (hash-ref merged "rows" (list)))
    (set! hero-now hero)
    (if (binding-landed? "pals-form" (pals-body canon) canon)
      (begin
        (set! rule-rev (+ rule-rev 1))
        (set! rules-dirty #t)
        (set! rules-thin #f)
        (mark-pals! #t changed?)
        (note! "KEEP" "fair" arm
               (if (and (string? say) (> (string-length say) 0))
                 say
                 (hash-ref merged "cue" "A new friend came along"))
               (if changed?
                 (if (hash? hero) (hash-ref hero "kind" "keeper") "keeper")
                 (if (string=? arm "pals") "friend" ""))
               "Who wants to run with us?"))
      (begin
        (set! pals-now prev-form)
        (set! pals-rows prev-rows)
        (set! hero-now prev-hero)
        (mark-pals! #f #f)
        (note! "ROLLBACK" "commit" arm "The friends stayed")))
    (release-slot!)
    (set! trial-open #f)
    (set! pals-job #f)))

; One phase. A fresh request starts at the check; a job already open
; takes its next phase. The slot stays held from a kept trial until bind.
(define (pals-step!)
  (cond
    ((not pals-job)
     (if (null? pals-queue)
       #f
       (begin
         (set! pals-job (hash-set (car pals-queue) "phase" "check"))
         (set! pals-queue (cdr pals-queue))
         (pals-check!))))
    ((string=? (hash-ref pals-job "phase" "") "trial") (pals-trial!))
    ((string=? (hash-ref pals-job "phase" "") "tell") (pals-tell!))
    ((string=? (hash-ref pals-job "phase" "") "bind") (pals-bind!))
    (else (pals-check!))))

(define (consider-pals! text say)
  (let ((incoming (one-line (if (string? text) text ""))))
    (let ((found (check-roster incoming)))
      (if (not (and (hash? found) (hash-ref found "ok")))
        (begin
          (mark-pals! #f #f)
          (note! "ROLLBACK" (if (hash? found) (hash-ref found "why" "shape") "shape")
               "pals" "The friends stayed"))
        (let ((incoming-rows (hash-ref found "pals"))
              (incoming-hero (hash-ref found "hero" #f)))
          (if (> (fresh-count pals-rows incoming-rows) 4)
            (begin
              (mark-pals! #f #f)
              (note! "ROLLBACK" "count" "pals" "The friends stayed"))
            (let ((has-rows (pair? incoming-rows))
                  (has-hero (hash? incoming-hero)))
              (if (not (or has-rows has-hero))
                (begin
                  (mark-pals! #f #f)
                  (note! "ROLLBACK" "empty" "pals" "The friends stayed"))
                (let ((merged (if has-rows
                                (merge-pals pals-rows incoming-rows)
                                (hash "ok" #t "why" "fair" "rows" pals-rows "cue" ""))))
                  (if (not (and (hash? merged) (hash-ref merged "ok")))
                    (begin
                      (mark-pals! #f #f)
                      (note! "ROLLBACK" (if (hash? merged) (hash-ref merged "why" "empty") "empty")
                           "pals" "The friends stayed"))
                    (let ((next-hero (if has-hero
                                       (if (keeper-plan? incoming-hero) #f incoming-hero)
                                       hero-now))
                          (rows (hash-ref merged "rows")))
                      (let ((canon (roster-text rows next-hero))
                            (changed? (not (string=? (hero-key next-hero) (hero-key hero-now)))))
                        (if (string=? canon pals-now)
                          (begin
                            (mark-pals! #f #f)
                            (note! "ROLLBACK" "same" "pals" "The friends stayed"))
                          (keep-pals! canon
                                      (hash "rows" rows
                                            "cue" (if changed?
                                                    (hero-cue (if (hash? next-hero)
                                                                next-hero
                                                                incoming-hero))
                                                    (hash-ref merged "cue" "A new friend came along")))
                                      say next-hero changed?))))))))))))))

; Restyle one friend who is already here, and step the runner's look.
; The count stays put. keep-pals! is the trial; a miss puts both back.
(define (roster-evolve! say)
  (if (or (not (player-alive? player))
          (llm-posting?)
          (chat-open?)
          (pair? wait-pals)
          (and (>= evolve-at 0.0) (< (- run-ms evolve-at) 400.0)))
    #f
    (let ((rows (if (pair? pals-rows)
                  (tune-motion (evolve-rows pals-rows) run-ms)
                  pals-rows))
          (next (evolve-hero hero-now)))
      (let ((canon (roster-text rows next))
            (changed? (not (string=? (hero-key next) (hero-key hero-now)))))
        (if (string=? canon pals-now)
          #f
          (begin
            (set! evolve-at run-ms)
            (keep-pals! canon
                        (hash "ok" #t "why" "fair" "rows" rows
                              "cue" (if (and (string? say) (> (string-length say) 0))
                                      say
                                      "A friend looks different"))
                        say next changed?)
            #t))))))

; A coin inside 2.4 seconds lengthens the streak. Three, six, and so on
; take one evolution step. A shield block takes one too. A stumble clears it.
(define (note-play! ev held)
  (cond
    ((string=? ev "coin")
     (set! level-coins (+ level-coins 1))
     (if (or (< pick-at 0.0) (> (- run-ms pick-at) 2400.0))
       (set! pick-streak 1)
       (set! pick-streak (+ pick-streak 1)))
     (set! pick-at run-ms))
    ((or (string=? ev "bump") (string=? ev "oops") (string=? ev "dead"))
     (begin (set! pick-streak 0) (set! sparked 0)))
    (else #f))
  (if (not (player-alive? player))
    #f
    (cond
      (held (roster-evolve! "The shield held"))
      ((and (evolve-spark? pick-streak #f #f) (not (= sparked pick-streak)))
       (if (roster-evolve! "A bright streak")
         (set! sparked pick-streak)
         #f))
      (else #f))))

(define (llm-prompt kind)
  (if (and wish-flight (string=? kind wish-kind)
           (string? wish-prompt) (> (string-length wish-prompt) 0))
    wish-prompt
    (cond
    ((string=? kind "scene")
     (string-append "Flowers now: " flower-now
                    ". Sky is " (num-src sky-r) " " (num-src sky-g) " " (num-src sky-b)
                    ". Suggest a different bright garden. Start with one short sentence."))
    ((string=? kind "pals")
     (join-hint (string-append "Friends already here: " (pal-names pals-rows)
                    ". The runner is now " (runner-kind)
                    ". Restyle one friend already here by keeping the same name, or add one new gentle friend who is not in that list. A puppy, fox, turtle, bee, penguin, panda, or dragon is welcome. Always include (hero KIND R G B) with a different gentle kind. Start with one short sentence.")
                pals-hint))
    (else
     (join-hint (string-append "Difficulty band " (number->string band)
                    ". Pickups are " loot-now
                    ". The road bends by " (num-src bend-now)
                    ". Jump speed is " (num-src speed-now)
                    " m/s. Invent a different rhythm from a straight row of hurdles. You may add (loot KIND), (bend AMP), (flyer KIND LANE Y), and (slope GRADE LENGTH). GRADE is from 0.04 to 0.16 and steeper on a higher band. A down slope of the same length returns the road to flat. A hurdle, gate, or block may end with a look word. Start with one short sentence.")
                hint-now)))))

; Game-side budget. The runtime's own HTTP cap is LLM_TIMEOUT; if that
; call never comes back, give up LLM_TIMEOUT+10 seconds later and drop
; whatever arrives after that.
(define (load-llm-timeout!)
  (let ((raw (try (getenv "LLM_TIMEOUT") (catch (e) ""))))
    (let ((alt (if (and (string? raw) (> (string-length raw) 0))
                 raw
                 (try (getenv "AURA_HTTP_TIMEOUT") (catch (e) "")))))
      (let ((n (if (and (string? alt) (> (string-length alt) 0))
                 (string->number alt)
                 #f)))
        (if (and (number? n) (> n 0))
          (set! llm-timeout-s (exact->inexact n))
          #f)))))

(define (watchdog-ms)
  (* (+ llm-timeout-s 10.0) 1000.0))

; Tests can ask for obstacles less often. The live game stays at 10 seconds.
(define (motif-gap-ms)
  (let ((raw (try (getenv "LUMEN_MOTIF_GAP_MS") (catch (e) ""))))
    (let ((n (if (and (string? raw) (> (string-length raw) 0)) (string->number raw) #f)))
      (if (and (number? n) (> n 0)) (exact->inexact n) 10000.0))))

(define (sync-llm-busy!)
  (set! llm-busy (or motif-busy scene-busy pals-busy edsl-busy)))

(define (expire-one! busy asked accept-now arm cue)
  (if (and busy (> asked 0.0) (> (- (monotonic-ms) asked) (watchdog-ms)))
    (begin
      (set! llm-watchdogs (+ llm-watchdogs 1))
      (note! "ROLLBACK" "watchdog" arm cue)
      #t)
    #f))

(define (expire-llm!)
  (if (expire-one! scene-busy scene-asked-at scene-accept "scene" "The garden waited")
    (begin (set! scene-accept -1) (set! scene-busy #f))
    #f)
  (if (expire-one! motif-busy motif-asked-at motif-accept "llm" "Still thinking")
    (begin (set! motif-accept -1) (set! motif-busy #f))
    #f)
  (if (expire-one! pals-busy pals-asked-at pals-accept "pals" "The friends waited")
    (begin (set! pals-accept -1) (set! pals-busy #f))
    #f)
  (if (expire-one! edsl-busy edsl-asked-at edsl-accept "biome" (world-stay))
    (begin
      (set! edsl-accept -1)
      (set! edsl-busy #f)
      (set! edsl-enter? #f)
      ; A world already kept stays. The late reply must not put the garden back.
      (if edsl-held #f (preview-back!)))
    #f)
  (sync-llm-busy!))

; The job hash can lose its token across the chat call. A missing token
; is 0 and still belongs to the one open ask. A real older token does
; not: the watchdog may already have started the next ask.
(define (accept-reply! tok accept)
  (and (number? tok) (number? accept) (>= accept 0)
       (or (= tok accept) (<= tok 0))))

(define (take-scene! c msg)
  (let ((tok (hash-ref msg "token" -1)))
    (wish-begin! tok "scene")
    (if (not (accept-reply! tok scene-accept))
      (begin (set! wish-mine #f) #f)
      (let ((ans (hash-ref msg "ans" #f)))
        (set! scene-busy #f)
        (set! scene-accept -1)
        (if (and (hash? ans) (hash-ref ans "ok"))
          (let ((raw (hash-ref ans "content" "")))
            (let ((text (if (string? raw) raw "")))
              (if (banned? text)
                (note! "ROLLBACK" "banned" "scene" (wish-cue-or "The garden stayed" "banned"))
                (let ((form (extract-garden text)))
                  (if form
                    (if (chat-open?)
                      (set! wait-scene (list form (say-line text)))
                      (consider-scene! form (say-line text)))
                    (note! "ROLLBACK" "no-garden" "scene" (wish-cue-or "The garden stayed" "shape")))))))
          (note! "ROLLBACK" (if (and (hash? ans) (not wish-mine)) (hash-ref ans "error" "llm") "llm")
                 "scene" (wish-cue-or "The garden stayed" "llm")))
        (set! wish-mine #f)
        (send c (rules-msg))
        (set! rules-dirty #f)
        (set! state-full #t)))))

; A pal form and a hero form written next to each other are one phrase.
; Searching (pal before (hero used to drop the runner.
(define (extract-pals s)
  (let ((hero (extract-balanced s "(hero")))
    (let ((body (let ((full (extract-balanced s "(pals")))
                  (if full full (extract-balanced s "(pal")))))
      (cond
        ((and body hero (not (string-contains? body "(hero")))
         (join-hero body hero))
        (body body)
        (else hero)))))

(define (take-pals! c msg)
  (let ((tok (hash-ref msg "token" -1)))
    (wish-begin! tok "pals")
    (if (not (accept-reply! tok pals-accept))
      (begin (set! wish-mine #f) #f)
      (let ((ans (hash-ref msg "ans" #f)))
        (set! pals-busy #f)
        (set! pals-accept -1)
        (if (and (hash? ans) (hash-ref ans "ok"))
          (let ((raw (hash-ref ans "content" "")))
            (let ((text (if (string? raw) raw "")))
              (if (banned? text)
                (note! "ROLLBACK" "banned" "pals" (wish-cue-or "The friends stayed" "banned"))
                (let ((form (dress-form (extract-pals text) (runner-kind))))
                  (if form
                    (if (chat-open?)
                      (set! wait-pals (list form (say-line text)))
                      (consider-pals! form (say-line text)))
                    (note! "ROLLBACK" "no-pal" "pals" (wish-cue-or "The friends stayed" "shape")))))))
          (note! "ROLLBACK" (if (and (hash? ans) (not wish-mine)) (hash-ref ans "error" "llm") "llm")
                 "pals" (wish-cue-or "The friends stayed" "llm")))
        (set! wish-mine #f)
        (send c (rules-msg))
        (set! rules-dirty #f)
        (set! state-full #t)))))

(define (take-motif! c msg)
  (let ((tok (hash-ref msg "token" -1)))
    (wish-begin! tok "motif")
    (if (not (accept-reply! tok motif-accept))
      (begin (set! wish-mine #f) #f)
      (let ((ans (hash-ref msg "ans" #f)))
        (set! motif-busy #f)
        (set! motif-accept -1)
        (if (and (hash? ans) (hash-ref ans "ok"))
          (let ((raw (hash-ref ans "content" "")))
            (let ((text (if (string? raw) raw "")))
              (if (banned? text)
                (note! "ROLLBACK" "banned" "llm" (wish-cue-or "That shape drifted away" "banned"))
                (let ((form (extract-seq text)))
                  (if form
                    (if (chat-open?)
                      (set! wait-motif (list form (say-line text)))
                      (consider-form! form (say-line text)))
                    (note! "ROLLBACK" "no-seq" "llm" (wish-cue-or "That shape drifted away" "shape")))))))
          (note! "ROLLBACK" (if (and (hash? ans) (not wish-mine)) (hash-ref ans "error" "llm") "llm")
                 "llm" (wish-cue-or "That shape drifted away" "llm")))
        (set! wish-mine #f)
        (send c (rules-msg))
        (set! rules-dirty #f)
        (set! state-full #t)))))

; Send on the caller. The worker is the only receiver, and we do not
; enqueue a second job while it is still inside llm:chat, so this does
; not block the tick and does not allocate a closure per ask.
(define (ask-scene!)
  (if (or scene-working (not scene-req))
    #f
    (let ((tok (+ scene-token 1)))
      (set! scene-token tok)
      (set! scene-accept tok)
      (set! scene-asked-at (exact->inexact (monotonic-ms)))
      (set! scene-busy #t)
      (set! scene-next (+ run-ms 12000.0))
      (channel:send scene-req (list tok (llm-prompt "scene")))
      (sync-llm-busy!))))

(define (pals-gap-ms)
  (let ((raw (try (getenv "LUMEN_PALS_GAP_MS") (catch (e) ""))))
    (let ((n (if (and (string? raw) (> (string-length raw) 0)) (string->number raw) #f)))
      (if (and (number? n) (> n 0)) (exact->inexact n) 11000.0))))

(define (edsl-gap-ms)
  (let ((raw (try (getenv "LUMEN_BIOME_GAP_MS") (catch (e) ""))))
    (let ((n (if (and (string? raw) (> (string-length raw) 0)) (string->number raw) #f)))
      (if (and (number? n) (> n 0)) (exact->inexact n) 18000.0))))

(define (edsl-user)
  (string-append "The runner is in " biome-now
                 ". Dream a different bright place"
                 (if (and (string? edsl-hint) (> (string-length edsl-hint) 0))
                   (string-append " for " edsl-hint)
                   "")
                 ". Start with one short sentence."))

(define (ask-edsl!)
  (if (or edsl-working (not edsl-req))
    #f
    (let ((tok (+ edsl-token 1)))
      (set! edsl-token tok)
      (set! edsl-accept tok)
      (set! edsl-asked-at (exact->inexact (monotonic-ms)))
      (set! edsl-busy #t)
      (set! edsl-next (+ run-ms (edsl-gap-ms)))
      (channel:send edsl-req (list tok (edsl-user)))
      (sync-llm-busy!))))

; A novel place. A live model answers on its own fiber. With no key, or
; while that fiber is already busy, the themed recipe is gated at once.
; A named city skips the model: the dream is a different place, and the
; child asked for this one. An in-flight dream must not replace it.
(define (edsl-hear! theme)
  (load-slow!)
  (let ((preset (edsl-preset theme))
        (city? (edsl-tour-city? theme)))
    (if (and city? (not (string? preset)))
      #f
      (if (and (not city?)
               llm-on edsl-req (not edsl-busy) (not edsl-working) (not (llm-posting?)))
        (begin
          (set! edsl-theme-now theme)
          (set! edsl-hint theme)
          (set! edsl-enter? #t)
          (ask-edsl!))
        (begin
          (if city?
            (begin
              (set! edsl-enter? #f)
              (set! edsl-theme-now "")
              (set! edsl-hint ""))
            #f)
          (if (string? preset)
            (consider-edsl! preset (edsl-say theme wish-locale) #t #t)
            #f))))))

(define (edsl-fallback! theme)
  (load-slow!)
  (let ((preset (edsl-preset theme)))
    (if (string? preset)
      (consider-edsl! preset (edsl-say theme wish-locale) #t #t)
      (note! "ROLLBACK" "shape" "biome" (world-stay)))))

(define (refine-miss theme hint fallback held enter why)
  (if (string=? theme "free")
    (if held
      (note! "ROLLBACK" why "biome" (world-stay) "world")
      (if (and (string? fallback) (> (string-length fallback) 0) (wish-commit! fallback))
        (preview-drop!)
        (begin
          (preview-back!)
          (note! "ROLLBACK" why "biome" (world-stay) "world"))))
    (if enter
      (edsl-fallback! theme)
      (note! "ROLLBACK" why "biome" (world-stay) "world"))))

(define (take-edsl! c msg)
  (let ((tok (hash-ref msg "token" -1))
        (enter edsl-enter?)
        (theme edsl-theme-now)
        (hint edsl-hint)
        (fallback edsl-fallback-form)
        (held edsl-held))
    (if (not (accept-reply! tok edsl-accept))
      #f
      (let ((ans (hash-ref msg "ans" #f)))
        (set! edsl-busy #f)
        (set! edsl-accept -1)
        (set! edsl-enter? #f)
        (set! edsl-theme-now "")
        (set! edsl-hint "")
        (set! edsl-fallback-form "")
        (if (and (hash? ans) (hash-ref ans "ok"))
          (let ((raw (hash-ref ans "content" "")))
            (let ((text (if (string? raw) raw "")))
              (if (banned? text)
                (refine-miss theme hint fallback held enter "banned")
                (let ((form (extract-balanced text "(biome"))
                      (asked (if (string=? theme "free") hint theme))
                      (install (or (string=? theme "free") enter)))
                  (if (and (string? form) (edsl-serves? asked form))
                    (if (consider-edsl! form (say-line text) install install)
                      (begin (if install (set! edsl-held #f) #f) (preview-drop!))
                      (refine-miss theme hint fallback held enter "shape"))
                    (refine-miss theme hint fallback held enter "shape")))))))
          (refine-miss theme hint fallback held enter "llm"))
        (send c (rules-msg))
        (set! rules-dirty #f)
        (set! state-full #t))))

(define (ask-pals!)
  (if (or pals-working (not pals-req))
    #f
    (let ((tok (+ pals-token 1)))
      (set! pals-token tok)
      (set! pals-accept tok)
      (set! pals-asked-at (exact->inexact (monotonic-ms)))
      (set! pals-busy #t)
      (set! pals-next (+ run-ms (pals-gap-ms)))
      (let ((user (llm-prompt "pals")))
        (set! pals-hint "")
        (channel:send pals-req (list tok user)))
      (sync-llm-busy!))))

(define (ask-motif!)
  (if (or motif-working (not motif-req))
    #f
    (let ((tok (+ motif-token 1)))
      (set! motif-token tok)
      (set! motif-accept tok)
      (set! motif-asked-at (exact->inexact (monotonic-ms)))
      (set! motif-busy #t)
      (set! motif-next (+ run-ms (motif-gap-ms)))
      (let ((user (llm-prompt "motif")))
        (set! hint-now "")
        (channel:send motif-req (list tok user)))
      (sync-llm-busy!))))

; channel:try-recv on an empty channel is #f (#5161). Each kind has its
; own channel, so a garden call that never returns cannot eat the next
; obstacle phrase. A late hash whose token was retired by the watchdog
; is ignored.
; A reply that arrived during another chat call waits here. The trial
; runs only after that call has left http-post.
(define (flush-deferred!)
  (if (or (llm-posting?) (chat-open?))
    #f
    (cond
      ((pair? wait-motif)
       (let ((form (car wait-motif))
             (say (car (cdr wait-motif))))
         (set! wait-motif #f)
         (consider-form! form say)))
      ((pair? wait-scene)
       (let ((form (car wait-scene))
             (say (car (cdr wait-scene))))
         (set! wait-scene #f)
         (consider-scene! form say)))
      ((pair? wait-pals)
       (let ((form (car wait-pals))
             (say (car (cdr wait-pals))))
         (set! wait-pals #f)
         (consider-pals! form say)))
      (else #f))))

(define (wish-note! kind why)
  (note! kind why "wish" (wish-line wish-locale why) "wish" "Say a bright little wish"))

(define (wish-owns? tok)
  (and wish-flight (number? tok) (= tok wish-token)))

(define (wish-settled!)
  (set! wish-flight #f)
  (set! wish-queued #f)
  (set! wish-open #f)
  (set! wish-think #f)
  (set! wish-prompt "")
  (set! wish-sent-at 0.0))

(define (wish-arm-free? kind)
  (cond
    ((string=? kind "scene") (and scene-req (not scene-busy) (not scene-working)))
    ((string=? kind "pals") (and pals-req (not pals-busy) (not pals-working)))
    (else (and motif-req (not motif-busy) (not motif-working)))))

(define (wish-arm-busy? kind)
  (cond
    ((string=? kind "scene") scene-busy)
    ((string=? kind "pals") pals-busy)
    (else motif-busy)))

; Eight seconds is a progress line. Fifteen seconds lets the run go on
; and ignores a late reply. The worker may still be inside HTTP; wish-wait
; keeps a second job off that channel until the late reply arrives.
(define (maybe-wish!)
  ; The UX timeout retires the token while the worker may still be inside
  ; HTTP. Stop waiting once that call's own cap has passed.
  (if (and wish-wait (> wish-sent-at 0.0)
           (> (- (exact->inexact (monotonic-ms)) wish-sent-at)
              (+ (watchdog-ms) 5000.0)))
    (begin (set! wish-wait #f) (set! wish-sent-at 0.0))
    #f)
  (if wish-flight
    (let ((ms (if (> wish-sent-at 0.0)
                (- (exact->inexact (monotonic-ms)) wish-sent-at)
                0.0)))
      (cond
        ((> ms 15000.0)
         (let ((sent wish-sent-at))
           (cond
             ((string=? wish-kind "scene") (begin (set! scene-accept -1) (set! scene-busy #f)))
             ((string=? wish-kind "pals") (begin (set! pals-accept -1) (set! pals-busy #f)))
             (else (begin (set! motif-accept -1) (set! motif-busy #f))))
           (wish-settled!)
           ; Keep the send time so a lost reply cannot hold wish-wait
           ; past the worker's own HTTP cap.
           (set! wish-sent-at sent)
           (set! wish-wait #t)
           (wish-note! "ROLLBACK" "timeout")))
        ((and (> ms 8000.0) (not wish-think))
         (begin (set! wish-think #t) (wish-note! "SAY" "think")))
        (else #f)))
    #f)
  (if (and wish-queued (not wish-flight) (not wish-wait) (wish-arm-free? wish-kind))
    (begin
      (set! wish-flight #t)
      (set! wish-queued #f)
      (set! wish-sent-at (exact->inexact (monotonic-ms)))
      (set! wish-think #f)
      (cond
        ((string=? wish-kind "scene") (ask-scene!))
        ((string=? wish-kind "pals") (ask-pals!))
        (else (ask-motif!)))
      (if (wish-arm-busy? wish-kind)
        (set! wish-token (cond
                           ((string=? wish-kind "scene") scene-accept)
                           ((string=? wish-kind "pals") pals-accept)
                           (else motif-accept)))
        (begin
          (set! wish-flight #f)
          (set! wish-queued #t))))
    #f))

(define (wish-begin! tok kind)
  (if (and wish-wait (string=? kind wish-kind))
    (set! wish-wait #f)
    #f)
  (set! wish-mine (wish-owns? tok))
  (if wish-mine (wish-settled!) #f))

(define (wish-cue-or en why)
  (if wish-mine (wish-line wish-locale why) en))

(define (apply-offline! row)
  (let ((arm (hash-ref row "arm"))
        (form (hash-ref row "form"))
        (say (hash-ref row "say")))
    (cond
      ((string=? arm "scene") (consider-scene! form say))
      ((string=? arm "pals") (consider-pals! form say))
      (else (consider-form! form say)))))

; ---------------------------------------------------------------- things
; A spoken wish also asks the model for a new thing (lib/thing.aura).
; The keyword picture above is the placeholder, on screen at once.
; Several fibers ask in parallel, each with its own prompt variant and
; temperature, and each checks and scores its own reply off the tick.
; The tick closes the round at the deadline, records the winner with
; evo:trial, and stages it. The next stretch that is laid installs it
; with (mutate :rebind) on thing-form, so a stretch already on the road
; never changes. Two stumbles on the first stretches that carry a new
; hurdle or gate, or a browser that cannot draw it, put the previous
; thing back.
(define thing-res #f)
(define thing-gen 0)
(define thing-open #f)
(define thing-t0 0.0)
; The round's gate inputs. The worker rows can lose their score and
; constraint fields to a runtime collection; the close re-judges each
; candidate from its form with these.
(define thing-rules #f)
(define thing-band 0)
(define thing-rows (list))
(define thing-text "")
(define thing-role "")
(define thing-asked 0)
(define thing-late 0)
; Fibers spawned and not yet heard from in the current round.
(define thing-out 0)
; The current round's chat fibers. A new wish cancels them: a canceled
; HTTP call cannot come back to corrupt the next round's rows, and a
; long run does not accumulate live capture frames.
(define thing-fids (list))
; The bridge can proxy the chat POST off this process. A direct core
; (tests, no page) leaves it off and uses http-post.
(define llm-proxy-on #f)
(define llm-replies (hash))
(define llm-ask-id 0)
(define conn #f)
(define thing-staged #f)
(define thing-live #f)
(define thing-prev #f)
; A local toy is already on screen. A later model miss must not toast a failure.
(define thing-quiet #f)
(define thing-shown-name "")
(define thing-bumps 0)
(define thing-chosen-at 0.0)

(define (env-num name fallback)
  (let ((raw (try (getenv name) (catch (e) ""))))
    (let ((n (if (and (string? raw) (> (string-length raw) 0)) (string->number raw) #f)))
      (if (and (number? n) (> n 0)) n fallback))))

(define (thing-fibers) (max 1 (min 4 (floor (env-num "LUMEN_THING_FIBERS" 4)))))
(define (thing-deadline-ms) (exact->inexact (env-num "LUMEN_THING_DEADLINE_MS" 11000)))

(define (now-ms) (exact->inexact (monotonic-ms)))

(define (thing-log . xs)
  (display "THING")
  (let loop ((ys xs))
    (if (null? ys)
      (newline)
      (begin (display " ") (display (car ys)) (loop (cdr ys))))))

; A HUD row for the browser. It rides out with the decision notes.
(define (thing-hud! phase . rest)
  (set! pending
    (cons (hash "op" "thing" "phase" phase "gen" thing-gen
                "asked" thing-asked
                "info" (if (pair? rest) (car rest) (hash))
                "live" (if (hash? thing-live) (hash-ref thing-live "public" #f) #f))
          pending)))

; The workers post straight to the chat endpoint: the probed provider's
; key and URL, or LLM_API_KEY / LLM_BASE_URL / LLM_MODEL. The child's
; words were already cleaned and filtered, and the reply is only read
; through check-thing.
(define (thing-endpoint)
  (if (provider-ready? llm-provider)
    (list (provider-key llm-provider) (provider-url llm-provider) (active-model))
    (list (env-str "LLM_API_KEY")
          (let ((b (env-str "LLM_BASE_URL"))) (if (string=? b "") "https://api.deepseek.com/v1" b))
          (let ((m (env-str "LLM_MODEL"))) (if (string=? m "") "deepseek-flash" m)))))

(define (thing-chat-http sys user temp timeout-s ep)
  (let ((body (json-encode
                (hash "model" (list-ref ep 2)
                      ; DeepSeek V4.1 Flash spends reasoning tokens out of
                      ; this budget. 900 truncated the (thing ...) form on
                      ; the larger wishes; 2400 leaves room for the form.
                      "max_tokens" 2400
                      "temperature" temp
                      "reasoning_effort" "minimal"
                      "messages"
                      (list (hash "role" "system" "content" sys)
                            (hash "role" "user" "content" user))))))
    (let ((raw (try (http-post (chat-url (list-ref ep 1)) body (list-ref ep 0) timeout-s)
                    (catch (e) ""))))
      (let ((ans (try (parse-chat (if (string? raw) raw "")) (catch (e) #f))))
        (if (hash? ans) ans (hash "ok" #f "error" "llm" "content" ""))))))

; The socket POST is synchronous in the script runtime, so a wish's
; first TLS handshake froze the tick. The bridge runs the POST in Node
; and replies on the same line socket; this worker only yields.
(define (thing-chat-proxy sys user temp timeout-s ep)
  (let ((id (number->string (+ llm-ask-id 1))))
    (set! llm-ask-id (+ llm-ask-id 1))
    (send conn (hash "op" "llm-ask" "id" id "model" (list-ref ep 2)
                     "max_tokens" 2400
                     "temperature" temp
                     "reasoning_effort" "minimal"
                     "timeout" timeout-s
                     "messages"
                     (list (hash "role" "system" "content" sys)
                           (hash "role" "user" "content" user))))
    (let loop ((deadline (+ (now-ms) (* timeout-s 1000.0))))
      (let ((r (hash-ref llm-replies id #f)))
        (cond
          (r (hash-set! llm-replies id #f)
             (hash "ok" (eq? (hash-ref r "ok" #f) #t)
                   "error" (hash-ref r "error" "")
                   "content" (hash-ref r "content" "")))
          ((> (now-ms) deadline)
           (hash "ok" #f "error" "timeout" "content" ""))
          (else
           (try (fiber:yield) (catch (e) #f))
           (loop deadline)))))))

(define (thing-chat sys user temp timeout-s ep)
  (if (and llm-proxy-on conn)
    (thing-chat-proxy sys user temp timeout-s ep)
    (thing-chat-http sys user temp timeout-s ep)))

; A live worker's captured t0 can read back as 0 after the runtime
; reuses its capture frame. Fall back to the round's own start so a
; reply is not dropped as 172 million ms late on uptime.
(define (thing-elapsed t0)
  (let ((base (if (and (number? t0) (> t0 0.0)) t0 thing-t0)))
    (- (now-ms) base)))

; One candidate. Everything the tick needs comes back as a list of
; atoms: gen, variant, reply ms, scored ms, checked, fair, score, form,
; why, the model's sentence, margin, geometry, budget.
(define (thing-worker res gen i text role rules band t0 timeout-s ep)
  (lambda ()
    ; fiber:spawn runs the new worker until its first yield; let the
    ; four prompts spread over later ticks instead of this one.
    (try (fiber:yield) (catch (e) #f))
    (let ((sent (try (thing-work res gen i text role rules band t0 timeout-s ep)
                     (catch (e) e))))
      (if (eq? sent #t)
        #t
        (begin
          (thing-log "gen" gen "variant" i "error"
                     (if (string? sent) sent "?"))
          (channel:send res
            (list gen i (thing-elapsed t0) (thing-elapsed t0)
                  0 0 0.0 "" "error" "" 0.0 1.0 1.0)))))))

(define (thing-work res gen i text role rules band t0 timeout-s ep)
  (begin
    (let* ((ans (thing-chat THING-SYS (thing-user text role i) (thing-variant-temp i) timeout-s ep))
           (got (thing-elapsed t0))
           (llm-ok (and (hash? ans) (hash-ref ans "ok" #f)))
           (content (if llm-ok (hash-ref ans "content" "") ""))
           (checked (if llm-ok (check-thing content) (thing-refuse "llm")))
           (ok (hash-ref checked "ok" #f))
           (fair (if ok
                   (try (thing-fair (hash-ref checked "role" "")
                                    (hash-ref checked "size" 0.0) rules)
                        (catch (e)
                          (thing-log "gen" gen "variant" i "gate-error"
                                     (if (string? e) e "?"))
                          (hash "fair" #f "why" "gate"
                                "margin" 0.0 "geometry" 1.0 "budget" 1.0)))
                   (hash "fair" #f "why" (hash-ref checked "why" "shape")
                         "margin" 0.0 "geometry" 1.0 "budget" 1.0)))
           (score (thing-score checked fair text band)))
      (channel:send res
        (list gen i got (thing-elapsed t0)
              (if ok 1 0) (if (hash-ref fair "fair" #f) 1 0) score
              (if ok (hash-ref checked "form" "") "")
              (if llm-ok (hash-ref fair "why" "") (string-append "llm " (hash-ref ans "error" "")))
              (say-line content)
              (hash-ref fair "margin" 0.0) (hash-ref fair "geometry" 1.0) (hash-ref fair "budget" 1.0)))
      #t)))

(define (thing-start! text)
  (if (not (and llm-on thing-res))
    #f
    (let ((n (thing-fibers))
          (rules (rules-hash))
          (b band)
          (t0 (now-ms))
          (timeout-s (+ 2.0 (/ (thing-deadline-ms) 1000.0)))
          (ep (thing-endpoint)))
      ; A new wish closes the round before it. Cancel the previous
      ; round's fibers so their suspended captures cannot pile up or
      ; report into this one.
      (let loop ((fs thing-fids))
        (if (null? fs)
          #f
          (begin
            (try (fiber:cancel (car fs)) (catch (e) #f))
            (loop (cdr fs)))))
      (set! thing-fids (list))
      (set! thing-gen (+ thing-gen 1))
      (set! thing-open #t)
      (set! thing-t0 t0)
      (set! thing-rows (list))
      (set! thing-text text)
      (set! thing-role (wish-role-of text))
      (set! thing-rules (rules-hash))
      (set! thing-band b)
      (set! thing-asked n)
      (set! thing-out n)
      (let ((gen thing-gen) (role thing-role))
        (let loop ((i 0))
          (if (< i n)
            (begin
              (set! thing-fids
                    (cons (fiber:spawn (thing-worker thing-res gen i text role rules b t0 timeout-s ep))
                          thing-fids))
              (loop (+ i 1)))
            #f)))
      (thing-log "gen" thing-gen "start" "fibers" n "role" (if (string=? thing-role "") "any" thing-role))
      (thing-hud! "thinking" (hash "fibers" n "role" thing-role)))))

(define (thing-row-gen r) (list-ref r 0))
(define (thing-row-ms r) (list-ref r 2))

; Every reply waiting on the channel. A reply from an older round, or
; one that came after its round closed, is counted and dropped.
(define (thing-drain!)
  (let loop ()
    (let ((m (channel:try-recv thing-res)))
      (if (and m (pair? m))
        (begin
          (set! thing-out (max 0 (- thing-out 1)))
          (if (and thing-open (= (thing-row-gen m) thing-gen)
                   (<= (thing-row-ms m) (thing-deadline-ms)))
            (set! thing-rows (append thing-rows (list m)))
            (begin
              (set! thing-late (+ thing-late 1))
              (thing-log "gen" (thing-row-gen m) "late" "variant" (list-ref m 1)
                         "ms" (floor (thing-row-ms m)))))
          (loop))
        #f))))

; The workers' own Aura code (prompt checks, check-thing, the autopilot)
; only runs while this fiber yields. One yield a tick is enough for the
; HTTP and the checks to progress. A timed spin of up to 4000 yields
; retained a capture frame per yield while a worker was live; a long run
; then exhausted the arena and wedged the server.
(define (thing-share!)
  (try (fiber:yield) (catch (e) #f)))

(define (thing-poll! c)
  (if (not thing-res)
    #f
    (begin
      ; http-post in a worker only moves while this fiber yields, the same
      ; as the phrase workers. One yield a tick while any worker is out.
      (if (> thing-out 0) (thing-share!) #f)
      (if (> thing-out 0) (thing-drain!) #f)
      (if (and thing-open
               (or (>= (length thing-rows) thing-asked)
                   (> (- (now-ms) thing-t0) (thing-deadline-ms))))
        (thing-close!)
        #f))))

(define (thing-judged-info j)
  (let ((r (list-ref j 2))
        (checked (list-ref j 3))
        (fair (list-ref j 4)))
    (hash "variant" (car j) "ms" (floor (list-ref r 2))
          "checked" (if (hash-ref checked "ok" #f) 1 0)
          "fair" (if (hash-ref fair "fair" #f) 1 0)
          "score" (car (cdr j)) "why" (hash-ref fair "why" ""))))

; The picture is already beside the runner. Do not say the model failed.
(define (thing-kept!)
  (set! thing-quiet #f)
  (thing-hud! "kept" (hash)))

; The round is over. A small novelty bonus breaks an equal score toward
; a form this run has not kept. Record the winner through one evo:trial,
; check it once more on this fiber, and stage it for the next stretch.
; Re-score one worker row on the tick from its checked form. A row's
; later atoms can come back from the runtime mixed with another
; candidate's (a score in the thousands, a constraint that fails the
; trial), so the close reads only the form and asks the same gate again.
(define (thing-rejudge r)
  (let* ((form (list-ref r 7))
         (checked (if (and (string? form) (> (string-length form) 0))
                    (check-thing form)
                    (thing-refuse "shape")))
         (ok (hash-ref checked "ok" #f))
         (fair (if ok
                 (try (thing-fair (hash-ref checked "role" "")
                                  (hash-ref checked "size" 0.0) thing-rules)
                      (catch (e)
                        (thing-log "gen" thing-gen "gate-error"
                                   (if (string? e) e "?"))
                        (hash "fair" #f "why" "gate"
                              "margin" 0.0 "geometry" 1.0 "budget" 1.0)))
                 (hash "fair" #f "why" (hash-ref checked "why" "shape")
                       "margin" 0.0 "geometry" 1.0 "budget" 1.0)))
         (score (thing-score checked fair thing-text thing-band)))
    (list (list-ref r 1) score r checked fair)))

(define (thing-count-judged judged)
  (let loop ((js judged) (n 0))
    (if (null? js)
      n
      (loop (cdr js)
            (if (hash-ref (list-ref (car js) 4) "fair" #f) (+ n 1) n)))))

(define (thing-close!)
  (require "lib/evolve")
  (set! thing-open #f)
  (let* ((rows (thing-in-time thing-rows thing-t0 (+ thing-t0 (thing-deadline-ms))))
         (rows2 (if (null? rows) thing-rows rows))
         (judged (map thing-rejudge rows2))
         (passed (thing-count-judged judged))
         (best (thing-pick (evolve-thing-rows
                             (map (lambda (j) (list (car j) (car (cdr j)) j)) judged)
                             (evolve-thing-memory))))
         (ms (floor (- (now-ms) thing-t0))))
    (let loop ((js judged))
      (if (null? js)
        #f
        (let ((j (car js)))
          (thing-log "gen" thing-gen "cand" (car j) "ms" (floor (list-ref (list-ref j 2) 2))
                     "checked" (if (hash-ref (list-ref j 3) "ok" #f) 1 0)
                     "fair" (if (hash-ref (list-ref j 4) "fair" #f) 1 0)
                     "score" (car (cdr j)) "why" (hash-ref (list-ref j 4) "why" ""))
          (loop (cdr js)))))
    (if (not best)
      (begin
        (thing-log "gen" thing-gen "none" "got" (length rows2) "passed" 0 "ms" ms)
        (if thing-quiet
          (thing-kept!)
          (begin
            (note! "ROLLBACK" (if (null? rows2) "timeout" "unfair") "thing"
                   (wish-line wish-locale (if (null? rows2) "timeout" "shape")) "thing")
            (thing-hud! "none" (hash "got" (length rows2) "passed" 0 "ms" ms
                                     "rows" (map thing-judged-info judged))))))
      (let* ((j (car (cdr (cdr best))))
             (variant (car j))
             (score (car (cdr j)))
             (r (list-ref j 2))
             (checked (list-ref j 3))
             (fair (list-ref j 4))
             (form (hash-ref checked "form" ""))
             (cand (evo:candidate form (hash "id" (string-append "t" (int-str thing-gen) "-" (int-str variant))
                                             "target" "thing-form")))
             (trial (begin
                      (set! trial-open #t)
                      (let ((t (try (evo:trial cand
                                               (hash "timeout-ms" 1500
                                                     "apply" (lambda (c) #t)
                                                     "evaluate"
                                                     (lambda (c)
                                                       (hash "status" "ok"
                                                             "objectives" (hash "fair" 1.0 "score" score)
                                                             "constraints"
                                                             (hash "budget" (hash-ref fair "budget" 1.0)
                                                                   "geometry" (hash-ref fair "geometry" 1.0)
                                                                   "reachable" 0.0 "safe" 0.0)
                                                             "behavior" (hash "band" (exact->inexact band))))))
                                    (catch (e) #f))))
                        (set! trial-open #f)
                        t)))
             (again checked))
        (if (and trial (evo:trial-ok? trial) (evo:feasible? trial) (hash-ref again "ok" #f))
          (begin
            (set! thing-staged
                  (hash "form" (hash-ref again "form" form)
                        "checked" again
                        "say" (list-ref r 9)
                        "score" score
                        "variant" variant
                        "passed" passed
                        "got" (length rows2)
                        "gen" thing-gen))
            (evolve-note-thing! (hash-ref again "form" form))
            (set! thing-chosen-at (now-ms))
            (thing-log "gen" thing-gen "chosen" "variant" variant "score" score
                       "passed" passed "got" (length rows2) "ms" ms)
            (thing-hud! "chosen" (hash "variant" variant "score" score
                                       "passed" passed "got" (length rows2) "ms" ms
                                       "name" (hash-ref again "name" "")
                                       "role" (hash-ref again "role" "")
                                       "rows" (map thing-judged-info judged))))
          (begin
            (thing-log "gen" thing-gen "trial-refused" "variant" variant)
            (if thing-quiet
              (thing-kept!)
              (begin
                (note! "ROLLBACK" "trial" "thing" (wish-line wish-locale "shape") "thing")
                (thing-hud! "none" (hash "got" (length rows2) "passed" passed "ms" ms
                                         "why" "trial"))))))))))

; Update the live thing cell. Returns "set-code" for the caller's log;
; there is no mutate:rebind and no module recompile.
(define (thing-rebind! form)
  (set! thing-src-now form)
  (set! rule-rev (+ rule-rev 1))
  "set-code")

(define (thing-cue-zh role name)
  (cond
    ((string=? role "pickup") "新的宝贝出现在路上")
    ((string=? role "jump") "前面有新的跳跳障碍")
    ((string=? role "slide") "前面有新的滑铲门")
    ((string=? role "decor") "路边长出了新东西")
    ((string=? role "pal") "一个新朋友跑来了")
    (else "新东西来了")))

; Called as a stretch is laid, before its pieces are fixed. This is the
; only place a staged thing goes live.
(define (thing-boundary! id)
  (if (not (hash? thing-staged))
    #f
    (let* ((st thing-staged)
           (form (hash-ref st "form" ""))
           (checked (hash-ref st "checked" #f))
           (how (thing-rebind! form)))
      (set! thing-staged #f)
      (if (string=? how "fail")
        (begin
          (thing-log "gen" (hash-ref st "gen" 0) "install-failed")
          (if thing-quiet
            (thing-kept!)
            (begin
              (note! "ROLLBACK" "commit" "thing" (wish-line wish-locale "shape") "thing")
              (thing-hud! "none" (hash "why" "commit")))))
        (let* ((keep-name (if (string=? thing-shown-name "")
                            (hash-ref checked "name" "")
                            thing-shown-name))
               (pub (hash-set (thing-public checked (hash-ref st "gen" 0)) "name" keep-name))
               (quiet thing-quiet))
          (set! thing-prev thing-live)
          (set! thing-live (hash "form" form "public" pub "from" id
                                 "role" (hash-ref checked "role" "")
                                 "gen" (hash-ref st "gen" 0)))
          (set! thing-bumps 0)
          (if quiet
            (set! shown (hash-ref (shown-put shown pub) "rows" shown))
            #f)
          (set! thing-quiet #f)
          (set! rules-dirty #t)
          (set! rules-thin #t)
          (thing-log "gen" (hash-ref st "gen" 0) "installed" "via" how "chunk" id
                     "ms" (floor (- (now-ms) thing-t0))
                     "wait" (floor (- (now-ms) thing-chosen-at)))
          (note! "KEEP" "fair" "thing"
                 (cond
                   (quiet
                    (if (string=? wish-locale "zh") "样子更细了" "A finer look"))
                   ((string=? wish-locale "zh")
                    (thing-cue-zh (hash-ref checked "role" "") (hash-ref checked "name" "")))
                   (else
                    (let ((say (hash-ref st "say" "")))
                      (if (> (string-length say) 0) say "A new thing came along"))))
                 "thing")
          (thing-hud! "live" (hash "via" how "chunk" id
                                   "ms" (floor (- (now-ms) thing-t0))
                                   "variant" (hash-ref st "variant" 0)
                                   "score" (hash-ref st "score" 0.0)
                                   "passed" (hash-ref st "passed" 0)
                                   "got" (hash-ref st "got" 0))))))))

(define (thing-rollback! why)
  (if (not (hash? thing-live))
    #f
    (let* ((back (if (hash? thing-prev) (hash-ref thing-prev "form" "") ""))
           (how (thing-rebind! back)))
      (thing-log "gen" (hash-ref thing-live "gen" 0) "rollback" why "via" how)
      (set! thing-live (if (hash? thing-prev)
                         (hash "form" back "public" (hash-ref thing-prev "public" #f)
                               "from" next-id "role" (hash-ref thing-prev "role" "")
                               "gen" (hash-ref thing-prev "gen" 0))
                         #f))
      (set! thing-prev #f)
      (set! thing-bumps 0)
      (set! rules-dirty #t)
      (set! rules-thin #t)
      (note! "ROLLBACK" why "thing"
             (if (string=? wish-locale "zh") "换回了上一个样子" "The previous look came back")
             "thing")
      (thing-hud! "rollback" (hash "why" why)))))

(define (chunk-id-at x)
  (let loop ((cs chunks))
    (if (null? cs)
      -1
      (let ((ch (car cs)))
        (if (and (>= x (hash-ref ch "x0" 0.0)) (< x (hash-ref ch "x1" 0.0)))
          (hash-ref ch "id" -1)
          (loop (cdr cs)))))))

; A stumble on one of the first three stretches that carry a new hurdle
; or gate counts against it. Two put the previous thing back.
(define (thing-watch! ev)
  (if (and (hash? thing-live)
           (or (string=? ev "bump") (string=? ev "oops"))
           (or (string=? (hash-ref thing-live "role" "") "jump")
               (string=? (hash-ref thing-live "role" "") "slide")))
    (let ((id (chunk-id-at (player-x player)))
          (from (hash-ref thing-live "from" 0)))
      (if (and (>= id from) (< id (+ from 3)))
        (begin
          (set! thing-bumps (+ thing-bumps 1))
          (if (>= thing-bumps 2) (thing-rollback! "bumps") #f))
        #f))
    #f))

(define (thing-for-chunk id)
  (if (and (hash? thing-live) (>= id (hash-ref thing-live "from" 0)))
    (hash-ref thing-live "public" #f)
    #f))

(define (on-thing-bad c msg)
  (let ((gen (hash-ref msg "gen" -1)))
    (if (and (hash? thing-live) (number? gen) (= gen (hash-ref thing-live "gen" -2)))
      (thing-rollback! "render")
      #f)
    (flush-notes! c)))

(define (wish-waiting? arm)
  (cond
    ((string=? arm "scene") (pair? wait-scene))
    ((string=? arm "pals") (pair? wait-pals))
    (else (pair? wait-motif))))

; The words are never the form. A bright line changes the picture at
; once, whether or not a model is awake. A gloomy line does not.
(define (voice-hear intent)
  (if (string=? wish-locale "zh")
    (hash-ref intent "zh" "")
    (hash-ref intent "en" "")))

; A matched sentence changes the picture here. It does not ask the model.
(define (voice-apply! intent)
  (let ((act (hash-ref intent "act" ""))
        (name (hash-ref intent "name" ""))
        (dir (hash-ref intent "dir" 0)))
    (cond
      ((string=? act "add-prop")
       (let loop ((xs (voice-parts name)) (cur props) (why "name") (ok #f) (saw-sun #f))
         (if (null? xs)
           (begin
             (set! props cur)
             (if (and saw-sun ok) (set! sun-hide #f) #f)
             (set! rules-dirty #t)
             (set! rules-thin #f)
             (note! (if ok "KEEP" "ROLLBACK") why "voice"
                    (voice-line act name why wish-locale)))
           (let ((got (voice-put cur (car xs))))
             (loop (cdr xs)
                   (hash-ref got "props" cur)
                   (if (hash-ref got "ok" #f) "fair" (if ok why (hash-ref got "why" "name")))
                   (or ok (hash-ref got "ok" #f))
                   (or saw-sun (and (string=? (car xs) "sun") (hash-ref got "ok" #f))))))))
      ((string=? act "drop-prop")
       (let loop ((xs (voice-parts name)) (cur props) (hid #f) (cut-any #f))
         (if (null? xs)
           (if (or hid cut-any)
             (begin
               (set! props cur)
               (if hid (set! sun-hide #t) #f)
               (set! rules-dirty #t)
               (set! rules-thin #f)
               (note! "KEEP" "fair" "voice" (voice-line act name "fair" wish-locale)))
             (note! "ROLLBACK" "missing" "voice"
                    (voice-line act name "missing" wish-locale)))
           (let ((one (car xs))
                 (got (voice-cut cur (car xs))))
             (if (hash-ref got "ok" #f)
               (loop (cdr xs) (hash-ref got "props" cur) (or hid (string=? one "sun")) #t)
               (if (and (string=? one "sun") (not sun-hide))
                 (loop (cdr xs) cur #t cut-any)
                 (loop (cdr xs) cur hid cut-any)))))))
      ((string=? act "drop-pal")
       (let loop ((xs (voice-parts name)) (rows pals-rows) (n 0) (why "missing"))
         (if (null? xs)
           (if (= n 0)
             (note! "ROLLBACK" why "pals"
                    (voice-line act name why wish-locale))
             (let ((say (voice-line act name "fair" wish-locale)))
               (keep-pals! (roster-text rows hero-now)
                           (hash "ok" #t "why" "fair" "rows" rows "cue" say)
                           say hero-now #f)))
           (let ((cut (drop-kind rows (car xs))))
             (if (hash-ref cut "ok" #f)
               (loop (cdr xs) (hash-ref cut "rows" rows) (+ n 1) "fair")
               (loop (cdr xs) rows n
                     (if (string=? why "fair") why (hash-ref cut "why" "missing"))))))))
      ; The whole roster goes home, including the last friend. Cars that
      ; roll in on their own stay away for this run.
      ((string=? act "drop-pals")
       (if (null? pals-rows)
         (note! "ROLLBACK" "missing" "voice"
                (voice-line act name "missing" wish-locale))
         (begin
           (set! pals-rows (list))
           (set! pals-now (roster-text (list) hero-now))
           (set! guest-at 4)
           (set! rules-dirty #t)
           (set! rules-thin #f)
           (note! "KEEP" "fair" "pals"
                  (voice-line act name "fair" wish-locale)
                  "friend"))))
      ((string=? act "speed")
       (let ((next (voice-speed-next speed-now dir)))
         (if (< (voice-abs (- next speed-now)) 0.05)
           (note! "KEEP" "same" "voice" (voice-line act "" "same" wish-locale))
           (begin
             (set! speed-lock #t)
             (set! speed-now next)
             (apply-feel! "voice" (voice-hear intent))))))
      ((string=? act "form")
       (let ((next (voice-form-step form dir)))
         (if (= next form)
           (note! "KEEP" "same" "voice" (voice-line act "" "same" wish-locale))
           (begin
             (set! form next)
             (set! pace next)
             (set! band next)
             (apply-feel! "voice" (voice-hear intent))))))
      ((string=? act "goal")
       (set! level-x1 (voice-goal (player-x player) level-x0 level-x1 dir))
       (set! goal-lock #t)
       (set! rules-dirty #t)
       (set! rules-thin #f)
       (note! "KEEP" "fair" "voice" (voice-hear intent)))
      ((string=? act "hero")
       (let ((kind (if (string? name) name "")))
         (if (not (hero-kind-ok? kind))
           (note! "ROLLBACK" "kind" "pals"
                  (voice-line act name "missing" wish-locale))
           (consider-pals! (hero-src kind)
                           (voice-line act name "fair" wish-locale)))))
      ((or (string=? act "biome") (string=? act "biome-next") (string=? act "mood"))
       (let* ((mood? (string=? act "mood"))
              (next (cond
                      (mood? (mood-known name))
                      ((string=? act "biome-next") (biome-next biome-now))
                      (else (biome-known name))))
              (cur (if mood? mood-now biome-now))
              (same (string=? next cur)))
         (if same
           (begin
             (if mood? #f (pin-builtin! next))
             (raise-banner! (if mood? "mood" "venue")
                            (if mood?
                              (venue-line next run-mult wish-locale)
                              (world-banner next wish-locale))
                            0)
             (note! "KEEP" "same" "voice"
                    (voice-line act next "same" wish-locale) next))
           (begin
             (if mood?
               (set! mood-now next)
               (pin-builtin! next))
             (raise-banner! (if mood? "mood" "venue")
                            (if mood?
                              (venue-line next run-mult wish-locale)
                              (world-banner next wish-locale))
                            0)
             (note! "KEEP" "fair" "voice"
                    (voice-line act next "fair" wish-locale) next)))))
      ((string=? act "music-next")
       (note! "KEEP" "fair" "music" (voice-line act "" "fair" wish-locale)))
      ((string=? act "drop-thing")
       (let ((got (shown-drop shown name)))
         (if (not (hash-ref got "ok" #f))
           (note! "ROLLBACK" "missing" "voice"
                  (voice-line act name "missing" wish-locale))
           (begin
             (set! shown (hash-ref got "rows" shown))
             (let ((pub (if (hash? thing-live) (hash-ref thing-live "public" #f) #f))
                   (gone (hash-ref got "name" "")))
               (if (and (hash? pub) (string=? gone (hash-ref pub "name" "")))
                 (set! thing-live #f)
                 #f))
             (set! rules-dirty #t)
             (set! rules-thin #t)
             (note! "KEEP" "fair" "voice" (voice-line act name "fair" wish-locale))))))
      (else #f))))

; Place a toy before the model answers. The picture goes out on the wire
; even when rebind is skipped because a chat is already in flight.
(define (thing-show! text)
  (let ((form (compose-thing text)))
    (if (not (string? form))
      #f
      (let ((checked (check-thing form)))
        (if (not (and (hash? checked) (hash-ref checked "ok" #f)))
          #f
          (begin
            (set! thing-gen (+ thing-gen 1))
            (let ((pub (thing-public checked thing-gen)))
              (set! thing-shown-name (hash-ref pub "name" ""))
              (set! shown (hash-ref (shown-put shown pub) "rows" (list)))
              (set! thing-prev thing-live)
              (set! thing-live (hash "form" form "public" pub "from" next-id
                                     "role" (hash-ref checked "role" "")
                                     "gen" thing-gen))
              (set! thing-quiet (if (and llm-on thing-res) #t #f))
              (set! thing-bumps 0)
              (set! rules-dirty #t)
              (set! rules-thin #t)
              (if (not (or (llm-posting?) (chat-open?)))
                (thing-rebind! form)
                #f)
              (note! "KEEP" "fair" "thing"
                     (compose-line (hash-ref pub "name" "") wish-locale)
                     "thing")
              #t)))))))

; The words are never the form. A known sky, star, gate, or friend
; changes at once, whether or not a model is awake. Any other garden
; sentence is asked of the model when one is awake, because the garden
; is not dreamed on a clock. With no model, that sentence still paints
; a known garden. A gloomy line does not.
(define (ask-model-wish! text)
  (set! wish-open #t)
  (set! wish-queued #t)
  (set! wish-text text)
  (set! wish-kind (wish-arm text))
  (set! wish-prompt (wish-user text))
  (set! wish-think #f)
  (wish-note! "SAY" "soon"))

(define (offer-wish! text)
  (if (and llm-on
           (string=? (wish-arm text) "scene")
           (not (wish-preset text))
           (not (wish-named text)))
    (ask-model-wish! text)
    (let ((row (wish-with-lang (wish-answer text sky-r sky-g sky-b) wish-locale)))
      (if (not row)
        (wish-note! "ROLLBACK" "shape")
        (begin
          (apply-offline! row)
          (if (wish-waiting? (hash-ref row "arm" "scene"))
            (wish-note! "SAY" "soon")
            #f)))))
  ; The local cake used to be composed on this tick for a placeholder.
  ; That compose is a tree-walker pass and cost 0.5-1.4 s; with a model
  ; up the round's own reply is the cake, so let it land instead.
  (if (and (compose-wanted? text) (not llm-on)) (thing-show! text) #f)
  (thing-start! text))

; The line a child reads when a place does not change.
(define (world-stay)
  (if (string=? wish-locale "zh")
    "还是原来的世界"
    "The world stayed"))

; 换一个城市 is a venue steer and is handled before this. A bare
; 换一个 asks the kept worlds for one child. It does not share the
; offline wish path, so the offer cap stays its own counter.
(define (grow-ask? text)
  (and (string? text)
       (or (string=? text "换一个")
           (string=? text "再换一个")
           (string=? (string-downcase text) "another world"))))

; Sky, friend, star, and gate lines stay on the wish they already had.
; A bare sentence with none of those words is a world, not an obstacle.
(define (wish-keep? text)
  (or (wish-preset text)
      (wish-named text)
      (let ((arm (wish-arm text)))
        (or (string=? arm "scene") (string=? arm "pals")))
      (edsl-motif-line? text)))

(define (preview-show! text)
  (let ((found (edsl-check text)))
    (if (not (and (hash? found) (hash-ref found "ok" #f)))
      #f
      (begin
        (if (not (pair? wish-hold))
          (set! wish-hold (list biome-now edsl-form edsl-spec (if biome-pin #t #f)))
          #f)
        (set! biome-now (hash-ref found "id"))
        (set! edsl-form (hash-ref found "form"))
        (set! edsl-spec (if (string=? (hash-ref found "recipe" "") "mix")
                          (edsl-pub found)
                          #f))
        (set! rules-dirty #t)
        (set! rules-thin #f)
        #t))))

(define (preview-drop!)
  (set! wish-hold #f))

(define (preview-back!)
  (if (not (pair? wish-hold))
    #f
    (let ((held wish-hold))
      (set! biome-now (car held))
      (set! edsl-form (car (cdr held)))
      (set! edsl-spec (car (cdr (cdr held))))
      (set! biome-pin (car (cdr (cdr (cdr held)))))
      (set! wish-hold #f)
      (set! rules-dirty #t)
      (set! rules-thin #f)
      #t)))

(define (wish-commit! text)
  (let ((found (edsl-check text)))
    (if (not (and (hash? found) (hash-ref found "ok" #f)))
      #f
      (consider-edsl! text (edsl-say (hash-ref found "id" "") wish-locale) #t #t))))

; The offline world is already kept. A model may refine a named place
; or an open 去. Gibberish stays on the hash, so a key cannot change it.
(define (maybe-refine! text full)
  (set! edsl-accept -1)
  (set! edsl-busy #f)
  (set! edsl-fallback-form full)
  (if (and llm-on edsl-req (not edsl-working) (not (llm-posting?))
           (or (edsl-shaped? text) (edsl-open-place? text)))
    (begin
      (set! edsl-hint text)
      (set! edsl-theme-now "free")
      (set! edsl-enter? #t)
      (ask-edsl!))
    (begin
      (set! edsl-hint "")
      (set! edsl-theme-now ""))))

(define (wish-world! c text)
  (load-slow!)
  (let ((full (edsl-offline text (if (pair? edsl-pool) edsl-pool (list)))))
    (let ((found (if (string? full) (edsl-check full) #f)))
      (if (not (and (hash? found) (hash-ref found "ok" #f)))
        (note! "ROLLBACK" "shape" "biome" (world-stay) "world")
        (begin
          (let ((tint (edsl-tint text full)))
            (preview-show! (if (string? tint) tint full)))
          (send c (rules-msg))
          (set! rules-dirty #f)
          (if (wish-commit! full)
            (begin
              (preview-drop!)
              (set! edsl-held #t)
              (maybe-refine! text full))
            (preview-back!)))))))

(define (on-wish c msg)
  (set! wish-locale (wish-lang (hash-ref msg "lang" "")))
  (if (wish-has-audio? msg)
    (wish-note! "ROLLBACK" "audio")
    (let ((text (wish-clean (hash-ref msg "text" "")))
          (source (wish-source (hash-ref msg "source" ""))))
      (cond
        ((string=? source "") (wish-note! "ROLLBACK" "hear"))
        ((string=? text "") (wish-note! "ROLLBACK" "empty"))
        ((banned? text) (wish-note! "ROLLBACK" "banned"))
        ((grow-ask? text)
         (if (or (llm-posting?) (chat-open?) trial-open)
           (note! "ROLLBACK" "busy" "biome" (world-stay) "world")
           (archive-offer! #t)))
        ((edsl-free-form text) (wish-world! c text))
        (else
         ; A named city comes before the built-in voice. 下一个城市
         ; contains 城市, and 北京的夜晚 contains 夜晚.
         (let ((steer (edsl-steer text biome-now)))
           (if steer
             (edsl-hear! steer)
             (let ((intent (voice-intent text)))
               (if intent
                 (voice-apply! intent)
                 (let ((theme (edsl-place text biome-now)))
                   (if theme
                     (edsl-hear! theme)
                     (if (wish-keep? text)
                       (offer-wish! text)
                       (wish-world! c text))))))))))))
  (flush-notes! c)
  (if rules-dirty
    (send-rules! c)
    #f))

(define (poll-llm! c)
  (if (not llm-on)
    #f
    (begin
      ; A reply can land on a tick before the deferred modules have been
      ; walked in. Those checks live in the modules, so load them first.
      (load-slow!)
      (flush-deferred!)
      ; try-recv only while a call is outstanding. An idle poll retains a
      ; capture frame per tick on this pin and a long run exhausts the
      ; arena. http-post only notices its timeout if this fiber yields.
      ; One yield is enough for a live call. After the watchdog the garden
      ; worker is still inside http-post with scene-busy already clear, so
      ; that overdue call gets a short burst. A normal turn does not spin.
      (if (and scene-working (not stall-waiting)
               (> scene-asked-at 0.0)
               (> (- (monotonic-ms) scene-asked-at) (watchdog-ms)))
        (let spin ((k 30))
          (if (<= k 0)
            #t
            (begin (try (fiber:yield) (catch (e) #f)) (spin (- k 1)))))
        (if (or scene-busy motif-busy pals-busy edsl-busy
                scene-working motif-working pals-working edsl-working)
          (try (fiber:yield) (catch (e) #f))
          #f))
      (if (or scene-busy motif-busy pals-busy edsl-busy) (expire-llm!) #f)
      ; wish-wait still owes one reply. Read it so the late token can
      ; clear the wait. An idle arm is not polled; that retains a frame.
      (if (or (and scene-busy (not stall-waiting))
              (and wish-wait (string=? wish-kind "scene")))
        (let ((scene-msg (reply-hash (channel:try-recv scene-res))))
          (if (hash? scene-msg) (take-scene! c scene-msg) #f))
        #f)
      (if (or motif-busy (and wish-wait (string=? wish-kind "motif")))
        (let ((motif-msg (reply-hash (channel:try-recv motif-res))))
          (if (hash? motif-msg) (take-motif! c motif-msg) #f))
        #f)
      (if (or pals-busy (and wish-wait (string=? wish-kind "pals")))
        (let ((pals-msg (reply-hash (channel:try-recv pals-res))))
          (if (hash? pals-msg) (take-pals! c pals-msg) #f))
        #f)
      (if edsl-busy
        (let ((biome-msg (reply-hash (channel:try-recv edsl-res))))
          (if (hash? biome-msg) (take-edsl! c biome-msg) #f))
        #f)
      (sync-llm-busy!)
      ; The take above may be the moment the slot freed. Score the waiting
      ; phrase on this tick, before another ask marks an arm busy again.
      (flush-deferred!)
      ; The child's wish goes out before another automatic ask can take
      ; the same slot. A wish already in flight, or a late reply still
      ; owed by that worker, holds the automatic asks off.
      (maybe-wish!)
      (if (or (pair? wait-motif) (pair? wait-scene) (pair? wait-pals)
              wish-queued wish-flight wish-wait)
        #f
        (begin
          ; The garden changes with the level, from how the run went, or
          ; when the child asks. It is not dreamed on a clock.
          ; The watchdog test is the one caller that still asks on a
          ; timer: it parks that first garden call and still wants a
          ; later one, with obstacle phrases in between.
          (if (and (env-on? "LUMEN_STALL_SCENE")
                   (not scene-busy) (not scene-working) (>= run-ms scene-next))
            (ask-scene!)
            #f)
          ; A held phrase seals only while no chat is in flight. Another
          ; obstacle ask would keep this arm busy and the sentence would wait.
          (if (and (= hold-phase 0)
                   (not motif-busy) (not motif-working) (>= run-ms motif-next))
            (ask-motif!)
            #f)
          ; The watchdog test parks one garden call and still expects
          ; obstacle phrases. A companion call beside both of those wedges
          ; llm:chat on this pin, so that test leaves the roster alone.
          (if (and (not pals-busy) (not pals-working)
                   (not (env-on? "LUMEN_STALL_SCENE"))
                   (>= run-ms pals-next))
            (ask-pals!)
            #f)
          ; A world is not dreamed on a clock. A clear steps the venue
          ; with the level, and a sentence from the child installs the
          ; place they named.
          )))))

; Exact 0..4. pace and the feel table compare with =, so an inexact
; 2.0 would miss every row and fall through to the top band.
(define (form-exact n)
  (cond
    ((not (number? n)) 0)
    ((< n 0.5) 0)
    ((< n 1.5) 1)
    ((< n 2.5) 2)
    ((< n 3.5) 3)
    (else 4)))

(define (level-exact n)
  (if (not (number? n))
    1
    (let loop ((k 1))
      (if (or (>= k 40) (< n (+ k 0.5)))
        k
        (loop (+ k 1))))))

(define (points-clamp n)
  (cond
    ((not (number? n)) 0.0)
    ((<= n 0.0) 0.0)
    ((>= n 500000.0) 500000.0)
    (else (exact->inexact n))))

; A saved mix comes back from its form. A built-in name does not load
; the EDSL. A normal garden hello must stay on the fast path.
(define (install-saved-spec! spec)
  (if (not (hash? spec))
    #f
    (begin
      (load-slow!)
      (let ((form (hash-ref spec "form" "")))
        (if (and (string? form) (> (string-length form) 0) (edsl-enter-kept! form))
          #t
          #f)))))

(define (install-biome-name! b pin?)
  (cond
    ((biome-name? b)
     (begin
       (edsl-clear!)
       (set! biome-now b)
       (set! biome-pin pin?)
       #t))
    ((and (string? b) (> (string-length b) 0))
     (begin
       (load-slow!)
       (if (not (edsl-id? b))
         #f
         (let ((preset (edsl-preset b)))
           (if (string? preset)
             (edsl-enter-kept! preset)
             (begin
               (edsl-clear!)
               (set! biome-now b)
               (set! biome-pin #t)
               #t))))))
    (else #f)))

(define (resume-custom? row)
  (or (hash? (hash-ref row "spec" #f))
      (let ((b (hash-ref row "biome" #f)))
        (and (string? b) (> (string-length b) 0) (not (biome-name? b))))))

; A saved run rebuilds the road at that form. A blank record stays on
; the road reset-run! just laid. Restart never calls this. A custom
; world at the start of a run still resumes, or a refresh would
; become the garden.
(define (resume-run! msg)
  (let ((row (hash-ref msg "resume" #f)))
    (if (not (hash? row))
      #f
      (let ((lv (level-exact (hash-ref row "level" 1)))
            (fm (form-exact (hash-ref row "form" 0)))
            (pts (points-clamp (hash-ref row "points" 0))))
        (if (and (= lv 1) (= fm 0) (<= pts 0.0) (not (resume-custom? row)))
          #f
          (begin
            (set! world (list))
            (set! live-st (live-blank))
            (set! staged-chunk #f)
            (set! chunks (list))
            (set! next-id 0)
            (set! next-x 0.0)
            (set! sent-id 0)
            (set! rival-for 0)
            (set! level-bumps 0)
            (set! form fm)
            (set! level-n lv)
            (set! pace fm)
            (set! band fm)
            (set! player (pset player 6 pts))
            (set! run-mult (mult-clamp (if (number? (hash-ref row "mult" #f))
                                         (hash-ref row "mult")
                                         lv)))
            (if (not (install-saved-spec! (hash-ref row "spec" #f)))
              (let ((b (hash-ref row "biome" #f)))
                (if (not (install-biome-name! b #t))
                  (set! biome-now (biome-for-level lv))
                  #f))
              #f)
            (let ((m (hash-ref row "mood" #f)))
              (if (mood-name? m) (set! mood-now m) #f))
            (set! chal-coins 0)
            (set! chal-done #f)
            (let ((f (feel-for band)))
              (set! g-now (gravity-now f))
              (set! jump-now (feel-jump f))
              (set! slide-now (feel-slide f))
              (if (not speed-lock) (set! speed-now (feel-speed f)) #f))
            ; Numbers already match, so this publishes them and does not
            ; toast a speed change the runner already had.
            (set! feel-cue "")
            (apply-feel! "pace")
            (begin-level!)))))))

; A new hello or restart starts a fresh trunk. Older branches stay.
(define (world-trunk!)
  (set! world-tree (hash "nodes" (hash-ref world-tree "nodes" (list))
                         "tip" ""
                         "n" (hash-ref world-tree "n" 0))))

(define (capture-run!)
  (hash "g" g-now "jump" jump-now "slide" slide-now "speed" speed-now
        "air" air-now "magnet" magnet-now "hue" hue-now
        "coyote" coyote-now "forgive" forgive-now
        "motif" motif-now "pieces" motif-pieces "span" motif-span
        "scene" scene-now
        "sky-r" sky-r "sky-g" sky-g "sky-b" sky-b
        "ground-r" ground-r "ground-g" ground-g "ground-b" ground-b
        "flower" flower-now "density" density-now "light" light-now "fog" fog-now
        "pals" pals-now "rows" pals-rows "hero" hero-now
        "bend" bend-now "loot" loot-now
        "deck" deck-ids "g-lock" g-lock "g-held" g-held "speed-lock" speed-lock
        "seed" seed "level" level-n "form" form "pace" pace "band" band
        "mult" run-mult "biome" biome-now "mood" mood-now "edsl" edsl-form "pin" biome-pin
        "chal-coins" chal-coins "chal-done" chal-done
        "banner-id" banner-id "banner-kind" banner-kind
        "banner-text" banner-text "banner-gain" banner-gain
        "chase" chase "recent" chase-recent "spread" coin-params
        "card-phase" card-phase "hold-phase" hold-phase
        "primer-phase" primer-phase
        "dream-phase" dream-phase "chase-phase" chase-phase
        "chase-plan" chase-plan "card-spec" card-spec "hold-form" hold-form
        "dream-form" dream-form
        "via" publish-via "rev" rule-rev "dirty" rules-dirty
        "pressure" pressure-now "streak" level-streak "skill-seen" skill-seen
        "hearts" run-hearts "defeats" run-defeats "over" run-over))

(define (restore-run! saved)
  (set! g-now (hash-ref saved "g"))
  (set! jump-now (hash-ref saved "jump"))
  (set! slide-now (hash-ref saved "slide"))
  (set! speed-now (hash-ref saved "speed"))
  (set! air-now (hash-ref saved "air"))
  (set! magnet-now (hash-ref saved "magnet"))
  (set! hue-now (hash-ref saved "hue"))
  (set! coyote-now (hash-ref saved "coyote"))
  (set! forgive-now (hash-ref saved "forgive"))
  (set! motif-now (hash-ref saved "motif"))
  (set! motif-pieces (hash-ref saved "pieces"))
  (set! motif-span (hash-ref saved "span"))
  (set! scene-now (hash-ref saved "scene"))
  (set! sky-r (hash-ref saved "sky-r"))
  (set! sky-g (hash-ref saved "sky-g"))
  (set! sky-b (hash-ref saved "sky-b"))
  (set! ground-r (hash-ref saved "ground-r"))
  (set! ground-g (hash-ref saved "ground-g"))
  (set! ground-b (hash-ref saved "ground-b"))
  (set! flower-now (hash-ref saved "flower"))
  (set! density-now (hash-ref saved "density"))
  (set! light-now (hash-ref saved "light"))
  (set! fog-now (hash-ref saved "fog"))
  (set! pals-now (hash-ref saved "pals"))
  (set! pals-rows (hash-ref saved "rows"))
  (set! hero-now (hash-ref saved "hero"))
  (set! bend-now (hash-ref saved "bend"))
  (set! loot-now (hash-ref saved "loot"))
  (set! deck-ids (hash-ref saved "deck"))
  (set! g-lock (hash-ref saved "g-lock"))
  (set! g-held (hash-ref saved "g-held"))
  (set! speed-lock (hash-ref saved "speed-lock"))
  (set! seed (hash-ref saved "seed"))
  (set! level-n (hash-ref saved "level"))
  (set! run-mult (mult-clamp (hash-ref saved "mult" 1)))
  (let ((named (hash-ref saved "biome" "garden")))
    (set! biome-now (if (world-id? named) named (biome-known named))))
  (let ((kept (hash-ref saved "edsl" "")))
    (if (and (string? kept) (> (string-length kept) 0) (edsl-enter-kept! kept))
      #f
      (edsl-clear!)))
  (set! mood-now (mood-known (hash-ref saved "mood" "day")))
  (set! biome-pin (equal? (hash-ref saved "pin" #f) #t))
  (set! chal-coins (if (number? (hash-ref saved "chal-coins" 0)) (floor (hash-ref saved "chal-coins" 0)) 0))
  (set! chal-done (equal? (hash-ref saved "chal-done" #f) #t))
  (set! banner-id (if (number? (hash-ref saved "banner-id" 0)) (floor (hash-ref saved "banner-id" 0)) 0))
  (set! banner-kind (if (string? (hash-ref saved "banner-kind" "")) (hash-ref saved "banner-kind" "") ""))
  (set! banner-text (if (string? (hash-ref saved "banner-text" "")) (hash-ref saved "banner-text" "") ""))
  (set! banner-gain (if (number? (hash-ref saved "banner-gain" 0)) (floor (hash-ref saved "banner-gain" 0)) 0))
  (set! form (hash-ref saved "form"))
  (set! pace (hash-ref saved "pace"))
  (set! band (hash-ref saved "band"))
  (set! chase (hash-ref saved "chase"))
  (set! chase-recent (hash-ref saved "recent"))
  (load-coins!)
  (set! coin-params (let ((row (hash-ref saved "spread" #f)))
                      (if (and (hash? row) (coin-bounds? row)) row (coin-blank))))
  (set! card-phase (hash-ref saved "card-phase"))
  (set! primer-phase (hash-ref saved "primer-phase"))
  (set! hold-phase (hash-ref saved "hold-phase"))
  (set! dream-phase (hash-ref saved "dream-phase"))
  (set! chase-phase (hash-ref saved "chase-phase"))
  (set! chase-plan (hash-ref saved "chase-plan"))
  (set! card-spec (hash-ref saved "card-spec"))
  (set! hold-form (hash-ref saved "hold-form"))
  (set! dream-form (hash-ref saved "dream-form"))
  (set! publish-via (hash-ref saved "via"))
  (set! rule-rev (hash-ref saved "rev"))
  (set! rules-dirty (hash-ref saved "dirty"))
  (set! pressure-now (let ((n (hash-ref saved "pressure" 1))) (if (number? n) n 1)))
  (set! level-streak (let ((n (hash-ref saved "streak" 0))) (if (number? n) n 0)))
  (set! run-hearts (let ((n (hash-ref saved "hearts" 3))) (if (number? n) (max 0 (min 3 (floor n))) 3)))
  (set! run-defeats (let ((n (hash-ref saved "defeats" 0))) (if (number? n) (max 0 (min 4 (floor n))) 0)))
  (set! run-over (equal? (hash-ref saved "over" #f) #t))
  (set! skill-seen (let ((n (hash-ref saved "skill-seen" 0.0))) (if (number? n) n 0.0)))
  (set! rewind-quiet #f))

(define (clear-slices!)
  (set! card-phase 0)
  (set! primer-phase 0)
  (set! hold-phase 0)
  (set! dream-phase 0)
  (set! chase-phase 0)
  (set! chase-plan #f)
  (set! card-spec #f)
  (set! hold-form "")
  (set! dream-form "")
  (set! gate-followups (list)))

(define (how-ok? how)
  (and (string? how) (not (string=? how "fail"))))

(define (publish-phrase! name body)
  (let ((how (publish-rule! name body (full-src))))
    (set! publish-via how)
    (set! rule-rev (+ rule-rev 1))
    (set! rules-dirty #t)
    (set! rules-thin #f)
    how))

(define (publish-world!)
  (and (how-ok? (publish-named! "rule-gravity" g-now))
       (how-ok? (publish-named! "rule-jump-v" jump-now))
       (how-ok? (publish-named! "rule-slide-s" slide-now))
       (how-ok? (publish-named! "rule-run-speed" speed-now))
       (how-ok? (publish-named! "rule-hue" hue-now))
       (how-ok? (publish-named! "rule-double-jump" air-now))
       (how-ok? (publish-named! "rule-magnet" magnet-now))
       (how-ok? (publish-named! "rule-coyote-s" coyote-now))
       (how-ok? (publish-named! "rule-forgive" forgive-now))
       (how-ok? (publish-phrase! "motif-form" (motif-body motif-now)))
       (how-ok? (publish-phrase! "scene-form" (scene-body scene-now)))
       (how-ok? (publish-phrase! "pals-form" (pals-body pals-now)))))

(define (scene-install! text)
  (let ((form (if (and (string? text) (> (string-length text) 0)) text default-scene)))
    (let ((found (check-scene form)))
      (if (not (and (hash? found) (hash-ref found "ok" #f)))
        #f
        (begin (apply-scene! found form) #t)))))

(define (pals-install! text)
  (let ((form (if (and (string? text) (> (string-length text) 0)) text default-pals)))
    (if (string=? form "(pals)")
      (begin
        (set! pals-now "(pals)")
        (set! pals-rows (list))
        (set! hero-now #f)
        #t)
      (let ((found (check-roster form)))
        (if (not (and (hash? found) (hash-ref found "ok" #f)))
          #f
          (begin
            (set! pals-now form)
            (set! pals-rows (hash-ref found "pals" (list)))
            (set! hero-now (hash-ref found "hero" #f))
            #t))))))

(define (motif-install! text)
  (if (not (and (string? text) (> (string-length text) 0)))
    (begin
      (set! motif-now "")
      (set! motif-pieces (list))
      (set! motif-span 0.0)
      #t)
    (let ((laid (layout-form text (rules-hash))))
      (if (not (layout-fair? laid))
        #f
        (begin
          (set! motif-now text)
          (set! motif-pieces (hash-ref laid "pieces" (list)))
          (set! motif-span (hash-ref laid "x1" 0.0))
          #t)))))

(define (apply-snap! snap)
  (if (not (world-snap-ok? snap))
    #f
    (begin
      (set! g-now (exact->inexact (hash-ref snap "g")))
      (set! jump-now (exact->inexact (hash-ref snap "jump")))
      (set! slide-now (exact->inexact (hash-ref snap "slide")))
      (set! speed-now (exact->inexact (hash-ref snap "speed")))
      (set! air-now (exact->inexact (hash-ref snap "air")))
      (set! magnet-now (exact->inexact (hash-ref snap "magnet")))
      (set! hue-now (exact->inexact (hash-ref snap "hue")))
      (set! coyote-now (exact->inexact (hash-ref snap "coyote")))
      (set! forgive-now (exact->inexact (hash-ref snap "forgive")))
      (set! loot-now (hash-ref snap "loot"))
      (set! bend-now (exact->inexact (hash-ref snap "bend")))
      (set! seed (exact->inexact (hash-ref snap "seed")))
      (set! level-n (level-exact (hash-ref snap "level")))
      (set! form (form-exact (hash-ref snap "form")))
      (set! pace (form-exact (hash-ref snap "pace")))
      (set! band (form-exact (hash-ref snap "band")))
      (let ((ids (world-deck snap)))
        (set! deck-ids (if (pair? ids) ids (list)))
        (set! g-lock (has-id? deck-ids "light")))
      (set! g-held
        (if (and g-lock (> (world-abs (- g-now CARD-LIGHT-G)) 0.05))
          g-now
          (if (and (not g-lock) (> (world-abs (- g-now (feel-g (feel-for form)))) 0.2))
            g-now
            #f)))
      (set! speed-lock (> (world-abs (- speed-now (feel-speed (feel-for form)))) 0.2))
      (set! chase (hash "speed" (exact->inexact (hash-ref snap "chase-speed"))
                        "cool" (exact->inexact (hash-ref snap "chase-cool"))
                        "at" (exact->inexact (hash-ref snap "chase-at"))
                        "commit" (exact->inexact (hash-ref snap "chase-commit"))
                        "knob" 0
                        "prev" #f))
      (set! chase-recent (list))
      (if (not (install-saved-spec! (hash-ref snap "spec" #f)))
        (let ((b (hash-ref snap "biome" "garden")))
          (if (not (install-biome-name! b #f))
            (begin (edsl-clear!) (set! biome-now "garden") (set! biome-pin #f))
            #f))
        #f)
      (let ((m (hash-ref snap "mood" "")))
        (if (mood-name? m) (set! mood-now m) #f))
      (and (scene-install! (hash-ref snap "scene" ""))
           (pals-install! (hash-ref snap "pals" ""))
           (motif-install! (hash-ref snap "motif" ""))))))

; Back at that branch's start: on the ground, same seed, saved rules.
; Notes taken while the road is laid are dropped. The tree is not one of them.
(define (rebuild-road!)
  (let ((kept pending))
    (set! rewind-quiet #t)
    (set! player (make-player 1.2))
    (set! world (list))
    (set! live-st (live-blank))
    (set! staged-chunk #f)
    (set! chunks (list))
    (set! next-id 0)
    (set! next-x 0.0)
    (set! sent-id 0)
    (set! rival-for 0)
    (set! run-ms 0.0)
    (set! level-bumps 0)
    (set! run-mult 1)
    (set! chal-coins 0)
    (set! chal-done #f)
    (set! banner-id 0)
    (set! banner-kind "")
    (set! banner-text "")
    (set! banner-gain 0)
    (set! acc 0.0)
    (set! last-ms 0)
    (set! feel-cue "")
    (set! slide-hinted #f)
    (set! goal-lock #f)
    (set! ward-ready #t)
    (set! ward-left 0.0)
    (set! run-hearts 3)
    (set! run-over #f)
    (try (begin (begin-level!) (ensure-ahead!)) (catch (e) #f))
    (set! rewind-quiet #f)
    (set! pending kept)
    (set! feel-cue "")
    (set! tuned #t)
    (remember-published!)
    (set! rules-dirty #f)))

(define (install-world! snap)
  (if (not (world-snap-ok? snap))
    #f
    (let ((saved (capture-run!)))
      (clear-slices!)
      (if (not (apply-snap! snap))
        (begin (restore-run! saved) (publish-world!) #f)
        (if (not (publish-world!))
          (begin (restore-run! saved) (publish-world!) #f)
          (begin (rebuild-road!) #t))))))

(define (on-rewind c msg)
  (let ((id (hash-ref msg "id" ""))
        (kind (hash-ref msg "kind" ""))
        (snap (hash-ref msg "snap" #f))
        (saved world-tree))
    (let ((got (world-take world-tree
                           (if (string? id) id "")
                           (if (string? kind) kind "")
                           snap)))
      (if (not (hash-ref got "ok" #f))
        (send c (hash "op" "err" "why" "rewind"))
        (begin
          (set! world-tree (hash-ref got "tree" world-tree))
          (if (not (install-world! (hash-ref got "snap" #f)))
            (begin
              (set! world-tree saved)
              (send c (hash "op" "err" "why" "rewind")))
            (begin
              (send c (welcome-msg))
              (send-all-chunks c)
              (set! state-full #t)
              (send c (state-msg "ok")))))))))

(define (take-hello-venue! msg)
  (let ((b (hash-ref msg "venue" #f))
        (m (hash-ref msg "mood" #f))
        (spec (hash-ref msg "spec" #f)))
    (if (hash? spec)
      (install-saved-spec! spec)
      (if (or (biome-name? b) (and (string? b) (> (string-length b) 0)))
        (install-biome-name! b #t)
        #f))
    (if (mood-name? m)
      (set! mood-now m)
      #f)))

(define (on-hello c msg)
  (let ((parsed (parse-seed (hash-ref msg "seed" #f))))
    (world-trunk!)
    (set! seed (if parsed parsed (exact->inexact (fresh-seed))))
    (set! speed-lock #f)
    (set! speed-now 8.0)
    (try (begin (reset-run!) (resume-run! msg) (take-hello-venue! msg))
         (catch (e) #f))
    (send-welcome! c)
    (try (open-hello!) (catch (e) #f))
    (send-all-chunks c)
    (set! state-full #t)
    (send c (state-msg "ok"))
    (flush-notes! c)))

(define (on-restart c msg)
  (let ((parsed (parse-seed (hash-ref msg "seed" #f))))
    (world-trunk!)
    (if parsed (set! seed parsed) #f)
    (try (begin (reset-run!) (take-hello-venue! msg))
         (catch (e) #f))
    (send-welcome! c)
    (try (open-hello!) (catch (e) #f))
    (send-all-chunks c)
    (set! state-full #t)
    (send c (state-msg "ok"))
    (flush-notes! c)))

(define (on-resync c msg)
  (send c (hash "op" "resync" "seed" seed))
  (send-all-chunks c)
  (set! state-full #t)
  (send c (state-msg "ok"))
  (flush-notes! c))

; Combo, Nice, a near miss, and an overtake live on the picture.
; The tick adds the new part of that total onto the server score so
; the finish sees the same skill the runner was shown. Per-level
; counts apply only while the picture is still on this level.
(define (absorb-skill! msg)
  (let ((skill (hash-ref msg "skill" #f)))
    (if (number? skill)
      (let* ((want (points-clamp skill))
             (delta (- want skill-seen)))
        (if (> delta 0.5)
          (let ((gain (if (> delta 800.0) 800.0 delta)))
            (set! player (pset player 6 (points-clamp (+ (player-score player) gain))))
            (set! skill-seen (points-clamp (+ skill-seen gain))))
          #f))
      #f))
  (let ((lv (hash-ref msg "level" #f)))
    (if (and (number? lv) (= (level-exact lv) level-n))
      (let ((combo (skill-count (hash-ref msg "combo" 0)))
            (near (skill-count (hash-ref msg "near" 0)))
            (overs (skill-count (hash-ref msg "overtakes" 0))))
        (if (> combo level-combo) (set! level-combo combo) #f)
        (if (> near level-near) (set! level-near near) #f)
        (if (> overs level-overtakes) (set! level-overtakes overs) #f))
      #f)))

(define (skill-count n)
  (cond
    ((not (number? n)) 0)
    ((<= n 0.0) 0)
    ((>= n 99.0) 99)
    (else (floor (+ n 0.001)))))

(define (tune-public)
  (let ((found (music-check tune-now)))
    (if (and (hash? found) (hash-ref found "ok" #f))
      (music-pub found)
      #f)))

; The phrase is queued, not installed on this tick. The page swaps it
; on the next bar. A harsh proposal never replaces tune-now.
(define (tune-send! kind why form)
  (let ((pub (music-pub (music-check form))))
    (if (not (hash? pub))
      #f
      (begin
        (set! pending (cons
          (hash "op" "decision" "kind" kind "why" why "arm" "tune"
                "via" publish-via "cue" "" "mark" "tune" "ask" ""
                "tune" pub)
          pending))
        #t))))

(define (load-tune-pick!)
  (if tune-pick-on
    #t
    (begin
      (require "lib/tune-pick")
      (set! tune-pick-on #t)
      #t)))

; Three children, one gate. The shortlist is this tune list. A spoken
; biome wish still waits on llm:chat; that delay is not this path.
; One evolve, one checked row, the prescreen, or the gate. The form
; that lands is the same one tune-choose would pick from these three
; children, because each step is that function split apart.
(define tune-job #f)
(define (tune-arm!)
  (load-tune-pick!)
  (set! tune-due #f)
  (set! tune-job (list "e0" (list) (list)
                       (+ (floor seed) level-n)
                       (if (and (number? speed-now) (> speed-now 0.1)) speed-now 8.0)
                       "")))
(define (tune-step!)
  (if (not tune-job)
    #f
    (let ((phase (list-ref tune-job 0))
          (forms (list-ref tune-job 1))
          (rows (list-ref tune-job 2))
          (base (list-ref tune-job 3))
          (pace (list-ref tune-job 4)))
      (cond
        ((string=? phase "e0")
         (set! tune-job (list "e1" (list (music-evolve tune-now base)) (list) base pace "")))
        ((string=? phase "e1")
         (set! tune-job (list "e2" (append forms (list (music-evolve tune-now (+ base 3)))) (list) base pace "")))
        ((string=? phase "e2")
         (set! tune-job (list "r0" (append forms (list (music-evolve tune-now (+ base 7)))) (list) base pace "")))
        ((string=? phase "r0")
         (set! tune-job (list "r1" forms (list (tune-row (car forms) pace)) base pace "")))
        ((string=? phase "r1")
         (set! tune-job (list "r2" forms (append rows (list (tune-row (car (cdr forms)) pace))) base pace "")))
        ((string=? phase "r2")
         (set! tune-job (list "pre" forms (append rows (list (tune-row (car (cdr (cdr forms))) pace))) base pace "")))
        ((string=? phase "pre")
         (let* ((screen (tune-prescreen rows))
                (keep (hash-ref screen "keep" (list)))
                (form (if (pair? keep) (hash-ref (car keep) "form" "") "")))
           (set! tune-job (list "gate" forms rows base pace
                                (if (and (string? form) (> (string-length form) 0))
                                  form
                                  (if (pair? forms) (car forms) ""))))))
        (else
         (let ((born (list-ref tune-job 5))
               (gate (music-gate born)))
           (if (string=? (hash-ref gate "verdict" "") "KEEP")
             (begin
               (set! tune-prev tune-now)
               (set! tune-now born)
               (tune-send! "KEEP" "fair" born))
             (tune-send! "ROLLBACK" (hash-ref gate "why" "bounds") tune-now))
           (set! tune-job #f)))))))

(define (maybe-tune!)
  (if (and tune-due (not tune-job) (not pals-job) (null? pals-queue)
           (not gate-tick) (not (llm-posting?)) (not trial-open))
    (try (tune-arm!) (catch (e) (set! tune-due #f)))
    #f))

; Drain one queued gate follow-up per tick (a friend's restyle). One
; thunk a tick keeps that cosmetic trial off the crossing frame. Waits
; while a chat POST or another trial holds the slot, exactly as
; maybe-tune! does. A thunk that raises is dropped, not retried. The
; gate already stepped the venue and kept the run.
(define (maybe-gate-followup!)
  (if (or gate-tick (null? gate-followups) (llm-posting?) (chat-open?) trial-open
          pals-job (pair? pals-queue))
      #f
      (let ((job (car gate-followups)))
        (set! gate-followups (cdr gate-followups))
        (try (job) (catch (e) #f)))))

(define (on-tick c msg)
  (set! gate-tick #f)
  (set! tick-built #f)
  (set! tick-rules #f)
  (record-hold! (or (llm-posting?) (chat-open?)))
  (record-flush!)
  (note-hearts! msg)
  (absorb-skill! msg)
  (if (and (player-alive? player) (> (hash-ref msg "jump" 0) 0))
    (set! player (press-jump player))
    #f)
  (if (and (player-alive? player) (> (hash-ref msg "slide" 0) 0))
    (set! player (press-slide player))
    #f)
  (if (and (player-alive? player) (number? (hash-ref msg "lane" 0))
           (not (= (hash-ref msg "lane" 0) 0)))
    (let ((before (player-lane player)))
      (set! player (press-lane player (hash-ref msg "lane" 0)))
      (if (not (= (player-lane player) before))
        (set! level-swaps (+ level-swaps 1))
        #f))
    #f)
  ; Let a worker take the token before this tick records a bump or a
  ; cleared band. One yield; the tick does not wait out the POST.
  (if (or scene-busy motif-busy pals-busy edsl-busy)
    (try (fiber:yield) (catch (e) #f))
    #f)
  (let ((ev (pump! (tick-slice msg))))
    (if (or (string=? ev "bump") (string=? ev "oops"))
      (note! "BUMP" ev "run"
             (if (string=? ev "oops") "Back on the path" "Oops! Keep going"))
      #f)
    (thing-watch! ev)
    (thing-poll! c)
    (advance-pace!)
    (maybe-hold!)
    (maybe-cards!)
    ; A chunk install lays coins. That tick does not also walk a chase
    ; or a dream, so the two costs do not share the frame.
    (let ((hint (hash-ref msg "x" 0)))
      (if (or road-job (road-due? hint))
        #f
        (maybe-chase!))
      (ensure-ahead! hint 1))
    (maybe-primer!)
    (poll-llm! c)
    (send-new-chunks c)
    (if rules-dirty
      (send-rules! c)
      #f)
    ; Decisions go out before state. The rebind check stops at state, so a
    ; note sent after it can sit unread when the deadline lands on that tick.
    ; A level's tune trial waits until no chat is holding the slot.
    (if tick-built #f (maybe-tune!))
    ; One queued gate follow-up (biome / roster evolve) per tick, after the
    ; tune so at most one cosmetic trial lands on a frame. Its KEEP/ROLLBACK
    ; note goes out with this tick's flush-notes below.
    (if tick-built #f (maybe-gate-followup!))
    (flush-notes! c)
    ; A trial that landed after the first rules send still has to reach
    ; the page on this tick, picture and all.
    (if rules-dirty
      (send-rules! c)
      #f)
    (send c (state-msg ev))
    ; One slice after the reply: a tune child, a dream phase, one chase
    ; shadow step, or the dream walk. A road tick does none of these.
    (if (or tick-built road-job)
      #f
      (cond
        ((or pals-job (pair? pals-queue)) (pals-step!))
        (tune-job (tune-step!))
        (dream-open (dream-open-step!))
        ((= chase-phase 2) (chase-seal-step!))
        ((maybe-dream!) #t)
        (else (maybe-guests!))))))

(define (on-cards c msg)
  (let ((act (hash-ref msg "action" "equip")))
    (if (and (string? act) (string=? act "export"))
      (send c (hash "op" "cards" "action" "export"
                    "seed" seed
                    "cards" deck-ids
                    "query" (share-query seed deck-ids)))
      (if (and (string? act) (string=? act "equip"))
        (begin
          (begin-cards! msg)
          (flush-notes! c))
        (send c (hash "op" "err" "why" "bad-cards"))))))

(define (on-rebind c msg)
  (let ((name (hash-ref msg "name" ""))
        (value (hash-ref msg "value" #f)))
    (if (not (and (number? value)
                  (or (string=? name "gravity") (string=? name "jump")
                      (string=? name "slide") (string=? name "speed")
                      (string=? name "hue"))))
      (send c (hash "op" "err" "why" "bad-value"))
      (begin
        (cond
          ((string=? name "gravity") (set! g-now (exact->inexact value)))
          ((string=? name "jump") (set! jump-now (exact->inexact value)))
          ((string=? name "slide") (set! slide-now (exact->inexact value)))
          ((string=? name "speed")
           (begin (set! speed-now (exact->inexact value)) (set! speed-lock #t)))
          ((string=? name "hue") (set! hue-now (exact->inexact value))))
        (set! tuned #t)
        (publish-named! (cond
                          ((string=? name "gravity") "rule-gravity")
                          ((string=? name "jump") "rule-jump-v")
                          ((string=? name "slide") "rule-slide-s")
                          ((string=? name "speed") "rule-run-speed")
                          (else "rule-hue"))
                        (cond
                          ((string=? name "gravity") g-now)
                          ((string=? name "jump") jump-now)
                          ((string=? name "slide") slide-now)
                          ((string=? name "speed") speed-now)
                          (else hue-now)))
        (note! "KEEP" name "rule"
               (cond
                 ((string=? name "gravity") (if (< value 32.0) "Lighter steps" "A bit heavier"))
                 ((string=? name "jump") (if (> value 11.2) "Higher jumps" "Softer jumps"))
                 ((string=? name "slide") "Longer slides")
                 ((string=? name "speed") (if (> value 8.0) "Faster now" "A gentler pace"))
                 (else "The light shifted")))
        (flush-notes! c)
        (send c (rules-msg))
        (set! rules-dirty #f)
        (set! state-full #t)))))

(define (on-propose c msg)
  (let ((text (hash-ref msg "form" "")))
    (cond
      ((and (string? text)
            (or (string-contains? text "(pal") (string-contains? text "(hero")))
       (consider-pals! text (say-line text)))
      ((and (string? text) (string-contains? text "(garden"))
       (consider-scene! text (say-line text)))
      (else (consider-form! text (say-line text)))))
  (flush-notes! c)
  (send c (rules-msg))
  (set! rules-dirty #f)
  (set! state-full #t)
  (send c (state-msg "ok")))

(define (on-audit c msg)
  (send c (hash "op" "audit" "items" audit "via" publish-via "rev" rule-rev)))

(define (env-str name)
  (let ((v (try (getenv name) (catch (e) ""))))
    (if (and (string? v) (> (string-length v) 0)) v "")))

(define (provider-key name)
  (cond
    ((string=? name "deepseek") (env-str "LUMEN_DEEPSEEK_KEY"))
    (else "")))

(define (provider-url name)
  (cond
    ((string=? name "deepseek") (env-str "LUMEN_DEEPSEEK_URL"))
    (else "")))

(define (provider-model name fallback)
  (let ((m (cond
             ((string=? name "deepseek") (env-str "LUMEN_DEEPSEEK_MODEL"))
             (else ""))))
    (if (string=? m "") fallback m)))

(define (provider-ready? name)
  (and (string=? name "deepseek")
       (> (string-length (provider-key name)) 0)
       (> (string-length (provider-url name)) 0)))

(define (ready-providers)
  (if (provider-ready? "deepseek") (list "deepseek") (list)))

(define (choose-provider)
  (let ((want (env-str "LUMEN_LLM")))
    (cond
      ((provider-ready? want) want)
      ((provider-ready? "deepseek") "deepseek")
      (else ""))))

(define (active-model)
  (cond
    ((string=? llm-provider "deepseek") (provider-model "deepseek" "deepseek-flash"))
    (else (env-str "LLM_MODEL"))))

(define (provider-label name)
  (if (string=? name "deepseek") "Now asking DeepSeek" "Now asking DeepSeek"))

(define (on-provider c msg)
  (let ((name (hash-ref msg "name" "")))
    (if (not (provider-ready? name))
      (send c (hash "op" "err" "why" "provider"))
      (begin
        (set! llm-provider name)
        (note! "KEEP" name "provider" (provider-label name))
        (flush-notes! c)
        (send c (rules-msg))
        (set! rules-dirty #f)
        (set! state-full #t)))))

(define (chat-url base)
  (let ((n (string-length base)))
    (let ((b (if (and (> n 0) (string-suffix? base "/"))
               (substring base 0 (- n 1))
               base)))
      (string-append b "/chat/completions"))))

(define (llm-text data)
  (let ((choices (hash-ref data "choices" #f)))
    (if (not (pair? choices))
      ""
      (let ((msg (hash-ref (car choices) "message" #f)))
        (if (not (hash? msg))
          ""
          (let ((content (hash-ref msg "content" "")))
            (if (and (string? content) (> (string-length content) 0))
              content
              (let ((reason (hash-ref msg "reasoning_content" "")))
                (if (and (string? reason) (> (string-length reason) 0)) reason "")))))))))

(define (parse-chat raw)
  (cond
    ((not (and (string? raw) (> (string-length raw) 0)))
     (hash "ok" #f "error" "empty" "content" ""))
    ((or (string-prefix? raw "http-post:") (string-prefix? raw "http-get:"))
     (hash "ok" #f "error" raw "content" ""))
    (else
     (let ((data (try (json-parse raw) (catch (e) #f))))
       (if (not (hash? data))
         (hash "ok" #f "error" "json" "content" "")
         (let ((err (hash-ref data "error" #f)))
           (if (hash? err)
             (hash "ok" #f "error" (hash-ref err "message" "error") "content" "")
             (let ((text (llm-text data)))
               (if (> (string-length text) 0)
                 (hash "ok" #t "error" "" "content" text)
                 (hash "ok" #f "error" "no-content" "content" ""))))))))))

; llm:chat always posts LLM_API_KEY. A probed provider carries its own
; key and base URL, so a switch can change the next call without a restart.
(define (post-chat url body key)
  (let ((raw (try (http-post url body key llm-timeout-s) (catch (e) #f))))
    (if (string? raw)
      raw
      (let ((raw2 (try (http-post url body key) (catch (e) ""))))
        (if (string? raw2) raw2 "")))))

(define (chat-via-http sys user)
  (let ((key (provider-key llm-provider))
        (base (provider-url llm-provider))
        (model (active-model)))
    (let ((body (json-encode
                  (hash "model" model
                        "max_tokens" 2048
                        "reasoning_effort" "minimal"
                        "messages"
                        (list (hash "role" "system" "content" sys)
                              (hash "role" "user" "content" user))))))
      (parse-chat (post-chat (chat-url base) body key)))))

(define (dispatch c msg)
  (set! conn c)
  (let ((op (hash-ref msg "op" "")))
    ; Ticks stay on the road modules until the runner has moved, then
    ; one deferred module loads per tick. Anything else loads the rest.
    (if slow-mods
      #f
      (if (or (string=? op "hello")
              (string=? op "bye")
              (string=? op "tick")
              (string=? op "resync")
              (string=? op "llm-proxy")
              (string=? op "llm-reply"))
        (if (and (string=? op "tick") (> (player-x player) 3.0))
          (load-slow-one!)
          #f)
        (load-slow!)))
    (cond
      ((string=? op "llm-proxy")
       (set! llm-proxy-on (eq? (hash-ref msg "ready" #f) #t)))
      ((string=? op "llm-reply")
       (hash-set! llm-replies (hash-ref msg "id" "") msg))
      ((string=? op "hello") (on-hello c msg))
      ((string=? op "restart") (on-restart c msg))
      ((string=? op "resync") (on-resync c msg))
      ((string=? op "tick") (on-tick c msg))
      ((string=? op "unstall")
       (if stall-waiting
         (begin
           (channel:send stall-ch #t)
           (set! stall-waiting #f))
         #f))
      ((string=? op "rebind") (on-rebind c msg))
      ((string=? op "cards") (on-cards c msg))
      ((string=? op "primer") (on-primer c msg))
      ((string=? op "propose") (on-propose c msg))
      ((string=? op "wish") (on-wish c msg))
      ((string=? op "thing-bad") (on-thing-bad c msg))
      ((string=? op "provider") (on-provider c msg))
      ((string=? op "audit") (on-audit c msg))
      ((string=? op "rewind") (on-rewind c msg))
      ((string=? op "bye") #f)
      (else (send c (hash "op" "err" "why" "unknown"))))))

(define (take-line)
  (let ((i (string-find buf "\n")))
    (if (< i 0)
      #f
      (let ((line (substring buf 0 i)))
        (set! buf (substring buf (+ i 1) (string-length buf)))
        line))))

(define (read-msg c)
  (let ((have (take-line)))
    (if have
      have
      (let ((got (tcp-recv c 8192)))
        (if (or (not (string? got)) (= (string-length got) 0))
          #f
          (begin
            (set! buf (string-append buf got))
            (read-msg c)))))))

(define (num-field h k)
  (let ((n (hash-ref h k 0)))
    (if (number? n) n 0)))

; Several ticks already sitting in the socket become one step. dt is
; capped at a tenth of a second, the same cap pump! uses for a live
; tick, so a stall does not fast-forward the road. Jump and slide are
; kept if either tick asked. Lane presses in the same direction fold
; into one step. The newest pose fields win.
(define (merge-ticks a b)
  (let ((dt (min 100.0 (+ (exact->inexact (num-field a "dt"))
                          (exact->inexact (num-field b "dt")))))
        (lane (+ (num-field a "lane") (num-field b "lane"))))
    (hash "op" "tick"
          "jump" (max (num-field a "jump") (num-field b "jump"))
          "slide" (max (num-field a "slide") (num-field b "slide"))
          "lane" (if (> lane 0.0) 1 (if (< lane 0.0) -1 0))
          "skill" (num-field b "skill")
          "combo" (num-field b "combo")
          "near" (num-field b "near")
          "overtakes" (num-field b "overtakes")
          "level" (num-field b "level")
          "hearts" (num-field b "hearts")
          "dt" dt
          "x" (num-field b "x"))))

(define (take-batch c)
  (let ((first (read-msg c)))
    (if (not first)
      #f
      (let loop ((acc (list first)))
        (let ((more (take-line)))
          (if more (loop (cons more acc)) (reverse acc)))))))

; Returns "bye" or "ok". Consecutive ticks in one read are one
; dispatch, so a disconnect does not simulate the whole backlog.
(define (dispatch-batch c lines)
  (let loop ((xs lines) (tick #f))
    (if (null? xs)
      (if tick
        (begin
          (try (dispatch c tick) (catch (e) (send c (hash "op" "err" "why" "drop"))))
          "ok")
        "ok")
      (let ((msg (try (json-parse (car xs)) (catch (e) #f))))
        (if (not (hash? msg))
          (begin
            (if tick
              (try (dispatch c tick) (catch (e) (send c (hash "op" "err" "why" "drop"))))
              #f)
            (send c (hash "op" "err" "why" "json"))
            (loop (cdr xs) #f))
          (let ((op (hash-ref msg "op" "")))
            (if (string=? op "tick")
              (loop (cdr xs) (if tick (merge-ticks tick msg) msg))
              (begin
                (if tick
                  (try (dispatch c tick) (catch (e) (send c (hash "op" "err" "why" "drop"))))
                  #f)
                (if (string=? op "bye")
                  "bye"
                  (begin
                    (try (dispatch c msg) (catch (e) (send c (hash "op" "err" "why" "drop"))))
                    (loop (cdr xs) #f)))))))))))

(define (serve-client c)
  (set! buf "")
  (let loop ()
    (let ((lines (take-batch c)))
      (if (not lines)
        #f
        (if (string=? (dispatch-batch c lines) "bye")
          #t
          (loop))))))

(define (start-llm!)
  (set! llm-provider (choose-provider))
  (let ((key (env-str "LLM_API_KEY")))
    (if (or (> (string-length key) 0) (provider-ready? llm-provider))
      (begin
        (require "std/llm" all:)
        (set! llm-on #t)
        (set! llm-chat-mode 0)
        ; v0.2.2 llm:chat is (sys user). A newer runtime takes a third
        ; hash (reasoning_effort, max_tokens). The extra call throws an
        ; arity error before any HTTP request; catch it and keep the
        ; two-argument call. A hash result means the extra argument was
        ; accepted, including an API error hash. A probed provider
        ; bypasses that path so its own key and URL are used.
        (set! llm-reply
          (lambda (sys user)
            (if (provider-ready? llm-provider)
              (chat-via-http sys user)
              (cond
                ((= llm-chat-mode 2) (llm:chat sys user))
                ((= llm-chat-mode 1) (llm:chat sys user llm-extra))
                (else
                 (let ((tried (try (llm:chat sys user llm-extra) (catch (e) #f))))
                   (if (hash? tried)
                     (begin (set! llm-chat-mode 1) tried)
                     (begin (set! llm-chat-mode 2) (llm:chat sys user)))))))))
        (load-llm-timeout!)
        (set! stall-scene? (env-on? "LUMEN_STALL_SCENE"))
        (set! stall-ch (channel:create 1))
        (set! llm-slot (channel:create 1))
        (channel:send llm-slot #t)
        (set! motif-req (channel:create 2))
        (set! motif-res (channel:create 2))
        (set! scene-req (channel:create 2))
        (set! scene-res (channel:create 2))
        (set! pals-req (channel:create 2))
        (set! pals-res (channel:create 2))
        (set! edsl-req (channel:create 2))
        (set! edsl-res (channel:create 2))
        (set! thing-res (channel:create 16))
        (fiber:spawn (lambda () (llm-worker motif-req motif-res SYS "motif")))
        (fiber:spawn (lambda () (llm-worker scene-req scene-res SCENE-SYS "scene")))
        (fiber:spawn (lambda () (llm-worker pals-req pals-res PALS-SYS "pals")))
        (fiber:spawn (lambda () (llm-worker edsl-req edsl-res BIOME-SYS "biome"))))
      #f)))

; One worker per phrase kind. A scene call stuck inside llm:chat does not
; take the obstacle worker with it. LUMEN_STALL_SCENE parks the first
; garden job until `unstall`, which is how the watchdog test imitates a
; call that ignores LLM_TIMEOUT.
; The token is a number copied before the chat call. Reading it back off
; the job hash after that await comes out 0, the tick drops the reply,
; and the arm stays busy so the phrase never lands.
; A hash sent across a fiber channel comes back empty on nightlies
; that still have cybrid-systems/aura#5294. Jobs and replies are lists
; of atoms. The tick builds the hash after the receive.
(define (reply-field msg i)
  (let ((v (list-ref-or msg i "")))
    (if (string? v) v "")))

(define (reply-hash msg)
  (cond
    ((not msg) #f)
    ((hash? msg) msg)
    ((and (pair? msg) (string? (car msg)))
     (hash "kind" (car msg)
           "token" (let ((n (list-ref-or msg 1 0)))
                     (if (number? n) n 0))
           "ans" (hash "ok" (= (let ((n (list-ref-or msg 2 0)))
                                 (if (number? n) n 0))
                               1)
                       "content" (reply-field msg 3)
                       "error" (reply-field msg 4))))
    (else #f)))

(define (deliver! res kind tok ans)
  (let ((body (if (hash? ans) ans (hash "ok" #f "error" "bad" "content" ""))))
    (channel:send res
                  (list kind
                        tok
                        (if (hash-ref body "ok") 1 0)
                        (let ((content (hash-ref body "content" "")))
                          (if (string? content) content ""))
                        (let ((err (hash-ref body "error" "")))
                          (if (string? err) err ""))))))

; One chat POST at a time. A second call used to run beside the first,
; and a trial opened on the tick then wedged the first POST so its
; phrase never came back. Wait through an open trial too: evo:trial
; yields, and entering http-post from that yield is the same wedge.
(define (call-llm! sys user)
  (let wait ()
    (if (and llm-slot (not (channel:try-recv llm-slot)))
      (begin (try (fiber:yield) (catch (e) #f)) (wait))
      #t))
  (let ((ans (try (llm-reply sys user) (catch (e) #f))))
    (if llm-slot (channel:send llm-slot #t) #f)
    (if (hash? ans) ans (hash "ok" #f "error" "llm" "content" ""))))

(define (llm-worker req res sys kind)
  (let loop ()
    (let ((job (channel:recv req)))
      ; (token user). A hash used to arrive empty, token 0 and no prompt.
      (let ((tok (cond
                   ((and (pair? job) (number? (car job))) (car job))
                   ((hash? job) (hash-ref job "token" 0))
                   (else 0)))
            (user (cond
                    ((and (pair? job) (pair? (cdr job)) (string? (car (cdr job))))
                     (car (cdr job)))
                    ((hash? job) (hash-ref job "user" ""))
                    (else ""))))
        (cond
          ((string=? kind "scene") (set! scene-working #t))
          ((string=? kind "pals") (set! pals-working #t))
          ((string=? kind "biome") (set! edsl-working #t))
          (else (set! motif-working #t)))
        (if (and stall-scene?
                 (= scene-stalled 0)
                 (string=? kind "scene"))
          (begin
            (set! scene-stalled 1)
            (set! stall-waiting #t)
            (channel:recv stall-ch)
            (set! stall-waiting #f))
          #f)
        (let ((ans (call-llm! sys user)))
          (deliver! res kind tok ans))
        (cond
          ((string=? kind "scene") (set! scene-working #f))
          ((string=? kind "pals") (set! pals-working #f))
          ((string=? kind "biome") (set! edsl-working #f))
          (else (set! motif-working #f)))
        (loop)))))

(define (port-number)
  (let ((raw (try (getenv "AURA_RUNNER_PORT") (catch (e) ""))))
    (let ((n (if (and (string? raw) (> (string-length raw) 0))
               (string->number raw)
               8765)))
      (if (and (number? n) (> n 0)) n 8765))))

; 127.0.0.1 is this machine. Docker sets AURA_RUNNER_BIND=0.0.0.0 so a
; published port reaches the core. The rules of the run do not change.
(define (bind-host)
  (let ((raw (try (getenv "AURA_RUNNER_BIND") (catch (e) ""))))
    (if (and (string? raw) (> (string-length raw) 0)) raw "127.0.0.1")))

(define (guest-text i)
  (cond
    ((= i 0) "(pal taxi toot 0.98 0.86 0.28 pace)")
    ((= i 1) "(pal wagon mill 0.48 0.78 0.55 side)")
    ((= i 2) "(pal car zip 0.62 0.55 0.95 follow)")
    ((= i 3) "(pal van cozy 0.95 0.62 0.45 pace)")
    (else "")))

; Mochi and three cars are already here. More cars roll in until the
; roster is full. A full roster waits, and a call in flight is left alone.
(define (maybe-guests!)
  (if (or (not (player-alive? player))
          (llm-posting?)
          (>= guest-at 4)
          (>= (length pals-rows) 6)
          (< run-ms (+ 400.0 (* (exact->inexact guest-at) 1800.0))))
    #f
    (let ((text (guest-text guest-at)))
      (set! guest-at (+ guest-at 1))
      (let ((got (admit-guest pals-rows text)))
        (if (not (and (hash? got) (hash-ref got "ok" #f)))
          #f
          (keep-pals! (roster-text (hash-ref got "rows") hero-now)
                      got
                      (hash-ref got "cue" "A new friend came along")
                      hero-now
                      #f
                      "guest"))))))

(define (boot-pals!)
  (let ((found (check-pals default-pals)))
    (if (and (hash? found) (hash-ref found "ok"))
      (begin
        (set! pals-now default-pals)
        (set! pals-rows (hash-ref found "pals")))
      #f)))

(define (main)
  (set-code (read-file "core/hot.aura"))
  (eval-current)
  (charter-boot!)
  (boot-pals!)
  (set! policy (make-policy))
  (publish-all!)
  ; The deferred modules used to compile on the first tick after the
  ; runner moved (about a quarter of a second, once). Load them before
  ; the port opens so a tick never pays that compile.
  (boot-note! 93 "正在读余下的规则")
  (load-slow!)
  ; First calls of reset, a chunk, and a roster check compile on the
  ; hello and the first guest. Do them before the port opens.
  (try (begin
         (reset-run!)
         (let ((ch (chunk-or-fallback (pattern-chunk 1 0 0 8.0) 8.0)))
           (string-pickups (hash-ref ch "pieces") 0 (hash-ref ch "x1")
                           1 25.0 1 (coin-blank)))
         (layout-form "(seq (ground 4.0) (gap 1.0) (ground 4.0))" (rules-hash))
         (check-roster "(pals (pal kitten mochi 0.95 0.62 0.35 hop))")
         (phrase-search "pals-form"))
       (catch (e) #f))
  (boot-note! 95 "规则好了")
  ; Bind before the model fibers. A taken port used to exit while those
  ; three receivers were still blocked, and the runtime warned about them.
  (let ((port (port-number)))
    (let ((listener (tcp-listen port (bind-host))))
      (if (not (number? listener))
        (begin
          (display "listen-failed ")
          (display port)
          (newline)
          1)
        (begin
          ; The page is already polling. "马上就好" was the last line it
          ; would ever read, including after this listener was up.
          (boot-note! 96 "正在开门")
          (start-llm!)
          (let ((bound (tcp-local-port listener)))
            (try (make-directory "out") (catch (e) #f))
            (write-file "out/aura.port" (number->string bound))
            (display "PORT ")
            (display bound)
            (newline)
            ; A pipe buffers this line. Push it out before accept, or the
            ; play scripts never see the port.
            (let flush ((i 0))
              (if (< i 80)
                (begin
                  (display "................................................................\n")
                  (flush (+ i 1)))
                #t))
            (let accept-loop ()
              (let ((client (tcp-accept listener)))
                (if (number? client)
                  (begin
                    (serve-client client)
                    (tcp-close client)
                    (accept-loop))
                  #f)))))))))

(main)
