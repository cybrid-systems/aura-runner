; Lumen Run server. Aura owns rules, chunks, fairness, difficulty and score.
; The browser predicts motion from the rule snapshot so a slow tick never
; changes how a jump feels.
; The prebuilt Aura binary compiles every top-level require before the
; first form runs. Wish, voice, review, edsl, and thing are not needed
; to open the garden, and together they dominate that compile. Load the
; road first, and the tune, because the first welcome carries it. Once
; the runner has moved, take one of the rest per tick so a single
; message never waits out the whole compile. A wish, a proposal, or a
; dream loads whatever is still missing.
(define slow-mods #f)
(define slow-step 0)
(define (boot-note! pct label)
  (try (begin
         (make-directory "out")
         (fence-write "out/boot.txt" (string-append (number->string pct) " " label)))
       (catch (e) #f)))
; Loaded with the road, before the port opens. The first chunk lays coins.
(define coin-params #f)
(define coins-on #f)
(define (load-coins!)
  (if coins-on
    coin-params
    (begin
      (require "lib/coins")
      (set! coins-on #t)
      (if (hash? coin-params)
        coin-params
        (begin
          (set! coin-params (coin-blank))
          coin-params)))))

(define (load-fast!)
  (require "lib/fence")
  (boot-note! 8 "正在启动")
  (require "std/socket" all:)
  (require "std/string" all:)
  (require "std/math" all:)
  (require "std/evo" all:)
  (require "std/evo-core" all:)
  (require "lib/recordq")
  (require "lib/fork")
  (boot-note! 18 "正在读规则")
  (require "lib/gen")
  (require "lib/live")
  (boot-note! 36 "正在铺路")
  ; One line before each module. A cold compile sits inside a single
  ; require, and the page can only show the line that was already written.
  (boot-note! 40 "正在读场景")
  (require "lib/scene")
  (boot-note! 48 "正在读朋友")
  (require "lib/pals")
  (boot-note! 54 "正在读卡片")
  (require "lib/cards")
  (boot-note! 60 "正在读地方")
  (require "lib/biome")
  (boot-note! 66 "正在读追逐")
  (require "lib/chase")
  (boot-note! 72 "正在读心")
  (require "lib/hearts")
  (boot-note! 76 "正在读比赛")
  (require "lib/race")
  (boot-note! 80 "正在读世界")
  (require "lib/world")
  (boot-note! 84 "正在读入门")
  (require "lib/primer")
  (boot-note! 88 "正在读曲子")
  (require "lib/music")
  ; Coins are laid into the first chunk, so they load with the road.
  ; One require here, before the port opens. A second require on the
  ; first chunk compiles the module again.
  (load-coins!)
  (boot-note! 92 "花园马上就好"))
(load-fast!)
(define (load-slow-one!)
  (cond
    (slow-mods #t)
    ((= slow-step 0)
     (begin (require "lib/review") (set! slow-step 1)))
    ((= slow-step 1)
     (begin (require "lib/thing") (set! slow-step 2)))
    ((= slow-step 2)
     (begin (require "lib/edsl") (set! slow-step 3)))
    ((= slow-step 3)
     (begin (require "lib/evolve") (set! slow-step 4)))
    ((= slow-step 4)
     (begin (require "lib/wish") (set! slow-step 5)))
    (else
     (begin
       (require "lib/voice")
       (set! edsl-pool (edsl-boot))
       (set! slow-mods #t)
       (set! slow-step 6)))))
(define (load-slow!)
  (let loop ()
    (if slow-mods
      #t
      (begin (load-slow-one!) (loop)))))

(define SYS
  "You design one obstacle phrase for a children's 3D endless runner called Lumen Run. The runner has three lanes (0 left, 1 centre, 2 right), jumps, and slides. No markdown. Allowed pieces: (seq (ground W) (gap W) (hurdle H W) (gate BOTTOM W) (coin Y) (spring W) (block LANE DEPTH) (coin-lane LANE Y)). Every parameter is a number; never write the words BOTTOM, W, H, LANE, DEPTH or other placeholders. Ranges in meters: spring W 0.45-1.6, hurdle W 0.35-2.2 and H 0.15-0.9, gate W 0.35-2.0 and BOTTOM 0.58-0.85, coin Y 0.4-2.4, coin-lane LANE 0, 1 or 2 and Y 0.4-2.4, ground W 0.8-18, gap W 0.4-2.0, block LANE 0, 1 or 2 and DEPTH 0.5-2.2. Optional (loot KIND) restyles every pickup. KIND is coin, star, gem, blossom, or apple. Optional (bend AMP) turns the road. AMP is 0.12 to 0.65. Start and end with ground. Leave at least one lane open beside every block. No violence, fear, weapons, or scary words. Bright garden, friendly shapes. First write one short bright English sentence with no parentheses, then the s-expression. That sentence is what the child reads. A ground of 10.4 is one beat, about 1.3 seconds, and a ground of 4.8 is a short rest. Leave a full beat of ground before a jump. Optional (flyer KIND LANE Y) sends one gentle toy flying toward the runner along one lane. KIND is plane, bubble, lantern, leaf, or ball. LANE is 0, 1 or 2. Y is 0.55 to 0.85. At most two flyers, and never on every lane at once. Optional last word on a hurdle, a gate, or a block picks its look. A hurdle is bar, log, fence, bloom, or drum. A gate is bar, ribbon, vine, lights, or scarf. A block is pot, stump, mushroom, crate, or bush. A low wide shape is a jump, a bar with room underneath is a slide, and one tall shape in a single lane is a lane change. Recolor a shape freely. One beat holds one move. Optional (slope GRADE LENGTH) is a gentle hill. GRADE is from -0.16 to -0.04 or from 0.04 to 0.16. LENGTH is 0.8 to 18 and scales like ground. Pair an up slope with a down slope of the same length so the road returns to flat. Do not put a gap on the crest. Example: (seq (ground 6) (block 0 1) (hurdle 0.4 0.7) (ground 5) (gate 0.72 0.8) (ground 5) (gap 1.1) (ground 5))")

(define SCENE-SYS
  "You redesign the garden backdrop for a children's 3D endless runner called Lumen Run. No markdown. Form: (garden (sky R G B) (ground R G B) (flower KIND DENSITY) (light L)). KIND is one of daisy, tulip, blossom, buttercup. Sky channels are 0.25 to 1 and the sky stays bright. Ground is green: G is at least 0.30 and at least as large as R, and not much smaller than B. Density is 0.15 to 1. Light is 0.50 to 1, never night. Optional (fog F) is 0 to 0.38; do not ask for thicker fog. No violence, fear, weapons, or scary words. Make it look different from a plain blue sky and daisies. First write one short bright English sentence with no parentheses, then the s-expression. That sentence is what the child reads. Example: (garden (sky 0.95 0.45 0.55) (ground 0.35 0.72 0.32) (flower tulip 0.85) (light 0.9))")

(define PALS-SYS
  "You change one friendly companion in a children's 3D endless runner called Lumen Run. No markdown. Restyle a friend who is already here by keeping the same name, or add one new gentle friend. Form: (pal KIND NAME R G B MOTION). KIND is kitten, car, van, racer, taxi, wagon, bunny, bird, butterfly, frog, duck, puppy, fox, turtle, bee, penguin, panda, dragon, or a new gentle word of 3 to 12 letters. NAME is 2 to 12 letters. R G B are 0.25 to 1 and the colour stays bright. MOTION is hop, pace, float, follow, side, near, cheer, or pace-ahead. near, cheer, and pace-ahead only change where the friend is drawn, never the hit. No violence, fear, weapons, or scary words. Always restyle the runner in that same answer with (hero KIND R G B), alone or as one clause inside (pals ...). Pick a KIND different from the runner's current look. KIND is keeper, kitten, car, van, racer, taxi, wagon, bunny, bird, butterfly, frog, duck, puppy, fox, turtle, bee, penguin, panda, or dragon. keeper is the light-keeper. R G B stay bright, from 0.25 to 1. A hero clause changes the runner only and does not add a friend. First write one short bright English sentence with no parentheses, then the s-expression. That sentence is what the child reads. Example: (pal bird lark 0.95 0.86 0.35 float)")

(define BIOME-SYS
  "You invent one bright place for a children's running game. No markdown. Reply with one short cheerful sentence, then one s-expression: (biome ID (label WORD) (sky ZR ZG ZB HR HG HB) (fog FR FG FB AMT) (body BODY) (road R G B) (curb R G B) (ground R G B) (surface SURFACE) (light L) (mood M) (particles KIND DENSITY) (props (PROP DENSITY SCALE) ...) (recipe mix)). ID and WORD are lowercase hyphenated words. BODY is sun, moon, stars, aurora, or none. SURFACE is grass, stone, dust, sand, ice, cloud, lava, reef, or plank. KIND is fireflies, stardust, snow, embers, rain, sparkles, or none. PROP is tree, tower, arch, crystal, rock, coral, ring, pagoda, palace-gate, pearl-tower, spire, bridge-tower, eiffel-tower, clock-tower, colonnade, bamboo, palm, stone-bridge, battlement, willow, cypress, sakura, pine, bush, fern, mushroom, cactus, or reed. Use one to four props. Every colour is 0 to 1. Fog AMT is at most 0.38. Light is 0.50 to 1. Density is 0.05 to 0.55. The road colour must differ from the shoulders. No violence, fear, or scary words.")

