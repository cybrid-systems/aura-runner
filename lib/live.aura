; Rebuild the live rule workspace.
; On Aura v0.2.2, (mutate :rebind) succeeds before and after evo:trial
; (measured: the parent stays writable, #5162). set-code is only the
; fallback if a rebind refuses. A second set-code replaces the workspace
; the running modules were compiled against, so it is not the keep path.
(require "std/string" all:)

(define (num-src n)
  (let ((s (number->string (exact->inexact n))))
    (if (string-contains? s ".") s (string-append s ".0"))))

(define (hot-source g jump slide speed coyote forgive hue motif)
  (string-append
    "(define (rule-gravity) " (num-src g) ")\n"
    "(define (rule-jump-v) " (num-src jump) ")\n"
    "(define (rule-slide-s) " (num-src slide) ")\n"
    "(define (rule-run-speed) " (num-src speed) ")\n"
    "(define (rule-coyote-s) " (num-src coyote) ")\n"
    "(define (rule-forgive) " (num-src forgive) ")\n"
    "(define (rule-hue) " (num-src hue) ")\n"
    "(define (motif-form) \"" motif "\")\n"
    "0"))

; Returns "rebind" or "set-code".
(define (publish-rule! name body full-src)
  (let ((rb (mutate :rebind name body "tune")))
    (if (equal? rb #t)
      (begin (eval-current) "rebind")
      (if (set-code full-src)
        (begin (eval-current) "set-code")
        "fail"))))

(define (extract-seq s)
  (if (not (string? s))
    #f
    (let ((i (string-find s "(seq")))
      (if (< i 0)
        #f
        (let ((n (string-length s)))
          (let loop ((k i) (depth 0))
            (if (>= k n)
              #f
              (let ((c (string-ref s k)))
                (cond
                  ((= c 40)
                   (loop (+ k 1) (+ depth 1)))
                  ((= c 41)
                   (if (<= depth 1)
                     (substring s i (+ k 1))
                     (loop (+ k 1) (- depth 1))))
                  (else (loop (+ k 1) depth)))))))))))

(define (one-line s)
  (string-replace (string-replace s "\n" " ") "\r" " "))
