; Rebuild the live rule workspace.
; On Aura v0.2.2, (mutate :rebind) succeeds before and after evo:trial
; (measured: the parent stays writable, #5162). set-code is only the
; fallback if a rebind refuses. A second set-code replaces the workspace
; the running modules were compiled against, so it is not the keep path.
(require "std/string" all:)

(define (num-src n)
  (let ((s (number->string (exact->inexact n))))
    (if (string-contains? s ".") s (string-append s ".0"))))

(define default-scene
  "(garden (sky 0.55 0.72 0.95) (ground 0.42 0.68 0.38) (flower daisy 0.45) (light 0.82))")

(define (hot-source g jump slide speed coyote forgive hue motif scene)
  (string-append
    "(define (rule-gravity) " (num-src g) ")\n"
    "(define (rule-jump-v) " (num-src jump) ")\n"
    "(define (rule-slide-s) " (num-src slide) ")\n"
    "(define (rule-run-speed) " (num-src speed) ")\n"
    "(define (rule-coyote-s) " (num-src coyote) ")\n"
    "(define (rule-forgive) " (num-src forgive) ")\n"
    "(define (rule-hue) " (num-src hue) ")\n"
    "(define (motif-form) \"" motif "\")\n"
    "(define (scene-form) \"" (if (and (string? scene) (> (string-length scene) 0)) scene default-scene) "\")\n"
    "0"))

; hot.aura writes (define (motif-form) "…"). The live workspace stores
; that as (define motif-form (lambda () "…")), so rebind uses the lambda.
; A bare string is refused (rebind-non-procedure). On Aura v0.2.2 this
; lambda returns #t, including a second rebind whose string holds a
; different phrase. Callers still fall back to set-code when rebind
; does not return #t (persist-reject restores the previous topology).
(define (motif-body text)
  (string-append "(lambda () \"" (if (string? text) text "") "\")"))

(define (scene-body text)
  (string-append "(lambda () \"" (if (string? text) text "") "\")"))

; Returns "rebind" or "set-code".
(define (publish-rule! name body full-src)
  (let ((rb (mutate :rebind name body "tune")))
    (if (equal? rb #t)
      (begin (eval-current) "rebind")
      (if (set-code full-src)
        (begin (eval-current) "set-code")
        "fail"))))

(define (extract-balanced s mark)
  (if (not (string? s))
    #f
    (let ((i (string-find s mark)))
      (if (< i 0)
        #f
        (let ((n (string-length s)))
          (let loop ((k i) (depth 0))
            (if (>= k n)
              #f
              (let ((c (string-ref s k)))
                (cond
                  ((= c 40)
                   (loop (+ k 1) (+ depth 1)))
                  ((= c 41)
                   (if (<= depth 1)
                     (substring s i (+ k 1))
                     (loop (+ k 1) (- depth 1))))
                  (else (loop (+ k 1) depth)))))))))))

(define (extract-seq s)
  (extract-balanced s "(seq"))

(define (extract-garden s)
  (extract-balanced s "(garden"))

(define (one-line s)
  (string-replace (string-replace s "\n" " ") "\r" " "))
