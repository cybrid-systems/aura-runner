; Biome EDSL. A city is data: colours, one mood, one building style, and
; up to three landmark names. The browser draws those names. This file
; only checks the data. It does not eval a model reply.
(require "std/string" all:)
(require "lib/sexp")

(define edsl-cap 150)
(define edsl-props
  (list "pagoda" "palace-gate" "pearl-tower" "spire" "bridge-tower" "eiffel-tower"
        "clock-tower" "colonnade" "bamboo" "palm" "stone-bridge" "battlement"
        "willow" "cypress" "sakura"))
(define edsl-moods (list "day" "night" "sunset" "neon"))
(define edsl-styles
  (list "palace" "neon" "deco" "stone" "pastel" "brick" "bay" "wall" "mist" "canal"))
(define edsl-parts (list "lantern" "petal" "mist" "neon" "dust" "sakura" "none"))
(define edsl-heads
  (list "sky" "sky1" "fog" "sun" "path" "curb" "ground" "hill" "hill2"
        "water" "build" "roof" "mote" "light" "mood" "style" "part" "props"))
(define edsl-ids
  (list "beijing" "shanghai" "hangzhou" "chengdu" "xian" "chongqing" "hongkong"
        "newyork" "sanfrancisco" "losangeles" "paris" "london" "rome" "venice" "tokyo"
        "visit-china" "visit-us" "visit-europe" "visit-asia" "visit-world"))
(define edsl-china
  (list "beijing" "shanghai" "hangzhou" "chengdu" "xian" "chongqing" "hongkong"))
(define edsl-us (list "newyork" "sanfrancisco" "losangeles"))
(define edsl-europe (list "paris" "london" "rome" "venice"))
(define edsl-world
  (list "beijing" "shanghai" "hangzhou" "chengdu" "xian" "chongqing" "hongkong"
        "newyork" "sanfrancisco" "losangeles" "paris" "london" "rome" "venice" "tokyo"))
(define edsl-hurdle (list 0.28 0.62 0.98))
(define edsl-gate (list 1.0 0.72 0.18))

(define (edsl-abs n)
  (if (< n 0) (- 0 n) n))

(define (edsl-num n)
  (let ((s (number->string (exact->inexact (if (number? n) n 0)))))
    (if (>= (string-index s "." 0) 0) s (string-append s ".0"))))

(define (edsl-has? text w)
  (and (string? text) (string? w) (>= (string-index text w 0) 0)))

(define (edsl-word? low w)
  (edsl-has? (string-append " " low " ") (string-append " " w " ")))

(define (edsl-member? xs name)
  (let loop ((ys xs))
    (if (or (not (pair? ys)) (null? ys))
      #f
      (if (and (string? (car ys)) (string=? (car ys) name))
        #t
        (loop (cdr ys))))))

(define (edsl-id? s)
  (and (string? s) (edsl-member? edsl-ids s)))

(define (edsl-cost name)
  (cond
    ((string=? name "pagoda") 11)
    ((string=? name "palace-gate") 9)
    ((string=? name "pearl-tower") 6)
    ((string=? name "spire") 5)
    ((string=? name "bridge-tower") 8)
    ((string=? name "eiffel-tower") 7)
    ((string=? name "clock-tower") 5)
    ((string=? name "colonnade") 6)
    ((string=? name "bamboo") 5)
    ((string=? name "palm") 6)
    ((string=? name "stone-bridge") 6)
    ((string=? name "battlement") 5)
    ((string=? name "willow") 4)
    ((string=? name "cypress") 2)
    ((string=? name "sakura") 4)
    (else 99)))

(define (edsl-style-cost name)
  (cond
    ((string=? name "palace") 3)
    ((string=? name "neon") 3)
    ((string=? name "deco") 3)
    ((string=? name "stone") 2)
    ((string=? name "pastel") 3)
    ((string=? name "brick") 3)
    ((string=? name "bay") 3)
    ((string=? name "wall") 4)
    ((string=? name "mist") 2)
    ((string=? name "canal") 3)
    (else 9)))

(define (edsl-budget props style)
  (let ((a (edsl-cost (if (pair? props) (car props) "")))
        (b (if (and (pair? props) (pair? (cdr props))) (edsl-cost (car (cdr props))) 0))
        (c (if (and (pair? props) (pair? (cdr props)) (pair? (cdr (cdr props))))
             (edsl-cost (car (cdr (cdr props))))
             0)))
    (+ (* 8 (edsl-style-cost style))
       16 8
       (if (string=? style "canal") 8 0)
       a (* 4 b) (* 2 c))))

(define (edsl-make id title en region mood style part light fog-a
                   sky sky1 fog sun path curb ground hill hill2 water build roof mote props)
  (hash "id" id "title" title "title-en" en "region" region
        "mood" mood "style" style "part" part
        "light" (exact->inexact light) "fog-amt" (exact->inexact fog-a)
        "sky" sky "sky1" sky1 "fog" fog "sun" sun "path" path "curb" curb
        "ground" ground "hill" hill "hill2" hill2 "water" water
        "build" build "roof" roof "mote" mote "props" props))

