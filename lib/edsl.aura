(define (edsl-all)
  (append edsl-cities edsl-templates))

(define (edsl-find xs id)
  (let loop ((ys xs))
    (if (or (not (pair? ys)) (null? ys))
      #f
      (if (string=? (hash-ref (car ys) "id" "") id)
        (car ys)
        (loop (cdr ys))))))

(define (edsl-find-key xs key)
  (let loop ((ys xs))
    (if (or (not (pair? ys)) (null? ys))
      #f
      (if (string=? (hash-ref (car ys) "key" "") key)
        (car ys)
        (loop (cdr ys))))))

(define (edsl-get id)
  (let ((row (edsl-find edsl-cities id)))
    (if row row (edsl-find edsl-templates id))))

(define (edsl-title name lang)
  (let ((zh (string=? lang "zh")))
    (cond
      ((string=? name "beijing") (if zh "北京" "Beijing"))
      ((string=? name "shanghai") (if zh "上海" "Shanghai"))
      ((string=? name "hangzhou") (if zh "杭州" "Hangzhou"))
      ((string=? name "chengdu") (if zh "成都" "Chengdu"))
      ((string=? name "xian") (if zh "西安" "Xi'an"))
      ((string=? name "chongqing") (if zh "重庆" "Chongqing"))
      ((string=? name "hongkong") (if zh "香港" "Hong Kong"))
      ((string=? name "newyork") (if zh "纽约" "New York"))
      ((string=? name "sanfrancisco") (if zh "旧金山" "San Francisco"))
      ((string=? name "losangeles") (if zh "洛杉矶" "Los Angeles"))
      ((string=? name "paris") (if zh "巴黎" "Paris"))
      ((string=? name "london") (if zh "伦敦" "London"))
      ((string=? name "rome") (if zh "罗马" "Rome"))
      ((string=? name "venice") (if zh "威尼斯" "Venice"))
      ((string=? name "tokyo") (if zh "东京" "Tokyo"))
      ((string=? name "visit-china") (if zh "中国" "China"))
      ((string=? name "visit-us") (if zh "美国" "America"))
      ((string=? name "visit-europe") (if zh "欧洲" "Europe"))
      ((string=? name "visit-asia") (if zh "亚洲" "Asia"))
      ((string=? name "visit-world") (if zh "远方" "Far away"))
      (else ""))))

(define (edsl-index xs name)
  (let loop ((ys xs) (i 0))
    (if (or (not (pair? ys)) (null? ys))
      -1
      (if (string=? (car ys) name) i (loop (cdr ys) (+ i 1))))))

(define (edsl-next region current)
  (let ((xs (cond
              ((string=? region "china") edsl-china)
              ((string=? region "us") edsl-us)
              ((string=? region "europe") edsl-europe)
              ((string=? region "world") edsl-world)
              (else (list)))))
    (if (null? xs)
      ""
      (list-ref xs (modulo (+ (edsl-index xs (if (string? current) current "")) 1) (length xs))))))

(define (edsl-join-nums xs)
  (let loop ((ys xs) (acc ""))
    (if (or (not (pair? ys)) (null? ys))
      acc
      (loop (cdr ys)
            (if (string=? acc "")
              (edsl-num (car ys))
              (string-append acc " " (edsl-num (car ys))))))))

(define (edsl-join-syms xs)
  (let loop ((ys xs) (acc ""))
    (if (or (not (pair? ys)) (null? ys))
      acc
      (loop (cdr ys)
            (if (string=? acc "")
              (car ys)
              (string-append acc " " (car ys)))))))

(define (edsl-form spec)
  (string-append
    "(biome " (hash-ref spec "id" "visit-world")
    " (sky " (edsl-join-nums (hash-ref spec "sky")) ")"
    " (sky1 " (edsl-join-nums (hash-ref spec "sky1")) ")"
    " (fog " (edsl-join-nums (append (hash-ref spec "fog") (list (hash-ref spec "fog-amt")))) ")"
    " (sun " (edsl-join-nums (hash-ref spec "sun")) ")"
    " (path " (edsl-join-nums (hash-ref spec "path")) ")"
    " (curb " (edsl-join-nums (hash-ref spec "curb")) ")"
    " (ground " (edsl-join-nums (hash-ref spec "ground")) ")"
    " (hill " (edsl-join-nums (hash-ref spec "hill")) ")"
    " (hill2 " (edsl-join-nums (hash-ref spec "hill2")) ")"
    " (water " (edsl-join-nums (hash-ref spec "water")) ")"
    " (build " (edsl-join-nums (hash-ref spec "build")) ")"
    " (roof " (edsl-join-nums (hash-ref spec "roof")) ")"
    " (mote " (edsl-join-nums (hash-ref spec "mote")) ")"
    " (light " (edsl-num (hash-ref spec "light")) ")"
    " (mood " (hash-ref spec "mood" "day") ")"
    " (style " (hash-ref spec "style" "stone") ")"
    " (part " (hash-ref spec "part" "none") ")"
    " (props " (edsl-join-syms (hash-ref spec "props" (list))) "))"))

(define (edsl-clause form name)
  (let loop ((xs (if (and (pair? form) (pair? (cdr form))) (cdr (cdr form)) (list))))
    (if (or (not (pair? xs)) (null? xs))
      #f
      (let ((sp (car xs)))
        (if (and (pair? sp) (string? (car sp)) (string=? (car sp) name))
          sp
          (loop (cdr xs)))))))

(define (edsl-heads-ok? form)
  (let loop ((xs (cdr (cdr form))))
    (if (or (not (pair? xs)) (null? xs))
      #t
      (let ((sp (car xs)))
        (if (or (not (pair? sp)) (not (string? (car sp))) (not (edsl-member? edsl-heads (car sp))))
          #f
          (loop (cdr xs)))))))

(define (edsl-nums sp n)
  (let loop ((xs (if (pair? sp) (cdr sp) (list))) (k 0) (acc (list)))
    (if (= k n)
      (if (null? xs) (reverse acc) #f)
      (if (or (null? xs) (not (number? (car xs))))
        #f
        (loop (cdr xs) (+ k 1) (cons (exact->inexact (car xs)) acc))))))

(define (edsl-syms sp)
  (let loop ((xs (if (pair? sp) (cdr sp) (list))) (acc (list)))
    (if (or (not (pair? xs)) (null? xs))
      (reverse acc)
      (if (string? (car xs))
        (loop (cdr xs) (cons (car xs) acc))
        #f))))

(define (edsl-chan? n)
  (and (number? n) (>= n 0.0) (<= n 1.0)))

(define (edsl-rgb? xs)
  (and (pair? xs) (= (length xs) 3)
       (edsl-chan? (car xs))
       (edsl-chan? (car (cdr xs)))
       (edsl-chan? (car (cdr (cdr xs))))))

(define (edsl-gap a b)
  (max (edsl-abs (- (car a) (car b)))
       (edsl-abs (- (car (cdr a)) (car (cdr b))))
       (edsl-abs (- (car (cdr (cdr a))) (car (cdr (cdr b)))))))

(define (edsl-sum xs)
  (+ (car xs) (car (cdr xs)) (car (cdr (cdr xs)))))

(define (edsl-props-ok? xs)
  (and (pair? xs) (<= (length xs) 3)
       (let loop ((ys xs))
         (if (or (not (pair? ys)) (null? ys))
           #t
           (if (edsl-member? edsl-props (car ys))
             (loop (cdr ys))
             #f)))))

(define (edsl-safe-id? s)
  (and (string? s) (> (string-length s) 0) (<= (string-length s) 16)
       (let ((c0 (string-ref s 0)))
         (and (>= c0 97) (<= c0 122)
              (let loop ((i 1))
                (if (>= i (string-length s))
                  #t
                  (let ((c (string-ref s i)))
                    (if (or (and (>= c 97) (<= c 122))
                            (and (>= c 48) (<= c 57))
                            (= c 45))
                      (loop (+ i 1))
                      #f))))))))

(define (edsl-fail why)
  (hash "ok" #f "why" why "id" "" "title" "" "title-en" ""
        "mood" "" "style" "" "part" "" "light" 0.0 "fog-amt" 0.0
        "props" (list) "instances" 0
        "violations" (hash "budget" 1.0 "geometry" 0.0 "reachable" 1.0 "safe" 0.0)))

(define (edsl-cut text)
  (if (not (string? text))
    #f
    (let ((i (string-index text "(biome" 0)))
      (if (< i 0)
        #f
        (let loop ((k i) (depth 0))
          (if (>= k (string-length text))
            #f
            (let ((c (string-ref text k)))
              (cond
                ((= c 40) (loop (+ k 1) (+ depth 1)))
                ((= c 41)
                 (if (= depth 1)
                   (substring text i (+ k 1))
                   (if (<= depth 1) #f (loop (+ k 1) (- depth 1)))))
                (else (loop (+ k 1) depth))))))))))

(define (edsl-check text)
  (let ((src (if (and (string? text) (edsl-has? text "(biome")) (edsl-cut text) text)))
    (if (or (not (string? src)) (> (string-length src) 690))
      (edsl-fail "long")
      (let ((form (sexp-parse src)))
        (if (or (not form) (not (edsl-safe-id? (let ((id (if (and (pair? form) (pair? (cdr form)) (string? (car (cdr form)))) (car (cdr form)) ""))) id)))
                (not (edsl-heads-ok? form)))
          (edsl-fail "form")
          (let ((id (car (cdr form))))
            (let ((bad
                    (let loop ((hs edsl-heads))
                      (if (null? hs)
                        ""
                        (if (not (edsl-clause form (car hs)))
                          (car hs)
                          (loop (cdr hs)))))))
              (if (not (string=? bad ""))
                (edsl-fail bad)
                (let ((sky (edsl-nums (edsl-clause form "sky") 3))
                      (sky1 (edsl-nums (edsl-clause form "sky1") 3))
                      (fog4 (edsl-nums (edsl-clause form "fog") 4))
                      (sun (edsl-nums (edsl-clause form "sun") 3))
                      (path (edsl-nums (edsl-clause form "path") 3))
                      (curb (edsl-nums (edsl-clause form "curb") 3))
                      (ground (edsl-nums (edsl-clause form "ground") 3))
                      (hill (edsl-nums (edsl-clause form "hill") 3))
                      (hill2 (edsl-nums (edsl-clause form "hill2") 3))
                      (water (edsl-nums (edsl-clause form "water") 3))
                      (build (edsl-nums (edsl-clause form "build") 3))
                      (roof (edsl-nums (edsl-clause form "roof") 3))
                      (mote (edsl-nums (edsl-clause form "mote") 3))
                      (light (edsl-nums (edsl-clause form "light") 1))
                      (mood (edsl-syms (edsl-clause form "mood")))
                      (style (edsl-syms (edsl-clause form "style")))
                      (part (edsl-syms (edsl-clause form "part")))
                      (props (edsl-syms (edsl-clause form "props"))))
                  (cond
                    ((not (and sky sky1 sun path curb ground hill hill2 water build roof mote))
                     (edsl-fail "channel"))
                    ((not fog4) (edsl-fail "fog"))
                    ((not (and (edsl-rgb? sky) (edsl-rgb? sky1) (edsl-rgb? sun) (edsl-rgb? path)
                               (edsl-rgb? curb) (edsl-rgb? ground) (edsl-rgb? hill) (edsl-rgb? hill2)
                               (edsl-rgb? water) (edsl-rgb? build) (edsl-rgb? roof) (edsl-rgb? mote)
                               (edsl-chan? (car fog4)) (edsl-chan? (car (cdr fog4))) (edsl-chan? (car (cdr (cdr fog4))))))
                     (edsl-fail "channel"))
                    ((not light) (edsl-fail "light"))
                    ((or (< (car (cdr (cdr (cdr fog4)))) 0.0) (> (car (cdr (cdr (cdr fog4)))) 0.30))
                     (edsl-fail "fog"))
                    ((or (< (car light) 0.74) (> (car light) 1.0)) (edsl-fail "light"))
                    ((or (not mood) (not (= (length mood) 1)) (not (edsl-member? edsl-moods (car mood))))
                     (edsl-fail "mood"))
                    ((or (not style) (not (= (length style) 1)) (not (edsl-member? edsl-styles (car style))))
                     (edsl-fail "style"))
                    ((or (not part) (not (= (length part) 1)) (not (edsl-member? edsl-parts (car part))))
                     (edsl-fail "part"))
                    ((not (edsl-props-ok? props)) (edsl-fail "props"))
                    ((not (> (edsl-sum path) 0.45)) (edsl-fail "path"))
                    ((or (< (edsl-gap path edsl-hurdle) 0.18) (< (edsl-gap path edsl-gate) 0.18))
                     (edsl-fail "contrast"))
                    (else
                     (let ((n (edsl-budget props (car style))))
                       (if (> n edsl-cap)
                         (edsl-fail "budget")
                         (hash "ok" #t "why" "fair" "src" src "id" id
                               "title" (edsl-title id "zh") "title-en" (edsl-title id "en")
                               "region" "" "mood" (car mood) "style" (car style) "part" (car part)
                               "light" (car light)
                               "fog-amt" (car (cdr (cdr (cdr fog4))))
                               "sky" sky "sky1" sky1
                               "fog" (list (car fog4) (car (cdr fog4)) (car (cdr (cdr fog4))))
                               "sun" sun "path" path "curb" curb "ground" ground
                               "hill" hill "hill2" hill2 "water" water "build" build "roof" roof
                               "mote" mote "props" props "instances" n
                               "violations" (hash "budget" 0.0 "geometry" 0.0 "reachable" 0.0 "safe" 0.0)))))))))))))))

(define (edsl-public spec)
  (if (not (and (hash? spec) (hash-ref spec "ok" #t)))
    #f
    (hash "id" (hash-ref spec "id" "")
          "title" (hash-ref spec "title" "")
          "titleEn" (hash-ref spec "title-en" "")
          "region" (hash-ref spec "region" "")
          "mood" (hash-ref spec "mood" "day")
          "style" (hash-ref spec "style" "")
          "part" (hash-ref spec "part" "")
          "light" (hash-ref spec "light" 0.8)
          "fogAmt" (hash-ref spec "fog-amt" 0.2)
          "sky" (hash-ref spec "sky")
          "sky1" (hash-ref spec "sky1")
          "fog" (hash-ref spec "fog")
          "sun" (hash-ref spec "sun")
          "path" (hash-ref spec "path")
          "curb" (hash-ref spec "curb")
          "ground" (hash-ref spec "ground")
          "hill" (hash-ref spec "hill")
          "hill2" (hash-ref spec "hill2")
          "water" (hash-ref spec "water")
          "build" (hash-ref spec "build")
          "roof" (hash-ref spec "roof")
          "mote" (hash-ref spec "mote")
          "props" (hash-ref spec "props" (list)))))

(define (edsl-named spec name)
  (let ((t (if (and (string? name) (> (string-length name) 0))
             (if (> (string-length name) 16) (substring name 0 16) name)
             (hash-ref spec "title" ""))))
    (hash-set (hash-set spec "title" t) "title-en" t)))

(define (edsl-cjk? s)
  (let ((n (if (string? s) (string-length s) 0)))
    (let loop ((i 0))
      (if (>= i n)
        #f
        (let ((c (string-ref s i)))
          (if (and (>= c 19968) (<= c 40895))
            #t
            (loop (+ i 1))))))))

(define (edsl-hash s)
  (let ((n (if (string? s) (string-length s) 0)))
    (let loop ((i 0) (h 0))
      (if (>= i n)
        h
        (loop (+ i 1) (modulo (+ (* h 33) (string-ref s i)) 997))))))

(define (edsl-key name)
  (let ((s (if (string? name) name ""))
        (low (if (string? name) (string-downcase name) "")))
    (cond
      ((or (edsl-has? s "拉萨") (edsl-has? s "藏") (edsl-has? s "疆")
           (edsl-has? low "lhasa") (edsl-has? low "tibet")) "china-high")
      ((or (edsl-has? s "大理") (edsl-has? s "洱") (edsl-has? low "dali")) "china-lake")
      ((or (edsl-has? s "桂林") (edsl-has? s "漓") (edsl-has? low "guilin")) "china-mist")
      ((or (edsl-has? s "阿姆斯特丹") (edsl-has? s "运河") (edsl-has? low "amsterdam")) "europe-canal")
      ((or (edsl-has? s "布拉格") (edsl-has? s "维也纳") (edsl-has? s "柏林")
           (edsl-has? low "prague") (edsl-has? low "vienna") (edsl-has? low "berlin")) "europe-stone")
      ((or (edsl-has? s "芝加哥") (edsl-has? s "波士顿") (edsl-has? s "西雅图")
           (edsl-has? low "chicago") (edsl-has? low "boston") (edsl-has? low "seattle")) "us-brick")
      ((or (edsl-has? s "京都") (edsl-has? s "大阪") (edsl-has? s "首尔")
           (edsl-has? s "新加坡") (edsl-has? s "曼谷")
           (edsl-has? low "kyoto") (edsl-has? low "osaka") (edsl-has? low "seoul")
           (edsl-has? low "singapore") (edsl-has? low "bangkok")) "asia-neon")
      ((edsl-cjk? s)
       (list-ref (list "china-mist" "china-high" "china-lake") (modulo (edsl-hash s) 3)))
      (else
       (list-ref (list "europe-stone" "us-brick" "asia-neon" "world-palm") (modulo (edsl-hash low) 4))))))

(define (edsl-fallback name)
  (let ((row (edsl-find-key edsl-templates (edsl-key name))))
    (if (not row)
      #f
      (edsl-named row (if (string? name) name "")))))

(define (edsl-copy-title spec)
  spec)

(define (edsl-say spec lang)
  (let ((zh (string=? lang "zh"))
        (t (if (hash? spec)
             (if (string=? lang "zh") (hash-ref spec "title" "") (hash-ref spec "title-en" ""))
             "")))
    (if (or (not (string? t)) (= (string-length t) 0))
      ""
      (if zh (string-append "来到" t "了") (string-append t " is here")))))

(define (edsl-row act name)
  (hash "act" act "name" name "dir" 1
        "zh" "" "en" ""))

(define (edsl-remove? text low)
  (or (edsl-has? text "去掉") (edsl-has? text "拿掉") (edsl-has? text "不要")
      (edsl-has? text "删除") (edsl-has? text "移除")
      (edsl-has? low "remove") (edsl-has? low "take away")))

(define (edsl-soft? text low)
  (or (edsl-has? low "sunny") (edsl-has? low "pink") (edsl-has? low "paint")
      (edsl-has? low "flower") (edsl-has? low "golden")
      (edsl-has? text "粉色") (edsl-has? text "金色") (edsl-has? text "花朵")))

(define (edsl-han text i)
  (let ((n (string-length text)))
    (let loop ((k i) (s "") (c 0))
      (if (or (>= k n) (>= c 8))
        s
        (let ((code (string-ref text k)))
          (if (and (>= code 19968) (<= code 40895))
            (loop (+ k 1) (string-append s (substring text k (+ k 1))) (+ c 1))
            s))))))

(define (edsl-skip? name)
  (edsl-member?
    (list "花园" "草地" "城市" "都市" "太空" "星空" "宇宙" "海边" "海岸" "海洋" "沙滩"
          "夜晚" "夜景" "黑夜" "晚上" "日落" "黄昏" "霓虹" "赛博" "白天" "晴天"
          "那里" "这里" "前面" "后面" "家里" "快点" "慢点" "左边" "右边"
          "garden" "city" "space" "universe" "coast" "ocean" "beach"
          "night" "day" "sunset" "dusk" "neon" "cyber"
          "there" "here" "home" "faster" "slower" "the city" "the garden")
    name))

(define (edsl-drop-the s)
  (if (and (string? s) (>= (string-length s) 4) (string=? (substring s 0 4) "the "))
    (substring s 4 (string-length s))
    s))

(define (edsl-ask text low)
  (if (edsl-remove? text low)
    ""
    (let ((go (string-index text "去" 0))
          (to (string-index text "前往" 0)))
      (let ((name
              (cond
                ((>= to 0) (edsl-han text (+ to 2)))
                ((>= go 0) (edsl-han text (+ go 1)))
                ((and (> (string-length text) 0) (= (string-ref text 0) (string-ref "到" 0)))
                 (edsl-han text 1))
                (else ""))))
        (if (and (string? name) (>= (string-length name) 2) (not (edsl-skip? name)))
          name
          (let ((mark (cond
                        ((>= (string-index low "take me to " 0) 0) "take me to ")
                        ((>= (string-index low "go to " 0) 0) "go to ")
                        ((>= (string-index low "goto " 0) 0) "goto ")
                        (else ""))))
            (if (string=? mark "")
              ""
              (let ((i (string-index low mark 0)))
                (let ((rest (edsl-drop-the (substring text (+ i (string-length mark)) (string-length text)))))
                  (let ((trim (if (> (string-length rest) 24) (substring rest 0 24) rest)))
                    (if (and (>= (string-length trim) 2) (not (edsl-skip? (string-downcase trim))))
                      trim
                      "")))))))))))

(define (edsl-city text low)
  (cond
    ((or (edsl-has? text "北京") (edsl-word? low "beijing") (edsl-word? low "peking")) "beijing")
    ((or (edsl-has? text "上海") (edsl-word? low "shanghai")) "shanghai")
    ((or (edsl-has? text "杭州") (edsl-has? text "西湖") (edsl-word? low "hangzhou")) "hangzhou")
    ((or (edsl-has? text "成都") (edsl-word? low "chengdu")) "chengdu")
    ((or (edsl-has? text "西安") (edsl-has? low "xi'an") (edsl-has? low "xi an") (edsl-word? low "xian")) "xian")
    ((or (edsl-has? text "重庆") (edsl-word? low "chongqing")) "chongqing")
    ((or (edsl-has? text "香港") (edsl-has? low "hong kong") (edsl-word? low "hongkong")) "hongkong")
    ((or (edsl-has? text "纽约") (edsl-has? low "new york") (edsl-word? low "newyork") (edsl-word? low "nyc")) "newyork")
    ((or (edsl-has? text "旧金山") (edsl-has? low "san francisco") (edsl-word? low "sanfrancisco")) "sanfrancisco")
    ((or (edsl-has? text "洛杉矶") (edsl-has? low "los angeles") (edsl-word? low "losangeles")) "losangeles")
    ((or (edsl-has? text "巴黎") (edsl-word? low "paris")) "paris")
    ((or (edsl-has? text "伦敦") (edsl-word? low "london")) "london")
    ((or (edsl-has? text "罗马") (edsl-word? low "rome")) "rome")
    ((or (edsl-has? text "威尼斯") (edsl-word? low "venice")) "venice")
    ((or (edsl-has? text "东京") (edsl-has? text "東京") (edsl-word? low "tokyo")) "tokyo")
    (else "")))

; A known city, a regional tour, or another city name. #f lets the
; built-in venues and the garden wish answer.
(define (edsl-hear text low)
  (if (or (edsl-remove? text low) (not (string? text)))
    #f
    (let ((region
            (cond
              ((or (edsl-has? text "环球旅行") (edsl-has? text "下一个城市") (edsl-has? text "下个城市")
                   (edsl-has? low "world tour")
                   (and (edsl-word? low "next") (edsl-word? low "city")
                        (not (edsl-word? low "scene")) (not (edsl-word? low "biome"))))
               "world")
              ((or (edsl-has? text "中国城市") (edsl-has? text "去中国")
                   (edsl-has? low "chinese cities") (edsl-has? low "china cities")
                   (edsl-has? low "go to china") (edsl-word? low "china"))
               "china")
              ((or (edsl-has? text "美国城市") (edsl-has? text "去美国")
                   (edsl-has? low "american cities") (edsl-has? low "go to america")
                   (edsl-word? low "america"))
               "us")
              ((or (edsl-has? text "欧洲城市") (edsl-has? text "去欧洲")
                   (edsl-has? low "european cities") (edsl-has? low "go to europe")
                   (edsl-word? low "europe"))
               "europe")
              (else ""))))
      (if (not (string=? region ""))
        (edsl-row "biome-tour" region)
        (let ((city (edsl-city text low)))
          (if (not (string=? city ""))
            (edsl-row "biome" city)
            (if (edsl-soft? text low)
              #f
              (let ((asked (edsl-ask text low)))
                (if (string=? asked "")
                  #f
                  (edsl-row "biome-ask" asked))))))))))
