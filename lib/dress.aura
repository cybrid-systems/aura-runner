; Roadside sculptures. Nested primitives and transforms.
; The picture reads the expanded cubes. This file does not draw.
;
; (dress city
;   (mirror
;     (place 1 0
;       (float 0.55
;         (spin 0.4
;           (stack 3 0.5
;             (shard 0.8 trim)))))))
;
; A candidate is kept when the contract passes. Evolution only replaces
; the live form when qd:insert! accepts it, so a new motion or depth
; cell wins and a repeat does not.
(require "std/string" all:)
(require "std/evo-core" all:)
(require "std/qd" all:)
(require "lib/sexp")

(define dress-venues (list "city" "garden" "space" "coast"))
(define dress-roles (list "wall" "vary" "roof" "trim" "flower" "flower2" "leaf" "water" "sun" "hedge"))
(define dress-default
  "(dress city (mirror (place 1 0 (float 0.55 (spin 0.4 (stack 3 0.5 (shard 0.8 trim)))))))")
(define dress-cap 16)
(define dress-lane 4.6)
(define dress-anchor 6.5)
(define dress-height 5.6)

(define (dress-member? xs name)
  (let loop ((ys xs))
    (if (or (not (pair? ys)) (null? ys))
      #f
      (if (and (string? (car ys)) (string=? (car ys) name))
        #t
        (loop (cdr ys))))))

(define (dress-num? v lo hi)
  (and (number? v) (>= v lo) (<= v hi)))

(define (dress-last xs)
  (if (or (not (pair? xs)) (null? (cdr xs)))
    (if (pair? xs) (car xs) #f)
    (dress-last (cdr xs))))

(define (dress-cube x y z sx sy sz role shape)
  (hash "x" x "y" y "z" z "sx" sx "sy" sy "sz" sz "role" role "shape" shape "spin" 0.0 "float" 0.0))

(define (dress-prim expr)
  (if (or (not (pair? expr)) (not (string? (car expr))))
    #f
    (let ((op (car expr))
          (role (dress-last expr))
          (n (length expr)))
      (if (not (dress-member? dress-roles role))
        #f
        (cond
          ((and (string=? op "box") (= n 5)
                (dress-num? (list-ref expr 1) 0.1 2.0)
                (dress-num? (list-ref expr 2) 0.1 2.0)
                (dress-num? (list-ref expr 3) 0.1 2.0))
           (list (dress-cube 0.0 (/ (list-ref expr 2) 2.0) 0.0
                             (list-ref expr 1) (list-ref expr 2) (list-ref expr 3) role 0)))
          ((and (string=? op "rod") (= n 3) (dress-num? (list-ref expr 1) 0.4 2.4))
           (let ((h (list-ref expr 1)))
             (list (dress-cube 0.0 (/ h 2.0) 0.0 0.14 h 0.14 role 0))))
          ((and (string=? op "slab") (= n 4)
                (dress-num? (list-ref expr 1) 0.3 2.0)
                (dress-num? (list-ref expr 2) 0.3 2.0))
           (list (dress-cube 0.0 0.07 0.0 (list-ref expr 1) 0.14 (list-ref expr 2) role 0)))
          ((and (string=? op "arch") (= n 4)
                (dress-num? (list-ref expr 1) 0.6 2.2)
                (dress-num? (list-ref expr 2) 0.6 2.2))
           (let ((w (list-ref expr 1)) (h (list-ref expr 2)) (post (- (/ (list-ref expr 1) 2.0) 0.1)))
             (list (dress-cube (- post) (/ h 2.0) 0.0 0.18 h 0.18 role 0)
                   (dress-cube post (/ h 2.0) 0.0 0.18 h 0.18 role 0)
                   (dress-cube 0.0 h 0.0 w 0.16 0.22 role 0))))
          ((and (string=? op "shard") (= n 3) (dress-num? (list-ref expr 1) 0.4 2.0))
           (let ((h (list-ref expr 1)))
             (list (dress-cube 0.0 (/ h 2.0) 0.0 0.22 h 0.5 role 0))))
          ((and (string=? op "ring") (= n 3) (dress-num? (list-ref expr 1) 0.3 1.2))
           (let ((r (list-ref expr 1)) (y (* (list-ref expr 1) 0.35)))
             (list (dress-cube (- r) y 0.0 0.22 0.22 0.22 role 0)
                   (dress-cube r y 0.0 0.22 0.22 0.22 role 0)
                   (dress-cube 0.0 y (- r) 0.22 0.22 0.22 role 0)
                   (dress-cube 0.0 y r 0.22 0.22 0.22 role 0))))
          ((and (string=? op "spire") (= n 3) (dress-num? (list-ref expr 1) 0.8 2.4))
           (let* ((h (list-ref expr 1))
                  (a (* h 0.46)) (b (* h 0.32)) (c (* h 0.22)))
             (list (dress-cube 0.0 (/ a 2.0) 0.0 0.55 a 0.55 role 0)
                   (dress-cube 0.0 (+ a (/ b 2.0)) 0.0 0.36 b 0.36 role 0)
                   (dress-cube 0.0 (+ a b (/ c 2.0)) 0.0 0.18 c 0.18 role 0))))
          ((and (string=? op "lantern") (= n 2))
           (list (dress-cube 0.0 0.55 0.0 0.1 1.1 0.1 role 0)
                 (dress-cube 0.0 1.25 0.0 0.28 0.28 0.28 role 1)))
          ((and (string=? op "disc") (= n 3) (dress-num? (list-ref expr 1) 0.3 1.4))
           (let ((r (list-ref expr 1)))
             (list (dress-cube 0.0 0.05 0.0 (* r 2.0) 0.1 (* r 2.0) role 0))))
          ((and (string=? op "bloom") (= n 2))
           (list (dress-cube 0.0 0.28 0.0 0.5 0.5 0.5 role 1)
                 (dress-cube -0.16 0.34 0.06 0.18 0.18 0.18 role 1)
                 (dress-cube 0.14 0.32 -0.06 0.16 0.16 0.16 role 1)))
          (else #f))))))

(define (dress-top cubes)
  (let loop ((ys cubes) (top 0.0))
    (if (or (not (pair? ys)) (null? ys))
      top
      (let ((c (car ys)))
        (loop (cdr ys) (max top (+ (hash-ref c "y" 0.0) (/ (hash-ref c "sy" 0.0) 2.0))))))))

(define (dress-shift cubes dy)
  (let loop ((ys cubes) (acc (list)))
    (if (or (not (pair? ys)) (null? ys))
      (reverse acc)
      (loop (cdr ys) (cons (hash-set (car ys) "y" (+ (hash-ref (car ys) "y" 0.0) dy)) acc)))))

(define (dress-expr expr depth)
  (if (or (not (pair? expr)) (not (string? (car expr))) (> depth 8))
    #f
    (let ((op (car expr)))
      (cond
        ((or (string=? op "box") (string=? op "rod") (string=? op "slab") (string=? op "arch")
             (string=? op "shard") (string=? op "ring") (string=? op "spire") (string=? op "lantern")
             (string=? op "disc") (string=? op "bloom"))
         (dress-prim expr))
        ((and (string=? op "join") (= (length expr) 3))
         (let ((a (dress-expr (list-ref expr 1) (+ depth 1)))
               (b (dress-expr (list-ref expr 2) (+ depth 1))))
           (if (and a b) (append a b) #f)))
        (else
         (let ((inner (dress-expr (dress-last expr) (+ depth 1))))
           (if (not inner)
             #f
             (cond
               ((and (string=? op "move") (= (length expr) 5)
                     (dress-num? (list-ref expr 1) -4.0 4.0)
                     (dress-num? (list-ref expr 2) -0.2 3.0)
                     (dress-num? (list-ref expr 3) -4.0 4.0))
                (let ((x (list-ref expr 1)) (y (list-ref expr 2)) (z (list-ref expr 3)))
                  (let loop ((ys inner) (acc (list)))
                    (if (null? ys)
                      (reverse acc)
                      (let ((c (car ys)))
                        (loop (cdr ys)
                              (cons (hash-set (hash-set (hash-set c "x" (+ (hash-ref c "x" 0.0) x))
                                                        "y" (+ (hash-ref c "y" 0.0) y))
                                              "z" (+ (hash-ref c "z" 0.0) z))
                                    acc)))))))
               ((and (string=? op "yaw") (= (length expr) 3) (dress-num? (list-ref expr 1) -0.5 0.5))
                (let* ((t (* (list-ref expr 1) 6.283185307179586))
                       (co (cos t)) (si (sin t)))
                  (let loop ((ys inner) (acc (list)))
                    (if (null? ys)
                      (reverse acc)
                      (let* ((c (car ys))
                             (x (hash-ref c "x" 0.0))
                             (z (hash-ref c "z" 0.0)))
                        (loop (cdr ys)
                              (cons (hash-set (hash-set c "x" (- (* x co) (* z si)))
                                              "z" (+ (* x si) (* z co)))
                                    acc)))))))
               ((and (string=? op "scale") (= (length expr) 3) (dress-num? (list-ref expr 1) 0.4 1.6))
                (let ((k (list-ref expr 1)))
                  (let loop ((ys inner) (acc (list)))
                    (if (null? ys)
                      (reverse acc)
                      (let ((c (car ys)))
                        (loop (cdr ys)
                              (cons (hash-set (hash-set (hash-set (hash-set (hash-set (hash-set c
                                  "x" (* (hash-ref c "x" 0.0) k))
                                  "y" (* (hash-ref c "y" 0.0) k))
                                  "z" (* (hash-ref c "z" 0.0) k))
                                  "sx" (* (hash-ref c "sx" 0.0) k))
                                  "sy" (* (hash-ref c "sy" 0.0) k))
                                  "sz" (* (hash-ref c "sz" 0.0) k))
                                    acc)))))))
               ((and (string=? op "float") (= (length expr) 3) (dress-num? (list-ref expr 1) 0.0 1.2))
                (let loop ((ys inner) (acc (list)))
                  (if (null? ys)
                    (reverse acc)
                    (loop (cdr ys) (cons (hash-set (car ys) "float" (list-ref expr 1)) acc)))))
               ((and (string=? op "spin") (= (length expr) 3) (dress-num? (list-ref expr 1) 0.0 1.5))
                (let loop ((ys inner) (acc (list)))
                  (if (null? ys)
                    (reverse acc)
                    (loop (cdr ys) (cons (hash-set (car ys) "spin" (list-ref expr 1)) acc)))))
               ((and (string=? op "stack") (= (length expr) 4)
                     (dress-num? (list-ref expr 1) 1.0 4.0)
                     (dress-num? (list-ref expr 2) 0.15 1.2))
                (let ((n (inexact->exact (floor (+ (list-ref expr 1) 0.001))))
                      (step (+ (dress-top inner) (list-ref expr 2))))
                  (let loop ((i 0) (acc (list)))
                    (if (>= i n)
                      acc
                      (loop (+ i 1) (append acc (dress-shift inner (* i step))))))))
               ((and (string=? op "recur") (= (length expr) 4)
                     (dress-num? (list-ref expr 1) 2.0 3.0)
                     (dress-num? (list-ref expr 2) 0.5 0.8))
                (let ((n (inexact->exact (floor (+ (list-ref expr 1) 0.001))))
                      (shrink (list-ref expr 2)))
                  (let loop ((i 0) (lift 0.0) (k 1.0) (acc (list)))
                    (if (>= i n)
                      acc
                      (let ((layer (let copy ((ys inner) (row (list)))
                                     (if (null? ys)
                                       (reverse row)
                                       (let ((c (car ys)))
                                         (copy (cdr ys)
                                               (cons (hash-set (hash-set (hash-set (hash-set (hash-set (hash-set c
                                                   "x" (* (hash-ref c "x" 0.0) k))
                                                   "y" (+ (* (hash-ref c "y" 0.0) k) lift))
                                                   "z" (* (hash-ref c "z" 0.0) k))
                                                   "sx" (* (hash-ref c "sx" 0.0) k))
                                                   "sy" (* (hash-ref c "sy" 0.0) k))
                                                   "sz" (* (hash-ref c "sz" 0.0) k))
                                                     row)))))))
                        (loop (+ i 1) (dress-top layer) (* k shrink) (append acc layer)))))))
               (else #f)))))))))

(define (dress-site side along cubes)
  (hash "side" side "along" along "cubes" cubes))

(define (dress-group expr depth)
  (if (or (not (pair? expr)) (not (string? (car expr))) (> depth 4))
    #f
    (cond
      ((and (string=? (car expr) "mirror") (= (length expr) 2))
       (let ((inner (dress-group (list-ref expr 1) (+ depth 1))))
         (if (not inner)
           #f
           (let ((flipped (let loop ((ys inner) (acc (list)))
                            (if (null? ys)
                              (reverse acc)
                              (loop (cdr ys)
                                    (cons (dress-site (- (hash-ref (car ys) "side" 1.0))
                                                      (hash-ref (car ys) "along" 0.0)
                                                      (hash-ref (car ys) "cubes" (list)))
                                          acc))))))
             (let ((sites (append inner flipped)))
               (if (> (length sites) 4) #f sites))))))
      ((and (string=? (car expr) "place") (= (length expr) 4)
            (number? (list-ref expr 1)) (= (abs (list-ref expr 1)) 1.0)
            (dress-num? (list-ref expr 2) -1.0 4.0))
       (let ((cubes (dress-expr (list-ref expr 3) 0)))
         (if cubes (list (dress-site (list-ref expr 1) (list-ref expr 2) cubes)) #f)))
      (else
       (let ((cubes (dress-expr expr 0)))
         (if cubes
           (list (dress-site 1.0 0.0 cubes) (dress-site -1.0 0.0 cubes))
           #f))))))

(define (dress-motion sites)
  (let loop ((ys sites) (fl #f) (sp #f))
    (if (or (not (pair? ys)) (null? ys))
      (+ (if fl 1 0) (if sp 2 0))
      (let scan ((cs (hash-ref (car ys) "cubes" (list))) (f fl) (s sp))
        (if (or (not (pair? cs)) (null? cs))
          (loop (cdr ys) f s)
          (let ((c (car cs)))
            (scan (cdr cs)
                  (or f (> (hash-ref c "float" 0.0) 0.0))
                  (or s (> (hash-ref c "spin" 0.0) 0.0)))))))))

(define (dress-depth expr)
  (if (or (not (pair? expr)) (null? expr) (not (string? (car expr))))
    0
    (let ((here (cond
                  ((and (or (string=? (car expr) "stack") (string=? (car expr) "recur"))
                        (pair? (cdr expr)) (number? (car (cdr expr))))
                   (inexact->exact (floor (+ (car (cdr expr)) 0.001))))
                  (else 0))))
      (min 6 (+ here (let loop ((ys (cdr expr)) (acc 0))
                       (if (or (not (pair? ys)) (null? ys))
                         acc
                         (loop (cdr ys) (+ acc (if (pair? (car ys)) (dress-depth (car ys)) 0))))))))))

(define (dress-judge sites)
  (let loop ((ys sites) (count 0) (readable #f))
    (if (or (not (pair? ys)) (null? ys))
      (if (= count 0)
        (hash "ok" #f "why" "shape" "count" 0)
        (if readable
          (hash "ok" #t "why" "fair" "count" count)
          (hash "ok" #f "why" "read" "count" count)))
      (let ((side (hash-ref (car ys) "side" 1.0))
            (cubes (hash-ref (car ys) "cubes" (list))))
        (let scan ((cs cubes) (n count) (read readable))
          (if (or (not (pair? cs)) (null? cs))
            (loop (cdr ys) n read)
            (let* ((c (car cs))
                   (n2 (+ n 1))
                   (lat (+ (* side dress-anchor) (hash-ref c "x" 0.0)))
                   (sx (hash-ref c "sx" 0.0))
                   (sy (hash-ref c "sy" 0.0))
                   (sz (hash-ref c "sz" 0.0))
                   (reach (/ (sqrt (+ (* sx sx) (* sz sz))) 2.0)))
              (cond
                ((> n2 dress-cap) (hash "ok" #f "why" "budget" "count" n2))
                ((< (- (abs lat) reach) dress-lane) (hash "ok" #f "why" "clearance" "count" n2))
                ((> (+ (hash-ref c "y" 0.0) (/ sy 2.0) (hash-ref c "float" 0.0)) dress-height)
                 (hash "ok" #f "why" "sight" "count" n2))
                ((< (min sx (min sy sz)) 0.1) (hash "ok" #f "why" "read" "count" n2))
                (else (scan (cdr cs) n2 (or read (>= (max sx (max sy sz)) 0.45))))))))))))

(define (dress-eval text)
  (let ((form (if (string? text) (sexp-parse text) #f)))
    (if (or (not (pair? form)) (not (string? (car form))) (not (string=? (car form) "dress"))
            (not (= (length form) 3)) (not (string? (list-ref form 1)))
            (not (dress-member? dress-venues (list-ref form 1))))
      (hash "ok" #f "why" "shape" "count" 0 "motion" 0 "depth" 0 "form" "")
      (let ((sites (dress-group (list-ref form 2) 0)))
        (if (not sites)
          (hash "ok" #f "why" "shape" "count" 0 "motion" 0 "depth" 0 "form" "")
          (let ((verdict (dress-judge sites)))
            (hash-set (hash-set (hash-set verdict
                      "motion" (dress-motion sites))
                      "depth" (dress-depth (list-ref form 2)))
                      "form" text)))))))

(define dress-form-live "")

(define (dress-gate text)
  (let* ((found (dress-eval text))
         (ok (and (hash? found) (hash-ref found "ok" #f)))
         (cand (evo:candidate (if (string? text) text "")
                              (hash "id" "dress" "target" "dress-form")))
         (trial (evo:trial cand
                           (hash "timeout-ms" 4000
                                 "apply" (lambda (c)
                                           (set! dress-form-live (if (string? text) text ""))
                                           #t)
                                 "evaluate"
                                 (lambda (c)
                                   (hash "status" "ok"
                                         "objectives" (hash "fair" (if ok 1.0 0.0))
                                         "constraints" (hash "budget" (if ok 0.0 1.0)
                                                              "clearance" (if ok 0.0 1.0)
                                                              "sight" (if ok 0.0 1.0))
                                         "behavior" (hash "band" 0.0)))))))
    (let ((keep (and ok trial (evo:trial-ok? trial) (evo:feasible? trial))))
      (hash "verdict" (if keep "KEEP" "ROLLBACK")
            "why" (if keep "fair" (hash-ref found "why" "shape"))
            "count" (hash-ref found "count" 0)
            "form" (if (string? text) text "")))))

(define (dress-blank)
  (qd:map-elites
    (hash "descriptors" (list (list "motion" 0 3 4) (list "depth" 0 6 4))
          "quality" "kept"
          "seed" 7)))

(define dress-archive (dress-blank))

(define (dress-keep! m text)
  (let ((found (dress-eval text)))
    (if (or (not (hash? m)) (not (hash? found)) (not (hash-ref found "ok" #f)))
      #f
      (let ((beh (list (exact->inexact (hash-ref found "motion" 0))
                       (exact->inexact (hash-ref found "depth" 0)))))
        (qd:insert! m
                    (evo:candidate text (hash "id" "dress" "target" "dress-form" "genome" text))
                    (+ 1.0 (qd:novelty m beh 3))
                    beh)))))

(define dress-prim-names
  (list "box" "rod" "slab" "arch" "shard" "ring" "spire" "lantern" "disc" "bloom"))
(define dress-role-names
  (list "wall" "vary" "roof" "trim" "flower" "flower2" "leaf" "water" "sun" "hedge"))

(define (dress-n2 n)
  (number->string (/ (round (* n 100.0)) 100.0)))

; One new tree. Bits of the seed pick the primitive, the role, and which
; transforms wrap it, so successive seeds are not a fixed menu.
(define (dress-candidate n)
  (let* ((prim (list-ref dress-prim-names (modulo n 10)))
         (role (list-ref dress-role-names (modulo (quotient n 2) 10)))
         (role2 (list-ref dress-role-names (modulo (+ n 5) 10)))
         (h (dress-n2 (+ 0.6 (* (modulo n 7) 0.12))))
         (w (dress-n2 (+ 0.8 (* (modulo (+ n 2) 5) 0.16))))
         (body (cond
                 ((or (string=? prim "lantern") (string=? prim "bloom"))
                  (string-append "(" prim " " role ")"))
                 ((string=? prim "box")
                  (string-append "(box " w " " h " " w " " role ")"))
                 ((string=? prim "slab")
                  (string-append "(slab " w " " h " " role ")"))
                 ((string=? prim "arch")
                  (string-append "(arch " w " " h " " role ")"))
                 (else (string-append "(" prim " " h " " role ")"))))
         (extra (if (= (modulo n 3) 0)
                  (string-append "(join " body " (" (if (= (modulo n 2) 0) "lantern" "bloom") " " role2 "))")
                  body))
         (spun (if (= (modulo n 2) 0)
                 (string-append "(spin " (dress-n2 (+ 0.3 (* (modulo n 4) 0.2))) " " extra ")")
                 extra))
         (floated (if (= (modulo n 5) 0)
                    spun
                    (string-append "(float " (dress-n2 (+ 0.25 (* (modulo n 5) 0.12))) " " spun ")")))
         (stacked (if (and (= (modulo n 4) 1) (or (string=? prim "shard") (string=? prim "rod") (string=? prim "disc")))
                    (string-append "(stack 2 " (dress-n2 (+ 0.3 (* (modulo n 3) 0.15))) " " floated ")")
                    floated))
         (placed (string-append "(place " (if (= (modulo n 2) 0) "1" "-1") " "
                                (dress-n2 (* (modulo n 4) 0.3)) " " stacked ")"))
         (group (if (= (modulo n 3) 1) placed (string-append "(mirror " placed ")"))))
    (string-append "(dress city " group ")")))

(define (dress-mutate text seed)
  (let ((n0 (if (number? seed) (inexact->exact (floor (abs seed))) 1)))
    (let loop ((k 0))
      (if (>= k 16)
        (if (and (string? text) (hash-ref (dress-eval text) "ok" #f)) text dress-default)
        (let ((form (dress-candidate (+ n0 (* k 17)))))
          (if (hash-ref (dress-eval form) "ok" #f)
            form
            (loop (+ k 1))))))))
