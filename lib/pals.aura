; Garden companions, and the runner's look. A model may add a kitten,
; a little car, or a new gentle kind, and may restyle the runner with
; one hero clause. The form is data, checked here, then rebound.
; Nothing in this file calls eval. Unknown kinds stay in the roster
; and the view draws them as a round friend. The runner stays the
; light-keeper until a hero clause says otherwise.
(require "lib/sexp")
(require "lib/gen")

(define default-pals
  "(pals (pal kitten mochi 0.95 0.62 0.35 hop) (pal car beep 0.3 0.55 0.95 pace))")

(define (pal-viol ok?)
  (hash "budget" 0.0 "geometry" 0.0 "reachable" (if ok? 0.0 1.0) "safe" 0.0))

(define (pals-refuse why)
  (hash "ok" #f "why" why "cue" "" "form" "" "pals" (list)
        "violations" (pal-viol #f)))

(define (num-tok n)
  (let ((s (number->string (exact->inexact n))))
    (if (string-contains? s ".") s (string-append s ".0"))))

(define (lower-sym s)
  (if (string? s) (string-downcase s) #f))

(define (letters? s lo hi)
  (and (string? s)
       (>= (string-length s) lo)
       (<= (string-length s) hi)
       (let ((n (string-length s)))
         (let loop ((i 0))
           (if (>= i n)
             #t
             (let ((c (string-ref s i)))
               (if (or (and (>= c 97) (<= c 122)) (and (>= c 65) (<= c 90)))
                 (loop (+ i 1))
                 #f)))))))

(define (reserved? s)
  (or (string=? s "pal") (string=? s "pals") (string=? s "seq")
      (string=? s "garden") (string=? s "sky") (string=? s "ground")
      (string=? s "block") (string=? s "hurdle") (string=? s "gate")
      (string=? s "gap") (string=? s "coin") (string=? s "spring")
      (string=? s "hero") (string=? s "keeper")))

(define (motion? s)
  (or (string=? s "hop") (string=? s "pace") (string=? s "float")
      (string=? s "follow") (string=? s "side")))

(define (plan-of kind)
  (cond
    ((or (string=? kind "keeper")
         (string=? kind "kitten") (string=? kind "car") (string=? kind "bunny")
         (string=? kind "bird") (string=? kind "butterfly") (string=? kind "frog")
         (string=? kind "duck") (string=? kind "puppy") (string=? kind "fox")
         (string=? kind "turtle") (string=? kind "bee") (string=? kind "friend"))
     kind)
    (else "friend")))

(define (pal-cue kind)
  (cond
    ((string=? kind "kitten") "A kitten came to play")
    ((string=? kind "car") "A little car rolled in")
    ((string=? kind "bunny") "A bunny hopped in")
    ((string=? kind "bird") "A bird flew along")
    ((string=? kind "butterfly") "A butterfly drifted by")
    ((string=? kind "frog") "A frog joined the path")
    ((string=? kind "duck") "A duck waddled in")
    ((string=? kind "puppy") "A puppy bounded in")
    ((string=? kind "fox") "A fox trotted in")
    ((string=? kind "turtle") "A turtle joined the path")
    ((string=? kind "bee") "A bee buzzed along")
    (else "A new friend came along")))

(define (color-ok? r g b)
  (and (number? r) (number? g) (number? b)
       (>= r 0.15) (<= r 1.0)
       (>= g 0.15) (<= g 1.0)
       (>= b 0.15) (<= b 1.0)
       (>= (+ (* 0.25 r) (* 0.50 g) (* 0.25 b)) 0.45)))

; keeper is reserved as a companion name, and allowed as the runner's look.
(define (hero-kind-ok? kind)
  (and (letters? kind 3 12)
       (or (string=? kind "keeper") (not (reserved? kind)))))

; (hero KIND R G B). The runner only. No motion: the player already moves.
(define (hero-one sp)
  (if (or (not (pair? sp)) (not (string? (car sp))) (not (string=? (car sp) "hero"))
          (not (= (length sp) 5)))
    "shape"
    (let ((kind (lower-sym (nth sp 1)))
          (r (nth sp 2))
          (g (nth sp 3))
          (b (nth sp 4)))
      (cond
        ((not (hero-kind-ok? kind)) "kind")
        ((not (and (number? r) (number? g) (number? b))) "shape")
        ((not (color-ok? r g b)) "color")
        (else (hash "kind" kind "plan" (plan-of kind)
                    "r" (exact->inexact r)
                    "g" (exact->inexact g)
                    "b" (exact->inexact b)))))))

(define (nth xs i)
  (if (or (null? xs) (< i 0))
    #f
    (if (= i 0) (car xs) (nth (cdr xs) (- i 1)))))

; (pal KIND NAME R G B MOTION) or a string why.
(define (pal-one sp)
  (if (or (not (pair? sp)) (not (string? (car sp))) (not (string=? (car sp) "pal"))
          (not (= (length sp) 7)))
    "shape"
    (let ((kind (lower-sym (nth sp 1)))
          (name (lower-sym (nth sp 2)))
          (r (nth sp 3))
          (g (nth sp 4))
          (b (nth sp 5))
          (motion (lower-sym (nth sp 6))))
      (cond
        ((or (not (letters? kind 3 12)) (reserved? kind)) "kind")
        ((or (not (letters? name 2 12)) (reserved? name)) "name")
        ((not (and (number? r) (number? g) (number? b))) "shape")
        ((not (color-ok? r g b)) "color")
        ((not (motion? motion)) "motion")
        (else (hash "kind" kind "name" name
                    "r" (exact->inexact r) "g" (exact->inexact g) "b" (exact->inexact b)
                    "motion" motion "plan" (plan-of kind) "cue" (pal-cue kind)))))))

(define (head-is? sp name)
  (and (pair? sp) (string? (car sp)) (string=? (car sp) name)))

; Pal clauses, plus at most one hero. A string result is the reason.
(define (take-children xs max-pals)
  (let loop ((xs xs) (pals (list)) (hero #f) (n 0))
    (if (null? xs)
      (if (and (= n 0) (not hero))
        "count"
        (hash "items" (reverse pals) "hero" hero))
      (let ((one (car xs)))
        (cond
          ((head-is? one "pal")
           (if (>= n max-pals)
             "count"
             (loop (cdr xs) (cons one pals) hero (+ n 1))))
          ((head-is? one "hero")
           (if hero
             "shape"
             (let ((got (hero-one one)))
               (if (string? got)
                 got
                 (loop (cdr xs) pals got n)))))
          (else "shape"))))))

(define (pal-items form max-pals)
  (cond
    ((head-is? form "pals") (take-children (cdr form) max-pals))
    ((head-is? form "pal") (hash "items" (list form) "hero" #f))
    ((head-is? form "hero")
     (let ((got (hero-one form)))
       (if (string? got)
         got
         (hash "items" (list) "hero" got))))
    (else "shape")))

(define (build-rows items)
  (let loop ((xs items) (acc (list)))
    (if (null? xs)
      (reverse acc)
      (let ((one (pal-one (car xs))))
        (if (string? one)
          one
          (loop (cdr xs) (cons one acc)))))))

(define (find-row rows name)
  (let loop ((xs rows))
    (if (null? xs)
      #f
      (if (string=? (hash-ref (car xs) "name" "") name)
        (car xs)
        (loop (cdr xs))))))

(define (dup-name? rows)
  (let loop ((xs rows))
    (if (null? xs)
      #f
      (if (find-row (cdr xs) (hash-ref (car xs) "name" ""))
        #t
        (loop (cdr xs))))))

(define (pal-clause row)
  (string-append "(pal "
                 (hash-ref row "kind") " "
                 (hash-ref row "name") " "
                 (num-tok (hash-ref row "r")) " "
                 (num-tok (hash-ref row "g")) " "
                 (num-tok (hash-ref row "b")) " "
                 (hash-ref row "motion") ")"))

(define (pals-text rows)
  (let loop ((xs rows) (acc "(pals"))
    (if (null? xs)
      (string-append acc ")")
      (loop (cdr xs) (string-append acc " " (pal-clause (car xs)))))))

(define (hero-cue hero)
  (let ((kind (if (hash? hero) (hash-ref hero "kind" "") "")))
    (cond
      ((string=? kind "kitten") "The runner became a kitten")
      ((string=? kind "car") "The runner became a little car")
      ((string=? kind "bunny") "The runner became a bunny")
      ((string=? kind "bird") "The runner became a bird")
      ((string=? kind "butterfly") "The runner became a butterfly")
      ((string=? kind "frog") "The runner became a frog")
      ((string=? kind "duck") "The runner became a duck")
      ((string=? kind "keeper") "The runner is the light-keeper again")
      (else "The runner looks different"))))

; Missing, or plan keeper, is the light-keeper and stays out of the text.
(define (keeper-plan? hero)
  (or (not (hash? hero)) (string=? (hash-ref hero "plan" "") "keeper")))

(define (hero-clause hero)
  (string-append " (hero "
                 (hash-ref hero "kind") " "
                 (num-tok (hash-ref hero "r")) " "
                 (num-tok (hash-ref hero "g")) " "
                 (num-tok (hash-ref hero "b")) ")"))

(define (roster-text rows hero)
  (let ((base (pals-text rows)))
    (if (keeper-plan? hero)
      base
      (let ((n (string-length base)))
        (string-append (substring base 0 (- n 1)) (hero-clause hero) ")")))))

(define (hero-key hero)
  (if (keeper-plan? hero)
    ""
    (string-append (hash-ref hero "kind" "") " "
                   (num-tok (hash-ref hero "r" 0)) " "
                   (num-tok (hash-ref hero "g" 0)) " "
                   (num-tok (hash-ref hero "b" 0)))))

(define (pals-ok rows hero)
  (hash "ok" #t "why" "fair"
        "cue" (if (pair? rows) (hash-ref (car rows) "cue" "") (hero-cue hero))
        "form" (roster-text rows hero)
        "pals" rows
        "hero" (if (hash? hero) hero #f)
        "violations" (pal-viol #t)))

; (pals (pal KIND NAME R G B MOTION) ...)
; or one (pal ...), or one (hero KIND R G B), or pals with one hero
; clause. At most four new friends in a single phrase. The stored
; roster may hold six, so check-roster is the wider gate. Channels
; stay bright. Kind and name are short words. A kind outside the
; drawn set is still kept; the view uses the friend body. keeper
; draws the light-keeper and is left out of the stored text.
(define (check-pals-max text max-pals)
  (if (or (not (string? text)) (= (string-length text) 0))
    (pals-refuse "empty")
    (if (banned? text)
      (pals-refuse "banned")
      (let ((form (sexp-parse text)))
        (if (not form)
          (pals-refuse "shape")
          (let ((split (pal-items form max-pals)))
            (if (string? split)
              (pals-refuse split)
              (let ((built (build-rows (hash-ref split "items")))
                    (hero (hash-ref split "hero")))
                (cond
                  ((string? built) (pals-refuse built))
                  ((and (null? built) (not (hash? hero))) (pals-refuse "count"))
                  ((dup-name? built) (pals-refuse "dup"))
                  (else (pals-ok built hero)))))))))))

(define (check-pals text)
  (check-pals-max text 4))

(define (check-roster text)
  (check-pals-max text 6))

(define (replace-row rows name row)
  (let loop ((xs rows) (acc (list)))
    (if (null? xs)
      (reverse acc)
      (if (string=? (hash-ref (car xs) "name" "") name)
        (loop (cdr xs) (cons row acc))
        (loop (cdr xs) (cons (car xs) acc))))))

; The first two stay. A seventh arrival takes the place of the oldest
; friend who joined after them.
(define (remove-at xs i)
  (let loop ((ys xs) (k 0) (acc (list)))
    (if (null? ys)
      (reverse acc)
      (if (= k i)
        (loop (cdr ys) (+ k 1) acc)
        (loop (cdr ys) (+ k 1) (cons (car ys) acc))))))

(define (pal-names rows)
  (let loop ((xs rows) (acc ""))
    (if (null? xs)
      (if (string=? acc "") "none" acc)
      (loop (cdr xs)
            (if (string=? acc "")
              (string-append (hash-ref (car xs) "name" "") " " (hash-ref (car xs) "kind" ""))
              (string-append acc ", "
                             (hash-ref (car xs) "name" "") " "
                             (hash-ref (car xs) "kind" "")))))))

; How many incoming names are not already on the roster.
(define (fresh-count rows incoming)
  (if (not (pair? incoming))
    0
    (let loop ((xs incoming) (n 0))
      (if (null? xs)
        n
        (loop (cdr xs)
              (if (find-row rows (hash-ref (car xs) "name" ""))
                n
                (+ n 1)))))))

; Add incoming rows onto the roster. An existing name is replaced.
; The cue names the first newcomer, or a quiet change when nobody new arrived.
(define (merge-pals rows incoming)
  (if (or (not (pair? incoming)) (null? incoming))
    (hash "ok" #f "why" "empty" "rows" rows "form" (pals-text rows) "cue" "")
    (let loop ((xs incoming) (cur rows) (new-cue "") (updated #f))
      (if (null? xs)
        (hash "ok" #t "why" "fair" "rows" cur "form" (pals-text cur)
              "cue" (if (string=? new-cue "")
                      (if updated "A friend looks different" "")
                      new-cue))
        (let ((row (car xs))
              (name (hash-ref (car xs) "name" "")))
          (if (find-row cur name)
            (loop (cdr xs) (replace-row cur name row) new-cue #t)
            (let ((room (if (>= (length cur) 6) (remove-at cur 2) cur)))
              (loop (cdr xs) (append room (list row))
                    (if (string=? new-cue "") (hash-ref row "cue" "A new friend came along") new-cue)
                    updated))))))))

; The runner's look advances when a phrase forgets it, or repeats it.
; A different kind written by the model is kept, including keeper.
(define (next-look kind)
  (cond
    ((string=? kind "kitten") "car")
    ((string=? kind "car") "bunny")
    ((string=? kind "bunny") "bird")
    ((string=? kind "bird") "butterfly")
    ((string=? kind "butterfly") "frog")
    ((string=? kind "frog") "duck")
    ((string=? kind "duck") "kitten")
    (else "kitten")))

(define (look-rgb kind)
  (cond
    ((string=? kind "car") "0.35 0.72 0.95")
    ((string=? kind "bunny") "0.98 0.78 0.86")
    ((string=? kind "bird") "0.95 0.86 0.35")
    ((string=? kind "butterfly") "0.72 0.55 0.98")
    ((string=? kind "frog") "0.45 0.82 0.4")
    ((string=? kind "duck") "0.98 0.78 0.28")
    (else "0.95 0.62 0.45")))

(define (hero-src kind)
  (string-append "(hero " kind " " (look-rgb kind) ")"))

(define (hero-kind-in form)
  (if (not (string? form))
    ""
    (let ((i (string-find form "(hero ")))
      (if (< i 0)
        ""
        (let ((rest (substring form (+ i 6) (string-length form))))
          (let ((sp (string-find rest " ")))
            (if (< sp 1)
              ""
              (lower-sym (substring rest 0 sp)))))))))

(define (take-balanced s i)
  (let ((n (string-length s)))
    (let loop ((k i) (depth 0))
      (if (>= k n)
        ""
        (let ((c (string-ref s k)))
          (cond
            ((= c 40) (loop (+ k 1) (+ depth 1)))
            ((= c 41)
             (if (<= depth 1)
               (substring s i (+ k 1))
               (loop (+ k 1) (- depth 1))))
            (else (loop (+ k 1) depth))))))))

(define (strip-hero form)
  (let ((i (string-find form "(hero")))
    (if (< i 0)
      form
      (let ((clause (take-balanced form i)))
        (if (string=? clause "")
          form
          (string-replace form clause ""))))))

(define (blank? s)
  (or (not (string? s))
      (= (string-length (string-replace s " " "")) 0)))

; Drop the hero into the same list. A bare (pal ...) becomes (pals ...).
(define (join-hero form hero)
  (let ((n (string-length form)))
    (if (or (< n 2) (not (= (string-ref form (- n 1)) 41)))
      (string-append "(pals " form " " hero ")")
      (if (string-prefix? form "(pals")
        (string-append (substring form 0 (- n 1)) " " hero ")")
        (string-append "(pals " form " " hero ")")))))

(define (dress-form form kind)
  (if (not (string? form))
    form
    (let ((cur (if (and (string? kind) (> (string-length kind) 0)) kind "keeper")))
      (let ((have (hero-kind-in form)))
        (if (and (> (string-length have) 0) (not (string=? have cur)))
          form
          (let ((base (if (> (string-length have) 0) (strip-hero form) form)))
            (if (blank? base)
              (hero-src (next-look cur))
              (join-hero base (hero-src (next-look cur))))))))))
