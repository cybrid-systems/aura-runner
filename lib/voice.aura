; Spoken controls that do not wait on a model. A sun, a moon and a
; plane are names the view already knows how to draw. Speed, pace and
; the finish are numbers inside the same bounds the run already uses.
; Any other picture is composed in lib/thing. The child's sentence is
; only matched. It is never evaluated.
(require "std/string" all:)
(require "lib/phys")
(require "lib/thing")
(require "lib/biome")

(define voice-speeds (list 8.0 10.0 12.0 13.0 14.0))

(define (voice-abs x)
  (if (< x 0) (- 0 x) x))

(define (voice-has? text w)
  (and (string? text) (string? w) (>= (string-index text w 0) 0)))

(define (voice-word? low w)
  (voice-has? (string-append " " low " ") (string-append " " w " ")))

(define (voice-prop? name)
  (or (string=? name "sun") (string=? name "moon") (string=? name "plane")))

(define (voice-member? xs name)
  (let loop ((ys xs))
    (if (or (not (pair? ys)) (null? ys))
      #f
      (if (and (string? (car ys)) (string=? (car ys) name))
        #t
        (loop (cdr ys))))))

(define (voice-without xs name)
  (let loop ((ys xs) (acc (list)))
    (if (or (not (pair? ys)) (null? ys))
      (reverse acc)
      (if (and (string? (car ys)) (string=? (car ys) name))
        (loop (cdr ys) acc)
        (loop (cdr ys) (cons (car ys) acc))))))

; At most three sky props. A second ask for the same one stays.
(define (voice-put props name)
  (let ((cur (if (pair? props) props (list))))
    (cond
      ((not (voice-prop? name)) (hash "ok" #f "why" "name" "props" cur))
      ((voice-member? cur name) (hash "ok" #t "why" "have" "props" cur))
      ((>= (length cur) 3) (hash "ok" #f "why" "full" "props" cur))
      (else (hash "ok" #t "why" "fair" "props" (append cur (list name)))))))

(define (voice-cut props name)
  (let ((cur (if (pair? props) props (list))))
    (if (voice-member? cur name)
      (hash "ok" #t "why" "fair" "props" (voice-without cur name))
      (hash "ok" #f "why" "missing" "props" cur))))

(define (voice-remove? text low)
  (or (voice-has? text "去掉") (voice-has? text "拿掉") (voice-has? text "不要")
      (voice-has? text "删除") (voice-has? text "移除") (voice-has? text "关掉")
      (voice-has? low "remove") (voice-has? low "take away")))

; Drop whatever was drawn last, when the sentence names nothing else.
(define (voice-drop-last? text low)
  (or (voice-has? text "不要了") (voice-has? text "去掉它") (voice-has? text "去掉这个")
      (voice-has? text "拿掉它") (voice-has? text "拿掉这个")
      (voice-has? low "remove it") (voice-has? low "take it away")))

; Every sky body the sentence names, so 去掉太阳、月亮 drops both.
(define (voice-prop-names text low)
  (append
    (if (or (voice-has? text "太阳") (voice-word? low "sun")) (list "sun") (list))
    (if (or (voice-has? text "月亮") (voice-word? low "moon")) (list "moon") (list))
    (if (or (voice-has? text "飞机") (voice-word? low "plane") (voice-word? low "airplane"))
      (list "plane")
      (list))))

(define (voice-join xs)
  (let loop ((ys xs) (acc ""))
    (if (or (not (pair? ys)) (null? ys))
      acc
      (loop (cdr ys)
            (if (string=? acc "") (car ys) (string-append acc "+" (car ys)))))))

(define (voice-parts name)
  (if (or (not (string? name)) (= (string-length name) 0))
    (list)
    (let loop ((s name) (acc (list)))
      (let ((i (string-index s "+" 0)))
        (if (< i 0)
          (reverse (cons s acc))
          (loop (substring s (+ i 1) (string-length s))
                (cons (substring s 0 i) acc)))))))

; Every friend kind the sentence names. 小猫 and 猫 are one kitten.
(define (voice-pal-names text low)
  (voice-uniq
    (append
      (if (or (voice-has? text "小猫") (voice-word? low "kitten") (voice-word? low "kitty")) (list "kitten") (list))
      (if (or (voice-has? text "兔子") (voice-has? text "兔") (voice-word? low "bunny") (voice-word? low "rabbit")) (list "bunny") (list))
      (if (or (voice-has? text "小狗") (voice-has? text "狗") (voice-word? low "puppy") (voice-word? low "dog")) (list "puppy") (list))
      (if (or (voice-has? text "小鸟") (voice-has? text "鸟") (voice-word? low "bird")) (list "bird") (list))
      (if (or (voice-has? text "蝴蝶") (voice-word? low "butterfly")) (list "butterfly") (list))
      (if (or (voice-has? text "青蛙") (voice-word? low "frog")) (list "frog") (list))
      (if (or (voice-has? text "鸭子") (voice-has? text "鸭") (voice-word? low "duck")) (list "duck") (list))
      (if (or (voice-has? text "狐狸") (voice-word? low "fox")) (list "fox") (list))
      (if (or (voice-has? text "乌龟") (voice-word? low "turtle")) (list "turtle") (list))
      (if (or (voice-has? text "蜜蜂") (voice-word? low "bee")) (list "bee") (list))
      (if (or (voice-has? text "企鹅") (voice-word? low "penguin")) (list "penguin") (list))
      (if (or (voice-has? text "熊猫") (voice-word? low "panda")) (list "panda") (list))
      (if (or (voice-has? text "出租车") (voice-word? low "taxi")) (list "taxi") (list))
      (if (or (voice-has? text "赛车") (voice-word? low "racer")) (list "racer") (list))
      (if (or (voice-has? text "货车") (voice-word? low "van")) (list "van") (list))
      (if (or (voice-has? text "马车") (voice-word? low "wagon")) (list "wagon") (list))
      (if (or (voice-has? text "汽车") (voice-has? text "小车") (voice-word? low "car")) (list "car") (list))
      (if (voice-has? text "猫") (list "kitten") (list)))))

(define (voice-uniq xs)
  (let loop ((ys xs) (acc (list)))
    (if (or (not (pair? ys)) (null? ys))
      (reverse acc)
      (if (voice-member? acc (car ys))
        (loop (cdr ys) acc)
        (loop (cdr ys) (cons (car ys) acc))))))

; npc / 小伙伴 / 朋友们: send the whole roster home, not one kind.
(define (voice-clear-pals? text low)
  (or (voice-has? low "npc")
      (voice-has? text "伙伴")
      (voice-has? text "同伴")
      (voice-has? text "朋友")
      (voice-word? low "friends")))

(define (voice-row act name dir zh en)
  (hash "act" act "name" name "dir" dir "zh" zh "en" en))

; 变成狐狸 / become fox names the runner, not a friend to send home.
(define (voice-become? text low)
  (or (voice-has? text "变成")
      (voice-has? low "become")
      (voice-has? low "turn into")))

(define (voice-hero-kind text low)
  (let ((names (voice-pal-names text low)))
    (if (pair? names)
      (car names)
      (if (or (voice-has? text "龙") (voice-word? low "dragon"))
        "dragon"
        (if (or (voice-has? text "守护") (voice-word? low "keeper"))
          "keeper"
          "")))))

(define (voice-speed-ask? text low)
  (or (voice-has? text "快点") (voice-has? text "加速") (voice-has? text "跑快")
      (voice-has? text "更快") (voice-word? low "faster")))

(define (voice-slow-ask? text low)
  (or (voice-has? text "慢点") (voice-has? text "减速") (voice-has? text "更慢")
      (voice-has? text "慢一") (voice-word? low "slower")))

(define (voice-hard-ask? text low)
  (or (voice-has? text "难一点") (voice-has? text "更难") (voice-has? text "难度高")
      (voice-has? text "难一些") (voice-word? low "harder")))

(define (voice-easy-ask? text low)
  (or (voice-has? text "简单一点") (voice-has? text "更简单") (voice-has? text "容易一点")
      (voice-has? text "难度低") (voice-word? low "easier")))

; A colour wish such as "sunny garden" still falls through. A bare
; venue word, or 换场景, switches at once and does not wait for a model.
(define (voice-venue-soft? text low)
  (or (voice-has? low "sunny")
      (voice-has? low "pink")
      (voice-has? low "paint")
      (voice-has? low "flower")
      (voice-has? low "golden")
      (voice-has? text "粉色")
      (voice-has? text "金色")
      (voice-has? text "花朵")))

(define (voice-next-venue? text low)
  (or (voice-has? text "换场景")
      (voice-has? text "下一个场景")
      (voice-has? text "下个场景")
      (and (voice-word? low "next") (or (voice-word? low "scene") (voice-word? low "biome")))
      (and (voice-word? low "switch") (or (voice-word? low "scene") (voice-word? low "biome")))))

; The next track. 下一首 is not 下一个城市, and 换一首 is not 换场景.
(define (voice-next-song? text low)
  (and (not (voice-next-venue? text low))
       (not (voice-has? text "城市"))
       (not (voice-has? text "场景"))
       (not (voice-word? low "city"))
       (not (voice-word? low "scene"))
       (not (voice-word? low "biome"))
       (or (voice-has? text "下一首")
           (voice-has? text "下首歌")
           (voice-has? text "换一首")
           (voice-has? text "换首歌")
           (voice-has? text "切歌")
           (voice-has? text "跳过这首")
           (and (voice-word? low "next")
                (or (voice-word? low "song") (voice-word? low "track")))
           (and (voice-word? low "skip")
                (or (voice-word? low "song") (voice-word? low "track") (voice-word? low "music"))))))

(define (voice-biome-name text low)
  (cond
    ((or (voice-has? text "花园") (voice-has? text "草地") (voice-word? low "garden")) "garden")
    ((or (voice-has? text "城市") (voice-has? text "都市") (voice-word? low "city")) "city")
    ((or (voice-has? text "太空") (voice-has? text "星空") (voice-has? text "宇宙")
         (voice-word? low "space") (voice-word? low "universe")) "space")
    ((or (voice-has? text "海边") (voice-has? text "海岸") (voice-has? text "海洋")
         (voice-has? text "沙滩")
         (voice-word? low "coast") (voice-word? low "ocean") (voice-word? low "beach")) "coast")
    (else "")))

(define (voice-mood-name text low)
  (cond
    ((or (voice-has? text "夜晚") (voice-has? text "夜景") (voice-has? text "黑夜")
         (voice-has? text "晚上") (voice-word? low "night")) "night")
    ((or (voice-has? text "日落") (voice-has? text "黄昏") (voice-word? low "sunset")
         (voice-word? low "dusk")) "sunset")
    ((or (voice-has? text "霓虹") (voice-has? text "赛博") (voice-word? low "neon")
         (voice-word? low "cyber")) "neon")
    ((or (voice-has? text "白天") (voice-has? text "晴天") (voice-word? low "day")) "day")
    (else "")))

; The next level, without dropping the combo the page is holding.
; combo is echoed so a gate cannot zero it. The multiplier steps once.
(define (gate-cross level form bumps points mult combo . rest)
  (let* ((skill (if (and (pair? rest) (hash? (car rest))) (car rest) #f))
         (plan (if skill
                 (adapt-finish form bumps points level skill)
                 (adapt-finish form bumps points level)))
         (next-level (+ (biome-level level) 1))
         (got (mult-add mult 1))
         (next-form (hash-ref plan "form" form)))
    (hash "level" next-level
          "form" next-form
          "act" (hash-ref plan "act" "scene")
          "scene" (hash-ref plan "scene" -1)
          "pressure" (hash-ref plan "pressure" 1)
          "streak" (hash-ref plan "streak" 0)
          "mult" (hash-ref got "mult")
          "gain" (hash-ref got "gain")
          "combo" combo
          "biome" (biome-for-level next-level)
          "what" (evo-what form next-form next-level)
          "chal" 0)))

; A known sky object, a friend to send home, a pace, the finish, or a venue.
; Anything else is #f and the garden wish still answers.
(define (voice-intent text)
  (if (or (not (string? text)) (= (string-length text) 0))
    #f
    (let* ((low (string-downcase text))
           (props (voice-prop-names text low))
           (pals (voice-pal-names text low))
           (drop (voice-remove? text low)))
      (cond
        ((and drop (pair? props))
         (voice-row "drop-prop" (voice-join props) 0 "拿下去了" "That one went away"))
        ((pair? props)
         (voice-row "add-prop" (voice-join props) 1 "升起来了" "That one came out"))
        ((and drop (pair? pals))
         (voice-row "drop-pal" (voice-join pals) 0 "朋友回家了" "That friend went home"))
        ((and drop (voice-clear-pals? text low))
         (voice-row "drop-pals" "all" 0 "朋友们回家了" "The friends went home"))
        ((and (not drop)
              (voice-become? text low)
              (not (string=? (voice-hero-kind text low) "")))
         (voice-row "hero" (voice-hero-kind text low) 0 "换成这个样子了" "The runner changed"))
        ; 不要快点 is slower, not a removal and not a faster step.
        ((and drop (voice-speed-ask? text low))
         (voice-row "speed" "" -1 "跑得慢一点了" "A gentler pace"))
        ((and drop (voice-slow-ask? text low))
         (voice-row "speed" "" 1 "跑得更快了" "Faster now"))
        ((voice-speed-ask? text low)
         (voice-row "speed" "" 1 "跑得更快了" "Faster now"))
        ((voice-slow-ask? text low)
         (voice-row "speed" "" -1 "跑得慢一点了" "A gentler pace"))
        ((voice-hard-ask? text low)
         (voice-row "form" "" 1 "难度高了一点" "A little harder"))
        ((voice-easy-ask? text low)
         (voice-row "form" "" -1 "难度低了一点" "A little easier"))
        ((voice-has? text "终点")
         (let ((d (cond
                    ((voice-has? text "远") 1)
                    ((voice-has? text "近") -1)
                    (else 0))))
           (voice-row "goal" "" d
                      (cond
                        ((> d 0) "终点远了一些")
                        ((< d 0) "终点近了一些")
                        (else "终点就在前面"))
                      (cond
                        ((> d 0) "The finish is farther")
                        ((< d 0) "The finish is closer")
                        (else "The finish is just ahead")))))
        ((voice-word? low "finish")
         (let ((d (cond
                    ((voice-word? low "farther") 1)
                    ((voice-word? low "closer") -1)
                    (else 0))))
           (voice-row "goal" "" d
                      (cond
                        ((> d 0) "终点远了一些")
                        ((< d 0) "终点近了一些")
                        (else "终点就在前面"))
                      (cond
                        ((> d 0) "The finish is farther")
                        ((< d 0) "The finish is closer")
                        (else "The finish is just ahead")))))
        ((voice-next-song? text low)
         (voice-row "music-next" "" 1 "换了一首歌" "Next song"))
        ((and (not (voice-venue-soft? text low)) (voice-next-venue? text low))
         (voice-row "biome-next" "next" 1 "换了一个场景" "A new place"))
        ((and (not (voice-venue-soft? text low))
              (not (string=? (voice-biome-name text low) "")))
         (let ((name (voice-biome-name text low)))
           (voice-row "biome" name 1 (biome-say name "zh") (biome-say name "en"))))
        ((and (not (voice-venue-soft? text low))
              (not (string=? (voice-mood-name text low) "")))
         (let ((name (voice-mood-name text low)))
           (voice-row "mood" name 1 (mood-say name "zh") (mood-say name "en"))))
        ((and drop (or (voice-drop-last? text low)
                       (not (string=? (compose-name text) ""))))
         (voice-row "drop-thing" (compose-name text) 0 "拿下去了" "That one went away"))
        (else #f)))))

; The line the child hears. why is fair, have, full, missing, last, or same.
(define (voice-line act name why lang)
  (let ((zh (string=? lang "zh")))
    (cond
      ((and (string=? act "add-prop") (string=? why "have"))
       (if zh "已经在那里了" "That one is already out"))
      ((and (string=? act "add-prop") (string=? why "full"))
       (if zh "天上已经有三样了" "The sky is full"))
      ((and (string=? act "add-prop") (voice-has? name "+"))
       (if zh "这些都升起来了" "Those came out"))
      ((and (string=? act "add-prop") (string=? name "sun"))
       (if zh "太阳升起来了" "The sun came out"))
      ((and (string=? act "add-prop") (string=? name "moon"))
       (if zh "月亮升起来了" "The moon came out"))
      ((and (string=? act "add-prop") (string=? name "plane"))
       (if zh "一架飞机飞过来了" "A plane flew over"))
      ((and (string=? act "drop-prop") (string=? why "missing"))
       (if zh "现在没有这个" "That one is not out"))
      ((and (string=? act "drop-prop") (voice-has? name "+"))
       (if zh "这些都拿下去了" "Those went away"))
      ((and (string=? act "drop-prop") (string=? name "sun"))
       (if zh "太阳落下去了" "The sun went down"))
      ((and (string=? act "drop-prop") (string=? name "moon"))
       (if zh "月亮落下去了" "The moon went down"))
      ((and (string=? act "drop-prop") (string=? name "plane"))
       (if zh "飞机飞走了" "The plane flew away"))
      ((and (string=? act "drop-pal") (string=? why "missing"))
       (if zh "现在没有这个朋友" "That friend is not here"))
      ((and (string=? act "drop-pal") (string=? why "last"))
       (if zh "至少留一个朋友一起跑" "One friend stays to run with you"))
      ((and (string=? act "drop-pal") (string=? why "fair") (voice-has? name "+"))
       (if zh "这些朋友回家了" "Those friends went home"))
      ((and (string=? act "drop-pal") (string=? why "fair"))
       (if zh "这个朋友回家了" "That friend went home"))
      ((and (string=? act "drop-pals") (string=? why "missing"))
       (if zh "现在没有这些朋友" "The friends are already home"))
      ((string=? act "drop-pals")
       (if zh "朋友们回家了" "The friends went home"))
      ((and (string=? act "hero") (string=? why "missing"))
       (if zh "还不会变成这个" "That look is not ready"))
      ((string=? act "hero")
       (if zh "换成这个样子了" "The runner changed"))
      ((string=? why "same")
       (if zh "已经是这样了" "That is already set"))
      ((string=? act "speed")
       (if (> (if (number? why) why 0) 0)
         (if zh "跑得更快了" "Faster now")
         (if zh "跑得慢一点了" "A gentler pace")))
      ((string=? act "form")
       (if (> (if (number? why) why 0) 0)
         (if zh "难度高了一点" "A little harder")
         (if zh "难度低了一点" "A little easier")))
      ((and (string=? act "goal") (number? why) (> why 0))
       (if zh "终点远了一些" "The finish is farther"))
      ((and (string=? act "goal") (number? why) (< why 0))
       (if zh "终点近了一些" "The finish is closer"))
      ((string=? act "goal")
       (if zh "终点就在前面" "The finish is just ahead"))
      ((and (string=? act "biome") (string=? why "same"))
       (if zh "已经是这个场景了" "That place is already here"))
      ((string=? act "biome")
       (biome-say name (if zh "zh" "en")))
      ((string=? act "biome-next")
       (if zh "换了一个场景" "A new place"))
      ((string=? act "music-next")
       (if zh "换了一首歌" "Next song"))
      ((and (string=? act "mood") (string=? why "same"))
       (if zh "已经是这个光线了" "That light is already on"))
      ((string=? act "mood")
       (mood-say name (if zh "zh" "en")))
      ((and (string=? act "drop-thing") (string=? why "missing"))
       (if zh "现在没有这个" "That one is not out"))
      ((string=? act "drop-thing")
       (if zh "拿下去了" "That one went away"))
      (else (if zh "好" "Okay")))))

; The next feel speed in that direction. 8 and 14 stay put at the ends.
; A speed between two rungs moves to the neighbour on that side.
(define (voice-speed-next now dir)
  (let ((v (if (and (number? now) (> now 0.1)) (exact->inexact now) 8.0)))
    (if (and (number? dir) (> dir 0))
      (let loop ((xs voice-speeds))
        (cond
          ((null? xs) 14.0)
          ((> (car xs) (+ v 0.01)) (car xs))
          (else (loop (cdr xs)))))
      (let loop ((xs (reverse voice-speeds)))
        (cond
          ((null? xs) 8.0)
          ((< (car xs) (- v 0.01)) (car xs))
          (else (loop (cdr xs))))))))

; Exact 0..4. The feel table compares with =, and an inexact 2.0 misses every row.
(define (voice-band n)
  (cond
    ((not (number? n)) 0)
    ((< n 0.5) 0)
    ((< n 1.5) 1)
    ((< n 2.5) 2)
    ((< n 3.5) 3)
    (else 4)))

(define (voice-form-step form dir)
  (let ((f (voice-band form)))
    (if (and (number? dir) (> dir 0))
      (if (>= f 4) 4 (+ f 1))
      (if (<= f 0) 0 (- f 1)))))

; dir 0 places the arch a short way ahead. 1 pushes it out, -1 pulls it in.
; It stays in front of the runner, and inside the course the level already uses.
(define (voice-goal x x0 x1 dir)
  (let ((px (if (number? x) (exact->inexact x) 0.0))
        (a (if (number? x0) (exact->inexact x0) 0.0))
        (b (if (number? x1) (exact->inexact x1) 128.0))
        (d (if (number? dir) dir 0)))
    (let ((want (cond
                  ((> d 0) (+ b 32.0))
                  ((< d 0) (- b 32.0))
                  (else (+ px 56.0))))
          (lo (max (+ px 18.0) (+ a 48.0)))
          (hi (+ a 220.0)))
      (max lo (min hi want)))))

; Points per level. The HUD score, not the distance.
(define (adapt-rate points level)
  (if (and (number? points) (number? level) (> level 0))
    (/ (max 0.0 (exact->inexact points)) (exact->inexact level))
    0.0))

(define (skill-num h k d)
  (if (hash? h) (hash-ref h k d) d))

(define (skill-flag h k)
  (and (hash? h) (equal? (hash-ref h k #f) #t)))

(define (finish-plan form act scene pressure streak)
  (hash "form" form "act" act "scene" scene "pressure" pressure "streak" streak))

; One change for the next level. A low score, or two bumps, eases the
; pace and opens the bright cloud garden. A clean odd level steps the
; pace up. An even level, or a single bump, keeps the pace and changes
; the garden instead. scene -1 means the garden stays.
; Pressure is a second band for coin density and poppers. It moves by
; one band: up on a clean streak, a x3 combo, an overtake, or a high
; score; down on two bumps, a low score, one heart left, or a settled
; run. Missing heart keys stay at a full set, so an older call plans
; the same way. A speed lock keeps the feel where it is and lets
; pressure tune density instead of asking for speed.
(define (adapt-finish form bumps points level . rest)
  (let ((f (voice-band form))
        (n (if (and (number? bumps) (> bumps 1.5)) 2 (if (and (number? bumps) (> bumps 0.5)) 1 0)))
        ; The real level, not a cap at 6. Capping made every later gate
        ; even, so the pace stopped climbing past level 6.
        (lv (biome-level level))
        (rate (adapt-rate points level))
        (skill (if (and (pair? rest) (hash? (car rest))) (car rest) #f)))
    (let* ((pressure (pressure-band (skill-num skill "pressure" 1)))
           (combo (skill-num skill "combo" 0))
           (overtakes (skill-num skill "overtakes" 0))
           (streak0 (skill-num skill "streak" 0))
           (locked (skill-flag skill "locked"))
           (streak (if (<= n 0)
                     (+ (if (and (number? streak0) (> streak0 0)) streak0 0) 1)
                     0))
           (hearts (skill-num skill "hearts" 3))
           (defeats (skill-num skill "defeats" 0))
           (hot (and (<= n 0)
                     (or (>= streak 2)
                         (and (number? combo) (>= combo 3))
                         (and (number? overtakes) (>= overtakes 1))
                         (>= rate 80.0))))
           (low (or (>= n 2) (< rate 25.0)
                    (<= hearts 1)
                    (>= defeats 1)))
           (next-p (cond
                     (low (max 0 (- pressure 1)))
                     (hot (min 4 (+ pressure 1)))
                     (else pressure))))
      (cond
        (low
         (finish-plan (max 0 (- f 1)) "ease" 5 next-p streak))
        ((and (<= n 0) (= (modulo lv 2) 1))
         (if locked
           (finish-plan f (if (> next-p pressure) "dense" "hold") -1 next-p streak)
           (finish-plan (min 4 (+ f 1)) "harder" -1 next-p streak)))
        (else
         (finish-plan f "scene" (modulo lv 6) next-p streak))))))

; The opening level keeps the plain span. Later levels stretch a little
; when the score is low and shorten a little when it is high.
(define (adapt-span pace points level)
  (let ((base (level-span pace)))
    (if (or (not (number? level)) (<= level 1)
            (not (number? points)) (<= points 0.0))
      base
      (let ((rate (adapt-rate points level)))
        (let ((k (cond
                   ((< rate 25.0) 1.12)
                   ((>= rate 80.0) 0.92)
                   (else 1.0))))
          (min 220.0 (max 96.0 (* base k))))))))

(define (adapt-line act lang)
  (let ((zh (string=? lang "zh")))
    (cond
      ((string=? act "ease") (if zh "这一关轻松一点" "A gentler path"))
      ((string=? act "harder") (if zh "这一关难了一点" "A little harder"))
      ((string=? act "dense") (if zh "这一关收集更密" "More to collect"))
      ((string=? act "hold") (if zh "这一关先这样" "Same pace"))
      (else (if zh "这一关换了风景" "A new garden")))))
