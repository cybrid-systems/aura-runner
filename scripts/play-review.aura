; Play every seeded stretch at its feel pace and print one note.
; Offline only. aura test runs the walk in tests/pattern_review_test.aura
; and does not run this autopilot. It does not call the network.
; A hard miss exits non-zero. PLAY_REVIEW_LOOSE=1 keeps the old
; look-only exit. This aura build treats a trailing --strict as its
; own option, so the gate is the default.
(require "lib/review")
(require "lib/gen")
(require "std/math" all:)
(require "std/string" all:)

(define (int-str n)
  (let ((s (number->string (floor (exact->inexact n)))))
    (let ((dot (string-find s ".")))
      (if (< dot 0) s (substring s 0 dot)))))

(define (fmt-2 n)
  (let* ((x (exact->inexact n))
         (neg (< x 0.0))
         (ax (if neg (- 0.0 x) x))
         (scaled (floor (+ (* ax 100.0) 0.5)))
         (whole (floor (/ scaled 100.0)))
         (frac (floor (- scaled (* whole 100.0))))
         (fs (int-str frac))
         (pad (if (< frac 10.0) (string-append "0" fs) fs))
         (body (string-append (int-str whole) "." pad)))
    (if neg (string-append "-" body) body)))

(define (loose?)
  (let ((raw (try (getenv "PLAY_REVIEW_LOOSE") (catch (e) ""))))
    (and (string? raw)
         (or (string=? raw "1") (string=? raw "true") (string=? raw "yes")))))

(define (show-row band i specs rules)
  (let ((text (string-append "(seq" (specs-src specs) ")")))
    (let ((t0 (monotonic-ms)))
      (let ((r (review-play text rules)))
        (let ((ms (floor (- (monotonic-ms) t0))))
          (display "band ")
          (display band)
          (display " row ")
          (display i)
          (display " ok ")
          (display (if (hash-ref r "ok") 1 0))
          (display " spare ")
          (display (fmt-2 (hash-ref r "spare" 0.0)))
          (display " ms ")
          (display (int-str ms))
          (display " ")
          (let ((h (hash-ref r "hint" "")))
            (if (and (string? h) (> (string-length h) 0))
              (display h)
              (display "clear")))
          (newline)
          (if (hash-ref r "ok") 1 0))))))

(define (walk-band band)
  (let ((rules (feel-rules band)))
    (let loop ((xs (pattern-table band)) (i 0) (good 0) (n 0))
      (if (null? xs)
        (list good n)
        (loop (cdr xs)
              (+ i 1)
              (+ good (show-row band i (car xs) rules))
              (+ n 1))))))

(let ((totals (let loop ((band 0) (good 0) (n 0))
                (if (> band 4)
                  (list good n)
                  (let ((row (walk-band band)))
                    (loop (+ band 1) (+ good (car row)) (+ n (car (cdr row)))))))))
  (let ((good (car totals))
        (n (car (cdr totals))))
    (display "played ok=")
    (display good)
    (display " total=")
    (display n)
    (newline)
    (if (and (not (loose?)) (< good n))
      (error "play-review: a seeded stretch failed the hard check"))
    (void)))
