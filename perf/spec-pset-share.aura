; Focused re-trial of pset-share on nightly 760246314.
;
; The standing memory negative-keys pset-share on hot-node=collide (the
; old IR-cap-bound profile). This run starts from an EMPTY memory and a
; pset-share-first strategy so the candidate is actually measured on the
; current nightly, against the null of pset, with the same golden checksum
; and the same program/site floors as perf/spec.aura. It writes to a
; separate out-dir so the standing memory and report are untouched.
;
;   AURA_BIN=<nightly> AURA_PATH=~/aura-perf:<nightly>/lib \
;     aura-perf autotune perf/spec-pset-share.aura

(require "lib/perf/loop" all:)
(require "lib/perf/util" all:)
(require "lib/perf/score" all:)
(require "std/string" all:)

(define (seed-source)
  (let ((phys (perf:read-text "lib/phys.aura")))
    (string-append
     (string-replace
      (string-replace
       (string-replace phys "0.0000001" "(/ 1.0 (* 1000.0 10000.0))")
       "0.0008" "(/ 8.0 10000.0)")
      "0.0001" "(/ 1.0 10000.0)")
     "\n"
     (perf:read-text "perf/workload.aura"))))

(define seed-path "perf/out/pset-share/seed.aura")
(define seed-text (seed-source))
(shell "mkdir -p perf/out/pset-share")
(perf:write-text seed-path seed-text)

(define golden
  (string-split (perf:read-text "perf/golden.txt") "\n"))

(define (golden-digest courses)
  (let ((i (- (length courses) 1)))
    (if (or (< i 0) (>= i (length golden)))
        "perf-missing-golden"
        (list-ref golden i))))

(define (regions)
  (let ((course (perf-course 0))
        (p (make-player 0.4)))
    (list
      (hash "name" "bench-kernel" "calls" 1 "workload" #t
            "stack" (list "bench-kernel")
            "thunk" (lambda () (bench-kernel (perf-courses 1))))
      (hash "name" "collide" "calls" 600
            "stack" (list "bench-kernel" "collide")
            "thunk" (lambda ()
                      (let loop ((i 0))
                        (if (>= i 600) 0
                            (begin (collide p course PERF-RULES) (loop (+ i 1)))))))
      (hash "name" "step-poppers" "calls" 600
            "stack" (list "bench-kernel" "step-poppers")
            "thunk" (lambda ()
                      (let loop ((i 0))
                        (if (>= i 600) 0
                            (begin (step-poppers course p PHYS-DT) (loop (+ i 1)))))))
      (hash "name" "nudge-flyers" "calls" 600
            "stack" (list "bench-kernel" "nudge-flyers")
            "thunk" (lambda ()
                      (let loop ((i 0))
                        (if (>= i 600) 0
                            (begin (nudge-flyers course PHYS-DT) (loop (+ i 1)))))))
      (hash "name" "over-gap?" "calls" 600
            "stack" (list "bench-kernel" "over-gap?")
            "thunk" (lambda ()
                      (let loop ((i 0))
                        (if (>= i 600) 0
                            (begin (over-gap? 5.0 1.0 course) (loop (+ i 1)))))))
      (hash "name" "pset" "calls" 7800
            "stack" (list "bench-kernel" "pset")
            "thunk" (lambda ()
                      (let loop ((i 0))
                        (if (>= i 7800) 0
                            (begin (pset p 0 0.5) (loop (+ i 1)))))))
      (hash "name" "pxs" "calls" 18000
            "stack" (list "bench-kernel" "pxs")
            "thunk" (lambda ()
                      (let loop ((i 0))
                        (if (>= i 18000) 0
                            (begin (pxs p 14) (loop (+ i 1))))))))))

(define (candidate id path target thought . rest)
  (hash "id" id
        "target" target
        "site" (if (pair? rest) (car rest) target)
        "genome" (perf:read-text path)
        "thought" thought))

; pset-share first; wrong-scale is the negative control the checksum must
; reject. The other catalog ideas are omitted so the budget goes to pset.
(define catalog
  (list
    (candidate "pset-share"
               "perf/candidates/pset-share.aura"
               "pset"
               "every field write built a scratch vector and a fresh list; a write of the same value returns the same list, a real write shares the prefix")
    (candidate "wrong-scale"
               "perf/candidates/wrong-scale.aura"
               "pset"
               "the score is doubled on the way in; the checksum has to reject it")))

(define expert-intend
  (hash "min-faster-pct" 10
        "site-min-faster-pct" 20
        "checksum" #t
        "budget" 2
        "protected" '()))

(define strategy-genes
  (list
    (hash "id" "gene-pset-first"
          "ratio" 2
          "actionable-ms" 1
          "per-round" 2
          "order" (list "pset-share" "wrong-scale"))))

(define worker-path
  (let ((w (getenv "AURA_PERF_WORKER")))
    (if (and (string? w) (> (string-length w) 0)) w "worker.aura")))

(define spec
  (hash "label" "aura-runner-pset-share"
        "seed-path" seed-path
        "worker" worker-path
        "target" "pset"
        "kernel" "bench-kernel"
        "out-dir" "perf/out/pset-share"
        "memory-path" "perf/out/pset-share/memory.json"
        "heldout-n" 2
        "repeats" 5
        "profile-repeats" 3
        "min-speedup-pct" 20
        "timeout-ms" 240000
        "screen-n" 1
        "screen-slack-ms" 50
        "genes" strategy-genes
        "intend" expert-intend
        "call" (lambda (courses) (bench-kernel courses))
        "regions-fn" regions
        "inputs" (lambda (n) (perf-courses n))
        "oracle" golden-digest
        "check-inputs" (lambda () (list (perf-courses 1) (perf-courses 2)))
        "count-defines" #t
        "catalog" catalog))

(define result (perf:autotune spec))
(display "done\n")
(exit (if (and (hash? result) (= (hash-ref result "intend-met" 0) 1)) 0 1))