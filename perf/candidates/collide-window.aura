; collide skips the pieces the body cannot reach.
;
; Every piece span lies inside [piece-x, piece-x + piece-w]: the gate
; bar, the pot and the flyer are all narrower than their piece. The
; body's box is [left, right]. A piece outside that window cannot
; overlap it, so the span, the lane and the rectangle are not worth
; computing. The piece itself stays in the list: only the test is
; skipped.

(define (collide p pieces rules)
  (let* ((forgive (hash-ref rules "forgive"))
         (ph (hash-ref rules "ph"))
         (pw (hash-ref rules "pw"))
         (sh (hash-ref rules "sh"))
         (jump (hash-ref rules "jump"))
         (h (if (> (pxs p 3) 0.0) sh ph))
         (lane (body-lane p))
         (left (+ (- (player-x p) (/ pw 2.0)) forgive))
         (right (- (+ (player-x p) (/ pw 2.0)) forgive))
         (bottom (+ (player-y p) forgive))
         (top (- (+ (player-y p) h) forgive)))
    (let loop ((ps pieces) (acc (list)) (player p) (event "ok") (dead #f))
      (if (or (null? ps) dead)
        (list player (append (reverse acc) ps) (if dead "dead" event))
        (let* ((q (car ps))
               (k (piece-k q))
               (qlane (piece-lane q))
               (px (piece-x q))
               (wide (piece-w q))
               (y1 (piece-y q)))
          (if (or (> px right) (< (+ px wide) left))
            (loop (cdr ps) (cons q acc) player event #f)
            (let* ((span (cond
                           ((= k 4.0) (gate-span px wide))
                           ((= k 8.0)
                            (let ((mid (+ px (* wide 0.5))))
                              (cons (- mid FLY-HALF) (+ mid FLY-HALF))))
                           ((= k 7.0)
                            (let* ((mid (+ px (* wide 0.5)))
                                   (half (min (* wide 0.5) POT-HALF)))
                              (cons (- mid half) (+ mid half))))
                           (else (cons px (+ px wide)))))
                   (x1 (car span))
                   (x2 (cdr span))
                   (y2 (if (= k 7.0) (min (+ y1 (piece-h q)) POT-TOP) (+ y1 (piece-h q))))
                   (side (if (or (= k 7.0) (= k 8.0))
                           (meets-side? (player-lx p) qlane (if (= k 7.0) POT-REACH FLY-REACH))
                           (hits-lane? q lane)))
                   (hit (and side (rects-overlap? left bottom right top x1 y1 x2 y2))))
              (cond
                ((and hit (or (= k 3.0) (= k 4.0) (= k 7.0) (= k 8.0) (= k 9.0)))
                 (if (strict? rules)
                   (loop (cdr ps) (cons q acc) (pset player 5 0.0) "dead" #t)
                   (if (> (player-grace player) 0.0)
                     (loop (cdr ps) (cons q acc) player event #f)
                     (loop (cdr ps) (cons q acc) (pay-bump player) "bump" #f))))
                ((and hit (= k 5.0))
                 (loop (cdr ps)
                       (cons (piece 0.0 x1 (piece-w q) (piece-h q) y1 (piece-lane q)) acc)
                       (pset player 6 (+ (player-score player) (pickup-worth rules)))
                       "coin"
                       #f))
                ((and hit (= k 6.0) (<= (player-y player) 0.05) (<= (player-vy player) 0.0))
                 (loop (cdr ps) (cons q acc)
                       (pset (pset (pset player 2 (* jump 1.28)) 3 0.0) 14 0.0)
                       "spring"
                       #f))
                (else (loop (cdr ps) (cons q acc) player event #f))))))))))
