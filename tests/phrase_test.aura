; The system prompt's example has to pass the same gate as a model
; phrase. Placeholder words from that prompt are not numbers, so the
; gate refuses them before they can be laid out.
(require "lib/gen")
(require "std/string" all:)

(define rules (rules-of 32.0 11.2 5.0 0.48 0.12 0.12))

(define (example-from src)
  (let ((mark "Example: "))
    (let ((i (string-find src mark)))
      (if (< i 0)
        ""
        (let ((rest (substring src (+ i (string-length mark)) (string-length src))))
          (let ((j (string-find rest "\"")))
            (if (< j 0)
              ""
              (substring rest 0 j))))))))

(define (report name text)
  (let ((r (check-source text rules)))
    (display name)
    (display " ")
    (display (if (hash-ref r "ok") 1 0))
    (display " ")
    (display (hash-ref r "why"))
    (newline)))

(define example (example-from (read-file "core/main.aura")))

(report "example" example)
(report "bottom" "(seq (ground 6) (gate BOTTOM 0.7) (ground 5))")
(report "w" "(seq (ground W) (ground 4))")
(report "h" "(seq (ground 6) (hurdle H 0.7) (ground 4))")
(report "lane" "(seq (ground 6) (block LANE 1) (ground 4))")
(report "depth" "(seq (ground 6) (block 0 DEPTH) (ground 4))")

; Loot and bend do not occupy the track. A known pickup and a gentle
; turn stay fair. An unknown word and a sharp turn do not.
(define styled "(seq (ground 6) (loot star) (coin 1.2) (bend 0.4) (ground 5))")
(define laid (layout-form styled rules))
(display "styled-meta ")
(display (if (and laid (string=? (hash-ref laid "loot") "star")) 1 0))
(display " ")
(display (if (and laid (> (hash-ref laid "bend") 0.39) (< (hash-ref laid "bend") 0.41)) 1 0))
(newline)
(report "styled" styled)
(report "badloot" "(seq (ground 6) (loot sword) (ground 4))")
(report "badbend" "(seq (ground 6) (bend 2) (ground 4))")

; A flyer is one lane, tall enough to meet a standing runner, and high
; enough to slide under. Three of them fail the budget of two. A weapon
; word is not a kind. The sentence in front of the form is not part of it.
(report "flyer" "(seq (ground 8) (flyer plane 1 0.7) (ground 8))")
(report "flyer-two" "(seq (ground 8) (flyer plane 0 0.7) (flyer bubble 2 0.65) (ground 8))")
(report "flyer-wall" "(seq (ground 8) (flyer plane 0 0.7) (flyer bubble 1 0.65) (flyer leaf 2 0.7) (ground 8))")
(report "flyer-missile" "(seq (ground 8) (flyer missile 1 0.7) (ground 8))")
(report "said" "A paper plane drifts down the lane. (seq (ground 8) (flyer plane 0 0.7) (ground 8))")
(report "said-bomb" "A bomb is coming now. (seq (ground 8) (flyer plane 0 0.7) (ground 8))")
(display "say ")
(display (if (string=? (say-line "A paper plane drifts down the lane. (seq (ground 6) (ground 4))")
                       "A paper plane drifts down the lane.")
           1 0))
(newline)
(define fly (list (piece 8.0 10.0 0.72 0.5 0.7 1.0 0.0 2.6)))
(define fr (step (make-player 1.0) fly rules PHYS-DT))
(define fx (piece-x (car (car (cdr fr)))))
(display "fly-step ")
(display (if (and (< fx 9.97) (> fx 9.94)) 1 0))
(newline)
