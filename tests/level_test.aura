; A level's length and the next pace follow the run, and a rival
; closes on the hero until it commits to a lane.
(require "lib/phys")

(define (show k v)
  (display k)
  (display " ")
  (display v)
  (newline))

(define (mm x)
  (let ((v (* x 1000.0)))
    (if (>= v 0.0)
      (floor (+ v 0.5))
      (- 0.0 (floor (+ (- 0.0 v) 0.5))))))

(show "span8" (mm (level-span 8.0)))
(show "span14" (mm (level-span 14.0)))
(show "span1" (mm (level-span 1.0)))

(show "up" (form-next 0 0))
(show "down" (form-next 2 2))
(show "cap" (form-next 4 0))
(show "hold" (form-next 0 1))

(define hero (pset (make-player 10.0) 9 2.0))
(define far (piece 10.0 30.0 0.72 0.95 0.0 0.0 0.0 2.4 0.0 0.0))
(define moved (car (step-rivals (list far) hero (/ 1.0 60.0))))
(show "far-x" (mm (piece-x moved)))
(show "far-lane" (mm (piece-lane moved)))

(define near (piece 10.0 14.0 0.72 0.95 0.0 0.0 0.0 2.4 0.0 0.0))
(define held (car (step-rivals (list near) hero (/ 1.0 60.0))))
(show "near-lane" (mm (piece-lane held)))
(show "near-x" (mm (piece-x held)))

(define rules (rules-of 32.0 11.2 8.0 0.48 0.12 0.12))
(define stand (make-player 20.0))
(define ground (piece 1.0 0.0 80.0 0.45 0.0))
(define hitq (piece 10.0 19.64 0.72 0.95 0.0 1.0 0.0 2.0 1.0 0.0))
(define hr (collide stand (list ground hitq) rules))
(show "bump" (if (string=? (car (cdr (cdr hr))) "bump") 1 0))

(define missq (piece 10.0 19.64 0.72 0.95 0.0 0.0 0.0 2.0 0.0 0.0))
(define mr (collide stand (list ground missq) rules))
(show "miss" (if (string=? (car (cdr (cdr mr))) "ok") 1 0))

(define air (pset stand 1 1.4))
(define ar (collide air (list ground hitq) rules))
(show "over" (if (string=? (car (cdr (cdr ar))) "ok") 1 0))

(void)
