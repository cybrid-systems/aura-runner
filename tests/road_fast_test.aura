; The road index must answer the same height and grade as a full scan,
; including a hole, a slope, an overlap, and a slab that is not in order.
; A step with no rival, flyer, or popper must hand back the same list.
(require "lib/phys")
(require "lib/gen")
(require "std/math" all:)

(define (expect name ok)
  (display name)
  (display " ")
  (display (if ok 1 0))
  (newline)
  (if ok #t (error (string-append "road-fast: " name))))

(define (scan x pieces)
  (let loop ((ps pieces) (hit #f) (lip 0.0) (best -1.0))
    (if (null? ps)
      (if hit hit (list lip 0.0))
      (let ((q (car ps)))
        (if (not (= (piece-k q) 1.0))
          (loop (cdr ps) hit lip best)
          (let* ((x0 (piece-x q))
                 (w (piece-w q))
                 (x1 (+ x0 w))
                 (y0 (piece-y q))
                 (rise (piece-nth q 6 0.0)))
            (if (and (>= x x0) (< x x1))
              (let* ((t (if (> w 0.0001) (/ (- x x0) w) 0.0))
                     (grade (if (> w 0.0001) (/ rise w) 0.0)))
                (loop (cdr ps) (list (+ y0 (* rise t)) grade) lip best))
              (if (and (<= x1 x) (> x1 best))
                (loop (cdr ps) hit (+ y0 rise) x1)
                (loop (cdr ps) hit lip best)))))))))

(define (close? a b)
  (let ((d (- a b)))
    (< (if (< d 0.0) (- 0.0 d) d) 0.0000001)))

(define (same-road? x pieces)
  (let ((a (road-at x pieces))
        (b (scan x pieces)))
    (and (close? (car a) (car b))
         (close? (car (cdr a)) (car (cdr b))))))

(define course
  (list (piece 5.0 1.0 0.4 0.4 1.0 1.0)
        (piece 1.0 0.0 4.0 0.2 0.0  -1.0 1.0)
        (piece 3.0 3.0 0.6 0.4 0.2 1.0)
        (piece 2.0 4.0 1.5 1.0 0.0 1.0)
        (piece 1.0 6.0 5.0 0.2 1.0 -1.0 -0.5)
        (piece 9.0 8.0 0.6 0.6 1.0 1.0)
        (piece 1.0 3.5 2.0 0.2 0.4 -1.0 0.2)))

(define (sweep pieces)
  (let loop ((i 0) (ok #t))
    (if (or (not ok) (> i 160))
      ok
      (loop (+ i 1) (same-road? (* (exact->inexact i) 0.1) pieces)))))

(expect "flat-slope-gap" (sweep course))
(expect "before" (same-road? -2.0 course))
(expect "lip" (same-road? 5.2 course))
(expect "repeat" (and (same-road? 2.0 course) (same-road? 2.0 course)))

(define flat (list (piece 1.0 0.0 30.0 0.2 0.0) (piece 7.0 4.0 0.8 0.8 0.0 1.0)))
(define again (step-rivals (nudge-flyers (step-poppers flat (make-player 1.0) PHYS-DT) PHYS-DT) (make-player 1.0) PHYS-DT))
(expect "same-list" (eq? again flat))

(define rules (rules-of 32.0 11.2 8.0 0.48 0.12 0.12))
(define p0 (make-player 1.0))
(define stepped (step p0 flat rules PHYS-DT))
(define p1 (car stepped))
(expect "moved" (> (player-x p1) (player-x p0)))
(expect "still-same" (eq? (car (cdr stepped)) flat))

(define (live-road x pieces)
  (let ((st (live-ensure (live-absorb (live-blank) pieces))))
    (road-query x (live-slabs st) (live-sn st))))

(define (same-live? x pieces)
  (let ((a (scan x pieces))
        (b (live-road x pieces)))
    (and (close? (car a) (car b))
         (close? (car (cdr a)) (car (cdr b))))))

(define (sweep-live pieces)
  (let loop ((i 0) (ok #t))
    (if (or (not ok) (> i 160))
      ok
      (loop (+ i 1) (same-live? (* (exact->inexact i) 0.1) pieces)))))

(expect "live-unordered" (sweep-live course))
(expect "live-lip" (same-live? 5.2 course))
(expect "live-overlap" (same-live? 3.7 course))

(define play
  (list (piece 1.0 0.0 12.0 0.2 0.0 -1.0 0.0)
        (piece 5.0 4.0 0.4 0.4 1.1 1.0)
        (piece 2.0 6.0 1.2 1.0 0.0 1.0)
        (piece 3.0 8.0 0.5 0.45 0.2 1.0)
        (piece 8.0 9.0 0.7 0.4 1.2 1.0 0.0 3.0)
        (piece 1.0 12.0 10.0 0.2 0.0 -1.0 2.0)
        (piece 9.0 16.0 0.6 0.6 1.85 0.0 0.0 3.6 2.8 1.05)
        (piece 10.0 18.0 0.7 0.9 0.0 2.0 0.0 2.2)
        (piece 6.0 20.0 0.8 0.2 0.0 1.0)
        (piece 1.0 22.0 20.0 0.2 2.0 -1.0 0.0)))

(define (only-movers ps)
  (let loop ((xs ps) (acc (list)))
    (if (null? xs)
      (reverse acc)
      (if (or (= (piece-k (car xs)) 8.0)
              (= (piece-k (car xs)) 9.0)
              (= (piece-k (car xs)) 10.0))
        (loop (cdr xs) (cons (car xs) acc))
        (loop (cdr xs) acc)))))

(define (movers-match? a b)
  (if (and (null? a) (null? b))
    #t
    (if (or (null? a) (null? b))
      #f
      (and (close? (piece-k (car a)) (piece-k (car b)))
           (close? (piece-x (car a)) (piece-x (car b)))
           (close? (piece-y (car a)) (piece-y (car b)))
           (movers-match? (cdr a) (cdr b))))))

(define (kept ps x)
  (let ((cut (- x 8.0)))
    (let loop ((xs ps) (acc (list)))
      (if (null? xs)
        (reverse acc)
        (let ((q (car xs)))
          (if (or (= (piece-k q) 0.0) (< (+ (piece-x q) (piece-w q)) cut))
            (loop (cdr xs) acc)
            (loop (cdr xs) (cons q acc))))))))

(define (body-match? a b)
  (and (close? (player-x a) (player-x b))
       (close? (player-y a) (player-y b))
       (close? (player-vy a) (player-vy b))
       (close? (player-score a) (player-score b))
       (close? (player-lane a) (player-lane b))))

(define (script p i)
  (cond
    ((= i 30) (press-jump p))
    ((= i 90) (press-lane p -1))
    ((= i 150) (press-jump p))
    (else p)))

(define (trace-live pieces rules n)
  (let loop ((i 0)
             (pa (make-player 1.0))
             (pb (make-player 1.0))
             (ps pieces)
             (st (live-absorb (live-blank) pieces)))
    (if (>= i n)
      #t
      (let* ((pa0 (script pa i))
             (pb0 (script pb i))
             (ra (step pa0 ps rules PHYS-DT))
             (rb (step-live pb0 st rules PHYS-DT))
             (ea (car (cdr (cdr ra))))
             (eb (car (cdr (cdr rb)))))
        (if (and (string=? ea eb)
                 (body-match? (car ra) (car rb))
                 (movers-match? (only-movers (kept (car (cdr ra)) (player-x (car ra))))
                                (only-movers (kept (live-movers (car (cdr rb))) (player-x (car rb))))))
          (loop (+ i 1) (car ra) (car rb) (car (cdr ra)) (car (cdr rb)))
          (begin
            (display "diverge ")
            (display i)
            (display " ")
            (display ea)
            (display "/")
            (display eb)
            (display " x ")
            (display (player-x (car ra)))
            (display "/")
            (display (player-x (car rb)))
            (display " y ")
            (display (player-y (car ra)))
            (display "/")
            (display (player-y (car rb)))
            (newline)
            #f))))))

(expect "live-trace" (trace-live play rules 220))
(define mag (rules-of 32.0 11.2 8.0 0.48 0.12 0.12 25.0 0.0 4.0))
(expect "live-magnet" (trace-live play mag 80))
(define dead (pset (make-player 1.0) 5 0.0))
(define dead-st (live-absorb (live-blank) play))
(define dead-r (step-live dead dead-st rules PHYS-DT))
(expect "live-dead" (and (string=? (car (cdr (cdr dead-r))) "dead")
                         (eq? (car (cdr dead-r)) dead-st)))

(define (laid-road n speed)
  (let loop ((i 0) (x 0.0) (ps (list)))
    (if (>= i n)
      ps
      (let ((ch (chunk-or-fallback (pattern-chunk 42 i 1 speed) speed)))
        (loop (+ i 1)
              (+ x (hash-ref ch "x1"))
              (append ps (shift-pieces (hash-ref ch "pieces") x)))))))

(expect "live-seeded" (trace-live (laid-road 3 8.0) rules 240))
