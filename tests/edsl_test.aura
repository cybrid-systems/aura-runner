; Every curated city and every offline regional recipe passes the
; contrast and instance budget inside evo:trial. Spoken names resolve
; without waiting on a model.
(require "std/evo-core" all:)
(require "lib/edsl")
(require "lib/voice")

(define (show k v)
  (display k)
  (display " ")
  (display v)
  (newline))

(define (need ok why)
  (if ok #t (error (string-append "edsl " why))))

(define (trial-of text id)
  (let ((cand (evo:candidate text (hash "id" id "target" "biome-form"))))
    (evo:trial cand
               (hash "timeout-ms" 4000
                     "apply" (lambda (c) #t)
                     "evaluate"
                     (lambda (c)
                       (let ((chk (edsl-check (evo:candidate-genome c))))
                         (hash "status" "ok"
                               "objectives" (hash "fair" (if (hash-ref chk "ok") 1.0 0.0))
                               "constraints" (hash-ref chk "violations")
                               "behavior" (hash "band" 0.0))))))))

(define (show-row row)
  (let* ((form (edsl-form row))
         (chk (edsl-check form))
         (label (let ((key (hash-ref row "key" "")))
                  (if (and (string? key) (> (string-length key) 0)) key (hash-ref row "id")))))
    (need (hash-ref chk "ok" #f) label)
    (need (<= (hash-ref chk "instances" 999) 150) label)
    (need (< (string-length form) 690) "long")
    (show label (string-append (hash-ref chk "why") " " (edsl-num (hash-ref chk "instances"))))))

(let loop ((xs (edsl-all)))
  (if (or (not (pair? xs)) (null? xs))
    #t
    (begin (show-row (car xs)) (loop (cdr xs)))))

(define good (trial-of (edsl-form (edsl-get "beijing")) "beijing"))
(define bad (trial-of "(biome beijing (sky 0.97 0.80 0.46) (sky1 1.0 0.64 0.34) (fog 0.98 0.84 0.58 0.90) (sun 1.0 0.84 0.42) (path 0.58 0.26 0.16) (curb 0.75 0.15 0.12) (ground 0.55 0.46 0.26) (hill 0.46 0.30 0.26) (hill2 0.34 0.20 0.22) (water 0.28 0.45 0.58) (build 0.74 0.14 0.12) (roof 0.16 0.09 0.08) (mote 1.0 0.35 0.18) (light 0.90) (mood day) (style palace) (part lantern) (props pagoda palace-gate))" "foggy"))
(show "trial-beijing" (if (and (evo:trial-ok? good) (evo:feasible? good)) 1 0))
(show "trial-fog" (if (or (not bad) (not (evo:trial-ok? bad)) (not (evo:feasible? bad))) 1 0))

(define (show-intent label text)
  (let ((r (voice-intent text)))
    (display label)
    (display " ")
    (if r
      (begin
        (display (hash-ref r "act"))
        (display " ")
        (display (hash-ref r "name")))
      (display "none"))
    (newline)))

(show-intent "cn-beijing" "去北京")
(show-intent "cn-beijing2" "北京")
(show-intent "en-beijing" "beijing")
(show-intent "cn-shanghai" "上海")
(show-intent "en-shanghai" "shanghai")
