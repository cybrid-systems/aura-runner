(show "next-china" (edsl-next "china" "garden"))
(show "next-china2" (edsl-next "china" "beijing"))
(show "next-us" (edsl-next "us" "newyork"))
(show "next-eu" (edsl-next "europe" "venice"))
(show "next-world" (edsl-next "world" "tokyo"))
(show "fall-guilin" (hash-ref (edsl-fallback "桂林") "id"))
(show "fall-lhasa" (hash-ref (edsl-fallback "拉萨") "key"))
(show "fall-dali" (hash-ref (edsl-fallback "大理") "key"))
(show "fall-amsterdam" (hash-ref (edsl-fallback "阿姆斯特丹") "key"))
(show "fall-chicago" (hash-ref (edsl-fallback "芝加哥") "id"))
(show "fall-prague" (hash-ref (edsl-fallback "Prague") "key"))
(show "fall-ok" (if (hash-ref (edsl-check (edsl-form (edsl-fallback "桂林"))) "ok") 1 0))
(show "title-zh" (edsl-title "paris" "zh"))
(show "title-en" (edsl-title "paris" "en"))

(void)
