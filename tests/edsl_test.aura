; Biome EDSL gate. A fair spec is KEEP'd into the pool. A low-contrast
; spec, an over-budget spec, and a broken shape are ROLLBACK. Offline
; evolution returns a form that the same gate keeps.
(require "std/evo-core" all:)
(require "lib/edsl")

(define (show k v)
  (display k)
  (display " ")
  (display v)
  (newline))

(define (line name gate)
  (display name)
  (display " ")
  (display (hash-ref gate "verdict" "?"))
  (display " ")
  (display (hash-ref gate "why" "?"))
  (display " ")
  (display (hash-ref gate "id" ""))
  (if (string=? (hash-ref gate "verdict" "") "KEEP")
    (begin
      (display " ")
      (display (hash-ref gate "label" ""))
      (display " ")
      (display (hash-ref gate "trial" "")))
    #f)
  (newline))

(line "garden" (edsl-gate edsl-garden))
(line "city" (edsl-gate edsl-city))
(line "space" (edsl-gate edsl-space))
(line "coast" (edsl-gate edsl-coast))
(line "lava" (edsl-gate edsl-lava))
(line "ice" (edsl-gate edsl-ice))
(line "candy" (edsl-gate edsl-candy))
(line "coral" (edsl-gate edsl-coral))
(line "cyber" (edsl-gate edsl-cyber))

; The natural prop vocabulary: conifer, shrub, frond and mushroom.
(define natural "(biome natural-grove (label Natural-Grove) (sky 0.55 0.72 0.95 0.86 0.91 0.98) (fog 0.78 0.86 0.94 0.22) (body sun) (road 0.93 0.78 0.52) (curb 0.45 0.32 0.22) (ground 0.42 0.68 0.38) (surface grass) (light 0.82) (mood 0.55) (particles fireflies 0.18) (props (pine 0.20 1.00) (bush 0.20 1.00) (fern 0.20 1.00) (mushroom 0.20 1.00)) (recipe mix))")
(line "natural" (edsl-gate natural))

(define dull
  "(biome dull-road (label Dull-Road) (sky 0.55 0.72 0.95 0.86 0.91 0.98) (fog 0.78 0.86 0.94 0.22) (body sun) (road 0.50 0.50 0.50) (curb 0.40 0.40 0.40) (ground 0.52 0.50 0.48) (surface stone) (light 0.80) (mood 0.50) (particles none 0.10) (props (rock 0.20 1.00)) (recipe mix))")
(define coinish
  "(biome coin-road (label Coin-Road) (sky 0.55 0.72 0.95 0.86 0.91 0.98) (fog 0.78 0.86 0.94 0.22) (body sun) (road 0.99 0.84 0.33) (curb 0.40 0.32 0.22) (ground 0.22 0.48 0.28) (surface sand) (light 0.80) (mood 0.50) (particles none 0.10) (props (rock 0.20 1.00)) (recipe mix))")
(define packed
  "(biome packed-road (label Packed-Road) (sky 0.55 0.72 0.95 0.86 0.91 0.98) (fog 0.78 0.86 0.94 0.22) (body sun) (road 0.48 0.30 0.22) (curb 0.32 0.18 0.14) (ground 0.18 0.16 0.18) (surface lava) (light 0.72) (mood 0.50) (particles embers 0.40) (props (tower 0.55 1.20) (arch 0.55 1.20) (tree 0.55 1.20) (coral 0.55 1.20)) (recipe mix))")
(define broken "(biome nope (sky 2 0 0 0 0 0))")
(define dark
  "(biome dark-sky (label Dark-Sky) (sky 0.01 0.01 0.02 0.20 0.20 0.24) (fog 0.20 0.20 0.24 0.10) (body moon) (road 0.48 0.30 0.22) (curb 0.32 0.18 0.14) (ground 0.18 0.16 0.18) (surface dust) (light 0.70) (mood 0.20) (particles none 0.10) (props (rock 0.20 1.00)) (recipe mix))")

(line "dull" (edsl-gate dull))
(line "coin" (edsl-gate coinish))
(line "packed" (edsl-gate packed))
(line "broken" (edsl-gate broken))
(line "dark" (edsl-gate dark))

(define pool (edsl-register (edsl-boot) edsl-lava))
(show "pool-lava" (if (edsl-has? pool "lava-canyon") 1 0))
(show "pool-garden" (if (edsl-has? pool "garden") 1 0))
(define rejected (edsl-register pool dull))
(show "pool-same" (if (= (edsl-len rejected) (edsl-len pool)) 1 0))
(show "pool-no-dull" (if (edsl-has? rejected "dull-road") 1 0))

(define evolved (edsl-evolve pool 4))
(define eg (if (string? evolved) (edsl-gate evolved) (hash "verdict" "ROLLBACK" "why" "none" "id" "")))
(show "evolve-keep" (if (string=? (hash-ref eg "verdict" "") "KEEP") 1 0))
(show "evolve-new" (if (and (string=? (hash-ref eg "verdict" "") "KEEP")
                            (not (edsl-builtin? (hash-ref eg "id" ""))))
                     1 0))
(show "evolve-id" (hash-ref eg "id" ""))

(define again (edsl-evolve (edsl-boot) 9))
(define ag (if (string? again) (edsl-gate again) (hash "verdict" "ROLLBACK" "id" "")))
(show "evolve2-keep" (if (string=? (hash-ref ag "verdict" "") "KEEP") 1 0))
(show "evolve2-diff" (if (and (string=? (hash-ref ag "verdict" "") "KEEP")
                              (not (string=? (hash-ref ag "id" "") (hash-ref eg "id" ""))))
                       1 0))

(show "theme-volcano" (edsl-theme "去火山"))
(show "theme-ice" (edsl-theme "极光冰原"))
(show "theme-candy" (edsl-theme "糖果世界"))
(show "theme-en" (edsl-theme "ice palace"))
(show "theme-garden" (if (edsl-theme "花园") 1 0))
(show "theme-cyber-word" (if (edsl-theme "cyber") 1 0))

(line "beijing" (edsl-gate edsl-beijing))
(line "shanghai" (edsl-gate edsl-shanghai))
(line "hangzhou" (edsl-gate edsl-hangzhou))
(line "paris" (edsl-gate edsl-paris))
(line "sanfrancisco" (edsl-gate edsl-sanfrancisco))
(show "theme-beijing" (edsl-theme "去北京"))
(show "theme-paris" (edsl-theme "paris"))
(show "theme-west" (edsl-theme "西湖"))
(show "place-next" (edsl-place "下一个城市" "paris"))
(show "place-china" (edsl-place "去中国" "garden"))
(show "place-guilin" (edsl-place "去桂林" "garden"))
(show "place-prague" (edsl-place "go to Prague" "garden"))
(show "place-city" (if (edsl-place "去城市" "garden") 1 0))
(show "steer-next" (edsl-steer "下一个城市" "paris"))
(show "steer-bare" (if (edsl-steer "城市" "garden") 1 0))
(show "steer-night" (edsl-steer "北京的夜晚" "garden"))
(show "steer-swap" (edsl-steer "换个城市" "beijing"))
(show "steer-china" (edsl-steer "中国城市" "garden"))
(show "theme-peking" (edsl-theme "去北平"))
(show "theme-mishear" (edsl-theme "去背景"))
(show "theme-degree" (edsl-theme "去程度"))
(show "theme-harm" (if (edsl-theme "不要伤害") 1 0))
(show "theme-sf" (edsl-theme "三藩市"))
(show "steer-change" (edsl-steer "换城市" "paris"))
(show "steer-seat" (edsl-steer "下一座城市" "paris"))
(show "steer-one" (edsl-steer "换一个城市" "paris"))
(show "steer-gap" (edsl-steer "下一个 城市" "paris"))
(show "steer-mis-cheng" (edsl-steer "下一个成市" "paris"))
(show "steer-mis-prog" (edsl-steer "下一个程序" "garden"))
(show "steer-short" (edsl-steer "下一城市" "paris"))
(show "steer-metro" (edsl-steer "下一个都市" "shanghai"))
(show "say-beijing" (edsl-say "beijing" "zh"))
(show "say-beijing-en" (edsl-say "beijing" "en"))
(show "say-candy" (edsl-say "candy-clouds" "zh"))

(define (must name ok)
  (display name)
  (display " ")
  (display (if ok 1 0))
  (newline)
  (if ok #t (error (string-append "edsl: " name))))

(line "sand" (edsl-gate edsl-sand))
(must "sand-keep" (string=? (hash-ref (edsl-gate edsl-sand) "verdict" "") "KEEP"))
(must "ask-desert" (and (string? (edsl-ask "去沙漠"))
                        (not (string=? (edsl-ask "去沙漠") "visit-china"))
                        (string=? (edsl-ask "去沙漠") "sand-dunes")))
(must "place-desert" (string=? (edsl-place "去沙漠" "garden") "sand-dunes"))
(must "theme-desert" (string=? (edsl-theme "去沙漠") "sand-dunes"))

(define desert (edsl-offline "去沙漠" (list)))
(define desert-chk (edsl-check desert))
(must "desert-world" (and (hash-ref desert-chk "ok" #f)
                          (string=? (hash-ref desert-chk "id" "") "sand-dunes")
                          (or (string=? (hash-ref desert-chk "surface" "") "sand")
                              (string=? (hash-ref desert-chk "surface" "") "dust"))
                          (edsl-warm? desert-chk)))

(define reef (edsl-offline "海底城市" (list)))
(define reef-chk (edsl-check reef))
(must "reef-world" (and (hash-ref reef-chk "ok" #f)
                        (string=? (hash-ref reef-chk "id" "") "coral-reef")
                        (or (string=? (hash-ref reef-chk "surface" "") "reef")
                            (edsl-has-kind? (hash-ref reef-chk "props" (list)) "coral")
                            (edsl-cyan-fog? reef-chk))))

(define rainy (edsl-offline "下雨的东京" (list)))
(define rainy-chk (edsl-check rainy))
(must "rain-tokyo" (and (hash-ref rainy-chk "ok" #f)
                        (string=? (hash-ref rainy-chk "id" "") "tokyo")
                        (string=? (hash-ref rainy-chk "particles" "") "rain")))

(must "night-beijing" (string=? (edsl-steer "北京的夜晚" "garden") "beijing"))
(must "cyber-theme" (string=? (edsl-theme "赛博雨") "cyber-rain"))
(must "cyber-not-free" (not (edsl-free-form "赛博雨")))

(define g1 (edsl-offline "xyzzy-plugh" (list)))
(define g2 (edsl-offline "qqqq-blorp" (list)))
(define g1b (edsl-offline "xyzzy-plugh" (list)))
(must "gibber-ok" (and (string? g1) (string? g2)
                       (hash-ref (edsl-check g1) "ok" #f)
                       (hash-ref (edsl-check g2) "ok" #f)))
(must "gibber-diff" (not (string=? g1 g2)))
(must "gibber-same" (string=? g1 g1b))

(must "still-sky" (not (edsl-free-form "把天空染成粉色")))
(must "still-star" (not (edsl-free-form "来一个金色的星星")))
(must "still-bunny" (not (edsl-free-form "来一只小兔子")))
(must "still-garden" (not (edsl-free-form "花园")))
(must "still-swap" (not (edsl-free-form "换城市")))
(must "still-slow" (not (edsl-free-form "跑得慢一点")))
(must "still-city" (not (edsl-place "去城市" "garden")))
(must "still-guilin" (string=? (edsl-place "去桂林" "garden") "visit-china"))
(must "still-next" (string? (edsl-steer "下一个城市" "paris")))
(must "still-another" (and (not (edsl-free-form "换一个"))
                           (not (edsl-theme "换一个"))
                           (not (edsl-steer "换一个" "garden"))))
(must "open-guilin" (edsl-open-place? "去桂林"))
(must "not-open-beijing" (not (edsl-open-place? "去北京")))
(must "not-open-desert" (not (edsl-open-place? "去沙漠")))

(void)
