; A generated thing is data. check-thing keeps a bright, bounded form and
; refuses anything outside the caps. The score ranks fair candidates; the
; pick and the deadline drop are pure functions over arrival rows.
(require "lib/thing")

(define rules (rules-of 32.0 11.2 8.0 0.48 0.12 0.12 25.0 0.0 0.0))

(define cake "A pink cake floats up. (thing pickup 1.2 (anim spin 0.1 1.0) (name cake) (part cylinder 0 0.3 0 0.8 0.4 0.8 0.98 0.62 0.75 0.1) (part cylinder 0 0.62 0 0.6 0.25 0.6 1.0 0.95 0.9 0.0) (part sphere 0 0.85 0 0.2 0.2 0.2 0.95 0.3 0.35 0.4))")
(define log "(thing jump 0.4 (part cylinder 0 0.4 0 1.0 0.8 0.6 0.75 0.55 0.35 0.0) (part sphere -0.4 0.8 0 0.2 0.2 0.2 0.4 0.85 0.4 0.0))")
(define arch "(thing slide 0.8 (part torus 0 0.5 0 0.9 0.6 0.4 0.6 0.7 1.0 0.3))")
(define tall "(thing jump 0.9 (part box 0 0.5 0 1 1 1 0.9 0.6 0.3 0))")
(define dark "(thing pickup 1.0 (part sphere 0 0.5 0 0.5 0.5 0.5 0.1 0.1 0.1 0))")
(define out "(thing pickup 1.0 (part sphere 0.4 0.5 0 0.5 0.5 0.5 0.9 0.9 0.2 0))")
(define bad-shape "(thing pickup 1.0 (part skull 0 0.5 0 0.5 0.5 0.5 0.9 0.9 0.2 0))")
(define (boxes n)
  (let loop ((i 0) (out ""))
    (if (>= i n)
      out
      (loop (+ i 1) (string-append out " (part box 0 0.5 0 0.2 0.2 0.2 0.9 0.9 0.2 0)")))))
(define many (string-append "(thing decor 1.0" (string-append (boxes 11) ")")))
(define ten (string-append "(thing decor 1.0" (string-append (boxes 10) ")")))
(define hopper "(thing jump 0.4 (anim hop 0.3 2.0) (part box 0 0.5 0 1 1 0.5 0.9 0.6 0.3 0))")
(define code "(thing pickup 1.0 (eval 1) (part sphere 0 0.5 0 0.5 0.5 0.5 0.9 0.9 0.2 0))")
(define str "(thing pickup 1.0 (part sphere 0 0.5 0 0.5 0.5 0.5 0.9 0.9 0.2 0) \"x\")")
(define gloomy "A bomb. (thing pickup 1.0 (part sphere 0 0.5 0 0.5 0.5 0.5 0.9 0.9 0.2 0))")
(define speck "(thing jump 0.4 (part sphere 0 0.1 0 0.1 0.1 0.1 0.9 0.9 0.2 0))")
(define yawed "(thing decor 1.0 (part box 0 0.5 0 0.3 0.9 0.2 0.9 0.6 0.3 0.1 45))")
(define yawed-bad "(thing decor 1.0 (part box 0 0.5 0 0.3 0.9 0.2 0.9 0.6 0.3 0.1 181))")
(define metal "(thing decor 1.0 (part box 0 0.5 0 0.3 0.9 0.2 0.9 0.6 0.3 0.1 45 0.8))")
(define metal-bad "(thing decor 1.0 (part box 0 0.5 0 0.3 0.9 0.2 0.9 0.6 0.3 0.1 45 1.5))")

(define (report name text)
  (let ((r (check-thing text)))
    (display name) (display " ")
    (display (if (hash-ref r "ok") 1 0)) (display " ")
    (display (hash-ref r "why"))
    (if (hash-ref r "ok")
      (begin (display " ") (display (hash-ref r "role")) (display " ") (display (hash-ref r "count")))
      #f)
    (newline)))

(report "cake" cake)
(report "log" log)
(report "arch" arch)
(report "tall" tall)
(report "dark" dark)
(report "out" out)
(report "bad-shape" bad-shape)
(report "many" many)
(report "ten" ten)
(report "hopper" hopper)
(report "code" code)
(report "str" str)
(report "gloomy" gloomy)
(report "speck" speck)
(report "yawed" yawed)
(report "yawed-bad" yawed-bad)
(report "metal" metal)
(report "metal-bad" metal-bad)
(report "none" "I could not think of one.")
; Replies seen from some models: the head word dropped, or the name in its place.
(report "headless" "Here comes a donut! (pickup 1.1 (anim spin 0.08 1.2) (name donut) (part torus 0 0.5 0 0.8 0.8 0.8 0.7 0.2 1 0.2))")
(report "named-head" "A donut! (doughnut pickup 1.2 (anim spin 0.08 1.2) (name doughnut) (part torus 0 0.5 0 0.8 0.8 0.8 0.6 0.2 0.9 0.2))")
(report "other-head" "(dance pickup) (lambda x 1.2 (part box 0 0.5 0 0.5 0.5 0.5 1 1 1 0))")

(define (bit ok) (if ok 1 0))
(define c-cake (check-thing cake))
(define c-log (check-thing log))
(define c-arch (check-thing arch))
(define f-cake (thing-fair "pickup" 1.2 rules))
(define f-log (thing-fair "jump" 0.4 rules))
(define f-arch (thing-fair "slide" 0.8 rules))
(display "fair-cake ") (display (bit (hash-ref f-cake "fair"))) (newline)
(display "fair-log ") (display (bit (hash-ref f-log "fair"))) (newline)
(display "fair-arch ") (display (bit (hash-ref f-arch "fair"))) (newline)
(display "role-cake ") (display (wish-role-of "来一个粉色的蛋糕")) (newline)
(display "role-arch ") (display (wish-role-of "我要一座彩虹桥可以滑过去")) (newline)
(display "role-none ") (display (bit (string=? (wish-role-of "开心") ""))) (newline)
(define s-cake (thing-score c-cake f-cake "来一个粉色的蛋糕" 1))
(define s-log (thing-score c-log f-log "来一个粉色的蛋糕" 1))
(display "score-intent ") (display (bit (> s-cake s-log))) (newline)
(display "score-unfair ") (display (thing-score c-cake (hash "fair" #f) "x" 0)) (newline)
(display "score-refused ") (display (thing-score (check-thing dark) f-cake "x" 0)) (newline)
(define rows (list (list 1 1.4) (list 2 1.9) (list 3 0.0) (list 4 1.9)))
(display "pick ") (display (car (thing-pick rows))) (newline)
(display "pick-none ") (display (bit (not (thing-pick (list (list 1 0.0) (list 2 0.0)))))) (newline)
(define arrivals (list (list 1 1000.0) (list 2 6000.0) (list 3 13000.0) (list 4 9000.0)))
(display "in-time ") (display (map car (thing-in-time arrivals 0.0 10000.0))) (newline)
(display "user-quote ") (display (bit (string-contains? (thing-user "来一个粉色的蛋糕" "pickup" 2) "来一个粉色的蛋糕"))) (newline)
(display "public-parts ") (display (length (hash-ref (thing-public c-cake 7) "parts"))) (newline)
