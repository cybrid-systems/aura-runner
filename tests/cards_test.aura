; Card decks. A refused set leaves the previous tuple alone. The live
; gravity rebind is the same publish path the run uses after a keep.
(require "lib/cards")

(define prev (list 32.0 0.0 0.0 (list)))
(define bad (commit-deck prev (list "nope") 32.0 11.2))
(define far (commit-deck prev (list) 4.0 11.2))
(define heavy (commit-deck prev (list "double") 32.0 90.0))
(define ver (commit-deck prev (list "light.2") 32.0 11.2))
(define good (commit-deck prev (list "magnet" "light" "double") 32.0 11.2))
(define q (share-query 42 (list "light" "double" "magnet")))

(display "bounds-light ")
(display (if (bounds-ok? CARD-LIGHT-G 11.2) 1 0))
(newline)
(display "bounds-lo ")
(display (if (bounds-ok? 4.0 11.2) 1 0))
(newline)
(display "bounds-hi ")
(display (if (bounds-ok? 90.0 11.2) 1 0))
(newline)
(display "bounds-jump ")
(display (if (bounds-ok? 32.0 2.0) 1 0))
(newline)
(display "roll-unknown ")
(display (if (equal? bad prev) 1 0))
(newline)
(display "roll-bounds ")
(display (if (and (equal? far prev) (equal? heavy prev) (equal? ver prev)) 1 0))
(newline)
(display "keep-three ")
(display (if (equal? good (list 22.0 1.0 2.4 (list "light" "double" "magnet"))) 1 0))
(newline)
(display "share ")
(display (if (and (string=? q "seed=42&cards=light.1,double.1,magnet.1")
                  (not (string-contains? q "key"))
                  (not (string-contains? q "audio"))
                  (not (string-contains? q "(define")))
           1 0))
(newline)

(set-code (read-file "core/hot.aura"))
(eval-current)
(define how (mutate :rebind "rule-gravity" "(lambda () 22.0)" "cards"))
(eval-current)
(display "rebind ")
(display (if (and (equal? how #t) (= (rule-gravity) 22.0)) 1 0))
(newline)
(define how-air (mutate :rebind "rule-double-jump" "(lambda () 1.0)" "air"))
(eval-current)
(display "rebind-air ")
(display (if (and (equal? how-air #t) (= (rule-double-jump) 1.0)) 1 0))
(newline)
(void)
