; The advanced line accepts one number on the card's rule. A call, a
; bad token, or a number outside the band leaves the previous gravity.
(require "lib/primer")

(define (expect name ok)
  (display name)
  (display " ")
  (display (if ok 1 0))
  (newline)
  (if ok #t (error (string-append "primer: " name))))

(define (val text)
  (primer-read "light" text))

(define keep24 (val "(define (rule-gravity) 24.0)"))
(define keep18 (val "(define (rule-gravity) 18)"))
(define keep40 (val "(define (rule-gravity) 40.0)"))
(define low (val "(define (rule-gravity) 17.9)"))
(define high (val "(define (rule-gravity) 40.1)"))
(define call (val "(define (rule-gravity) (banned?))"))
(define banned (val "(define (banned?) #f)"))
(define whole (val "(set-code \"(define (banned?) #f)\")"))
(define extra (val "(define (rule-gravity) 24.0) (define (banned?) #f)"))
(define word (val "(define (rule-gravity) hello)"))
(define other (val "(define (rule-magnet) 2.4)"))
(define magnet (primer-read "magnet" "(define (rule-magnet) 9)"))
(define magnet-ok (primer-read "magnet" "(define (rule-magnet) 2.4)"))
(define jump (primer-read "double" "(define (rule-double-jump) 1.0)"))
(define gate (val "(define (rule-gravity) 24.0) (layout-fair? #f)"))

(expect "slice" (= PRIMER-SLICE 12))
(expect "g24" (and (hash-ref keep24 "ok" #f)
                   (string=? (hash-ref keep24 "name" "") "rule-gravity")
                   (primer-near? (hash-ref keep24 "value" 0) 24.0)))
(expect "bounds-in" (and (hash-ref keep18 "ok" #f) (hash-ref keep40 "ok" #f)))
(expect "bounds-out" (and (not (hash-ref low "ok" #f))
                          (string=? (hash-ref low "why" "") "bounds")
                          (not (hash-ref high "ok" #f))
                          (string=? (hash-ref high "why" "") "bounds")))
(expect "list" (and (not (hash-ref call "ok" #f))
                    (string=? (hash-ref call "why" "") "list")
                    (not (hash-ref banned "ok" #f))
                    (string=? (hash-ref banned "why" "") "list")
                    (not (hash-ref whole "ok" #f))
                    (not (hash-ref extra "ok" #f))
                    (not (hash-ref gate "ok" #f))))
(expect "lex" (and (not (hash-ref word "ok" #f))
                   (string=? (hash-ref word "why" "") "lex")))
(expect "card" (and (not (hash-ref other "ok" #f))
                    (string=? (hash-ref other "why" "") "card")))
(expect "magnet" (and (not (hash-ref magnet "ok" #f))
                      (hash-ref magnet-ok "ok" #f)
                      (hash-ref jump "ok" #f)))
(expect "keep-prev" (and (primer-near? (primer-keep 32.0 "light" "(define (rule-gravity) 24.0)") 24.0)
                         (primer-near? (primer-keep 32.0 "light" "(define (rule-gravity) 99)") 32.0)
                         (primer-near? (primer-keep 32.0 "light" "(define (rule-gravity) (banned?))") 32.0)
                         (primer-near? (primer-keep 32.0 "light" "(define (banned?) #f)") 32.0)
                         (primer-near? (primer-keep 22.0 "light" "(set-code \"x\")") 22.0)))

(void)
