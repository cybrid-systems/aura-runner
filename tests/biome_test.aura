; The multiplier climbs across a gate and the combo is echoed back.
; Venues follow the level, and a spoken word switches at once.
(require "lib/voice")
(require "lib/biome")

(define (show k v)
  (display k)
  (display " ")
  (display v)
  (newline))

(define (bit ok) (if ok 1 0))

(show "biome1" (biome-for-level 1))
(show "biome2" (biome-for-level 2))
(show "biome3" (biome-for-level 3))
(show "biome4" (biome-for-level 4))
(show "biome5" (biome-for-level 5))
(show "biome6" (biome-for-level 6))
(show "next-garden" (biome-next "garden"))
(show "next-coast" (biome-next "coast"))

(define up (mult-add 1 1))
(define cap (mult-add 8 1))
(show "mult-up" (string-append (biome-int (hash-ref up "mult")) " " (biome-int (hash-ref up "gain"))))
(show "mult-cap" (string-append (biome-int (hash-ref cap "mult")) " " (biome-int (hash-ref cap "gain"))))

(define c1 (chal-see 0 #f 1))
(define c2 (chal-see 1 #f 1))
(define c3 (chal-see 2 #f 1))
(define c4 (chal-see 3 #t (hash-ref c3 "mult")))
(show "chal-1" (string-append (biome-int (hash-ref c1 "coins")) " " (biome-int (bit (hash-ref c1 "done"))) " " (biome-int (hash-ref c1 "mult"))))
(show "chal-3" (string-append (biome-int (hash-ref c3 "coins")) " " (biome-int (bit (hash-ref c3 "done"))) " " (biome-int (hash-ref c3 "mult")) " " (biome-int (hash-ref c3 "gain"))))
(show "chal-more" (string-append (biome-int (hash-ref c4 "coins")) " " (biome-int (bit (hash-ref c4 "done"))) " " (biome-int (hash-ref c4 "mult")) " " (biome-int (hash-ref c4 "gain"))))

; A clean level 1 with points steps the pace and keeps the combo.
(define g1 (gate-cross 1 0 0 100 1 3))
(show "gate-combo" (hash-ref g1 "combo"))
(show "gate-mult" (hash-ref g1 "mult"))
(show "gate-gain" (hash-ref g1 "gain"))
(show "gate-biome" (hash-ref g1 "biome"))
(show "gate-what" (hash-ref g1 "what"))
(show "gate-form" (hash-ref g1 "form"))
(show "gate-level" (hash-ref g1 "level"))

; Level 2 holds the pace, so the cape is what evolved. Combo stays.
(define g2 (gate-cross 2 1 0 200 (hash-ref g1 "mult") 4))
(show "gate2-combo" (hash-ref g2 "combo"))
(show "gate2-mult" (hash-ref g2 "mult"))
(show "gate2-biome" (hash-ref g2 "biome"))
(show "gate2-what" (hash-ref g2 "what"))

(define g3 (gate-cross 3 1 2 10 (hash-ref g2 "mult") 4))
(show "gate3-biome" (hash-ref g3 "biome"))
(show "gate3-what" (hash-ref g3 "what"))
(show "gate3-combo" (hash-ref g3 "combo"))

(define g4 (gate-cross 4 1 1 80 8 2))
(show "gate4-mult" (hash-ref g4 "mult"))
(show "gate4-gain" (hash-ref g4 "gain"))
(show "gate4-biome" (hash-ref g4 "biome"))
(show "gate4-combo" (hash-ref g4 "combo"))

(show "line-en" (evo-line 2 "city" 2 1 "harder" "en"))
(show "line-zh" (evo-line 2 "city" 2 1 "harder" "zh"))

(define (show-intent label text)
  (let ((r (voice-intent text)))
    (display label)
    (display " ")
    (if r
      (begin
        (display (hash-ref r "act"))
        (display " ")
        (display (hash-ref r "name")))
      (display "none"))
    (newline)))

(show-intent "cn-garden" "花园")
(show-intent "cn-grass" "草地")
(show-intent "cn-city" "城市")
(show-intent "cn-metro" "都市")
(show-intent "cn-space" "太空")
(show-intent "cn-stars" "星空")
(show-intent "cn-cosmos" "宇宙")
(show-intent "cn-coast" "海边")
(show-intent "cn-ocean" "海洋")
(show-intent "cn-next" "换场景")
(show-intent "cn-next2" "下一个场景")
(show-intent "cn-night" "夜晚")
(show-intent "cn-night2" "夜景")
(show-intent "cn-dark" "黑夜")
(show-intent "cn-day" "白天")
(show-intent "cn-sunny" "晴天")
(show-intent "cn-sunset" "日落")
(show-intent "cn-dusk" "黄昏")
(show-intent "cn-neon" "霓虹")
(show-intent "cn-cyber" "赛博")
(show-intent "en-garden" "garden")
(show-intent "en-city" "go to the city")
(show-intent "en-space" "space")
(show-intent "en-coast" "ocean")
(show-intent "en-next" "next scene")
(show-intent "en-switch" "switch biome")
(show-intent "en-night" "night")
(show-intent "en-day" "day")
(show-intent "en-sunset" "sunset")
(show-intent "en-neon" "neon")
(show-intent "en-cyber" "cyber")
(show-intent "soft-sunny" "sunny garden")
(show-intent "soft-pink" "把天空染成粉色")
(show-intent "soft-star" "来一个金色的星星")
(show-intent "still-fast" "跑快点")

(show "world-space" (world-banner "space"))
(show "world-garden" (world-banner "garden"))
(show "world-city" (world-banner "city"))
(show "world-coast" (world-banner "coast"))

(void)
