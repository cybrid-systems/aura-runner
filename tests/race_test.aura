; Standing, the level gate, and the rival's answer to who led.
; The hit half-width and the speed cap stay where they were.
(require "lib/race")
(require "lib/chase")
(require "lib/phys")
(require "lib/voice")

(define (expect name ok)
  (display name)
  (display " ")
  (display (if ok 1 0))
  (newline)
  (if ok #t (error (string-append "race: " name))))

(define (near? a b)
  (not (chase-apart? a b)))

(define ahead (race-read 20.0 15.0))
(define behind (race-read 10.0 13.0))
(expect "first" (and (= (hash-ref ahead "place" 0) 1)
                     (string=? (hash-ref ahead "who" "") "player")
                     (string=? (hash-ref ahead "label" "") "+5m")))
(expect "second" (and (= (hash-ref behind "place" 0) 2)
                      (string=? (hash-ref behind "who" "") "rival")
                      (string=? (hash-ref behind "label" "") "-3m")))
(expect "gate-you" (string=? (race-gate 128.0 100.0 128.0) "player"))
(expect "gate-rival" (string=? (race-gate 128.0 140.0 128.0) "rival"))
(expect "gate-early" (string=? (race-gate 40.0 20.0 128.0) ""))
(expect "banner" (string=? (gate-line "Level clear" "player" "keen")
                           "Level clear · You led · Rival trains harder"))
(expect "banner-ease" (string=? (gate-line "Level clear" "rival" "gentle")
                                "Level clear · Rival led · Rival eases off"))
(expect "aside" (string=? (race-aside "player" "keen") " · You led · Rival trains harder"))

(define blank (chase-blank))
(expect "half" (near? RIVAL-HALF 0.28))
(expect "cap" (and (< (chase-cap 8.0) 8.0) (near? CHASE-FRACTION 0.45)))

(define held (chase-step blank 3 1 0 8.0))
(expect "one-hold" (and (not (hash-ref held "moved" #f))
                        (string=? (hash-ref held "mood" "") "hold")))
(define trained (chase-step blank 3 1 0 8.0 "player"))
(expect "train" (and (hash-ref trained "moved" #f)
                     (string=? (hash-ref trained "mood" "") "keen")
                     (string=? (chase-line "KEEP" "keen" "player") "Rival trains harder")))
(define eased (chase-step blank 3 0 0 8.0 "rival"))
(expect "ease-race" (and (hash-ref eased "moved" #f)
                         (string=? (hash-ref eased "mood" "") "gentle")
                         (string=? (chase-line "KEEP" "gentle" "rival") "Rival eases off")))
(define fair (chase-step blank 3 2 0 8.0 "player"))
(expect "fair-gentle" (string=? (hash-ref fair "mood" "") "gentle"))
(define novice (chase-step blank 0 0 0 8.0 "player"))
(expect "novice" (not (hash-ref novice "moved" #f)))
(expect "line-same" (and (string=? (chase-line "KEEP" "gentle") "它放慢了")
                         (string=? (chase-line "KEEP" "keen") "它跑得更勤了")
                         (string=? (chase-line "ROLLBACK" "hold") "它还是原来的样子")))

(define plain (adapt-finish 0 0 100 1))
(define hurt (adapt-finish 2 0 400 3 (hash "hearts" 1 "pressure" 2)))
(define lost (adapt-finish 0 0 200 1 (hash "defeats" 1 "pressure" 2)))
(expect "plain" (string=? (hash-ref plain "act" "") "harder"))
(expect "hurt" (string=? (hash-ref hurt "act" "") "ease"))
(expect "defeat" (string=? (hash-ref lost "act" "") "ease"))

(void)
