; A wish is filtered before any model call. Preset phrases are the
; offline road, sky, and friend that already pass the gate. A normal
; golden-star sentence is not a banned word.
(require "lib/wish")

(define rules (rules-of 32.0 11.2 8.0 0.48 0.12 0.12 25.0 0.0 0.0))
(define star (wish-preset "来一个金色的星星"))
(define sky (wish-preset "Paint the sky pink"))
(define bun (wish-preset "来一只小兔子"))
(define gate (wish-preset "A flower gate to slide under"))
(define cleaned (wish-clean "  say (seq)  "))
(define line (wish-line "zh" "banned"))
(define prompt (wish-user "来一个金色的星星"))

(define (bit ok) (if ok 1 0))

(display "ban-zh ")
(display (bit (banned? "来一个炸弹")))
(newline)
(display "ban-en ")
(display (bit (banned? "throw a bomb")))
(newline)
(display "ok-zh ")
(display (bit (not (banned? "来一个金色的星星"))))
(newline)
(display "ok-en ")
(display (bit (not (banned? "A golden star on the path"))))
(newline)
(display "arm-star ")
(display (if (string=? (wish-arm "来一个金色的星星") "motif") 1 0))
(newline)
(display "arm-gate ")
(display (if (string=? (wish-arm "来一个要滑铲的花门") "motif") 1 0))
(newline)
(display "arm-sky ")
(display (if (string=? (wish-arm "把天空染成粉色") "scene") 1 0))
(newline)
(display "arm-bunny ")
(display (if (string=? (wish-arm "来一只小兔子") "pals") 1 0))
(newline)
(display "arm-pink ")
(display (if (string=? (wish-arm "Paint the sky pink") "scene") 1 0))
(newline)
(display "clean ")
(display (if (and (string=? (wish-clean "  来一个金色的星星  ") "来一个金色的星星")
                  (not (string-contains? cleaned "("))
                  (not (string-contains? cleaned ")")))
           1 0))
(newline)
(display "audio ")
(display (if (and (wish-has-audio? (hash "audio" "nope"))
                  (not (wish-has-audio? (hash "text" "hi"))))
           1 0))
(newline)
(display "line ")
(display (if (and (string=? line "这一句有点不合适，换个明媚的说法")
                  (not (string-contains? line "炸弹"))
                  (not (string-contains? prompt "key"))
                  (not (string-contains? prompt "(define")))
           1 0))
(newline)
(display "preset-miss ")
(display (if (not (wish-preset "hello there")) 1 0))
(newline)
(display "fair-star ")
(display (bit (preset-fair? "来一个金色的星星" rules)))
(newline)
(display "fair-gate ")
(display (bit (preset-fair? "A flower gate to slide under" rules)))
(newline)
(display "fair-sky ")
(display (bit (and sky (hash-ref (check-scene (hash-ref sky "form")) "ok" #f))))
(newline)
(display "fair-bunny ")
(display (bit (and bun (hash-ref (check-pals (hash-ref bun "form")) "ok" #f))))
(newline)
(display "rows ")
(display (if (and star gate (string=? (hash-ref star "arm") "motif")
              (string=? (hash-ref gate "arm") "motif"))
           1 0))
(newline)

(void)
