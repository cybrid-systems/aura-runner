; A wish is filtered before any model call. Preset phrases are the
; offline road, sky, and friend that already pass the gate. A normal
; golden-star sentence is not a banned word.
(require "lib/wish")

(define rules (rules-of 32.0 11.2 8.0 0.48 0.12 0.12 25.0 0.0 0.0))
(define star (wish-preset "来一个金色的星星"))
(define sky (wish-preset "Paint the sky pink"))
(define bun (wish-preset "来一只小兔子"))
(define gate (wish-preset "A flower gate to slide under"))
(define cleaned (wish-clean "  say (seq)  "))
(define line (wish-line "zh" "banned"))
(define prompt (wish-user "来一个金色的星星"))

(define (bit ok) (if ok 1 0))

(display "ban-zh ")
(display (bit (banned? "来一个炸弹")))
(newline)
(display "ban-en ")
(display (bit (banned? "throw a bomb")))
(newline)
(display "ok-zh ")
(display (bit (not (banned? "来一个金色的星星"))))
(newline)
(display "ok-en ")
(display (bit (not (banned? "A golden star on the path"))))
(newline)
(display "arm-star ")
(display (if (string=? (wish-arm "来一个金色的星星") "motif") 1 0))
(newline)
(display "arm-gate ")
(display (if (string=? (wish-arm "来一个要滑铲的花门") "motif") 1 0))
(newline)
(display "arm-sky ")
(display (if (string=? (wish-arm "把天空染成粉色") "scene") 1 0))
(newline)
(display "arm-bunny ")
(display (if (string=? (wish-arm "来一只小兔子") "pals") 1 0))
(newline)
(display "arm-pink ")
(display (if (string=? (wish-arm "Paint the sky pink") "scene") 1 0))
(newline)
(display "clean ")
(display (if (and (string=? (wish-clean "  来一个金色的星星  ") "来一个金色的星星")
                  (not (string-contains? cleaned "("))
                  (not (string-contains? cleaned ")")))
           1 0))
(newline)
(display "audio ")
(display (if (and (wish-has-audio? (hash "audio" "nope"))
                  (not (wish-has-audio? (hash "text" "hi"))))
           1 0))
(newline)
(display "line ")
(display (if (and (string=? line "这一句有点不合适，换个明媚的说法")
                  (not (string-contains? line "炸弹"))
                  (not (string-contains? prompt "key"))
                  (not (string-contains? prompt "(define")))
           1 0))
(newline)
(display "preset-miss ")
(display (if (not (wish-preset "hello there")) 1 0))
(newline)
(display "fair-star ")
(display (bit (preset-fair? "来一个金色的星星" rules)))
(newline)
(display "fair-gate ")
(display (bit (preset-fair? "A flower gate to slide under" rules)))
(newline)
(display "fair-sky ")
(display (bit (and sky (hash-ref (check-scene (hash-ref sky "form")) "ok" #f))))
(newline)
(display "fair-bunny ")
(display (bit (and bun (hash-ref (check-pals (hash-ref bun "form")) "ok" #f))))
(newline)
(display "rows ")
(display (if (and star gate (string=? (hash-ref star "arm") "motif")
              (string=? (hash-ref gate "arm") "motif"))
           1 0))
(newline)

(define hello (wish-answer "hello there" 0.0 0.0 0.0))
(define hello2 (wish-answer "hello there" 0.0 0.0 0.0))
(define hello-scene (check-scene (hash-ref hello "form")))
(define shifted (wish-answer "hello there"
                             (hash-ref hello-scene "sky-r")
                             (hash-ref hello-scene "sky-g")
                             (hash-ref hello-scene "sky-b")))
(define blue (wish-answer "蓝色的海" 0.55 0.72 0.95))
(define blue-scene (check-scene (hash-ref blue "form")))
(define rose (wish-answer "粉色的云" 0.0 0.0 0.0))
(define kitten (wish-answer "来一只小猫" 0.0 0.0 0.0))
(define spoken-star (wish-answer "我想要星星" 0.0 0.0 0.0))
(define zh (wish-with-lang blue "zh"))
(define week (wish-answer "星期一见" 0.0 0.0 0.0))

(display "look ")
(display (bit (and hello
                  (string=? (hash-ref hello "arm") "scene")
                  (hash-ref hello-scene "ok" #f)
                  (string=? (hash-ref hello "form") (hash-ref hello2 "form"))
                  (not (string=? (hash-ref hello "form") (hash-ref shifted "form")))
                  (hash-ref (check-scene (hash-ref shifted "form")) "ok" #f))))
(newline)
(display "look-blue ")
(display (bit (and (string=? (hash-ref blue "arm") "scene")
                  (hash-ref blue-scene "ok" #f)
                  (> (hash-ref blue-scene "sky-b") 0.9)
                  (string=? (hash-ref rose "say") "The sky turned rosy")
                  (not (string=? (hash-ref blue "form") (hash-ref rose "form"))))))
(newline)
(display "look-friend ")
(display (bit (and (string=? (hash-ref kitten "arm") "pals")
                  (hash-ref (check-pals (hash-ref kitten "form")) "ok" #f)
                  (string=? (hash-ref spoken-star "arm") "motif")
                  (string-contains? (hash-ref spoken-star "form") "star")
                  (string=? (hash-ref week "arm") "scene"))))
(newline)
(display "look-zh ")
(display (bit (and (string=? (hash-ref zh "say") "天空变成蓝色")
                  (string=? (hash-ref zh "form") (hash-ref blue "form"))
                  (not (string-contains? (hash-ref zh "form") "蓝色")))))
(newline)

(void)
