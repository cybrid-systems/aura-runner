; Offline critic. A hard note turns ok to 0. A soft note does not, so
; the prompt example stays fair. The race ranks a calm opening above a
; stacked phrase, and a child fiber cannot change the parent mark.
(require "std/string" all:)
(require "lib/review")
(require "lib/gen")

(define rules8 (rules-of 32.0 11.2 8.0 0.48 0.12 0.12))
(define rules5 (rules-of 32.0 11.2 5.0 0.48 0.12 0.12))

(define open-text (string-append "(seq" (specs-src (car patterns-0)) ")"))
(define gap-text "(seq (ground 4.0) (gap 5.5) (ground 4.0))")
(define stacked-text "(seq (ground 10.4) (hurdle 0.4 0.7) (ground 2.4) (hurdle 0.4 0.7) (ground 10.4))")
(define blocked-text "(seq (ground 10.4) (block 1 1) (coin-lane 1 0.7) (ground 10.4))")
(define toy-text "(seq (ground 10.4) (gate 0.8 0.8) (flyer plane 1 0.7) (ground 10.4))")
(define soft-text "(seq (ground 4.8) (hurdle 0.4 0.7) (ground 10.4))")
(define lonely-text "(seq (ground 10.4) (coin 1.2) (ground 10.4))")

(define (show-review name rules text)
  (let ((r (review-text text rules)))
    (display name)
    (display " ")
    (display (if (hash-ref r "ok") 1 0))
    (newline)
    (display name)
    (display "-hint ")
    (let ((h (hash-ref r "hint" "")))
      (if (and (string? h) (> (string-length h) 0))
        (display h)
        (display "clear")))
    (newline)))

(define (example-from src)
  (let ((mark "Example: "))
    (let ((i (string-find src mark)))
      (if (< i 0)
        ""
        (let ((rest (substring src (+ i (string-length mark)) (string-length src))))
          (let ((j (string-find rest "\"")))
            (if (< j 0)
              ""
              (substring rest 0 j))))))))

(show-review "open" rules8 open-text)
(show-review "gap" rules5 gap-text)
(show-review "stacked" rules8 stacked-text)
(show-review "blocked" rules8 blocked-text)
(show-review "toy" rules8 toy-text)
(show-review "soft" rules8 soft-text)
(show-review "lonely" rules8 lonely-text)

(let ((ex (example-from (read-file "core/main.aura"))))
  (let ((r (check-source ex rules5)))
    (display "example ")
    (display (if (hash-ref r "ok") 1 0))
    (display " ")
    (display (hash-ref r "why"))
    (newline)))

(define raced (review-race (list open-text stacked-text) rules8))
(let loop ((xs (hash-ref raced "rows" (list))))
  (if (null? xs)
    #f
    (begin
      (display "race-row ")
      (display (car (car xs)))
      (display " ")
      (display (if (hash-ref (car (cdr (car xs))) "ok") 1 0))
      (newline)
      (loop (cdr xs)))))
(display "race ")
(display (hash-ref raced "winner" -1))
(newline)
(display "mark ")
(display (hash-ref raced "mark" 0))
(newline)
(display "fibers ")
(display (hash-ref raced "fibers" 0))
(newline)

(let ((played (review-play open-text rules8)))
  (display "play ")
  (display (if (hash-ref played "ok") 1 0))
  (newline))
