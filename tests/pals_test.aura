; Companion phrases. A bright kitten, a car, a known bird and a made-up
; puppy are kept. A dark colour, a bad motion, a short name, a banned
; word, a duplicate and a crowd of five are not. Merging adds the bird,
; updates the car, and makes room when the path already has six friends.
(require "lib/pals")

(define (report name text)
  (let ((r (check-pals text)))
    (display name)
    (display " ")
    (display (if (hash-ref r "ok") 1 0))
    (display " ")
    (display (hash-ref r "why"))
    (if (hash-ref r "ok")
      (begin (display " ") (display (hash-ref r "cue")))
      #f)
    (newline)))

(report "default" default-pals)
(report "car" "(pal car beep 0.3 0.55 0.95 pace)")
(report "bird" "(pal bird lark 0.95 0.86 0.35 float)")
(report "puppy" "(pal puppy pip 0.6 0.8 0.4 hop)")
(report "dark" "(pal kitten mochi 0.05 0.05 0.05 hop)")
(report "motion" "(pal car beep 0.3 0.55 0.95 fly)")
(report "digit" "(pal car2 beep 0.3 0.55 0.95 pace)")
(report "short" "(pal bird a 0.9 0.8 0.4 float)")
(report "banned" "(pal kitten kill 0.9 0.6 0.4 hop)")
(report "dup" "(pals (pal bird lark 0.9 0.8 0.4 float) (pal frog lark 0.4 0.7 0.4 hop))")
(report "empty" "")
(report "shape" "hello")
(report "count" "(pals (pal bird aa 0.9 0.8 0.4 float) (pal bird bb 0.9 0.8 0.4 float) (pal bird cc 0.9 0.8 0.4 float) (pal bird dd 0.9 0.8 0.4 float) (pal bird ee 0.9 0.8 0.4 float))")
(report "example" "(pal bird lark 0.95 0.86 0.35 float)")

(define base (hash-ref (check-pals default-pals) "pals"))
(define (one text) (hash-ref (check-pals text) "pals"))

(define step1 (merge-pals base (one "(pal bird lark 0.95 0.86 0.35 float)")))
(display "merge ")
(display (if (string=? (hash-ref step1 "cue") "A bird flew along") 1 0))
(newline)

(define upd (merge-pals base (one "(pal car beep 0.4 0.6 0.9 pace)")))
(display "update ")
(display (if (and (string=? (hash-ref upd "cue") "A friend looks different")
                  (= (length (hash-ref upd "rows")) 2))
           1 0))
(newline)

(define puppy (check-pals "(pal puppy pip 0.6 0.8 0.4 hop)"))
(display "plan ")
(display (hash-ref (car (hash-ref puppy "pals")) "plan"))
(newline)

(define emitted (pals-text base))
(define again (check-pals emitted))
(display "round ")
(display (if (and (hash-ref again "ok")
                  (string=? (hash-ref (car (hash-ref again "pals")) "name") "mochi")
                  (string=? (hash-ref (car (cdr (hash-ref again "pals"))) "kind") "car"))
           1 0))
(newline)

(define (add rows text)
  (merge-pals rows (one text)))

(define s1 (add base "(pal bird lark 0.95 0.86 0.35 float)"))
(define s2 (add (hash-ref s1 "rows") "(pal frog hopp 0.4 0.75 0.35 hop)"))
(define s3 (add (hash-ref s2 "rows") "(pal duck wadd 0.95 0.85 0.4 pace)"))
(define s4 (add (hash-ref s3 "rows") "(pal bunny bun 0.95 0.7 0.75 hop)"))
(define s5 (add (hash-ref s4 "rows") "(pal butterfly flip 0.7 0.45 0.9 float)"))
(define final-names (pal-names (hash-ref s5 "rows")))
(display "cap ")
(display (if (and (= (length (hash-ref s5 "rows")) 6)
                  (string-contains? final-names "mochi")
                  (string-contains? final-names "beep")
                  (string-contains? final-names "flip")
                  (not (string-contains? final-names "lark")))
           1 0))
(newline)
(display "roster ")
(display final-names)
(newline)

(report "hero" "(hero bird 0.95 0.86 0.35)")
(report "hero-dark" "(hero kitten 0.05 0.05 0.05)")
(report "hero-word" "(hero hero 0.9 0.8 0.5)")
(report "keeper-pal" "(pal keeper mochi 0.9 0.7 0.4 hop)")
(report "keeper" "(hero keeper 0.9 0.8 0.6)")
(report "two-hero" "(pals (hero bird 0.9 0.8 0.4) (hero kitten 0.9 0.7 0.4))")
(report "hero-crowd" "(pals (pal bird aa 0.9 0.8 0.4 float) (pal bird bb 0.9 0.8 0.4 float) (pal bird cc 0.9 0.8 0.4 float) (pal bird dd 0.9 0.8 0.4 float) (hero duck 0.95 0.85 0.4))")

(define hero-only (check-pals "(hero bird 0.95 0.86 0.35)"))
(display "hero-rows ")
(display (if (and (hash-ref hero-only "ok")
                  (null? (hash-ref hero-only "pals"))
                  (string=? (hash-ref (hash-ref hero-only "hero") "kind") "bird")
                  (string=? (hash-ref (hash-ref hero-only "hero") "plan") "bird"))
           1 0))
(newline)

(define mixed (check-pals "(pals (pal bird lark 0.95 0.86 0.35 float) (hero kitten 0.95 0.62 0.4))"))
(display "mixed ")
(display (if (and (hash-ref mixed "ok")
                  (= (length (hash-ref mixed "pals")) 1)
                  (string=? (hash-ref (hash-ref mixed "hero") "plan") "kitten")
                  (string=? (hash-ref (car (hash-ref mixed "pals")) "name") "lark"))
           1 0))
(newline)

(define wrapped (roster-text base (hash-ref hero-only "hero")))
(define back (check-pals wrapped))
(display "hero-round ")
(display (if (and (hash-ref back "ok")
                  (string=? (hash-ref (hash-ref back "hero") "kind") "bird")
                  (string=? (hash-ref (car (hash-ref back "pals")) "name") "mochi")
                  (string-contains? wrapped "hero bird"))
           1 0))
(newline)

(display "no-hero ")
(display (if (and (not (string-contains? (pals-text base) "hero"))
                  (not (hash-ref (check-pals default-pals) "hero"))
                  (not (hash-ref (check-pals "(pal bird lark 0.95 0.86 0.35 float)") "hero")))
           1 0))
(newline)

(define keeper-hero (hash-ref (check-pals "(hero keeper 0.9 0.8 0.6)") "hero"))
(display "keeper-omit ")
(display (if (string=? (roster-text base keeper-hero) (pals-text base)) 1 0))
(newline)

(define pup (check-pals "(hero puppy 0.7 0.8 0.45)"))
(display "hero-plan ")
(display (hash-ref (hash-ref pup "hero") "plan"))
(newline)

(define crowd5 "(pals (pal bird aa 0.9 0.8 0.4 float) (pal bird bb 0.9 0.8 0.4 float) (pal bird cc 0.9 0.8 0.4 float) (pal bird dd 0.9 0.8 0.4 float) (pal bird ee 0.9 0.8 0.4 float))")
(display "roster5 ")
(display (if (and (not (hash-ref (check-pals crowd5) "ok"))
                  (hash-ref (check-roster crowd5) "ok"))
           1 0))
(newline)

(define dressed (dress-form "(pal bird lark 0.95 0.86 0.35 float)" "keeper"))
(define dressed-ok (check-pals dressed))
(display "dress ")
(display (if (and (hash-ref dressed-ok "ok")
                  (string=? (hash-ref (hash-ref dressed-ok "hero") "plan") "kitten")
                  (string=? (hash-ref (car (hash-ref dressed-ok "pals")) "name") "lark"))
           1 0))
(newline)

(define kept-look (dress-form "(hero bird 0.95 0.86 0.35)" "keeper"))
(display "dress-keep ")
(display (if (string=? kept-look "(hero bird 0.95 0.86 0.35)") 1 0))
(newline)

(define advanced (dress-form "(hero kitten 0.95 0.62 0.45)" "kitten"))
(define advanced-ok (check-pals advanced))
(display "dress-next ")
(display (if (and (hash-ref advanced-ok "ok")
                  (string=? (hash-ref (hash-ref advanced-ok "hero") "plan") "car"))
           1 0))
(newline)

(define model-look "(pals (pal bird lark 0.95 0.86 0.35 float) (hero duck 0.98 0.78 0.28))")
(display "dress-model ")
(display (if (and (string=? (dress-form model-look "keeper") model-look)
                  (string=? (hash-ref (hash-ref (check-pals model-look) "hero") "kind") "duck"))
           1 0))
(newline)

(define joined (join-hero "(pal bird lark 0.95 0.86 0.35 float)" "(hero duck 0.98 0.78 0.28)"))
(define joined-ok (check-pals joined))
(display "join-hero ")
(display (if (and (hash-ref joined-ok "ok")
                  (string=? (hash-ref (hash-ref joined-ok "hero") "kind") "duck")
                  (string=? (hash-ref (car (hash-ref joined-ok "pals")) "name") "lark"))
           1 0))
(newline)
