; Charter, worldline fork, kept-world archive, tune shortlist,
; the evolution-record queue, and the out/ write fence.
; The tune numbers are the music list only. A spoken biome wish still
; waits on llm:chat. 11.7s is not a budget for this path.
(require "std/string" all:)
(require "std/evo-core" all:)
(require "lib/charter")
(require "lib/fork")
(require "lib/fence")
(require "lib/recordq")
(require "lib/coins")
(require "lib/archive")
(require "lib/tune-pick")

(define (expect name ok)
  (display name)
  (display " ")
  (display (if ok 1 0))
  (newline)
  (if ok #t (error (string-append "advance: " name))))

(define phys-before (read-file "lib/phys.aura"))

(expect "fence-ok" (fence-ok? "out/boot.txt"))
(expect "fence-deny-path" (not (fence-ok? "secret.txt")))
(expect "fence-boot" (fence-write "out/fence-probe.txt" "ok"))
(expect "fence-secret" (not (fence-write "secret.txt" "no")))
(define secret (try (read-file "secret.txt") (catch (e) #f)))
(expect "no-secret" (not (equal? secret "no")))

(expect "block-step" (charter-blocked? "step" "mutate:rebind"))
(expect "allow-gravity" (not (charter-blocked? "rule-gravity" "mutate:rebind")))
(expect "why-collide" (string=? (charter-why "collide") "不能改碰撞"))
(expect "why-step" (string=? (charter-why "step") "不能改步子"))
(expect "cue" (string=? (charter-cue) "被宪法拒绝"))
(expect "hit-step" (charter-hit? "(define (step p) p)"))
(expect "hot-open" (not (charter-hit? (read-file "core/hot.aura"))))
(expect "phys-same" (string=? phys-before (read-file "lib/phys.aura")))

(define chosen (fork-choose (list (hash "score" 1.0 "id" "a")
                                  (hash "score" 2.0 "id" "c")
                                  (hash "score" 2.0 "id" "d"))))
(expect "choose-high" (string=? (hash-ref chosen "id" "") "c"))
(define tied (fork-choose (list (hash "score" 2.0 "id" "a")
                                (hash "score" 2.0 "id" "b"))))
(expect "choose-tie" (string=? (hash-ref tied "id" "") "a"))

(set-code (read-file "core/hot.aura"))
(eval-current)
(define seen
  (fork-wrap
    (lambda ()
      (let ((spec (fork-spec "COIN" (lambda (s) s))))
        ((hash-ref spec "apply") #f)
        ((hash-ref spec "evaluate") #f)))))
(expect "fork-token" (string=? seen "COIN"))
(expect "fork-restored" (string=? (fork-offer) ""))

(charter-boot!)
(define step-how (try (mutate :rebind "step" "(lambda (p) p)" "tune") (catch (e) "refused")))
(expect "step-stays" (not (equal? step-how #t)))
(define grav-how (try (mutate :rebind "rule-gravity" "(lambda () 32.0)" "tune") (catch (e) #f)))
(expect "grav-open" (equal? grav-how #t))
(eval-current)
(define grav-now (rule-gravity))
(expect "grav-value" (and (number? grav-now) (< grav-now 32.02) (> grav-now 31.98)))
(expect "phys-still" (string=? phys-before (read-file "lib/phys.aura")))

(define blank (coin-blank))
(define forks (coin-forks blank "keen" 0))
(expect "coin-forks" (and (pair? forks) (<= (length forks) 3) (hash? (car forks))))
(expect "coin-untouched" (coin-same-params? blank (coin-blank)))

(define arch (archive-blank))
(define garden (edsl-preset "garden"))
(define city (edsl-preset "city"))
(expect "keep-garden" (archive-keep! arch garden 0))
(expect "not-ready" (not (archive-ready? arch)))
(expect "keep-city" (archive-keep! arch city 1))
(expect "ready" (archive-ready? arch))
(define child (archive-child arch))
(expect "child"
        (and (string? child)
             (not (string=? child garden))
             (not (string=? child city))
             (hash-ref (edsl-check child) "ok" #f)))
(define live garden)
(define bad-gate (edsl-gate "(biome nope)"))
(expect "bad-rollback" (string=? (hash-ref bad-gate "verdict" "") "ROLLBACK"))
(if (string=? (hash-ref bad-gate "verdict" "") "KEEP")
  (set! live (hash-ref bad-gate "form" live))
  #f)
(expect "live-stays" (string=? live garden))

(define harsh
  "(tune garden-day (key C major) (tempo 200) (chords I V vi IV) (motif 0 2 4 7 4 2 0 4) (tone triangle 880 0.02 0.22) (pad sine 620 0.04 0.30) (kick 1 0 0 0 1 0 0 0) (snare 0 0 1 0 0 0 1 0) (hat 1 0 1 0 1 0 1 0) (swing 0.06) (layers 2) (gain 0.12))")
(define forms (list music-home harsh (music-evolve music-home 3)))
(define screen (tune-screen forms 8.0))
(display "music-candidates ")
(display (hash-ref screen "candidates" 0))
(newline)
(display "music-trials ")
(display (hash-ref screen "trials" 0))
(newline)
(expect "music-candidates" (= (hash-ref screen "candidates" 0) 3))
(expect "music-trials" (= (hash-ref screen "trials" 0) 1))
(expect "harsh-lost" (not (string-contains? (hash-ref screen "form" "") "(tempo 200)")))
(define front (tune-front (list (tune-row music-home 8.0) (tune-row harsh 8.0))))
(expect "harsh-off-front"
        (and (= (length front) 1)
             (> (hash-ref (car front) "pleasure" 0.0) 0.5)))
(expect "evolve-id" (string=? (music-id-of (music-evolve music-home 0)) "evo-0"))

(record-hold! #t)
(record-note! "spread" "KEEP" "fair" 0.1)
(expect "queued" (= (record-count) 1))
(expect "held" (not (record-flush!)))
(expect "still-queued" (= (record-count) 1))
(record-hold! #f)
(record-flush!)
(expect "flushed" (= (record-count) 0))
