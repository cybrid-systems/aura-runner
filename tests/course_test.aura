; Band 0 and 1 have to put a slide gate on the road, including in the
; opening stretch, and a failed pattern must still advance with an obstacle.
(require "lib/gen")
(require "std/string" all:)

(define rules (rules-of 32.0 11.2 5.0 0.48 0.12 0.12))
(define rules1 (rules-of 31.4 11.4 5.8 0.50 0.12 0.12))

(define (show k v)
  (display k)
  (display " ")
  (display v)
  (newline))

(define (count-kind ps k)
  (let loop ((xs ps) (n 0))
    (if (null? xs)
      n
      (loop (cdr xs) (if (= (piece-k (car xs)) k) (+ n 1) n)))))

(define (action? k)
  (or (= k 2.0) (= k 3.0) (= k 4.0) (= k 7.0)))

(define (action-xs ps origin acc)
  (let loop ((ys ps) (out acc))
    (if (null? ys)
      out
      (let ((q (car ys)))
        (loop (cdr ys)
              (if (action? (piece-k q))
                (cons (+ origin (piece-x q)) out)
                out))))))

(define (max-delta xs)
  (if (or (null? xs) (null? (cdr xs)))
    0.0
    (let loop ((ys (cdr xs)) (prev (car xs)) (m 0.0))
      (if (null? ys)
        m
        (let ((d (- (car ys) prev)))
          (loop (cdr ys) (car ys) (if (> d m) d m)))))))

(define (ordered-actions seed band n)
  (let loop ((i 0) (origin 0.0) (acc (list)))
    (if (>= i n)
      (reverse acc)
      (let ((ch (pattern-chunk seed i band)))
        (if (not ch)
          (list)
          (loop (+ i 1)
                (+ origin (hash-ref ch "x1"))
                (action-xs (hash-ref ch "pieces") origin acc)))))))

(define (gap-ok? seed band)
  (let ((xs (ordered-actions seed band 6)))
    (if (not (pair? xs))
      #f
      (if (not (pair? (cdr xs)))
        #f
        (let ((d (max-delta xs)))
          (and (> d 0.0) (<= d 30.0)))))))

(define (stretch-gates seed metres)
  (let loop ((i 0) (x 0.0) (gates 0))
    (if (or (>= i 8) (>= x metres))
      gates
      (let ((ch (pattern-chunk seed i 0)))
        (if (not ch)
          -1
          (loop (+ i 1)
                (+ x (hash-ref ch "x1"))
                (+ gates (count-kind (hash-ref ch "pieces") 4.0))))))))

(define (first-gate-x seed)
  (let ((ch (pattern-chunk seed 0 0)))
    (if (not ch)
      999.0
      (let loop ((ps (hash-ref ch "pieces")))
        (if (null? ps)
          999.0
          (if (= (piece-k (car ps)) 4.0)
            (piece-x (car ps))
            (loop (cdr ps))))))))

(define (example-from src)
  (let ((mark "Example: "))
    (let ((i (string-find src mark)))
      (if (< i 0)
        ""
        (let ((rest (substring src (+ i (string-length mark)) (string-length src))))
          (let ((j (string-find rest "\"")))
            (if (< j 0) "" (substring rest 0 j))))))))

(show "gates0" (patterns-with-gate 0))
(show "gates1" (patterns-with-gate 1))
(show "early" (if (and (> (stretch-gates 1 150.0) 0)
                       (> (stretch-gates 42 150.0) 0)
                       (> (stretch-gates 99 150.0) 0))
                1 0))
(show "soon" (if (and (< (first-gate-x 1) 16.0)
                      (< (first-gate-x 42) 16.0)
                      (< (first-gate-x 99) 16.0))
               1 0))
(show "spacing" (if (and (gap-ok? 1 0) (gap-ok? 42 0) (gap-ok? 7 1) (gap-ok? 42 1))
                  1 0))

(define fb (chunk-or-fallback #f))
(define fb-ps (if fb (hash-ref fb "pieces") (list)))
(show "fallback" (if (and fb
                          (> (hash-ref fb "x1" 0.0) 0.0)
                          (> (+ (count-kind fb-ps 3.0) (count-kind fb-ps 4.0)) 0))
                   1 0))

(define example (example-from (read-file "core/main.aura")))
(define ex (check-source example rules))
(show "example" (if (and (string-contains? example "(gate ")
                         ex
                         (hash-ref ex "ok"))
                  1 0))

(define b1 (offline-chunk 42 0 1 rules1))
(show "band1" (if b1 1 0))

(define (chunk-flyers seed index band)
  (let ((ch (pattern-chunk seed index band)))
    (if (not ch) -1 (count-kind (hash-ref ch "pieces") 8.0))))

(show "toys" (if (and (= (chunk-flyers 1 0 0) 1)
                      (= (chunk-flyers 42 1 0) 1)
                      (= (chunk-flyers 99 2 0) 1)
                      (= (chunk-flyers 3 0 1) 1)
                      (= (chunk-flyers 5 0 2) 1)
                      (= (chunk-flyers 7 0 3) 1)
                      (= (chunk-flyers 9 0 4) 1))
               1 0))

; Every built hurdle, gate and block carries a look other than the plain one.
(define (pieces-styled? ps)
  (let loop ((xs ps))
    (if (null? xs)
      #t
      (let ((q (car xs))
            (k (piece-k (car xs))))
        (if (and (or (= k 3.0) (= k 4.0) (= k 7.0))
                 (<= (piece-nth q 6 0.0) 0.0))
          #f
          (loop (cdr xs)))))))

(define (table-styled? band)
  (let loop ((rows (pattern-table band)))
    (if (null? rows)
      #t
      (let ((laid (layout-specs (car rows) 0.0)))
        (if (and laid (pieces-styled? (car laid)))
          (loop (cdr rows))
          #f)))))

(show "looks" (if (and (table-styled? 0) (table-styled? 1) (table-styled? 2)
                       (table-styled? 3) (table-styled? 4))
                1 0))

(define (worth-show k y near base pressure expect)
  (show k (if (= (coin-risk-worth y near base pressure) expect) 1 0)))

(worth-show "worth-ground" 0.55 #f 25.0 1 25.0)
(worth-show "worth-high" 1.2 #f 25.0 1 40.0)
(worth-show "worth-near" 0.55 #t 25.0 1 34.0)
(worth-show "worth-both" 1.2 #t 25.0 1 50.0)
(worth-show "worth-easy" 0.55 #f 25.0 0 21.0)
(worth-show "worth-hot" 1.2 #t 25.0 4 58.0)

(define (mover-sig ps)
  (let loop ((xs ps) (n 0) (acc 0.0))
    (if (null? xs)
      (list n (floor (+ (* acc 1000.0) 0.5)))
      (let ((q (car xs)))
        (if (or (= (piece-k q) 2.0) (= (piece-k q) 3.0) (= (piece-k q) 4.0) (= (piece-k q) 7.0))
          (loop (cdr xs) (+ n 1) (+ acc (piece-x q) (piece-w q)))
          (loop (cdr xs) n acc))))))

(define (coin-worths ps)
  (let loop ((xs ps) (lo 999.0) (hi 0.0) (n 0))
    (if (null? xs)
      (list n lo hi)
      (let ((q (car xs)))
        (if (= (piece-k q) 5.0)
          (let ((w (piece-nth q 6 0.0)))
            (loop (cdr xs) (if (< w lo) w lo) (if (> w hi) w hi) (+ n 1)))
          (loop (cdr xs) lo hi n))))))

(define (min-gap ps)
  (let loop ((xs ps) (prev #f) (m 99.0))
    (if (null? xs)
      m
      (let ((q (car xs)))
        (if (= (piece-k q) 5.0)
          (let ((x (piece-x q)))
            (loop (cdr xs) x (if prev (let ((d (abs-diff x prev))) (if (and (> d 0.2) (< d m)) d m)) m)))
          (loop (cdr xs) prev m))))))

(define wave-laid (layout-form "(seq (ground 10.4) (coin 0.7) (ground 12))" (feel-rules 0)))
(define wave-ps (hash-ref wave-laid "pieces"))
(define wave-x (hash-ref wave-laid "x1"))
(define wave-1 (string-pickups wave-ps 0 wave-x 1 25.0))
(define wave-0 (string-pickups wave-ps 0 wave-x 0 25.0))
(define wave-4 (string-pickups wave-ps 0 wave-x 4 25.0))
(define wave-row (coin-worths wave-1))
(show "wave-worth" (if (and (>= (car wave-row) 2) (= (car (cdr wave-row)) 25.0) (= (car (cdr (cdr wave-row))) 25.0)) 1 0))
(show "spread" (if (and (> (min-gap wave-0) (min-gap wave-1)) (> (min-gap wave-1) (min-gap wave-4))) 1 0))

(define arc-laid (layout-form "(seq (ground 8) (coin 0.7) (ground 3.2) (hurdle 0.45 0.7) (ground 8))" (feel-rules 0)))
(define arc-ps (hash-ref arc-laid "pieces"))
(define arc-x (hash-ref arc-laid "x1"))
(define arc-4 (string-pickups arc-ps 0 arc-x 4 25.0))
(define arc-row (coin-worths arc-4))
(show "arc-worth" (if (and (>= (car arc-row) 2) (> (car (cdr (cdr arc-row))) 25.0)) 1 0))
(show "arc-still" (if (equal? (mover-sig arc-ps) (mover-sig arc-4)) 1 0))
(show "wave-still" (if (equal? (mover-sig wave-ps) (mover-sig wave-4)) 1 0))

(define pop-early (popper-for 1 0.0 80.0 4))
(define pop-plain (popper-for 1 0.0 80.0 1))
(define pop-late (popper-for 1 0.0 80.0 0))
(show "pop-easy" (if (and (not (popper-for 4 0.0 40.0 0)) (not (popper-for 1 0.0 14.0 0))) 1 0))
(show "pop-extra" (if (and (not (popper-for 5 0.0 40.0)) (popper-for 5 0.0 40.0 4)) 1 0))
(show "pop-early" (if (and pop-early pop-plain pop-late
                           (< (piece-x pop-early) (piece-x pop-plain))
                           (> (piece-x pop-late) (piece-x pop-plain))
                           (>= (piece-x pop-early) 6.0)
                           (>= (piece-lane pop-early) 0.0)
                           (< (piece-lane pop-early) 3.0))
                    1 0))

; A mild hill is a phrase the autopilot can clear. A grade outside the
; cap is refused before it is laid. A phrase that forgets the way down
; is closed. Flat ground stays the short piece, and an uphill run is slower.
(define feel0 (feel-rules 0))
(define mild "(seq (ground 10.4) (slope 0.12 8) (ground 4.8) (slope -0.12 8) (ground 10.4))")
(define steep "(seq (ground 6) (slope 0.4 8) (ground 6))")
(define hill (check-source mild feel0))
(define cliff (check-source steep feel0))
(show "hill" (if (and hill (hash-ref hill "ok")) 1 0))
(show "steep" (if (and cliff (not (hash-ref cliff "ok")) (string=? (hash-ref cliff "why") "range")) 1 0))

(define one (layout-form "(seq (ground 6))" feel0))
(define g0 (car (hash-ref one "pieces")))
(show "flat-piece" (if (and one (= (length g0) 6) (= (piece-y g0) 0.0)) 1 0))

(define opened (layout-form "(seq (ground 4) (slope 0.1 8) (ground 4))" feel0))
(define endh (road-height (- (hash-ref opened "x1") 0.05) (hash-ref opened "pieces")))
(show "closed" (if (and opened (< (if (< endh 0.0) (- 0.0 endh) endh) 0.02)) 1 0))

(define (roll n pieces rules)
  (let loop ((i 0) (p (make-player 0.4)))
    (if (>= i n)
      p
      (loop (+ i 1) (car (step p pieces rules PHYS-DT))))))

(define flat-road (list (piece 1.0 0.0 40.0 0.45 0.0)))
(define up-road (list (piece 1.0 0.0 40.0 0.45 0.0 -1.0 4.8)))
(define flat-p (roll 120 flat-road feel0))
(define up-p (roll 120 up-road feel0))
(show "climb" (if (and (> (road-height 20.0 up-road) 1.0)
                       (= (road-height 20.0 flat-road) 0.0)
                       (< (player-x up-p) (- (player-x flat-p) 0.5))
                       (> (player-y up-p) 1.0))
                1 0))
