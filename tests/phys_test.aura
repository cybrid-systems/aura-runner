(require "lib/phys")
(require "std/math" all:)

(define rules (rules-of 32.0 11.2 5.0 0.48 0.12 0.12))

(define (mm x)
  (let ((v (* x 1000.0)))
    (if (>= v 0.0)
      (floor (+ v 0.5))
      (- 0.0 (floor (+ (- 0.0 v) 0.5))))))

(define (show-player tag p)
  (display tag)
  (display " ")
  (display (mm (player-x p)))
  (display " ")
  (display (mm (player-y p)))
  (display " ")
  (display (mm (player-vy p)))
  (display " ")
  (display (if (player-alive? p) 1 0))
  (newline))

(display "apex ")
(display (mm (+ (* 0.5 11.2 (/ 1.0 20.0)) (/ (* 11.2 11.2) (* 2.0 32.0)))))
(newline)
(display "air ")
(display (mm (* 5.0 (+ (/ 1.0 20.0) (/ (* 2.0 11.2) 32.0)))))
(newline)

; Jump on open ground. No gaps, so the runner stays alive.
(define open (list (piece 1.0 0.0 80.0 0.45 0.0)))
(define jumper (press-jump (make-player 1.0)))
(define ti 0)
(let loop ()
  (if (>= ti 70)
    #t
    (begin
      (if (or (= ti 0) (= ti 10) (= ti 22) (= ti 40) (= ti 55))
        (show-player (number->string ti) jumper)
        #f)
      (let ((r (step jumper open rules PHYS-DT)))
        (set! jumper (car r)))
      (set! ti (+ ti 1))
      (loop))))
(display "alive ")
(display (if (and (player-alive? jumper) (<= (player-y jumper) 0.001)) 1 0))
(newline)

; Short gap is clearable when the jump is pressed as the lip approaches.
(define gap-run
  (list (piece 1.0 0.0 8.0 0.45 0.0)
        (piece 2.0 8.0 1.2 1.2 -1.2)
        (piece 1.0 9.2 12.0 0.45 0.0)))
(define gp (make-player 1.0))
(define gpieces gap-run)
(define crossed 0)
(let loop ((i 0))
  (if (or (>= i 400) (not (player-alive? gp)))
    #t
    (begin
      (if (and (>= (- 8.0 (player-x gp)) 0.2)
               (<= (- 8.0 (player-x gp)) 0.7))
        (set! gp (press-jump gp))
        #f)
      (let ((r (step gp gpieces rules PHYS-DT)))
        (set! gp (car r))
        (set! gpieces (car (cdr r))))
      (if (and (player-alive? gp) (> (player-x gp) 10.5))
        (set! crossed 1)
        #f)
      (loop (+ i 1)))))
(display "gap-clear ")
(display crossed)
(display " ")
(display (if (player-alive? gp) 1 0))
(newline)

; A gap wider than the jump used to end the run. The runner is lifted
; past it and stays in the race.
(define wide
  (list (piece 1.0 0.0 6.0 0.45 0.0)
        (piece 2.0 6.0 6.0 1.2 -1.2)))
(define wp (make-player 1.0))
(define wpieces wide)
(let loop ((i 0))
  (if (or (>= i 400) (not (player-alive? wp)))
    #t
    (begin
      (if (and (>= (- 6.0 (player-x wp)) 0.15)
               (<= (- 6.0 (player-x wp)) 0.8))
        (set! wp (press-jump wp))
        #f)
      (let ((r (step wp wpieces rules PHYS-DT)))
        (set! wp (car r))
        (set! wpieces (car (cdr r))))
      (loop (+ i 1)))))
(display "wide-alive ")
(display (if (player-alive? wp) 1 0))
(newline)

; Slide under a gate. Standing into it stumbles and continues.
(define gated
  (list (piece 1.0 0.0 30.0 0.45 0.0)
        (piece 4.0 8.0 0.7 0.34 0.66)))
(define sp (make-player 1.0))
(define spieces gated)
(let loop ((i 0))
  (if (or (>= i 300) (not (player-alive? sp)) (> (player-x sp) 10.0))
    #t
    (begin
      (if (and (>= (- 8.0 (player-x sp)) 0.3)
               (<= (- 8.0 (player-x sp)) 1.0))
        (set! sp (press-slide sp))
        #f)
      (let ((r (step sp spieces rules PHYS-DT)))
        (set! sp (car r))
        (set! spieces (car (cdr r))))
      (loop (+ i 1)))))
(display "slide-alive ")
(display (if (and (player-alive? sp) (> (player-x sp) 9.2)) 1 0))
(newline)

(define stand (make-player 1.0))
(define stand-pieces gated)
(let loop ((i 0))
  (if (or (>= i 300) (not (player-alive? stand)))
    #t
    (let ((r (step stand stand-pieces rules PHYS-DT)))
      (set! stand (car r))
      (set! stand-pieces (car (cdr r)))
      (loop (+ i 1)))))
(display "stand-alive ")
(display (if (player-alive? stand) 1 0))
(newline)

; Coin adds 25 and is spent once.
(define coined
  (list (piece 1.0 0.0 20.0 0.45 0.0)
        (piece 5.0 3.0 0.42 0.42 0.4)))
(define cp (make-player 1.0))
(define cpieces coined)
(let loop ((i 0))
  (if (>= i 80) #t
    (let ((r (step cp cpieces rules PHYS-DT)))
      (set! cp (car r))
      (set! cpieces (car (cdr r)))
      (loop (+ i 1)))))
(display "coins ")
(display (player-score cp))
(newline)

; A hurdle bumps. The runner stays alive, keeps the distance, loses one
; coin's worth of points, and is briefly invulnerable.
(define hurdled
  (list (piece 1.0 0.0 30.0 0.45 0.0)
        (piece 5.0 2.2 0.42 0.42 0.4)
        (piece 3.0 4.2 0.7 0.55 0.0)))
(define hp (make-player 1.0))
(define hpieces hurdled)
(define bump-grace 0.0)
(define saw-bump 0)
(let loop ((i 0))
  (if (>= i 220)
    #t
    (let ((r (step hp hpieces rules PHYS-DT)))
      (set! hp (car r))
      (set! hpieces (car (cdr r)))
      (if (string=? (car (cdr (cdr r))) "bump")
        (begin
          (set! saw-bump 1)
          (set! bump-grace (player-grace hp)))
        #f)
      (loop (+ i 1)))))
(display "bump-alive ")
(display (if (and (= saw-bump 1) (player-alive? hp) (> (player-x hp) 6.0)) 1 0))
(newline)
(display "bump-score ")
(display (player-score hp))
(newline)
(display "bump-grace ")
(display (if (> bump-grace 1.0) 1 0))
(newline)

; Falling in a pit sets the runner on the ground ahead. No end state.
(define pit
  (list (piece 1.0 0.0 4.0 0.45 0.0)
        (piece 2.0 4.0 5.0 1.2 -1.2)
        (piece 1.0 9.0 20.0 0.45 0.0)))
(define pp (make-player 1.0))
(define ppieces pit)
(define saw-oops 0)
(define pit-grace 0.0)
(let loop ((i 0))
  (if (>= i 220)
    #t
    (let ((r (step pp ppieces rules PHYS-DT)))
      (set! pp (car r))
      (set! ppieces (car (cdr r)))
      (if (string=? (car (cdr (cdr r))) "oops")
        (begin
          (set! saw-oops 1)
          (set! pit-grace (player-grace pp)))
        #f)
      (loop (+ i 1)))))
(display "pit-alive ")
(display (if (and (= saw-oops 1) (player-alive? pp) (> (player-x pp) 12.0) (<= (player-y pp) 0.001)) 1 0))
(newline)
(display "pit-grace ")
(display (if (> pit-grace 1.0) 1 0))
(newline)

; A pot meets a centred body. The same lane's edge, and a jump that
; clears the leaves, do not. A gate meets a standing body and misses a slide.
(define pot-ps (list (piece 7.0 4.9 1.1 1.65 0.0 1.0)))
(define (pot-event p)
  (car (cdr (cdr (step p pot-ps rules PHYS-DT)))))
(display "pot-centre ")
(display (if (string=? (pot-event (make-player 5.0)) "bump") 1 0))
(newline)
(display "pot-edge ")
(display (if (string=? (pot-event (pset (make-player 5.0) 10 0.88)) "ok") 1 0))
(newline)
(display "pot-clear ")
(display (if (string=? (pot-event (pset (make-player 5.0) 1 1.05)) "ok") 1 0))
(newline)

(define fly-ps (list (piece 8.0 4.8 0.72 0.5 0.7 1.0 0.0 0.0)))
(define (fly-event p)
  (car (cdr (cdr (step p fly-ps rules PHYS-DT)))))
(display "fly-centre ")
(display (if (string=? (fly-event (make-player 5.0)) "bump") 1 0))
(newline)
(display "fly-edge ")
(display (if (string=? (fly-event (pset (make-player 5.0) 10 0.88)) "ok") 1 0))
(newline)

(define (run-gate slider)
  (let loop ((p (if slider (press-slide (make-player 7.6)) (make-player 7.6)))
             (ps (list (piece 4.0 8.0 0.7 0.34 0.66)))
             (i 0)
             (bumped 0))
    (if (>= i 90)
      (list bumped (player-x p))
      (let ((r (step p ps rules PHYS-DT)))
        (loop (car r) (car (cdr r)) (+ i 1)
              (if (string=? (car (cdr (cdr r))) "bump") 1 bumped))))))
(define stood (run-gate #f))
(define slid (run-gate #t))
(display "gate-stand ")
(display (car stood))
(newline)
(display "gate-slide ")
(display (if (and (= (car slid) 0) (> (car (cdr slid)) 9.0)) 1 0))
(newline)
