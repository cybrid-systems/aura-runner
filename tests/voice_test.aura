; Spoken sky props, friends, pace and the finish. The picture does not
; wait on a model. A level then eases, steps up, or changes garden
; from the score.
(require "lib/voice")
(require "lib/thing")
(require "lib/wish")
(require "lib/pals")
(require "lib/scene")

(define (bit ok) (if ok 1 0))

(define (show-intent label text)
  (let ((r (voice-intent text)))
    (display label)
    (display " ")
    (if r
      (begin
        (display (hash-ref r "act"))
        (display " ")
        (display (hash-ref r "name"))
        (display " ")
        (display (hash-ref r "dir")))
      (display "none"))
    (newline)))

(show-intent "sun" "画个太阳")
(show-intent "moon" "来一个月亮")
(show-intent "plane" "加一架飞机")
(show-intent "sun-en" "draw a sun")
(show-intent "drop-sun" "去掉太阳")
(show-intent "drop-moon" "remove the moon")
(show-intent "kitten" "不要小猫")
(show-intent "fox" "去掉狐狸")
(show-intent "fast" "跑快点")
(show-intent "slow" "慢一点")
(show-intent "hard" "难一点")
(show-intent "easy" "简单一点")
(show-intent "goal" "设置终点")
(show-intent "far" "终点远一点")
(show-intent "near" "终点近一点")
(show-intent "star" "来一个金色的星星")
(show-intent "pink" "把天空染成粉色")
(show-intent "hello" "hello there")
(show-intent "sunny" "sunny garden")

(define (mm x)
  (let ((v (* x 1000.0)))
    (floor (+ v 0.5))))

(display "speed-up ")
(display (mm (voice-speed-next 8.0 1)))
(newline)
(display "speed-top ")
(display (mm (voice-speed-next 14.0 1)))
(newline)
(display "speed-down ")
(display (mm (voice-speed-next 14.0 -1)))
(newline)
(display "speed-mid ")
(display (mm (voice-speed-next 9.0 1)))
(newline)
(display "form-up ")
(display (voice-form-step 0 1))
(newline)
(display "form-cap ")
(display (voice-form-step 4 1))
(newline)
(display "form-floor ")
(display (voice-form-step 0 -1))
(newline)

(display "goal-set ")
(display (mm (voice-goal 10.0 0.0 128.0 0)))
(newline)
(display "goal-near ")
(display (mm (voice-goal 100.0 0.0 128.0 -1)))
(newline)
(display "goal-far ")
(display (mm (voice-goal 20.0 0.0 128.0 1)))
(newline)
(display "goal-cap ")
(display (mm (voice-goal 200.0 0.0 128.0 0)))
(newline)

(define (show-plan label f bumps points level)
  (let ((p (adapt-finish f bumps points level)))
    (display label)
    (display " ")
    (display (hash-ref p "act"))
    (display " ")
    (display (hash-ref p "form"))
    (display " ")
    (display (hash-ref p "scene"))
    (newline)))

(show-plan "low" 0 0 0 1)
(show-plan "odd" 0 0 100 1)
(show-plan "even" 1 0 200 2)
(show-plan "bumps" 2 2 300 3)
(show-plan "hold" 1 1 50 2)
(show-plan "cap" 4 0 400 5)

(display "span-open ")
(display (mm (adapt-span 8.0 0 1)))
(newline)
(display "span-low ")
(display (mm (adapt-span 8.0 10 2)))
(newline)
(display "span-high ")
(display (mm (adapt-span 8.0 200 2)))
(newline)
(display "span-top ")
(display (mm (adapt-span 14.0 500 3)))
(newline)

(define put1 (voice-put (list) "sun"))
(define put2 (voice-put (hash-ref put1 "props") "sun"))
(define put3 (voice-put (hash-ref put1 "props") "moon"))
(define full (voice-put (list "sun" "moon" "plane") "sun"))
(define cut (voice-cut (list "sun" "moon") "sun"))
(define miss (voice-cut (list) "moon"))
(display "put ")
(display (bit (and (hash-ref put1 "ok") (string=? (car (hash-ref put1 "props")) "sun"))))
(newline)
(display "have ")
(display (hash-ref put2 "why"))
(newline)
(display "two ")
(display (length (hash-ref put3 "props")))
(newline)
(display "full ")
(display (hash-ref full "why"))
(newline)
(display "cut ")
(display (bit (and (hash-ref cut "ok") (string=? (car (hash-ref cut "props")) "moon"))))
(newline)
(display "miss ")
(display (hash-ref miss "why"))
(newline)

(define rows (hash-ref (check-roster default-pals) "pals"))
(define dropped (drop-kind rows "kitten"))
(define gone (drop-kind rows "fox"))
(define left (hash-ref (drop-kind (hash-ref (drop-kind (hash-ref dropped "rows") "van") "rows") "racer") "rows"))
(define last (drop-kind left "car"))
(display "drop ")
(display (bit (and (hash-ref dropped "ok") (= (length (hash-ref dropped "rows")) 3))))
(newline)
(display "drop-miss ")
(display (hash-ref gone "why"))
(newline)
(display "drop-last ")
(display (hash-ref last "why"))
(newline)

(define fox (wish-named "来一只狐狸"))
(define bee (wish-named "来一只蜜蜂"))
(display "fox ")
(display (bit (and fox (string=? (hash-ref fox "arm") "pals")
                    (hash-ref (check-pals (hash-ref fox "form")) "ok" #f)
                    (hash-ref (check-scene (hash-ref (wish-at 5) "form")) "ok" #f))))
(newline)
(display "bee ")
(display (bit (and bee (hash-ref (check-pals (hash-ref bee "form")) "ok" #f))))
(newline)
(display "line-zh ")
(display (bit (string=? (voice-line "add-prop" "sun" "fair" "zh") "太阳升起来了")))
(newline)
(display "line-miss ")
(display (bit (string=? (voice-line "drop-prop" "plane" "missing" "en") "That one is not out")))
(newline)

(show-intent "not-fast" "不要快点")
(show-intent "drop-dragon" "去掉龙")
(show-intent "drop-it" "不要了")
(show-intent "draw-dragon" "画一条龙")

(define (show-compose label text)
  (let ((form (compose-thing text)))
    (display label)
    (display " ")
    (if (not (string? form))
      (display "no")
      (let ((c (check-thing form)))
        (display (if (hash-ref c "ok" #f) 1 0))
        (display " ")
        (display (hash-ref c "name" ""))
        (display " ")
        (display (hash-ref c "role" ""))
        (if (hash-ref c "ok" #f)
          #f
          (begin (display " ") (display (hash-ref c "why" ""))))))
    (newline)))

(show-compose "dragon" "画一条龙")
(show-compose "house" "一座粉色的房子")
(show-compose "robot" "画个机器人")
(show-compose "unknown" "画个任意的小玩意儿")
(show-compose "cloud" "一朵云")
(show-compose "jump" "画一个跳高的栏杆")
(show-compose "slide" "画一个可以滑过去的门")

(display "differ ")
(let ((a (compose-thing "画个任意的小玩意儿"))
      (b (compose-thing "画个另一种完全不同的玩意儿啊")))
  (display (bit (and (string? a) (string? b) (not (string=? a b))))))
(newline)

(display "name-garden ")
(display (compose-name "粉色的花园"))
(newline)
(display "name-flower ")
(display (compose-name "花朵"))
(newline)
(display "name-sunny ")
(display (compose-name "sunny garden"))
(newline)
(display "name-house ")
(display (compose-name "draw a house"))
(newline)

(define (yn label v)
  (display label)
  (display " ")
  (display (bit v))
  (newline))

(yn "want-dragon" (compose-wanted? "画一条龙"))
(yn "want-pink" (compose-wanted? "把天空染成粉色"))
(yn "want-hello" (compose-wanted? "hello there"))
(yn "want-cloud" (compose-wanted? "粉色的云"))
(yn "want-star" (compose-wanted? "来一个金色的星星"))

(define (pub-of text id)
  (thing-public (check-thing (compose-thing text)) id))

(define s1 (hash-ref (shown-put (list) (pub-of "画一条龙" 1)) "rows"))
(define s2 (hash-ref (shown-put s1 (pub-of "一座粉色的房子" 2)) "rows"))
(define s3 (hash-ref (shown-put s2 (pub-of "画一条龙" 3)) "rows"))
(display "shown-n ")
(display (length s3))
(newline)
(display "shown-top ")
(display (hash-ref (shown-last s3) "name" ""))
(newline)

(define sd (shown-drop s3 "dragon"))
(display "shown-drop ")
(display (hash-ref sd "why"))
(display " ")
(display (length (hash-ref sd "rows")))
(newline)
(define sm (shown-drop s3 "castle"))
(display "shown-miss ")
(display (hash-ref sm "why"))
(newline)
(define sl (shown-drop s2 ""))
(display "shown-last ")
(display (hash-ref sl "why"))
(display " ")
(display (hash-ref sl "name"))
(newline)

(define cap
  (let* ((a (hash-ref (shown-put s2 (pub-of "画个机器人" 4)) "rows"))
         (b (hash-ref (shown-put a (pub-of "画一个蛋糕" 5)) "rows"))
         (c (hash-ref (shown-put b (pub-of "画一棵树" 6)) "rows")))
    (hash-ref (shown-put c (pub-of "画一条鱼" 7)) "rows")))
(display "shown-cap ")
(display (length cap))
(display " ")
(display (hash-ref (car cap) "name" ""))
(newline)

(show-intent "drop-both" "去掉太阳、月亮")
(show-intent "drop-and" "去掉太阳和月亮")
(show-intent "add-both" "画个太阳和月亮")
