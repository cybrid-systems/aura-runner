(show-intent "hero-fox" "变成狐狸")
(show-intent "hero-car" "变成小车")
(show-intent "hero-dragon" "变成龙")
(show-intent "hero-penguin" "变成企鹅")
(show-intent "hero-panda" "变成熊猫")
(show-intent "hero-en" "become fox")
(show-intent "hero-keep" "变成守护者")

(define become (voice-intent "变成狐狸"))
(define fox-form (hero-src (hash-ref become "name")))
(define fox-ok (check-pals fox-form))
(display "hero-form ")
(display (bit (and become
                   (string=? (hash-ref become "act") "hero")
                   (hash-ref fox-ok "ok" #f)
                   (string=? (hash-ref (hash-ref fox-ok "hero") "plan") "fox"))))
(newline)
(display "hero-line ")
(display (bit (string=? (voice-line "hero" "fox" "fair" "zh") "换成这个样子了")))
(newline)

(define (show-heat label f bumps points level skill)
  (let ((p (adapt-finish f bumps points level skill)))
    (display label)
    (display " ")
    (display (hash-ref p "act"))
    (display " ")
    (display (hash-ref p "form"))
    (display " ")
    (display (hash-ref p "pressure"))
    (display " ")
    (display (hash-ref p "streak"))
    (newline)))

(show-heat "heat-low" 2 2 10 2 (hash "pressure" 3 "streak" 2))
(show-heat "heat-combo" 1 0 80 2 (hash "pressure" 1 "combo" 3 "streak" 0))
(show-heat "heat-pass" 0 0 90 3 (hash "pressure" 2 "overtakes" 1))
(show-heat "heat-step" 0 0 400 1 (hash "pressure" 0 "combo" 5 "streak" 4))
(show-heat "heat-lock" 0 0 100 1 (hash "pressure" 1 "combo" 3 "locked" #t))
(show-heat "heat-ease" 2 2 10 2 (hash "pressure" 2 "locked" #t))
(show-heat "heat-streak" 1 0 60 2 (hash "pressure" 1 "streak" 1))
(show-heat "heat-hold" 1 1 80 2 (hash "pressure" 2 "combo" 4))
(show-heat "heat-cap" 4 0 400 5 (hash "pressure" 4 "combo" 5))
(show-heat "heat-still" 0 0 40 1 (hash "pressure" 1 "locked" #t))
(display "line-dense ")
(display (bit (and (string=? (adapt-line "dense" "en") "More to collect")
                   (string=? (adapt-line "dense" "zh") "这一关收集更密"))))
(newline)

